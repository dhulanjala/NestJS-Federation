script-source,932,C:\\development\\NestJS Federation\\gateway\\node_modules\\make-fetch-happen\\lib\\cache\\index.js,const { NotCachedError } = require('./errors.js')\nconst CacheEntry = require('./entry.js')\nconst remote = require('../remote.js')\n\n// do whatever is necessary to get a Response and return it\nconst cacheFetch = async (request\x2C options) => {\n  // try to find a cached entry that satisfies this request\n  const entry = await CacheEntry.find(request\x2C options)\n  if (!entry) {\n    // no cached result\x2C if the cache mode is 'only-if-cached' that's a failure\n    if (options.cache === 'only-if-cached') {\n      throw new NotCachedError(request.url)\n    }\n\n    // otherwise\x2C we make a request\x2C store it and return it\n    const response = await remote(request\x2C options)\n    const newEntry = new CacheEntry({ request\x2C response\x2C options })\n    return newEntry.store('miss')\n  }\n\n  // we have a cached response that satisfies this request\x2C however if the cache\n  // mode is 'no-cache' then we send the revalidation request no matter what\n  if (options.cache === 'no-cache') {\n    return entry.revalidate(request\x2C options)\n  }\n\n  // if the cached entry is not stale\x2C or if the cache mode is 'force-cache' or\n  // 'only-if-cached' we can respond with the cached entry. set the status\n  // based on the result of needsRevalidation and respond\n  const _needsRevalidation = entry.policy.needsRevalidation(request)\n  if (options.cache === 'force-cache' ||\n      options.cache === 'only-if-cached' ||\n      !_needsRevalidation) {\n    return entry.respond(request.method\x2C options\x2C _needsRevalidation ? 'stale' : 'hit')\n  }\n\n  // if we got here\x2C the cache entry is stale so revalidate it\n  return entry.revalidate(request\x2C options)\n}\n\ncacheFetch.invalidate = async (request\x2C options) => {\n  if (!options.cachePath) {\n    return\n  }\n\n  return CacheEntry.invalidate(request\x2C options)\n}\n\nmodule.exports = cacheFetch\n
