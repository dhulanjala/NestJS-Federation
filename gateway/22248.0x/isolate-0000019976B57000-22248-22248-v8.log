script-source,968,C:\\development\\NestJS Federation\\gateway\\node_modules\\semver\\functions\\compare-build.js,'use strict'\n\nconst SemVer = require('../classes/semver')\nconst compareBuild = (a\x2C b\x2C loose) => {\n  const versionA = new SemVer(a\x2C loose)\n  const versionB = new SemVer(b\x2C loose)\n  return versionA.compare(versionB) || versionA.compareBuild(versionB)\n}\nmodule.exports = compareBuild\n
