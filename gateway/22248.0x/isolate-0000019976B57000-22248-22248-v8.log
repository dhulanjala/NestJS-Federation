m)\n  }).catch(err => stream.emit('error'\x2C err))\n\n  return stream\n}\n\nmodule.exports.copy = copy\n\nfunction copy (cache\x2C integrity\x2C dest) {\n  return withContentSri(cache\x2C integrity\x2C (cpath) => {\n    return fs.copyFile(cpath\x2C dest)\n  })\n}\n\nmodule.exports.hasContent = hasContent\n\nasync function hasContent (cache\x2C integrity) {\n  if (!integrity) {\n    return false\n  }\n\n  try {\n    return await withContentSri(cache\x2C integrity\x2C async (cpath\x2C sri) => {\n      const stat = await fs.stat(cpath)\n      return { size: stat.size\x2C sri\x2C stat }\n    })\n  } catch (err) {\n    if (err.code === 'ENOENT') {\n      return false\n    }\n\n    if (err.code === 'EPERM') {\n      /* istanbul ignore else */\n      if (process.platform !== 'win32') {\n        throw err\n      } else {\n        return false\n      }\n    }\n  }\n}\n\nasync function withContentSri (cache\x2C integrity\x2C fn) {\n  const sri = ssri.parse(integrity)\n  // If `integrity` has multiple entries\x2C pick the first digest\n  // with available local data.\n  const algo = sri.pickAlgorithm()\n  const digests = sri[algo]\n\n  if (digests.length <= 1) {\n    const cpath = contentPath(cache\x2C digests[0])\n    return fn(cpath\x2C digests[0])\n  } else {\n    // Can't use race here because a generic error can happen before\n    // a ENOENT error\x2C and can happen before a valid result\n    const results = await Promise.all(digests.map(async (meta) => {\n      try {\n        return await withContentSri(cache\x2C meta\x2C fn)\n      } catch (err) {\n        if (err.code === 'ENOENT') {\n          return Object.assign(\n            new Error('No matching content found for ' + sri.toString())\x2C\n            { code: 'ENOENT' }\n          )\n        }\n        return err\n      }\n    }))\n    // Return the first non error if it is found\n    const result = results.find((r) => !(r instanceof Error))\n    if (result) {\n      return result\n    }\n\n    // Throw the No ma