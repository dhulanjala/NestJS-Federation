script-source,264,C:\\development\\NestJS Federation\\gateway\\node_modules\\graphql\\language\\printer.js,'use strict';\n\nObject.defineProperty(exports\x2C '__esModule'\x2C {\n  value: true\x2C\n});\nexports.print = print;\n\nvar _blockString = require('./blockString.js');\n\nvar _printString = require('./printString.js');\n\nvar _visitor = require('./visitor.js');\n\n/** @category Printing */\n\n/**\n * Converts an AST into a string\x2C using one set of reasonable\n * formatting rules.\n * @param ast - The GraphQL AST node to print.\n * @returns A stable string representation of the AST.\n * @example\n * ```ts\n * import { parse\x2C print } from 'graphql';\n *\n * const ast = parse('{ hero { name } }');\n * const text = print(ast);\n *\n * text; // => '{\\n  hero {\\n    name\\n  }\\n}'\n * ```\n */\nfunction print(ast) {\n  return (0\x2C _visitor.visit)(ast\x2C printDocASTReducer);\n}\n\nconst MAX_LINE_LENGTH = 80;\nconst printDocASTReducer = {\n  Name: {\n    leave: (node) => node.value\x2C\n  }\x2C\n  Variable: {\n    leave: (node) => '$' + node.name\x2C\n  }\x2C\n  // Document\n  Document: {\n    leave: (node) => join(node.definitions\x2C '\\n\\n')\x2C\n  }\x2C\n  OperationDefinition: {\n    leave(node) {\n      const varDefs = hasMultilineItems(node.variableDefinitions)\n        ? wrap('(\\n'\x2C join(node.variableDefinitions\x2C '\\n')\x2C '\\n)')\n        : wrap('('\x2C join(node.variableDefinitions\x2C '\x2C ')\x2C ')');\n      const prefix =\n        wrap(''\x2C node.description\x2C '\\n') +\n        join(\n          [\n            node.operation\x2C\n            join([node.name\x2C varDefs])\x2C\n            join(node.directives\x2C ' ')\x2C\n          ]\x2C\n          ' '\x2C\n        ); // Anonymous queries with no directives or variable definitions can use\n      // the query short form.\n\n      return (prefix === 'query' ? '' : prefix + ' ') + node.selectionSet;\n    }\x2C\n  }\x2C\n  VariableDefinition: {\n    leave: ({ variable\x2C type\x2C defaultValue\x2C directives\x2C description }) =>\n      wrap(''\x2C description\x2C '\\n') +\n      variable +\n      ': ' +\n      type +\n      wrap(' = '\x2C defaultValue) +\n      wrap(' '\x2C join(directives\x2C ' '))\x2C\n  }\x2C\n  SelectionSet: {\n    leave: ({ selections }) => block(selections)\x2C\n  }\x2C\n  Field: {\n    leave({ alias\x2C name\x2C arguments: args\x2C directives\x2C selectionSet }) {\n      const prefix = wrap(''\x2C alias\x2C ': ') + name;\n      let argsLine = prefix + wrap('('\x2C join(args\x2C '\x2C ')\x2C ')');\n\n      if (argsLine.length > MAX_LINE_LENGTH) {\n        argsLine = prefix + wrap('(\\n'\x2C indent(join(args\x2C '\\n'))\x2C '\\n)');\n      }\n\n      return join([argsLine\x2C join(directives\x2C ' ')\x2C selectionSet]\x2C ' ');\n    }\x2C\n  }\x2C\n  Argument: {\n    leave: ({ name\x2C value }) => name + ': ' + value\x2C\n  }\x2C\n  // Fragments\n  FragmentSpread: {\n    leave: ({ name\x2C directives }) =>\n      '...' + name + wrap(' '\x2C join(directives\x2C ' '))\x2C\n  }\x2C\n  InlineFragment: {\n    leave: ({ typeCondition\x2C directives\x2C selectionSet }) =>\n      join(\n        [\n          '...'\x2C\n          wrap('on '\x2C typeCondition)\x2C\n          join(directives\x2C ' ')\x2C\n          selectionSet\x2C\n        ]\x2C\n        ' '\x2C\n      )\x2C\n  }\x2C\n  FragmentDefinition: {\n    leave: ({\n      name\x2C\n      typeCondition\x2C\n      variableDefinitions\x2C\n      directives\x2C\n      selectionSet\x2C\n      description\x2C\n    }) =>\n      wrap(''\x2C description\x2C '\\n') + // Note: fragment variable definitions are experimental and may be changed\n      // or removed in the future.\n      `fragment ${name}${wrap('('\x2C join(variableDefinitions\x2C '\x2C ')\x2C ')')} ` +\n      `on ${typeCondition} ${wrap(''\x2C join(directives\x2C ' ')\x2C ' ')}` +\n      selectionSet\x2C\n  }\x2C\n  // Value\n  IntValue: {\n    leave: ({ value }) => value\x2C\n  }\x2C\n  FloatValue: {\n    leave: ({ value })