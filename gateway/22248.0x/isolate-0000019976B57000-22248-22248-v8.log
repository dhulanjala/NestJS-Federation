          sqrt   |\x0d\n *      toExponential                   |\x0d\n *      toFixed                         |\x0d\n *      toFormat                        |\x0d\n *      toFraction                      |\x0d\n *      toJSON                          |\x0d\n *      toNumber                        |\x0d\n *      toPrecision                     |\x0d\n *      toString                        |\x0d\n *      valueOf                         |\x0d\n *\x0d\n */\x0d\n\x0d\n\x0d\n  var BigNumber\x2C\x0d\n    isNumeric = /^-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:e[+-]?\\d+)?$/i\x2C\x0d\n    mathceil = Math.ceil\x2C\x0d\n    mathfloor = Math.floor\x2C\x0d\n\x0d\n    bignumberError = '[BigNumber Error] '\x2C\x0d\n    tooManyDigits = bignumberError + 'Number primitive has more than 15 significant digits: '\x2C\x0d\n\x0d\n    BASE = 1e14\x2C\x0d\n    LOG_BASE = 14\x2C\x0d\n    MAX_SAFE_INTEGER = 0x1fffffffffffff\x2C         // 2^53 - 1\x0d\n    // MAX_INT32 = 0x7fffffff\x2C                   // 2^31 - 1\x0d\n    POWS_TEN = [1\x2C 10\x2C 100\x2C 1e3\x2C 1e4\x2C 1e5\x2C 1e6\x2C 1e7\x2C 1e8\x2C 1e9\x2C 1e10\x2C 1e11\x2C 1e12\x2C 1e13]\x2C\x0d\n    SQRT_BASE = 1e7\x2C\x0d\n\x0d\n    // EDITABLE\x0d\n    // The limit on the value of DECIMAL_PLACES\x2C TO_EXP_NEG\x2C TO_EXP_POS\x2C MIN_EXP\x2C MAX_EXP\x2C and\x0d\n    // the arguments to toExponential\x2C toFixed\x2C toFormat\x2C and toPrecision.\x0d\n    MAX = 1E9;                                   // 0 to MAX_INT32\x0d\n\x0d\n\x0d\n  /*\x0d\n   * Create and return a BigNumber constructor.\x0d\n   */\x0d\n  function clone(configObject) {\x0d\n    var div\x2C convertBase\x2C parseNumeric\x2C\x0d\n      P = BigNumber.prototype = { constructor: BigNumber\x2C toString: null\x2C valueOf: null }\x2C\x0d\n      ONE = new BigNumber(1)\x2C\x0d\n\x0d\n\x0d\n      //----------------------------- EDITABLE CONFIG DEFAULTS -------------------------------\x0d\n\x0d\n\x0d\n      // The default values below must be integers within the inclusive ranges stated