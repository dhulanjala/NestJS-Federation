script-source,997,C:\\development\\NestJS Federation\\gateway\\node_modules\\@npmcli\\fs\\lib\\with-temp-dir.js,const { join\x2C sep } = require('path')\n\nconst getOptions = require('./common/get-options.js')\nconst { mkdir\x2C mkdtemp\x2C rm } = require('fs/promises')\n\n// create a temp directory\x2C ensure its permissions match its parent\x2C then call\n// the supplied function passing it the path to the directory. clean up after\n// the function finishes\x2C whether it throws or not\nconst withTempDir = async (root\x2C fn\x2C opts) => {\n  const options = getOptions(opts\x2C {\n    copy: ['tmpPrefix']\x2C\n  })\n  // create the directory\n  await mkdir(root\x2C { recursive: true })\n\n  const target = await mkdtemp(join(`${root}${sep}`\x2C options.tmpPrefix || ''))\n  let err\n  let result\n\n  try {\n    result = await fn(target)\n  } catch (_err) {\n    err = _err\n  }\n\n  try {\n    await rm(target\x2C { force: true\x2C recursive: true })\n  } catch {\n    // ignore errors\n  }\n\n  if (err) {\n    throw err\n  }\n\n  return result\n}\n\nmodule.exports = withTempDir\n
