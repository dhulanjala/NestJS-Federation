Token */\x2C 47 /* MinusMinusToken */\x2C [isNonJsxSameLineTokenContext\x2C isBinaryOpContext]\x2C 4 /* InsertSpace */)\x2C\n    rule("NoSpaceAfterCloseBrace"\x2C 20 /* CloseBraceToken */\x2C [28 /* CommaToken */\x2C 27 /* SemicolonToken */]\x2C [isNonJsxSameLineTokenContext]\x2C 16 /* DeleteSpace */)\x2C\n    // For functions and control block place } on a new line [multi-line rule]\n    rule("NewLineBeforeCloseBraceInBlockContext"\x2C anyTokenIncludingMultilineComments\x2C 20 /* CloseBraceToken */\x2C [isMultilineBlockContext]\x2C 8 /* InsertNewLine */)\x2C\n    // Space/new line after }.\n    rule("SpaceAfterCloseBrace"\x2C 20 /* CloseBraceToken */\x2C anyTokenExcept(22 /* CloseParenToken */)\x2C [isNonJsxSameLineTokenContext\x2C isAfterCodeBlockContext]\x2C 4 /* InsertSpace */)\x2C\n    // Special case for (}\x2C else) and (}\x2C while) since else & while tokens are not part of the tree which makes SpaceAfterCloseBrace rule not applied\n    // Also should not apply to })\n    rule("SpaceBetweenCloseBraceAndElse"\x2C 20 /* CloseBraceToken */\x2C 93 /* ElseKeyword */\x2C [isNonJsxSameLineTokenContext]\x2C 4 /* InsertSpace */)\x2C\n    rule("SpaceBetweenCloseBraceAndWhile"\x2C 20 /* CloseBraceToken */\x2C 117 /* WhileKeyword */\x2C [isNonJsxSameLineTokenContext]\x2C 4 /* InsertSpace */)\x2C\n    rule("NoSpaceBetweenEmptyBraceBrackets"\x2C 19 /* OpenBraceToken */\x2C 20 /* CloseBraceToken */\x2C [isNonJsxSameLineTokenContext\x2C isObjectContext]\x2C 16 /* DeleteSpace */)\x2C\n    // Add a space after control dec context if the next character is an open bracket ex: 'if (false)[a\x2C b] = [1\x2C 2];' -> 'if (false) [a\x2C b] = [1\x2C 2];'\n    rule("SpaceAfterConditionalClosingParen"\x2C 22 /* CloseParenToken */\x2C 23 /* OpenBracketToken */\x2C [isControlDeclContext]\x2C 4 /* InsertSpace */)\x2C\n    rule("NoSpaceBetweenFunctionKeywordAndStar"\x2C 100 /* FunctionKeyword */\x2C 42 /* AsteriskToken */\x2C [isFunctionDeclarationOrFunctionExpressionContext]\x2C 16 /* DeleteSpace */)\x2C\n    rule("SpaceAfterStarInGeneratorDeclaration"\x2C 42 /* AsteriskToken */\x2C 80 /* Identifier */\x2C [isFunctionDeclarationOrFunctionExpressionContext]\x2C 4 /* InsertSpace */)\x2C\n    rule("SpaceAfterFunctionInFuncDecl"\x2C 100 /* FunctionKeyword */\x2C anyToken\x2C [isFunctionDeclContext]\x2C 4 /* InsertSpace */)\x2C\n    // Insert new line after { and before } in multi-line contexts.\n    rule("NewLineAfterOpenBraceInBlockContext"\x2C 19 /* OpenBraceToken */\x2C anyToken\x2C [isMultilineBlockContext]\x2C 8 /* InsertNewLine */)\x2C\n    // For get/set members\x2C we check for (identifier\x2Cidentifier) since get/set don't have tokens and they are represented as just an identifier token.\n    // Though\x2C we do extra check on the context to make sure we are dealing with get/set node. Example:\n    //      get x() {}\n    //      set x(val) {}\n    rule("SpaceAfterGetSetInMember"\x2C [139 /* GetKeyword */\x2C 153 /* SetKeyword */]\x2C 80 /* Identifier */\x2C [isFunctionDeclContext]\x2C 4 /* InsertSpace */)\x2C\n    rule("NoSpaceBetweenYieldKeywordAndStar"\x2C 127 /* YieldKeyword */\x2C 42 /* AsteriskToken */\x2C [isNonJsxSameLineTokenContext\x2C isYieldOrYieldStarWithOperand]\x2C 16 /* DeleteSpace */)\x2C\n    rule("SpaceBetweenYieldOrYieldStarAndOperand"\x2C [127 /* YieldKeyword */\x2C 42 /* AsteriskToken */]\x2C anyToken\x2C [isNonJsxSameLineTokenContext\x2C isYieldOrYieldStarWithOperand]\x2C 4 /* InsertSpace */)\x2C\n    rule("NoSpaceBetweenReturnAndSemicolon"\x2C 107 /* ReturnKeyword */\x2C 27 /* SemicolonToken */\x2C [isNonJsxSameLineTokenContext]\x2C 16 /* DeleteSpace */)\x2C\n    rule("SpaceAfterCertainKeywords"\x2C [115 /* VarKeyword */\x2C 111 /* ThrowKeyword */\x2C 105 /* NewKeyword */\x2C 91 /* DeleteKeyword */\x2C 107 /* ReturnKeyword */\x2C 114 /* TypeOfKeyword */\x2C 135 /* AwaitKeyword */]\x2C anyToken\x2C [isNonJsxSameLineTokenContext]\x2C 4 /* InsertSpace */)\x2C\n    rule("SpaceAfterLetConstInVariableDeclaration"\x2C [121 /* LetKeyword */\x2C 87 /* ConstKeyword */]\x2C anyToken\x2C [isNonJsxSameLineTokenContext\x2C isStartOfVariableDeclarationList]\x2C 4 /* InsertSpace */)\x2C\n    rule("NoSpaceBeforeOpenParenInFuncCall"\x2C anyToken\x2C 21 /* OpenParenToken */\x2C [isNonJsxSameLineTokenContext\x2C isFunctionCallOrNewContext\x2C isPreviousTokenNotComma]\x2C 16 /* DeleteSpace */)\x2C\n    // Special case for binary operators (that are keywords). For these we have to add a space and shouldn't follow any user options.\n    rule("SpaceBeforeBinaryKeywordOperator"\x2C anyToken\x2C binaryKeywordOperators\x2C [isNonJsxSameLineTokenContext\x2C isBinaryOpContext]\x2C 4 /* InsertSpace */)\x2C\n    rule("SpaceAfterBinaryKeywordOperator"\x2C binaryKeywordOperators\x2C anyToken\x2C [isNonJsxSameLineTokenContext\x2C isBinaryOpContext]\x2C 4 /* InsertSpace */)\x2C\n    rule("SpaceAfterVoidOperator"\x2C 116 /* VoidKeyword */\x2C anyToken\x2C [isNonJsxSameLineTokenContext\x2C isVoidOpContext]\x2C 4 /* InsertSpace */)\x2C\n    // Async-await\n    rule("SpaceBetweenAsyncAndOpenParen"\x2C 134 /* AsyncKeyword */\x2C 21 /* OpenParenToken */\x2C [isArrowFunctionContext\x2C isNonJsxSameLineTokenContext]\x2C 4 /* InsertSpace */)\x2C\n    rule("SpaceBetweenAsyncAndFunctionKeyword"\x2C 134 /* AsyncKeyword */\x2C [100 /* FunctionKeyword */\x2C 80 /* Identifier */]\x2C [isNonJsxSameLineTokenContext]\x2C 4 /* InsertSpace */)\x2C\n    // Template string\n    rule("NoSpaceBetweenTagAndTemplateString"\x2C [80 /* Identifier */\x2C 22 /* CloseParenToken */]\x2C [15 /* NoSubstitutionTemplateLiteral */\x2C 16 /* TemplateHead */]\x2C [isNonJsxSameLineTokenContext]\x2C 16 /* DeleteSpace */)\x2C\n    // JSX opening elements\n    rule("SpaceBeforeJsxAttribute"\x2C anyToken\x2C 80 /* Identifier */\x2C [isNextTokenParentJsxAttribute\x2C isNonJsxSameLineTokenContext]\x2C 4 /* InsertSpace */)\x2C\n    rule("SpaceBeforeSlashInJsxOpeningElement"\x2C anyToken\x2C 44 /* SlashToken */\x2C [isJsxSelfClosingElementContext\x2C isNonJsxSameLineTokenContext]\x2C 4 /* InsertSpace */)\x2C\n    rule("NoSpaceBeforeGreaterThanTokenInJsxOpeningElement"\x2C 44 /* SlashToken */\x2C 32 /* GreaterThanToken */\x2C [isJsxSelfClosingElementContext\x2C isNonJsxSameLineTokenContext]\x2C 16 /* DeleteSpace */)\x2C\n    rule("NoSpaceBeforeEqualInJsxAttribute"\x2C anyToken\x2C 64 /* EqualsToken */\x2C [isJsxAttributeContext\x2C isNonJsxSameLineTokenContext]\x2C 16 /* DeleteSpace */)\x2C\n    rule("NoSpaceAfterEqualInJsxAttribute"\x2C 64 /* EqualsToken */\x2C anyToken\x2C [isJsxAttributeContext\x2C isNonJsxSameLineTokenContext]\x2C 16 /* DeleteSpace */)\x2C\n    rule("NoSpaceBeforeJsxNamespaceColon"\x2C 80 /* Identifier */\x2C 59 /* ColonToken */\x2C [isNextTokenParentJsxNamespacedName]\x2C 16 /* DeleteSpace */)\x2C\n    rule("NoSpaceAfterJsxNamespaceColon"\x2C 59 /* ColonToken */\x2C 80 /* Identifier */\x2C [isNextTokenParentJsxNamespacedName]\x2C 16 /* DeleteSpace */)\x2C\n    // TypeScript-specific rules\n    // Use of module as a function call. e.g.: import m2 = module("m2");\n    rule("NoSpaceAfterModuleImport"\x2C [144 /* ModuleKeyword */\x2C 149 /* RequireKeyword */]\x2C 21 /* OpenParenToken */\x2C [isNonJsxSameLineTokenContext]\x2C 16 /* DeleteSpace */)\x2C\n    // Add a space around certain TypeScript keywords\n    rule(\n      "SpaceAfterCertainTypeScriptKeywords"\x2C\n      [\n        128 /* AbstractKeyword */\x2C\n        129 /* AccessorKeyword */\x2C\n        86 /* ClassKeyword */\x2C\n        138 /* DeclareKeyword */\x2C\n        90 /* DefaultKeyword */\x2C\n        94 /* EnumKeyword */\x2C\n        95 /* ExportKeyword */\x2C\n        96 /* ExtendsKeyword */\x2C\n        139 /* GetKeyword */\x2C\n        119 /* ImplementsKeyword */\x2C\n        102 /* ImportKeyword */\x2C\n        120 /* InterfaceKeyword */\x2C\n        144 /* ModuleKeyword */\x2C\n        145 /* NamespaceKeyword */\x2C\n        123 /* PrivateKeyword */\x2C\n        125 /* PublicKeyword */\x2C\n        124 /* ProtectedKeyword */\x2C\n        148 /* ReadonlyKeyword */\x2C\n        153 /* SetKeyword */\x2C\n        126 /* StaticKeyword */\x2C\n        156 /* TypeKeyword */\x2C\n        161 /* FromKeyword */\x2C\n        143 /* KeyOfKeyword */\x2C\n        140 /* InferKeyword */\n      ]\x2C\n      anyToken\x2C\n      [isNonJsxSameLineTokenContext]\x2C\n      4 /* InsertSpace */\n    )\x2C\n    rule(\n      "SpaceBeforeCertainTypeScriptKeywords"\x2C\n      anyToken\x2C\n      [96 /* ExtendsKeyword */\x2C 119 /* ImplementsKeyword */\x2C 161 /* FromKeyword */]\x2C\n      [isNonJsxSameLineTokenContext]\x2C\n      4 /* InsertSpace */\n    )\x2C\n    // Treat string literals in module names as identifiers\x2C and add a space between the literal and the opening Brace braces\x2C e.g.: module "m2" {\n    rule("SpaceAfterModuleName"\x2C 11 /* StringLiteral */\x2C 19 /* OpenBraceToken */\x2C [isModuleDeclContext]\x2C 4 /* InsertSpace */)\x2C\n    // Lambda expressions\n    rule("SpaceBeforeArrow"\x2C anyToken\x2C 39 /* EqualsGreaterThanToken */\x2C [isNonJsxSameLineTokenContext]\x2C 4 /* InsertSpace */)\x2C\n    rule("SpaceAfterArrow"\x2C 39 /* EqualsGreaterThanToken */\x2C anyToken\x2C [isNonJsxSameLineTokenContext]\x2C 4 /* InsertSpace */)\x2C\n    // Optional parameters and let args\n    rule("NoSpaceAfterEllipsis"\x2C 26 /* DotDotDotToken */\x2C 80 /* Identifier */\x2C [isNonJsxSameLineTokenContext]\x2C 16 /* DeleteSpace */)\x2C\n    rule("NoSpaceAfterOptionalParameters"\x2C 58 /* QuestionToken */\x2C [22 /* CloseParenToken */\x2C 28 /* CommaToken */]\x2C [isNonJsxSameLineTokenContext\x2C isNotBinaryOpContext]\x2C 16 /* DeleteSpace */)\x2C\n    // Remove spaces in empty interface literals. e.g.: x: {}\n    rule("NoSpaceBetweenEmptyInterfaceBraceBrackets"\x2C 19 /* OpenBraceToken */\x2C 20 /* CloseBraceToken */\x2C [isNonJsxSameLineTokenContext\x2C isObjectTypeContext]\x2C 16 /* DeleteSpace */)\x2C\n    // generics and type assertions\n    rule("NoSpaceBeforeOpenAngularBracket"\x2C typeNames\x2C 30 /* LessThanToken */\x2C [isNonJsxSameLineTokenContext\x2C isTypeArgumentOrParameterOrAssertionContext]\x2C 16 /* DeleteSpace */)\x2C\n    rule("NoSpaceBetweenCloseParenAndAngularBracket"\x2C 22 /* CloseParenToken */\x2C 30 /* LessThanToken */\x2C [isNonJsxSameLineTokenContext\x2C isTypeArgumentOrParameterOrAssertionContext]\x2C 16 /* DeleteSpace */)\x2C\n    rule("NoSpaceAfterOpenAngularBracket"\x2C 30 /* LessThanToken */\x2C anyToken\x2C [isNonJsxSameLineTokenContext\x2C isTypeArgumentOrParameterOrAssertionContext]\x2C 16 /* DeleteSpace */)\x2C\n    rule("NoSpaceBeforeCloseAngularBracket"\x2C anyToken\x2C 32 /* GreaterThanToken */\x2C [isNonJsxSameLineTokenContext\x2C isTypeArgumentOrParameterOrAssertionContext]\x2C 16 /* DeleteSpace */)\x2C\n    rule("NoSpaceAfterCloseAngularBracket"\x2C 32 /* GreaterThanToken */\x2C [21 /* OpenParenToken */\x2C 23 /* OpenBracketToken */\x2C 32 /* GreaterThanToken */\x2C 28 /* CommaToken */]\x2C [\n      isNonJsxSameLineTokenContext\x2C\n      isTypeArgumentOrParameterOrAssertionContext\x2C\n      isNotFunctionDeclContext\x2C\n      /*To prevent an interference with the SpaceBeforeOpenParenInFuncDecl rule*/\n      isNonTypeAssertionContext\n    ]\x2C 16 /* DeleteSpace */)\x2C\n    // decorators\n    rule("SpaceBeforeAt"\x2C [22 /* CloseParenToken */\x2C 80 /* Identifier */]\x2C 60 /* AtToken */\x2C [isNonJsxSameLineTokenContext]\x2C 4 /* InsertSpace */)\x2C\n    rule("NoSpaceAfterAt"\x2C 60 /* AtToken */\x2C anyToken\x2C [isNonJsxSameLineTokenContext]\x2C 16 /* DeleteSpace */)\x2C\n    // Insert space after @ in decorator\n    rule(\n      "SpaceAfterDecorator"\x2C\n      anyToken\x2C\n      [\n        128 /* AbstractKeyword */\x2C\n        80 /* Identifier */\x2C\n        95 /* ExportKeyword */\x2C\n        90 /* DefaultKeyword */\x2C\n        86 /* ClassKeyword */\x2C\n        126 /* StaticKeyword */\x2C\n        125 /* PublicKeyword */\x2C\n        123 /* PrivateKeyword */\x2C\n        124 /* ProtectedKeyword */\x2C\n        139 /* GetKeyword */\x2C\n        153 /* SetKeyword */\x2C\n        23 /* OpenBracketToken */\x2C\n        42 /* AsteriskToken */\n      ]\x2C\n      [isEndOfDecoratorContextOnSameLine]\x2C\n      4 /* InsertSpace */\n    )\x2C\n    rule("NoSpaceBeforeNonNullAssertionOperator"\x2C anyToken\x2C 54 /* ExclamationToken */\x2C [isNonJsxSameLineTokenContext\x2C isNonNullAssertionContext]\x2C 16 /* DeleteSpace */)\x2C\n    rule("NoSpaceAfterNewKeywordOnConstructorSignature"\x2C 105 /* NewKeyword */\x2C 21 /* OpenParenToken */\x2C [isNonJsxSameLineTokenContext\x2C isConstructorSignatureContext]\x2C 16 /* DeleteSpace */)\x2C\n    rule("SpaceLessThanAndNonJSXTypeAnnotation"\x2C 30 /* LessThanToken */\x2C 30 /* LessThanToken */\x2C [isNonJsxSameLineTokenContext]\x2C 4 /* InsertSpace */)\n  ];\n  const userConfigurableRules = [\n    // Treat constructor as an identifier in a function declaration\x2C and remove spaces between constructor and following left parentheses\n    rule("SpaceAfterConstructor"\x2C 137 /* ConstructorKeyword */\x2C 21 /* OpenParenToken */\x2C [isOptionEnabled("insertSpaceAfterConstructor")\x2C isNonJsxSameLineTokenContext]\x2C 4 /* InsertSpace */)\x2C\n    rule("NoSpaceAfterConstructor"\x2C 137 /* ConstructorKeyword */\x2C 21 /* OpenParenToken */\x2C [isOptionDisabledOrUndefined("insertSpaceAfterConstructor")\x2C isNonJsxSameLineTokenContext]\x2C 16 /* DeleteSpace */)\x2C\n    rule("SpaceAfterComma"\x2C 28 /* CommaToken */\x2C anyToken\x2C [isOptionEnabled("insertSpaceAfterCommaDelimiter")\x2C isNonJsxSameLineTokenContext\x2C isNonJsxElementOrFragmentContext\x2C isNextTokenNotCloseBracket\x2C isNextTokenNotCloseParen]\x2C 4 /* InsertSpace */)\x2C\n    rule("NoSpaceAfterComma"\x2C 28 /* CommaToken */\x2C anyToken\x2C [isOptionDisabledOrUndefined("insertSpaceAfterCommaDelimiter")\x2C isNonJsxSameLineTokenContext\x2C isNonJsxElementOrFragmentContext]\x2C 16 /* DeleteSpace */)\x2C\n    // Insert space after function keyword for anonymous functions\n    rule("SpaceAfterAnony