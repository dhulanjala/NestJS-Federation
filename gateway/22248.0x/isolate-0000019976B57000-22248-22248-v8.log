script-source,1002,C:\\development\\NestJS Federation\\gateway\\node_modules\\cacache\\lib\\memoization.js,'use strict'\n\nconst { LRUCache } = require('lru-cache')\n\nconst MEMOIZED = new LRUCache({\n  max: 500\x2C\n  maxSize: 50 * 1024 * 1024\x2C // 50MB\n  ttl: 3 * 60 * 1000\x2C // 3 minutes\n  sizeCalculation: (entry\x2C key) => key.startsWith('key:') ? entry.data.length : entry.length\x2C\n})\n\nmodule.exports.clearMemoized = clearMemoized\n\nfunction clearMemoized () {\n  const old = {}\n  MEMOIZED.forEach((v\x2C k) => {\n    old[k] = v\n  })\n  MEMOIZED.clear()\n  return old\n}\n\nmodule.exports.put = put\n\nfunction put (cache\x2C entry\x2C data\x2C opts) {\n  pickMem(opts).set(`key:${cache}:${entry.key}`\x2C { entry\x2C data })\n  putDigest(cache\x2C entry.integrity\x2C data\x2C opts)\n}\n\nmodule.exports.put.byDigest = putDigest\n\nfunction putDigest (cache\x2C integrity\x2C data\x2C opts) {\n  pickMem(opts).set(`digest:${cache}:${integrity}`\x2C data)\n}\n\nmodule.exports.get = get\n\nfunction get (cache\x2C key\x2C opts) {\n  return pickMem(opts).get(`key:${cache}:${key}`)\n}\n\nmodule.exports.get.byDigest = getDigest\n\nfunction getDigest (cache\x2C integrity\x2C opts) {\n  return pickMem(opts).get(`digest:${cache}:${integrity}`)\n}\n\nclass ObjProxy {\n  constructor (obj) {\n    this.obj = obj\n  }\n\n  get (key) {\n    return this.obj[key]\n  }\n\n  set (key\x2C val) {\n    this.obj[key] = val\n  }\n}\n\nfunction pickMem (opts) {\n  if (!opts || !opts.memoize) {\n    return MEMOIZED\n  } else if (opts.memoize.get && opts.memoize.set) {\n    return opts.memoize\n  } else if (typeof opts.memoize === 'object') {\n    return new ObjProxy(opts.memoize)\n  } else {\n    return MEMOIZED\n  }\n}\n
