s.encoding = "utf8" // We output strings.\n    Transform.call(this\x2C options)\n  }\n\n  IconvLiteDecoderStream.prototype = Object.create(Transform.prototype\x2C {\n    constructor: { value: IconvLiteDecoderStream }\n  })\n\n  IconvLiteDecoderStream.prototype._transform = function (chunk\x2C encoding\x2C done) {\n    if (!Buffer.isBuffer(chunk) && !(chunk instanceof Uint8Array)) { return done(new Error("Iconv decoding stream needs buffers as its input.")) }\n    try {\n      var res = this.conv.write(chunk)\n      if (res && res.length) this.push(res\x2C this.encoding)\n      done()\n    } catch (e) {\n      done(e)\n    }\n  }\n\n  IconvLiteDecoderStream.prototype._flush = function (done) {\n    try {\n      var res = this.conv.end()\n      if (res && res.length) this.push(res\x2C this.encoding)\n      done()\n    } catch (e) {\n      done(e)\n    }\n  }\n\n  IconvLiteDecoderStream.prototype.collect = function (cb) {\n    var res = ""\n    this.on("error"\x2C cb)\n    this.on("data"\x2C function (chunk) { res += chunk })\n    this.on("end"\x2C function () {\n      cb(null\x2C res)\n    })\n    return this\n  }\n\n  return {\n    IconvLiteEncoderStream: IconvLiteEncoderStream\x2C\n    IconvLiteDecoderStream: IconvLiteDecoderStream\n  }\n}\n
