script-source,1015,C:\\development\\NestJS Federation\\gateway\\node_modules\\make-fetch-happen\\lib\\remote.js,const { Minipass } = require('minipass')\nconst fetch = require('minipass-fetch')\nconst { promiseRetry } = require('@gar/promise-retry')\nconst ssri = require('ssri')\nconst { log } = require('proc-log')\nconst { redact: cleanUrl } = require('@npmcli/redact')\n\nconst CachingMinipassPipeline = require('./pipeline.js')\nconst { getAgent } = require('@npmcli/agent')\nconst pkg = require('../package.json')\n\nconst USER_AGENT = `${pkg.name}/${pkg.version} (+https://npm.im/${pkg.name})`\n\nconst RETRY_ERRORS = [\n  'ECONNRESET'\x2C // remote socket closed on us\n  'ECONNREFUSED'\x2C // remote host refused to open connection\n  'EADDRINUSE'\x2C // failed to bind to a local port (proxy?)\n  'ETIMEDOUT'\x2C // someone in the transaction is WAY TOO SLOW\n  // from @npmcli/agent\n  'ECONNECTIONTIMEOUT'\x2C\n  'EIDLETIMEOUT'\x2C\n  'ERESPONSETIMEOUT'\x2C\n  'ETRANSFERTIMEOUT'\x2C\n  // Known codes we do NOT retry on:\n  // ENOTFOUND (getaddrinfo failure. Either bad hostname\x2C or offline)\n  // EINVALIDPROXY // invalid protocol from @npmcli/agent\n  // EINVALIDRESPONSE // invalid status code from @npmcli/agent\n]\n\nconst RETRY_TYPES = [\n  'request-timeout'\x2C\n]\n\n// make a request directly to the remote source\x2C\n// retrying certain classes of errors as well as\n// following redirects (through the cache if necessary)\n// and verifying response integrity\nconst remoteFetch = (request\x2C options) => {\n  // options.signal is intended for the fetch itself\x2C not the agent.  Attaching it to the agent will re-use that signal across multiple requests\x2C which prevents any connections beyond the first one.\n  const agent = getAgent(request.url\x2C { ...options\x2C signal: undefined })\n  if (!request.headers.has('connection')) {\n    request.headers.set('connection'\x2C agent ? 'keep-alive' : 'close')\n  }\n\n  if (!request.headers.has('user-agent')) {\n    request.headers.set('user-agent'\x2C USER_AGENT)\n  }\n\n  // keep our own options since we're overriding the agent\n  // and the redirect mode\n  const _opts = {\n    ...options\x2C\n    agent\x2C\n    redirect: 'manual'\x2C\n  }\n\n  return promiseRetry(async (retryHandler\x2C attemptNum) => {\n    const req = new fetch.Request(request\x2C _opts)\n    const url = cleanUrl(req.url)\n    try {\n      let res = await fetch(req\x2C _opts)\n      if (_opts.integrity && res.status === 200) {\n        // we got a 200 response and the user has specified an expected\n        // integrity value\x2C so wrap the response in an ssri stream to verify it\n        const integrityStream = ssri.integrityStream({\n          algorithms: _opts.algorithms\x2C\n          integrity: _opts.integrity\x2C\n          size: _opts.size\x2C\n        })\n        const pipeline = new CachingMinipassPipeline({\n          events: ['integrity'\x2C 'size']\x2C\n        }\x2C res.body\x2C integrityStream)\n        // we also propagate the integrity and size events out to the pipeline so we can use\n        // this new response body as an integrityEmitter for cacache\n        integrityStream.on('integrity'\x2C i => pipeline.emit('integrity'\x2C i))\n        integrityStream.on('size'\x2C s => pipeline.emit('size'\x2C s))\n        res = new fetch.Response(pipeline\x2C res)\n        // set an explicit flag so we know if our response body will emit integrity and size\n        res.body.hasIntegrityEmitter = true\n      }\n\n      res.headers.set('x-fetch-attempts'\x2C attemptNum)\n\n      // do not retry POST requests\x2C or requests with a streaming body\n      // do retry requests with a 408\x2C 420\x2C 429 or 500+ status in the response\n      const isStream = Minipass.isStream(req.body)\n      const isRetriable = req.method !== 'POST' &&\n          !isStream &&\n          ([408\x2C 420\x2C 429].includes(res.status) || res.status >= 500)\n\n      if (isRetriable) {\n        if (typeof options.onRetry === 'function') {\n          options.onRetry(res)\n        }\n\n        /* eslint-disable-next-line max-len */\n        log.http('fetch'\x2C `${req.method} ${url} attempt ${attemptNum} failed with ${res.status}`)\n        return retryHandler(res)\n      }\n\n      return res\n    } catch (err) {\n      const code = (err.code === 'EPROMISERETRY')\n        ? err.retried.code\n        : err.code\n\n      // err.retried will be the thing that was thrown from above\n      // if it's a response\x2C we just got a bad status code and we\n      // can re-throw to allow the retry\n      const isRetryError = err.retried instanceof fetch.Response ||\n        (RETRY_ERRORS.includes(code) && RETRY_TYPES.includes(err.type))\n\n      if (req.method === 'POST' || isRetryError) {\n        throw err\n      }\n\n      if (typeof options.onRetry === 'function') {\n        options.onRetry(err)\n      }\n\n      log.http('fetch'\x2C `${req.method} ${url} attempt ${attemptNum} failed with ${err.code}`)\n      return retryHandler(err)\n    }\n  }\x2C options.retry).catch((err) => {\n    // don't reject for http errors\x2C just return them\n    if (err.status >= 400 && err.type !== 'system') {\n      return err\n    }\n\n    throw err\n  })\n}\n\nmodule.exports = remoteFetch\n
