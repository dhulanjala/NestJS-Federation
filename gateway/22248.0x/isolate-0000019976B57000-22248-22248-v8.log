   }\n        return output;\n    }\n}\nfunction aggregateError(code\x2C message\x2C causes) {\n    return new AggregateGraphQLError(code\x2C message\x2C causes);\n}\nexports.aggregateError = aggregateError;\nfunction errorCauses(e) {\n    if (e instanceof AggregateGraphQLError) {\n        return e.causes;\n    }\n    if (e instanceof graphql_1.GraphQLError) {\n        return [e];\n    }\n    return undefined;\n}\nexports.errorCauses = errorCauses;\nfunction printGraphQLErrorsOrRethrow(e) {\n    const causes = errorCauses(e);\n    if (!causes) {\n        throw e;\n    }\n    return causes.map(e => e.toString()).join('\\n\\n');\n}\nexports.printGraphQLErrorsOrRethrow = printGraphQLErrorsOrRethrow;\nfunction printErrors(errors) {\n    return errors.map(e => e.toString()).join('\\n\\n');\n}\nexports.printErrors = printErrors;\nconst DEFAULT_METADATA = { addedIn: '2.0.0' };\nconst makeErrorCodeCategory = (extractCode\x2C makeDescription\x2C metadata = DEFAULT_METADATA) => ({\n    createCode: (element) => {\n        return makeCodeDefinition(extractCode(element)\x2C makeDescription(element)\x2C metadata);\n    }\x2C\n    get: (element) => {\n        const def = codeDefByCode[extractCode(element)];\n        (0\x2C utils_1.assert)(def\x2C `Unexpected element: ${element}`);\n        return def;\n    }\n});\nconst makeFederationDirectiveErrorCodeCategory = (codeSuffix\x2C makeDescription\x2C metadata = DEFAULT_METADATA) => makeErrorCodeCategory((directive) => `${directive.toLocaleUpperCase()}_${codeSuffix}`\x2C makeDescription\x2C metadata);\nfunction errorCode(e) {\n    if (!e.extensions || !('code' in e.extensions)) {\n        return undefined;\n    }\n    return e.extensions.code;\n}\nexports.errorCode = errorCode;\nfunction errorCodeDef(e) {\n    const code = typeof e === 'string' ? e : errorCode(e);\n    return code ? codeDefByCode[code] : undefined;\n}\nexports.errorCodeDef = errorCodeDef;\nfunction withModifiedErrorMessage(e\x2C newMessage) {\n    return new graphql_1.GraphQLError(newMessage\x2C {\n        nodes: e.nodes\x2C\n        source: e.source\x2C\n        positions: e.positions\x2C\n        path: e.path\x2C\n        originalError: e.originalError\x2C\n        extensions: e.extensions\n    });\n}\nexports.withModifiedErrorMessage = withModifiedErrorMessage;\nfunction withModifiedErrorNodes(e\x2C newNodes) {\n    return new graphql_1.GraphQLError(e.message\x2C {\n        nodes: newNodes\x2C\n        source: e.source\x2C\n        positions: e.positions\x2C\n        path: e.path\x2C\n        originalError: e.originalError\x2C\n        extensions: e.extensions\n    });\n}\nexports.withModifiedErrorNodes = withModifiedErrorNodes;\nconst INVALID_GRAPHQL = makeCodeDefinition('INVALID_GRAPHQL'\x2C 'A schema is invalid GraphQL: it violates one of the rule of the specification.');\nconst DIRECTIVE_DEFINITION_INVALID = makeCodeDefinition('DIRECTIVE_DEFINITION_INVALID'\x2C 'A built-in or federation directive has an invalid definition in the schema.'\x2C { ...DEFAULT_METADATA\x2C replaces: ['TAG_DEFINITION_INVALID'] });\nconst TYPE_DEFINITION_INVALID = makeCodeDefinition('TYPE_DEFINITION_INVALID'\x2C 'A built-in or federation type has an invalid definition in the schema.');\nconst UNSUPPORTED_LINKED_FEATURE = makeCodeDefinition('UNSUPPORTED_LINKED_FEATURE'\x2C 'Indicates that a feature used in a @link is either unsupported or is used with unsupported options.');\nconst UNKNOWN_FEDERATION_LINK_VERSION = makeCodeDefinition('UNKNOWN_FEDERATION_LINK_VERSION'\x2C 'The version of federation in a @link directive on the schema is unknown.');\nconst UNKNOWN_LINK_VERSION = makeCodeDefinition('UNKNOWN_LINK_VERSION'\x2C 'The version of @link set on the schema is unknown.'\x2C { addedIn: '2.1.0' });\nconst FIELDS_HAS_ARGS = makeFederationDirectiveErrorCodeCategory('FIELDS_HAS_ARGS'\x2C (directive) => `The \\`fields\\` argument of a \\`@${directive}\\` directive includes a field defined with arguments (which is not currently supported).`);\nconst KEY_FIELDS_HAS_ARGS = FIELDS_HAS_ARGS.createCode('key');\nconst PROVIDES_FIELDS_HAS_ARGS = FIELDS_HAS_ARGS.createCode('provides');\nconst DIRECTIVE_FIELDS_MISSING_EXTERNAL = makeFederationDirectiveErrorCodeCategory('FIELDS_MISSING_EXTERNAL'\x2C (directive) => `The \\`fields\\` argument of a \\`@${directive}\\` directive includes a field that is not marked as \\`@external\\`.`\x2C { addedIn: FED1_CODE });\nconst PROVIDES_MISSING_EXTERNAL = DIRECTIVE_FIELDS_MISSING_EXTERNAL.createCode('provides');\nconst REQUIRES_MISSING_EXTERNAL = DIRECTIVE_FIELDS_MISSING_EXTERNAL.createCode('requires');\nconst DIRECTIVE_UNSUPPORTED_ON_INTERFACE = makeFederationDirectiveErrorCodeCategory('UNSUPPORTED_ON_INTERFACE'\x2C (directive) => `A \\`@${directive}\\` directive is used on an interface\x2C which is ${directive === 'key' ? 'only supported when @linking to federation 2.3+' : 'not (yet) supported'}.`);\nconst KEY_UNSUPPORTED_ON_INTERFACE = DIRECTIVE_UNSUPPORTED_ON_INTERFACE.createCode('key');\nconst PROVIDES_UNSUPPORTED_ON_INTERFACE = DIRECTIVE_UNSUPPORTED_ON_INTERFACE.createCode('provides');\nconst REQUIRES_UNSUPPORTED_ON_INTERFACE = DIRECTIVE_UNSUPPORTED_ON_INTERFACE.createCode('requires');\nconst DIRECTIVE_IN_FIELDS_ARG = makeFederationDirectiveErrorCodeCategory('DIRECTIVE_IN_FIELDS_ARG'\x2C (directive) => `The \\`fields\\` argument of a \\`@${directive}\\` directive includes some directive applications. This is not supported`\x2C { addedIn: '2.1.0' });\nconst KEY_HAS_DIRECTIVE_IN_FIELDS_ARGS = DIRECTIVE_IN_FIELDS_ARG.createCode('key');\nconst PROVIDES_HAS_DIRECTIVE_IN_FIELDS_ARGS = DIRECTIVE_IN_FIELDS_ARG.createCode('provides');\nconst REQUIRES_HAS_DIRECTIVE_IN_FIELDS_ARGS = DIRECTIVE_IN_FIELDS_ARG.createCode('requires');\nconst EXTERNAL_UNUSED = makeCodeDefinition('EXTERNAL_UNUSED'\x2C 'An `@external` field is not being used by any instance of `@key`\x2C `@requires`\x2C `@provides` or to satisfy an interface implementation.'\x2C { addedIn: FED1_CODE });\nconst TYPE_WITH_ONLY_UNUSED_EXTERNAL = makeCodeDefinition('TYPE_WITH_ONLY_UNUSED_EXTERNAL'\x2C 'A federation 1 schema has a composite type comprised only of unused external fields.'\n    + ` Note that this error can _only_ be raised for federation 1 schema as federation 2 schema do not allow unused external fields (and errors with code ${EXTERNAL_UNUSED.code} will be raised in that case).`\n    + ' But when federation 1 schema are automatically migrated to federation 2 ones\x2C unused external fields are automatically removed\x2C and in rare case this can leave a type empty. If that happens\x2C an error with this code will be raised');\nconst PROVIDES_ON_NON_OBJECT_FIELD = makeCodeDefinition('PROVIDES_ON_NON_OBJECT_FIELD'\x2C 'A `@provides` directive is used to mark a field whose base type is not an object type.');\nconst DIRECTIVE_INVALID_FIELDS_TYPE = makeFederationDirectiveErrorCodeCategory('INVALID_FIELDS_TYPE'\x2C (directive) => `The value passed to the \\`fields\\` argument of a \\`@${directive}\\` directive is not a string.`);\nconst KEY_INVALID_FIELDS_TYPE = DIRECTIVE_INVALID_FIELDS_TYPE.createCode('key');\nconst PROVIDES_INVALID_FIELDS_TYPE = DIRECTIVE_INVALID_FIELDS_TYPE.createCode('provides');\nconst REQUIRES_INVALID_FIELDS_TYPE = DIRECTIVE_INVALID_FIELDS_TYPE.createCode('requires');\nconst DIRECTIVE_INVALID_FIELDS = makeFederationDirectiveErrorCodeCategory('INVALID_FIELDS'\x2C (directive) => `The \\`fields\\` argument of a \\`@${directive}\\` directive is invalid (it has invalid syntax\x2C includes unknown fields\x2C ...).`);\nconst KEY_INVALID_FIELDS = DIRECTIVE_INVALID_FIELDS.createCode('key');\nconst PROVIDES_INVALID_FIELDS = DIRECTIVE_INVALID_FIELDS.createCode('provides');\nconst REQUIRES_INVALID_FIELDS = DIRECTIVE_INVALID_FIELDS.createCode('requires');\nconst KEY_FIELDS_SELECT_INVALID_TYPE = makeCodeDefinition('KEY_FIELDS_SELECT_INVALID_TYPE'\x2C 'The `fields` argument of `@key` directive includes a field whose type is a list\x2C interface\x2C or union type. Fields of these types cannot be part of a `@key`'\x2C { addedIn: FED1_CODE });\nconst ROOT_TYPE_USED = makeErrorCodeCategory((kind) => `ROOT_${kind.toLocaleUpperCase()}_USED`\x2C (kind) => `A subgraph's schema defines a type with the name \\`${kind}\\`\x2C while also specifying a _different_ type name as the root query object. This is not allowed.`\x2C { addedIn: FED1_CODE });\nconst ROOT_QUERY_USED = ROOT_TYPE_USED.createCode('query');\nconst ROOT_MUTATION_USED = ROOT_TYPE_USED.createCode('mutation');\nconst ROOT_SUBSCRIPTION_USED = ROOT_TYPE_USED.createCode('subscription');\nconst INVALID_SUBGRAPH_NAME = makeCodeDefinition('INVALID_SUBGRAPH_NAME'\x2C 'A subgraph name is invalid (subgraph names cannot be a single underscore ("_")).');\nconst NO_QUERIES = makeCodeDefinition('NO_QUERIES'\x2C 'None of the composed subgraphs expose any query.');\nconst INTERFACE_FIELD_NO_IMPLEM = makeCodeDefinition('INTERFACE_FIELD_NO_IMPLEM'\x2C 'After subgraph merging\x2C an implementation is missing a field of one of the interface it implements (which can happen for valid subgraphs).');\nconst TYPE_KIND_MISMATCH = makeCodeDefinition('TYPE_KIND_MISMATCH'\x2C 'A type has the same name in different subgraphs\x2C but a different kind. For instance\x2C one definition is an object type but another is an interface.'\x2C { ...DEFAULT_METADATA\x2C replaces: ['VALUE_TYPE_KIND_MISMATCH'\x2C 'EXTENSION_OF_WRONG_KIND'\x2C 'ENUM_MISMATCH_TYPE'] });\nconst CONTEXT_NOT_SET = makeCodeDefinition('CONTEXT_NOT_SET'\x2C 'Context is never set for context trying to be used.'\x2C { addedIn: '2.8.0' });\nconst CONTEXT_INVALID_SELECTION = makeCodeDefinition('CONTEXT_INVALID_SELECTION'\x2C 'Selection within @fromContext must resolve to a single field.'\x2C { addedIn: '2.8.0' });\nconst NO_CONTEXT_IN_SELECTION = makeCodeDefinition('NO_CONTEXT_IN_SELECTION'\x2C 'Selection in @fromContext field argument does not reference a context.'\x2C { addedIn: '2.8.0' });\nconst CONTEXT_NO_RESOLVABLE_KEY = makeCodeDefinition('CONTEXT_NO_RESOLVABLE_KEY'\x2C 'If an ObjectType uses a @fromContext\x2C at least one of its keys must be resolvable.'\x2C { addedIn: '2.8.0' });\nconst CONTEXT_NAME_INVALID = makeCodeDefinition('CONTEXT_NAME_INVALID'\x2C 'Context name is invalid.'\x2C { addedIn: '2.8.0' });\nconst EXTERNAL_TYPE_MISMATCH = makeCodeDefinition('EXTERNAL_TYPE_MISMATCH'\x2C 'An `@external` field has a type that is incompatible with the declaration(s) of that field in other subgraphs.'\x2C { addedIn: FED1_CODE });\nconst EXTERNAL_COLLISION_WITH_ANOTHER_DIRECTIVE = makeCodeDefinition('EXTERNAL_COLLISION_WITH_ANOTHER_DIRECTIVE'\x2C 'The @external directive collides with other directives in some situations.'\x2C { addedIn: '2.1.0' });\nconst EXTERNAL_ARGUMENT_MISSING = makeCodeDefinition('EXTERNAL_ARGUMENT_MISSING'\x2C 'An `@external` field is missing some arguments present in the declaration(s) of that field in other subgraphs.');\nconst EXTERNAL_ARGUMENT_TYPE_MISMATCH = makeCodeDefinition('EXTERNAL_ARGUMENT_TYPE_MISMATCH'\x2C 'An `@external` field declares an argument with a type that is incompatible with the corresponding argument in the declaration(s) of that field in other subgraphs.');\nconst EXTERNAL_ARGUMENT_DEFAULT_MISMATCH = makeCodeDefinition('EXTERNAL_ARGUMENT_DEFAULT_MISMATCH'\x2C 'An `@external` field declares an argument with a default that is incompatible with the corresponding argument in the declaration(s) of that field in other subgraphs.');\nconst EXTERNAL_ON_INTERFACE = makeCodeDefinition('EXTERNAL_ON_INTERFACE'\x2C 'The field of an interface type is marked with `@external`: as external is about marking field not resolved by the subgraph and as interface field are not resolved (only implementations of those fields are)\x2C an "external" interface field is nonsensical');\nconst MERGED_DIRECTIVE_APPLICATION_ON_EXTERNAL = makeCodeDefinition('MERGED_DIRECTIVE_APPLICATION_ON_EXTERNAL'\x2C 'In a subgraph\x2C a field is both marked @external and has a merged directive applied to it');\nconst FIELD_TYPE_MISMATCH = makeCodeDefinition('FIELD_TYPE_MISMATCH'\x2C 'A field has a type that is incompatible with other declarations of that field in other subgraphs.'\x2C { ...DEFAULT_METADATA\x2C replaces: ['VALUE_TYPE_FIELD_TYPE_MISMATCH'] });\nconst ARGUMENT_TYPE_MISMATCH = makeCodeDefinition('FIELD_ARGUMENT_TYPE_MISMATCH'\x2C 'An argument (of a field/directive) has a type that is incompatible with that of other declarations of that same argument in other subgraphs.'\x2C { ...DEFAULT_METADATA\x2C replaces: ['VALUE_TYPE_INPUT_VALUE_MISMATCH'] });\nconst INPUT_FIELD_DEFAULT_MISMATCH = makeCodeDefinition('INPUT_FIELD_DEFAULT_MISMATCH'\x2C 'An input field has a default value that is incompatible with other declarations of that field in other subgraphs.');\nconst ARGUMENT_DEFAULT_MISMATCH = makeCodeDefinition('FIELD_ARGUMENT_DEFAULT_MISMATCH'\x2C 'An argument (of a field/directive) has a default value that is incompatible with that of other declarations of that same argument in other subgraphs.');\nconst EXTENSION_WITH_NO_BASE = makeCodeDefinition('EXTENSION_WITH_NO_BASE'\x2C 'A subgraph is attempting to `extend` a type that is not originally defined in any known subgraph.'\x2C { addedIn: FED1_CODE });\nconst EXTERNAL_MISSING_ON_BASE = makeCodeDefinition('EXTERNAL_MISSING_ON_BASE'\x2C 'A field is marked as `@external` in a subgraph but with no non-external declaration in any other subgraph.'\x2C { addedIn: FED1_CODE });\nconst INVALID_FIELD_SHARING = makeCodeDefinition('INVALID_FIELD_SHARING'\x2C 'A field that is non-shareable in at least one subgraph is resolved by multiple subgraphs.');\nconst INVALID_SHAREABLE_USAGE = makeCodeDefinition('INVALID_SHAREABLE_USAGE'\x2C 'The `@shareable` federation directive is used in an invalid way.'\x2C { addedIn: '2.1.2' });\nconst INVALID_LINK_DIRECTIVE_USAGE = makeCodeDefinition('INVALID_LINK_DIRECTIVE_USAGE'\x2C 'An application of the @link directive is invalid/does not respect the specification.');\nconst INVALID_LINK_IDENTIFIER = makeCodeDefinition('INVALID_LINK_IDENTIFIER'\x2C 'A url/version for a @link feature is invalid/does not respect the specification.'\x2C { addedIn: '2.1.0' });\nconst LINK_IMPORT_NAME_MISMATCH = makeCodeDefinition('LINK_IMPORT_NAME_MISMATCH'\x2C 'The import name for a merged directive (as declared by the relevant `@link(import:)` argument) is inconsistent between subgraphs.');\nconst REFERENCED_INACCESSIBLE = makeCodeDefinition('REFERENCED_INACCESSIBLE'\x2C 'An element is marked as @inaccessible but is referenced by an element visible in the API schema.');\nconst DEFAULT_VALUE_USES_INACCESSIBLE = makeCodeDefinition('DEFAULT_VALUE_USES_INACCESSIBLE'\x2C 'An element is marked as @inaccessible but is used in the default value of an element visible in the API schema.');\nconst QUERY_ROOT_TYPE_INACCESSIBLE = makeCodeDefinition('QUERY_ROOT_TYPE_INACCESSIBLE'\x2C 'An element is marked as @inaccessible but is the query root type\x2C which must be visible in the API schema.');\nconst REQUIRED_INACCESSIBLE = makeCodeDefinition('REQUIRED_INACCESSIBLE'\x2C 'An element is marked as @inaccessible but is required by an element visible in the API schema.');\nconst IMPLEMENTED_BY_INACCESSIBLE = makeCodeDefinition('IMPLEMENTED_BY_INACCESSIBLE'\x2C 'An element is marked as @inaccessible but implements an element visible in the API schema.');\nconst DISALLOWED_INACCESSIBLE = makeCodeDefinition('DISALLOWED_INACCESSIBLE'\x2C 'An element is marked as @inaccessible that is not allowed to be @inaccessible.');\nconst ONLY_INACCESSIBLE_CHILDREN = makeCodeDefinition('ONLY_INACCESSIBLE_CHILDREN'\x2C 'A type visible in the API schema has only @inaccessible children.');\nconst REQUIRED_INPUT_FIELD_MISSING_IN_SOME_SUBGRAPH = makeCodeDefinition('REQUIRED_INPUT_FIELD_MISSING_IN_SOME_SUBGRAPH'\x2C 'A field of an input object type is mandatory in some subgraphs\x2C but the field is not defined in all the subgraphs that define the input object type.');\nconst REQUIRED_ARGUMENT_MISSING_IN_SOME_SUBGRAPH = makeCodeDefinition('REQUIRED_ARGUMENT_MISSING_IN_SOME_SUBGRAPH'\x2C 'An argument of a field or directive definition is mandatory in some subgraphs\x2C but the argument is not defined in all the subgraphs that define the field or directive definition.');\nconst EMPTY_MERGED_INPUT_TYPE = makeCodeDefinition('EMPTY_MERGED_INPUT_TYPE'\x2C 'An input object type has no field common to all the subgraphs that define the type. Merging that type would result in an invalid empty input object type.');\nconst ENUM_VALUE_MISMATCH = makeCodeDefinition('ENUM_VALUE_MISMATCH'\x2C 'An enum type that is used as both an input and output type has a value that is not defined in all the subgraphs that define the enum type.');\nconst EMPTY_MERGED_ENUM_TYPE = makeCodeDefinition('EMPTY_MERGED_ENUM_TYPE'\x2C 'An enum type has no value common to all the subgraphs that define the type. Merging that type would result in an invalid empty enum type.');\nconst SHAREABLE_HAS_MISMATCHED_RUNTIME_TYPES = makeCodeDefinition('SHAREABLE_HAS_MISMATCHED_RUNTIME_TYPES'\x2C 'A shareable field return type has mismatched possible runtime types in the subgraphs in which the field is declared. As shared fields must resolve the same way in all subgraphs\x2C this is almost surely a mistake.');\nconst SATISFIABILITY_ERROR = makeCodeDefinition('SATISFIABILITY_ERROR'\x2C 'Subgraphs can be merged\x2C but the resulting supergraph API would have queries that cannot be satisfied by those subgraphs.');\nconst OVERRIDE_FROM_SELF_ERROR = makeCodeDefinition('OVERRIDE_FROM_SELF_ERROR'\x2C 'Field with `@override` directive has "from" location that references its own subgraph.');\nconst OVERRIDE_SOURCE_HAS_OVERRIDE = makeCodeDefinition('OVERRIDE_SOURCE_HAS_OVERRIDE'\x2C 'Field which is overridden to another subgraph is also marked @override.');\nconst OVERRIDE_COLLISION_WITH_ANOTHER_DIRECTIVE = makeCodeDefinition('OVERRIDE_COLLISION_WITH_ANOTHER_DIRECTIVE'\x2C 'The @override directive cannot be used on external fields\x2C nor to override fields with either @external\x2C @provides\x2C or @requires.');\nconst OVERRIDE_ON_INTERFACE = makeCodeDefinition('OVERRIDE_ON_INTERFACE'\x2C 'The @override directive cannot be used on the fields of an interface type.'\x2C { addedIn: '2.3.0' });\nconst OVERRIDE_LABEL_INVALID = makeCodeDefinition('OVERRIDE_LABEL_INVALID'\x2C 'The @override directive `label` argument must match the pattern /^[a-zA-Z][a-zA-Z0-9_\\-:./]*$/ or /^percent\\((\\d{1\x2C2}(\\.\\d{1\x2C8})?|100)\\)$/'\x2C { addedIn: '2.7.0' });\nconst UNSUPPORTED_FEATURE = makeCodeDefinition('UNSUPPORTED_FEATURE'\x2C 'Indicates an error due to feature currently unsupported by federation.'\x2C { addedIn: '2.1.0' });\nconst INVALID_FEDERATION_SUPERGRAPH = makeCodeDefinition('INVALID_FEDERATION_SUPERGRAPH'\x2C 'Indicates that a schema provided for an Apollo Federation supergraph is not a valid supergraph schema.'\x2C { addedIn: '2.1.0' });\nconst DOWNSTREAM_SERVICE_ERROR = makeCodeDefinition('DOWNSTREAM_SERVICE_ERROR'\x2C 'Indicates an error in a subgraph service query during query execution in a federated service.'\x2C { addedIn: FED1_CODE });\nconst DIRECTIVE_COMPOSITION_ERROR = makeCodeDefinition('DIRECTIVE_COMPOSITION_ERROR'\x2C 'Error when composing custom directives.'\x2C { addedIn: '2.1.0' });\nconst INTERFACE_OBJECT_USAGE_ERROR = makeCodeDefinition('INTERFACE_OBJECT_USAGE_ERROR'\x2C 'Error in the usage of the @interfaceObject directive.'\x2C { addedIn: '2.3.0' });\nconst INTERFACE_KEY_NOT_ON_IMPLEMENTATION = makeCodeDefinition('INTERFACE_KEY_NOT_ON_IMPLEMENTATION'\x2C 'A `@key` is defined on an interface type\x2C but is not defined (or is not resolvable) on at least one of the interface implementations'\x2C { addedIn: '2.3.0' });\nconst INTERFACE_KEY_MISSING_IMPLEMENTATION_TYPE = makeCodeDefinition('INTERFACE_KEY_MISSING_IMPLEMENTATION_TYPE'\x2C 'A subgraph has a `@key` on an interface type\x2C but that subgraph does not define an implementation (in the supergraph) of that interface'\x2C { addedIn: '2.3.0' });\nconst CONTEXTUAL_ARGUMENT_NOT_CONTEXTUAL_IN_ALL_SUBGRAPHS = makeCodeDefinition('CONTEXTUAL_ARGUMENT_NOT_CONTEXTUAL_IN_ALL_SUBGRAPHS'\x2C 'Argument on field is marked contextual in only some subgraphs'\x2C { addedIn: '2.7.0' });\nconst COST_APPLIED_TO_INTERFACE_FIELD = makeCodeDefinition('COST_APPLIED_TO_INTERFACE_FIELD'\x2C 'The `@cost` directive must be applied to concrete types'\x2C { addedIn: '2.9.2' });\nconst LIST_SIZE_APPLIED_TO_NON_LIST = makeCodeDefinition('LIST_SIZE_APPLIED_TO_NON_LIST'\x2C 'The `@listSize` directive must be applied to list types'\x2C { addedIn: '2.9.2' });\nconst LIST_SIZE_INVALID_ASSUMED_SIZE = makeCodeDefinition('LIST_SIZE_INVALID_ASSUMED_SIZE'\x2C 'The `@listSize` directive assumed size cannot be negative'\x2C { addedIn: '2.9.2' });\nconst LIST_SIZE_INVALID_SLICING_ARGUMENT = makeCodeDefinition('LIST_SIZE_INVALID_SLICING_ARGUMENT'\x2C 'The `@listSize` directive must have existing integer slicing arguments'\x2C { addedIn: '2.9.2' });\nconst LIST_SIZE_INVALID_SIZED_FIELD = makeCodeDefinition('LIST_SIZE_INVALID_SIZED_FIELD'\x2C 'The `@listSize` directive must reference existing list fields as sized fields'\x2C { addedIn: '2.9.2' });\nconst MAX_VALIDATION_SUBGRAPH_PATHS_EXCEEDED = makeCodeDefinition('MAX_VALIDATION_SUBGRAPH_PATHS_EXCEEDED'\x2C 'The maximum number of validation subgraph paths has been exceeded.'\x2C { addedIn: '2.8.0' });\nconst AUTH_REQUIREMENTS_APPLIED_ON_INTERFACE = makeCodeDefinition('AUTH_REQUIREMENTS_APPLIED_ON_INTERFACE'\x2C 'The @authenticated\x2C @requiresScopes and @policy directive cannot be applied on interface\x2C interface fields and interface object'\x2C { addedIn: '2.9.4' });\nconst MISSING_TRANSITIVE_AUTH_REQUIREMENTS = makeCodeDefinition('MISSING_TRANSITIVE_AUTH_REQUIREMENTS'\x2C 'Field missing transitive @authenticated\x2C @requiresScopes and/or @policy auth requirements needed to access dependent data.'\x2C { addedIn: '2.9.4' });\nexports.ERROR_CATEGORIES = {\n    DIRECTIVE_FIELDS_MISSING_EXTERNAL\x2C\n    DIRECTIVE_UNSUPPORTED_ON_INTERFACE\x2C\n    DIRECTIVE_INVALID_FIELDS_TYPE\x2C\n    DIRECTIVE_INVALID_FIELDS\x2C\n    FIELDS_HAS_ARGS\x2C\n    ROOT_TYPE_USED\x2C\n    DIRECTIVE_IN_FIELDS_ARG\x2C\n};\nexports.ERRORS = {\n    INVALID_GRAPHQL\x2C\n    DIRECTIVE_DEFINITION_INVALID\x2C\n    TYPE_DEFINITION_INVALID\x2C\n    UNSUPPORTED_LINKED_FEATURE\x2C\n    UNKNOWN_FEDERATION_LINK_VERSION\x2C\n    UNKNOWN_LINK_VERSION\x2C\n    KEY_FIELDS_HAS_ARGS\x2C\n    PROVIDES_FIELDS_HAS_ARGS\x2C\n    PROVIDES_MISSING_EXTERNAL\x2C\n    REQUIRES_MISSING_EXTERNAL\x2C\n    KEY_UNSUPPORTED_ON_INTERFACE\x2C\n    PROVIDES_UNSUPPORTED_ON_INTERFACE\x2C\n    REQUIRES_UNSUPPORTED_ON_INTERFACE\x2C\n    EXTERNAL_UNUSED\x2C\n    EXTERNAL_COLLISION_WITH_ANOTHER_DIRECTIVE\x2C\n    TYPE_WITH_ONLY_UNUSED_EXTERNAL\x2C\n    PROVIDES_ON_NON_OBJECT_FIELD\x2C\n    KEY_INVALID_FIELDS_TYPE\x2C\n    PROVIDES_INVALID_FIELDS_TYPE\x2C\n    REQUIRES_INVALID_FIELDS_TYPE\x2C\n    KEY_INVALID_FIELDS\x2C\n    PROVIDES_INVALID_FIELDS\x2C\n    REQUIRES_INVALID_FIELDS\x2C\n    KEY_FIELDS_SELECT_INVALID_TYPE\x2C\n    ROOT_QUERY_USED\x2C\n    ROOT_MUTATION_USED\x2C\n    ROOT_SUBSCRIPTION_USED\x2C\n    INVALID_SUBGRAPH_NAME\x2C\n    NO_QUERIES\x2C\n    INTERFACE_FIELD_NO_IMPLEM\x2C\n    TYPE_KIND_MISMATCH\x2C\n    CONTEXT_NOT_SET\x2C\n    CONTEXT_INVALID_SELECTION\x2C\n    NO_CONTEXT_IN_SELECTION\x2C\n    CONTEXT_NO_RESOLVABLE_KEY\x2C\n    CONTEXT_NAME_INVALID\x2C\n    EXTERNAL_TYPE_MISMATCH\x2C\n    EXTERNAL_ARGUMENT_MISSING\x2C\n    EXTERNAL_ARGUMENT_TYPE_MISMATCH\x2C\n    EXTERNAL_ARGUMENT_DEFAULT_MISMATCH\x2C\n    EXTERNAL_ON_INTERFACE\x2C\n    MERGED_DIRECTIVE_APPLICATION_ON_EXTERNAL\x2C\n    FIELD_TYPE_MISMATCH\x2C\n    ARGUMENT_TYPE_MISMATCH\x2C\n    INPUT_FIELD_DEFAULT_MISMATCH\x2C\n    ARGUMENT_DEFAULT_MISMATCH\x2C\n    EXTENSION_WITH_NO_BASE\x2C\n    EXTERNAL_MISSING_ON_BASE\x2C\n    INVALID_FIELD_SHARING\x2C\n    INVALID_SHAREABLE_USAGE\x2C\n    INVALID_LINK_DIRECTIVE_USAGE\x2C\n    INVALID_LINK_IDENTIFIER\x2C\n    LINK_IMPORT_NAME_MISMATCH\x2C\n    REFERENCED_INACCESSIBLE\x2C\n    DEFAULT_VALUE_USES_INACCESSIBLE\x2C\n    QUERY_ROOT_TYPE_INACCESSIBLE\x2C\n    REQUIRED_INACCESSIBLE\x2C\n    DISALLOWED_INACCESSIBLE\x2C\n    IMPLEMENTED_BY_INACCESSIBLE\x2C\n    ONLY_INACCESSIBLE_CHILDREN\x2C\n    REQUIRED_ARGUMENT_MISSING_IN_SOME_SUBGRAPH\x2C\n    REQUIRED_INPUT_FIELD_MISSING_IN_SOME_SUBGRAPH\x2C\n    EMPTY_MERGED_INPUT_TYPE\x2C\n    ENUM_VALUE_MISMATCH\x2C\n    EMPTY_MERGED_ENUM_TYPE\x2C\n    SHAREABLE_HAS_MISMATCHED_RUNTIME_TYPES\x2C\n    SATISFIABILITY_ERROR\x2C\n    OVERRIDE_COLLISION_WITH_ANOTHER_DIRECTIVE\x2C\n    OVERRIDE_FROM_SELF_ERROR\x2C\n    OVERRIDE_SOURCE_HAS_OVERRIDE\x2C\n    OVERRIDE_ON_INTERFACE\x2C\n    OVERRIDE_LABEL_INVALID\x2C\n    UNSUPPORTED_FEATURE\x2C\n    INVALID_FEDERATION_SUPERGRAPH\x2C\n    DOWNSTREAM_SERVICE_ERROR\x2C\n    KEY_HAS_DIRECTIVE_IN_FIELDS_ARGS\x2C\n    PROVIDES_HAS_DIRECTIVE_IN_FIELDS_ARGS\x2C\n    REQUIRES_HAS_DIRECTIVE_IN_FIELDS_ARGS\x2C\n    DIRECTIVE_COMPOSITION_ERROR\x2C\n    INTERFACE_OBJECT_USAGE_ERROR\x2C\n    INTERFACE_KEY_NOT_ON_IMPLEMENTATION\x2C\n    INTERFACE_KEY_MISSING_IMPLEMENTATION_TYPE\x2C\n    CONTEXTUAL_ARGUMENT_NOT_CONTEXTUAL_IN_ALL_SUBGRAPHS\x2C\n    COST_APPLIED_TO_INTERFACE_FIELD\x2C\n    LIST_SIZE_APPLIED_TO_NON_LIST\x2C\n    LIST_SIZE_INVALID_ASSUMED_SIZE\x2C\n    LIST_SIZE_INVALID_SIZED_FIELD\x2C\n    LIST_SIZE_INVALID_SLICING_ARGUMENT\x2C\n    MAX_VALIDATION_SUBGRAPH_PATHS_EXCEEDED\x2C\n    AUTH_REQUIREMENTS_APPLIED_ON_INTERFACE\x2C\n    MISSING_TRANSITIVE_AUTH_REQUIREMENTS\x2C\n};\nconst codeDefByCode = Object.values(exports.ERRORS).reduce((obj\x2C codeDef) => { obj[codeDef.code] = codeDef; return obj; }\x2C {});\nexports.REMOVED_ERRORS = [\n    ['KEY_FIELDS_MISSING_ON_BASE'\x2C 'Keys can now use any field from any other subgraph.']\x2C\n    ['KEY_FIELDS_MISSING_EXTERNAL'\x2C 'Using `@external` for key fields is now discouraged\x2C unless the field is truly meant to be external.']\x2C\n    ['KEY_MISSING_ON_BASE'\x2C 'Each subgraph is now free to declare a key only if it needs it.']\x2C\n    ['MULTIPLE_KEYS_ON_EXTENSION'\x2C 'Every subgraph can have multiple keys\x2C as necessary.']\x2C\n    ['KEY_NOT_SPECIFIED'\x2C 'Each subgraph can declare key independently of any other subgraph.']\x2C\n    ['EXTERNAL_USED_ON_BASE'\x2C 'As there is not type ownership anymore\x2C there is also no particular limitation as to where a field can be external.']\x2C\n    ['PROVIDES_NOT_ON_ENTITY'\x2C '@provides can now be used on any type.']\x2C\n    ['REQUIRES_FIELDS_MISSING_ON_BASE'\x2C 'Fields in @requires can now be from any subgraph.']\x2C\n    ['REQUIRES_USED_ON_BASE'\x2C 'As there is not type ownership anymore\x2C there is also no particular limitation as to which subgraph can use a @requires.']\x2C\n    ['DUPLICATE_SCALAR_DEFINITION'\x2C 'As duplicate scalar definitions is invalid GraphQL\x2C this will now be an error with code `INVALID_GRAPHQL`.']\x2C\n    ['DUPLICATE_ENUM_DEFINITION'\x2C 'As duplicate enum definitions is invalid GraphQL\x2C this will now be an error with code `INVALID_GRAPHQL`.']\x2C\n    ['DUPLICATE_ENUM_VALUE'\x2C 'As duplicate enum values is invalid GraphQL\x2C this will now be an error with code `INVALID_GRAPHQL`.']\x2C\n    ['ENUM_MISMATCH'\x2C 'Subgraph definitions for an enum are now merged by composition.']\x2C\n    ['VALUE_TYPE_NO_ENTITY'\x2C 'There is no strong different between entity and value types in the model (they are just usage pattern) and a type can have keys in one subgraph but not another.']\x2C\n    ['VALUE_TYPE_UNION_TYPES_MISMATCH'\x2C 'Subgraph definitions for an union are now merged by composition.']\x2C\n    ['PROVIDES_FIELDS_SELECT_INVALID_TYPE'\x2C '@provides can now be used on field of interface\x2C union and list types.']\x2C\n    ['RESERVED_FIELD_USED'\x2C 'This error was previously not correctly enforced: the _service and _entities\x2C if present\x2C were overridden; this is still the case.']\x2C\n    ['NON_REPEATABLE_DIRECTIVE_ARGUMENTS_MISMATCH'\x2C 'Since federation 2.1.0\x2C the case this error used to cover is now a warning (with code `INCONSISTENT_NON_REPEATABLE_DIRECTIVE_ARGUMENTS`) instead of an error.']\x2C\n    ['REQUIRES_FIELDS_HAS_ARGS'\x2C 'Since federation 2.1.1\x2C using fields with arguments in a @requires is fully supported.']\x2C\n    ['INTERFACE_FIELD_IMPLEM_TYPE_MISMATCH'\x2C 'This error was thrown by a validation introduced to avoid running into a known runtime bug. Since federation 2.3\x2C the underlying runtime bug has been addressed and the validation/limitation was no longer necessary and has been removed.']\x2C\n];\n//# sourceMappingURL=error.js.map
