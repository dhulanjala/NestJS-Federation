script-source,921,C:\\development\\NestJS Federation\\gateway\\node_modules\\make-fetch-happen\\lib\\fetch.js,'use strict'\n\nconst { FetchError\x2C Request\x2C isRedirect } = require('minipass-fetch')\nconst url = require('url')\n\nconst CachePolicy = require('./cache/policy.js')\nconst cache = require('./cache/index.js')\nconst remote = require('./remote.js')\n\n// given a Request\x2C a Response and user options\n// return true if the response is a redirect that\n// can be followed. we throw errors that will result\n// in the fetch being rejected if the redirect is\n// possible but invalid for some reason\nconst canFollowRedirect = (request\x2C response\x2C options) => {\n  if (!isRedirect(response.status)) {\n    return false\n  }\n\n  if (options.redirect === 'manual') {\n    return false\n  }\n\n  if (options.redirect === 'error') {\n    throw new FetchError(`redirect mode is set to error: ${request.url}`\x2C\n      'no-redirect'\x2C { code: 'ENOREDIRECT' })\n  }\n\n  if (!response.headers.has('location')) {\n    throw new FetchError(`redirect location header missing for: ${request.url}`\x2C\n      'no-location'\x2C { code: 'EINVALIDREDIRECT' })\n  }\n\n  if (request.counter >= request.follow) {\n    throw new FetchError(`maximum redirect reached at: ${request.url}`\x2C\n      'max-redirect'\x2C { code: 'EMAXREDIRECT' })\n  }\n\n  return true\n}\n\n// given a Request\x2C a Response\x2C and the user's options return an object\n// with a new Request and a new options object that will be used for\n// following the redirect\nconst getRedirect = (request\x2C response\x2C options) => {\n  const _opts = { ...options }\n  const location = response.headers.get('location')\n  const redirectUrl = new url.URL(location\x2C /^https?:/.test(location) ? undefined : request.url)\n  // Comment below is used under the following license:\n  /**\n   * @license\n   * Copyright (c) 2010-2012 Mikeal Rogers\n   * Licensed under the Apache License\x2C Version 2.0 (the "License");\n   * you may not use this file except in compliance with the License.\n   * You may obtain a copy of the License at\n   * http://www.apache.org/licenses/LICENSE-2.0\n   * Unless required by applicable law or agreed to in writing\x2C\n   * software distributed under the License is distributed on an "AS\n   * IS" BASIS\x2C WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND\x2C either\n   * express or implied. See the License for the specific language\n   * governing permissions and limitations under the License.\n   */\n\n  // Remove authorization if changing hostnames (but not if just\n  // changing ports or protocols).  This matches the behavior of request:\n  // https://github.com/request/request/blob/b12a6245/lib/redirect.js#L134-L138\n  if (new url.URL(request.url).hostname !== redirectUrl.hostname) {\n    request.headers.delete('authorization')\n    request.headers.delete('cookie')\n  }\n\n  // for POST request with 301/302 response\x2C or any request with 303 response\x2C\n  // use GET when following redirect\n  if (\n    response.status === 303 ||\n    (request.method === 'POST' && [301\x2C 302].includes(response.status))\n  ) {\n    _opts.method = 'GET'\n    _opts.body = null\n    request.headers.delete('content-length')\n  }\n\n  _opts.headers = {}\n  request.headers.forEach((value\x2C key) => {\n    _opts.headers[key] = value\n  })\n\n  _opts.counter = ++request.counter\n  const redirectReq = new Request(url.format(redirectUrl)\x2C _opts)\n  return {\n    request: redirectReq\x2C\n    options: _opts\x2C\n  }\n}\n\nconst fetch = async (request\x2C options) => {\n  const response = CachePolicy.storable(request\x2C options)\n    ? await cache(request\x2C options)\n    : await remote(request\x2C options)\n\n  // if the request wasn't a GET or HEAD\x2C and the response\n  // status is between 200 and 399 inclusive\x2C invalidate the\n  // request url\n  if (!['GET'\x2C 'HEAD'].includes(request.method) &&\n      response.status >= 200 &&\n      response.status <= 399) {\n    await cache.invalidate(request\x2C options)\n  }\n\n  if (!canFollowRedirect(request\x2C response\x2C options)) {\n    return response\n  }\n\n  const redirect = getRedirect(request\x2C response\x2C options)\n  return fetch(redirect.request\x2C redirect.options)\n}\n\nmodule.exports = fetch\n
