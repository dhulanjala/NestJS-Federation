script-source,47,node:internal/source_map/source_map_cache,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypeIndexOf\x2C\x0d\n  ArrayPrototypePush\x2C\x0d\n  JSONParse\x2C\x0d\n  ObjectFreeze\x2C\x0d\n  RegExpPrototypeExec\x2C\x0d\n  RegExpPrototypeSymbolSplit\x2C\x0d\n  SafeMap\x2C\x0d\n  StringPrototypeCodePointAt\x2C\x0d\n  StringPrototypeSplit\x2C\x0d\n  StringPrototypeStartsWith\x2C\x0d\n} = primordials;\x0d\n\x0d\n// See https://tc39.es/ecma426/ for SourceMap V3 specification.\x0d\nconst { Buffer } = require('buffer');\x0d\nlet debug = require('internal/util/debuglog').debuglog('source_map'\x2C (fn) => {\x0d\n  debug = fn;\x0d\n});\x0d\n\x0d\nconst { readFileSync } = require('fs');\x0d\nconst { validateBoolean\x2C validateObject } = require('internal/validators');\x0d\nconst {\x0d\n  setSourceMapsEnabled: setSourceMapsNative\x2C\x0d\n} = internalBinding('errors');\x0d\nconst {\x0d\n  defaultPrepareStackTrace\x2C\x0d\n  setInternalPrepareStackTrace\x2C\x0d\n} = require('internal/errors');\x0d\nconst { getLazy\x2C isUnderNodeModules\x2C kEmptyObject } = require('internal/util');\x0d\n\x0d\nconst getModuleSourceMapCache = getLazy(() => {\x0d\n  const { SourceMapCacheMap } = require('internal/source_map/source_map_cache_map');\x0d\n  return new SourceMapCacheMap();\x0d\n});\x0d\n\x0d\n// The generated source module/script instance is not accessible\x2C so we can use\x0d\n// a Map without memory concerns. Separate generated source entries with the module\x0d\n// source entries to avoid overriding the module source entries with arbitrary\x0d\n// source url magic comments.\x0d\nconst generatedSourceMapCache = new SafeMap();\x0d\nconst kLeadingProtocol = /^\\w+:\\/\\//;\x0d\nconst kSourceMappingURLMagicComment = /\\/[*/]#\\s+sourceMappingURL=(?<sourceMappingURL>[^\\s]+)/g;\x0d\nconst kSourceURLMagicComment = /\\/[*/]#\\s+sourceURL=(?<sourceURL>[^\\s]+)/g;\x0d\n\x0d\nconst { isAbsolute } = require('path');\x0d\nconst { fileURLToPath\x2C pathToFileURL\x2C URL\x2C URLParse } = require('internal/url');\x0d\n\x0d\nlet SourceMap;\x0d\n\x0d\n// This is configured with --enable-source-maps during pre-execution.\x0d\nlet sourceMapsSupport = ObjectFreeze({\x0d\n  __proto__: null\x2C\x0d\n  enabled: false\x2C\x0d\n  nodeModules: false\x2C\x0d\n  generatedCode: false\x2C\x0d\n});\x0d\nfunction getSourceMapsSupport() {\x0d\n  // Return a read-only object.\x0d\n  return sourceMapsSupport;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Enables or disables source maps programmatically.\x0d\n * @param {boolean} enabled\x0d\n * @param {object} options\x0d\n * @param {boolean} [options.nodeModules]\x0d\n * @param {boolean} [options.generatedCode]\x0d\n */\x0d\nfunction setSourceMapsSupport(enabled\x2C options = kEmptyObject) {\x0d\n  validateBoolean(enabled\x2C 'enabled');\x0d\n  validateObject(options\x2C 'options');\x0d\n\x0d\n  const { nodeModules = false\x2C generatedCode = false } = options;\x0d\n  validateBoolean(nodeModules\x2C 'options.nodeModules');\x0d\n  validateBoolean(generatedCode\x2C 'options.generatedCode');\x0d\n\x0d\n  setSourceMapsNative(enabled);\x0d\n  if (enabled) {\x0d\n    const {\x0d\n      prepareStackTraceWithSourceMaps\x2C\x0d\n    } = require('internal/source_map/prepare_stack_trace');\x0d\n    setInternalPrepareStackTrace(prepareStackTraceWithSourceMaps);\x0d\n  } else {\x0d\n    setInternalPrepareStackTrace(defaultPrepareStackTrace);\x0d\n  }\x0d\n\x0d\n  sourceMapsSupport = ObjectFreeze({\x0d\n    __proto__: null\x2C\x0d\n    enabled\x2C\x0d\n    nodeModules: nodeModules\x2C\x0d\n    generatedCode: generatedCode\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\n/**\x0d\n * Extracts the source url from the content if present. For example\x0d\n * //# sourceURL=file:///path/to/file\x0d\n *\x0d\n * Read more at: https://tc39.es/source-map-spec/#linking-evald-code-to-named-generated-code\x0d\n * @param {string} content - source content\x0d\n * @returns {string | null} source url or null if not present\x0d\n */\x0d\nfunction extractSourceURLMagicComment(content) {\x0d\n  let match;\x0d\n  let matchSourceURL;\x0d\n  // A while loop is used here to get the last occurrence of sourceURL.\x0d\n  // This is needed so that we don't match sourceURL in string literals.\x0d\n  while ((match = RegExpPrototypeExec(kSourceURLMagicComment\x2C content))) {\x0d\n    matchSourceURL = match;\x0d\n  }\x0d\n  if (matchSourceURL == null) {\x0d\n    return null;\x0d\n  }\x0d\n  let sourceURL = matchSourceURL.groups.sourceURL;\x0d\n  if (sourceURL != null && RegExpPrototypeExec(kLeadingProtocol\x2C sourceURL) === null) {\x0d\n    sourceURL = pathToFileURL(sourceURL).href;\x0d\n  }\x0d\n  return sourceURL;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Extracts the source map url from the content if present. For example\x0d\n * //# sourceMappingURL=file:///path/to/file\x0d\n *\x0d\n * Read more at: https://tc39.es/source-map-spec/#linking-generated-code\x0d\n * @param {string} content - source content\x0d\n * @returns {string | null} source map url or null if not present\x0d\n */\x0d\nfunction extractSourceMapURLMagicComment(content) {\x0d\n  let match;\x0d\n  let lastMatch;\x0d\n  // A while loop is used here to get the last occurrence of sourceMappingURL.\x0d\n  // This is needed so that we don't match sourceMappingURL in string literals.\x0d\n  while ((match = RegExpPrototypeExec(kSourceMappingURLMagicComment\x2C content))) {\x0d\n    lastMatch = match;\x0d\n  }\x0d\n  if (lastMatch == null) {\x0d\n    return null;\x0d\n  }\x0d\n  return lastMatch.groups.sourceMappingURL;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Caches the source map\x2C with the given filename\x2C moduleInstance\x2C sourceURL and sourceMapURL.\x0d\n * This function does not automatically extract the source map from the content. The caller should either\x0d\n * extract the source map from the content via V8 API or use {@link extractSourceURLMagicComment} explicitly.\x0d\n * @param {string} filename - the actual filename\x0d\n * @param {string} content - the actual source content\x0d\n * @param {import('internal/modules/cjs/loader').Module | ModuleWrap} moduleInstance - a module instance that\x0d\n *   associated with the source\x2C once this is reclaimed\x2C the source map entry will be removed from the cache\x0d\n * @param {boolean} isGeneratedSource - if the source was generated and evaluated with the global eval\x0d\n * @param {string | undefined} sourceURL - the source url\x0d\n * @param {string | undefined} sourceMapURL - the source map url\x0d\n */\x0d\nfunction maybeCacheSourceMap(filename\x2C content\x2C moduleInstance\x2C isGeneratedSource\x2C sourceURL\x2C sourceMapURL) {\x0d\n  const support = getSourceMapsSupport();\x0d\n  if (!(process.env.NODE_V8_COVERAGE || support.enabled)) return;\x0d\n  const { normalizeReferrerURL } = require('internal/modules/helpers');\x0d\n  filename = normalizeReferrerURL(filename);\x0d\n  if (filename === undefined) {\x0d\n    // This is most likely an invalid filename in sourceURL of [eval]-wrapper.\x0d\n    return;\x0d\n  }\x0d\n  if (!support.nodeModules && isUnderNodeModules(filename)) {\x0d\n    // Skip file under node_modules if not enabled.\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  // Bail out when there is no source map url.\x0d\n  if (typeof sourceMapURL !== 'string') {\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  // Normalize the sourceURL to a file URL if it is a path.\x0d\n  sourceURL = normalizeReferrerURL(sourceURL);\x0d\n\x0d\n  const data = dataFromUrl(filename\x2C sourceMapURL);\x0d\n  // `data` could be null if the source map is invalid.\x0d\n  // In this case\x2C create a cache entry with null data with source url for test coverage.\x0d\n\x0d\n  const entry = {\x0d\n    __proto__: null\x2C\x0d\n    lineLengths: lineLengths(content)\x2C\x0d\n    data\x2C\x0d\n    // Save the source map url if it is not a data url.\x0d\n    sourceMapURL: data ? null : sourceMapURL\x2C\x0d\n    sourceURL\x2C\x0d\n  };\x0d\n\x0d\n  if (isGeneratedSource) {\x0d\n    generatedSourceMapCache.set(filename\x2C entry);\x0d\n    return;\x0d\n  }\x0d\n  // If it is not a generated source\x2C we assume we are in a "cjs/esm"\x0d\n  // context.\x0d\n  const keys = sourceURL ? [filename\x2C sourceURL] : [filename];\x0d\n  getModuleSourceMapCache().set(keys\x2C entry\x2C moduleInstance);\x0d\n}\x0d\n\x0d\n/**\x0d\n * Caches the source map if it is present in the eval'd source.\x0d\n * @param {string} content - the eval'd source code\x0d\n */\x0d\nfunction maybeCacheGeneratedSourceMap(content) {\x0d\n  const support = getSourceMapsSupport();\x0d\n  if (!(process.env.NODE_V8_COVERAGE || support.enabled || support.generated)) return;\x0d\n\x0d\n  const sourceURL = extractSourceURLMagicComment(content);\x0d\n  if (sourceURL === null) {\x0d\n    return;\x0d\n  }\x0d\n  const sourceMapURL = extractSourceMapURLMagicComment(content);\x0d\n  if (sourceMapURL === null) {\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  try {\x0d\n    // Use the sourceURL as the filename\x2C and do not create a duplicate entry.\x0d\n    maybeCacheSourceMap(sourceURL\x2C content\x2C null\x2C true\x2C undefined /** no duplicated sourceURL */\x2C sourceMapURL);\x0d\n  } catch (err) {\x0d\n    // This can happen if the filename is not a valid URL.\x0d\n    // If we fail to cache the source map\x2C we should not fail the whole process.\x0d\n    debug(err);\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * Resolves source map payload data from the source url and source map url.\x0d\n * If the source map url is a data url\x2C the data is returned.\x0d\n * Otherwise the source map url is resolved to a file path and the file is read.\x0d\n * @param {string} sourceURL - url of the source file\x0d\n * @param {string} sourceMappingURL - url of the source map\x0d\n * @returns {object} deserialized source map JSON object\x0d\n */\x0d\nfunction dataFromUrl(sourceURL\x2C sourceMappingURL) {\x0d\n  const url = URLParse(sourceMappingURL);\x0d\n\x0d\n  if (url != null) {\x0d\n    switch (url.protocol) {\x0d\n      case 'data:':\x0d\n        return sourceMapFromData