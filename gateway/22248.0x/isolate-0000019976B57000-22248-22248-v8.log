script-source,1238,C:\\development\\NestJS Federation\\gateway\\node_modules\\body-parser\\lib\\utils.js,'use strict'\n\n/**\n * Module dependencies.\n */\n\nconst bytes = require('bytes')\nconst contentType = require('content-type')\nconst typeis = require('type-is')\n\n/**\n * Module exports.\n */\nmodule.exports = {\n  getCharset\x2C\n  normalizeOptions\x2C\n  passthrough\n}\n\n/**\n * Get the charset of a request.\n *\n * @param {Object} req\n * @returns {string | undefined}\n * @private\n */\nfunction getCharset (req) {\n  const header = req.headers['content-type']\n  if (!header) return undefined\n  return contentType.parse(header).parameters.charset?.toLowerCase()\n}\n\n/**\n * Get the simple type checker.\n *\n * @param {string | string[]} type\n * @returns {Function}\n * @private\n */\nfunction typeChecker (type) {\n  return function checkType (req) {\n    return Boolean(typeis(req\x2C type))\n  }\n}\n\n/**\n * Normalizes the common options for all parsers.\n *\n * @param {Object} options options to normalize\n * @param {string | string[] | Function} defaultType default content type(s) or a function to determine it\n * @returns {Object}\n * @private\n */\nfunction normalizeOptions (options\x2C defaultType) {\n  if (!defaultType) {\n    // Parsers must define a default content type\n    throw new TypeError('defaultType must be provided')\n  }\n\n  const inflate = options?.inflate !== false\n  const limit = typeof options?.limit === 'undefined' || options?.limit === null\n    ? 102400 // 100kb default\n    : bytes.parse(options.limit)\n  const type = options?.type || defaultType\n  const verify = options?.verify || false\n  const defaultCharset = options?.defaultCharset || 'utf-8'\n\n  if (limit === null) {\n    throw new TypeError(`option limit "${String(options.limit)}" is invalid`)\n  }\n\n  if (verify !== false && typeof verify !== 'function') {\n    throw new TypeError('option verify must be function')\n  }\n\n  // create the appropriate type checking fu