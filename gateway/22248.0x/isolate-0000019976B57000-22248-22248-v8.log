script-source,153,C:\\development\\NestJS Federation\\gateway\\node_modules\\arg\\index.js,const flagSymbol = Symbol('arg flag');\n\nfunction arg(opts\x2C {argv = process.argv.slice(2)\x2C permissive = false\x2C stopAtPositional = false} = {}) {\n\x09if (!opts) {\n\x09\x09throw new Error('Argument specification object is required');\n\x09}\n\n\x09const result = {_: []};\n\n\x09const aliases = {};\n\x09const handlers = {};\n\n\x09for (const key of Object.keys(opts)) {\n\x09\x09if (!key) {\n\x09\x09\x09throw new TypeError('Argument key cannot be an empty string');\n\x09\x09}\n\n\x09\x09if (key[0] !== '-') {\n\x09\x09\x09throw new TypeError(`Argument key must start with '-' but found: '${key}'`);\n\x09\x09}\n\n\x09\x09if (key.length === 1) {\n\x09\x09\x09throw new TypeError(`Argument key must have a name; singular '-' keys are not allowed: ${key}`);\n\x09\x09}\n\n\x09\x09if (typeof opts[key] === 'string') {\n\x09\x09\x09aliases[key] = opts[key];\n\x09\x09\x09continue;\n\x09\x09}\n\n\x09\x09let type = opts[key];\n\x09\x09let isFlag = false;\n\n\x09\x09if (Array.isArray(type) && type.length === 1 && typeof type[0] === 'function') {\n\x09\x09\x09const [fn] = type;\n\x09\x09\x09type = (value\x2C name\x2C prev = []) => {\n\x09\x09\x09\x09prev.push(fn(value\x2C name\x2C prev[prev.length - 1]));\n\x09\x09\x09\x09return prev;\n\x09\x09\x09};\n\x09\x09\x09isFlag = fn === Boolean || fn[flagSymbol] === true;\n\x09\x09} else if (typeof type === 'function') {\n\x09\x09\x09isFlag = type === Boolean || type[flagSymbol] === true;\n\x09\x09} else {\n\x09\x09\x09throw new TypeError(`Type missing or not a function or valid array type: ${key}`);\n\x09\x09}\n\n\x09\x09if (key[1] !== '-' && key.length > 2) {\n\x09\x09\x09throw new TypeError(`Short argument keys (with a single hyphen) must have only one character: ${key}`);\n\x09\x09}\n\n\x09\x09handlers[key] = [type\x2C isFlag];\n\x09}\n\n\x09for (let i = 0\x2C len = argv.length; i < len; i++) {\n\x09\x09const wholeArg = argv[i];\n\n\x09\x0