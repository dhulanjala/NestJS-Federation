script-source,1011,C:\\development\\NestJS Federation\\gateway\\node_modules\\cacache\\lib\\content\\rm.js,'use strict'\n\nconst fs = require('fs/promises')\nconst contentPath = require('./path')\nconst { hasContent } = require('./read')\n\nmodule.exports = rm\n\nasync function rm (cache\x2C integrity) {\n  const content = await hasContent(cache\x2C integrity)\n  // ~pretty~ sure we can't end up with a content lacking sri\x2C but be safe\n  if (content && content.sri) {\n    await fs.rm(contentPath(cache\x2C content.sri)\x2C { recursive: true\x2C force: true })\n    return true\n  } else {\n    return false\n  }\n}\n
