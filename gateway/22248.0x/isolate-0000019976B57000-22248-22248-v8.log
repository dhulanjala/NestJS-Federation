script-source,428,node:punycode,'use strict';\x0d\nconst {\x0d\n  isInsideNodeModules\x2C\x0d\n} = internalBinding('util');\x0d\n\x0d\nif (!isInsideNodeModules()) {\x0d\n\x09process.emitWarning(\x0d\n\x09\x09'The `punycode` module is deprecated. Please use a userland ' +\x0d\n\x09\x09'alternative instead.'\x2C\x0d\n\x09\x09'DeprecationWarning'\x2C\x0d\n\x09\x09'DEP0040'\x2C\x0d\n\x09);\x0d\n}\x0d\n\x0d\n/** Highest positive signed 32-bit float value */\x0d\nconst maxInt = 2147483647; // aka. 0x7FFFFFFF or 2^31-1\x0d\n\x0d\n/** Bootstring parameters */\x0d\nconst base = 36;\x0d\nconst tMin = 1;\x0d\nconst tMax = 26;\x0d\nconst skew = 38;\x0d\nconst damp = 700;\x0d\nconst initialBias = 72;\x0d\nconst initialN = 128; // 0x80\x0d\nconst delimiter = '-'; // '\\x2D'\x0d\n\x0d\n/** Regular expressions */\x0d\nconst regexPunycode = /^xn--/;\x0d\nconst regexNonASCII = /[^\\0-\\x7F]/; // Note: U+007F DEL is excluded too.\x0d\nconst regexSeparators = /[\\x2E\\u3002\\uFF0E\\uFF61]/g; // RFC 3490 separators\x0d\n\x0d\n/** Error messages */\x0d\nconst errors = {\x0d\n\x09'overflow': 'Overflow: input needs wider integers to process'\x2C\x0d\n\x09'not-basic': 'Illegal input >= 0x80 (not a basic code point)'\x2C\x0d\n\x09'invalid-input': 'Invalid input'\x0d\n};\x0d\n\x0d\n/** Convenience shortcuts */\x0d\nconst baseMinusTMin = base - tMin;\x0d\nconst floor = Math.floor;\x0d\nconst stringFromCharCode = String.fromCharCode;\x0d\n\x0d\n/*--------------------------------------------------------------------------*/\x0d\n\x0d\n/**\x0d\n * A generic error utility function.\x0d\n * @private\x0d\n * @param {String} type The error type.\x0d\n * @returns {Error} Throws a `RangeError` with the applicable error message.\x0d\n */\x0d\nfunction error(type) {\x0d\n\x09throw new RangeError(errors[type]);\x0d\n}\x0d\n\x0d\n/**\x0d\n * A generic `Array#map` utility function.\x0d\n * @private\x0d\n * @param {Array} array The array to iterate over.\x0d\n * @param {Function} callback The function that gets called for every array\x0d\n * item.\x0d\n * @returns {Array} A new array of values returned by the callback function.\x0d\n */\x0d\nfunction map(array\x2C callback) {\x0d\n\x09const result = [];\x0d\n\x09let length = array.length;\x0d\n\x09while (length--) {\x0d\n\x09\x09result[length] = callback(array[length]);\x0d\n\x09}\x0d\n\x09return result;\x0d\n}\x0d\n\x0d\n/**\x0d\n * A simple `Array#map`-like wrapper to work with domain name strings or email\x0d\n * addresses.\x0d\n * @private\x0d\n * @param {String} domain The domain name or email address.\x0d\n * @param {Function} callback The function that gets called for every\x0d\n * character.\x0d\n * @returns {String} A new string of characters returned by the callback\x0d\n * function.\x0d\n */\x0d\nfunction mapDomain(domain\x2C callback) {\x0d\n\x09const parts = domain.split('@');\x0d\n\x09let result = '';\x0d\n\x09if (parts.length > 1) {\x0d\n\x09\x09// In email addresses\x2C only the domain name should be punycoded. Leave\x0d\n\x09\x09// the local part (i.e. everything up to `@`) intact.\x0d\n\x09\x09result = parts[0] + '@';\x0d\n\x09\x09domain = parts[1];\x0d\n\x09}\x0d\n\x09// Avoid `split(regex)` for IE8 compatibility. See #17.\x0d\n\x09domain = domain.replace(regexSeparators\x2C '\\x2E');\x0d\n\x09const labels = domain.split('.');\x0d\n\x09const encoded = map(labels\x2C callback).join('.');\x0d\n\x09return result + encoded;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Creates an array containing the numeric code points of each Unicode\x0d\n * character in the string. While JavaScript uses UCS-2 internally\x2C\x0d\n * this function will convert a pair of surrogate halves (each of which\x0d\n * UCS-2 exposes as separate characters) into a single code point\x2C\x0d\n * matching UTF-16.\x0d\n * @see `punycode.ucs2.encode`\x0d\n * @see <https://mathiasbynens.be/notes/javascript-encoding>\x0d\n * @memberOf punycode.ucs2\x0d\n * @name decode\x0d\n * @param {String} string The Unicode input string (UCS-2).\x0d\n * @returns {Array} The new array of code points.\x0d\n */\x0d\nfunction ucs2decode(string) {\x0d\n\x09const output = [];\x0d\n\x09let counter = 0;\x0d\n\x09const length = string.length;\x0d\n\x09while (counter < length) {\x0d\n\x09\x09const value = string.charCodeAt(counter++);\x0d\n\x09\x09if (value >= 0xD800 && value <= 0xDBFF && counter < length) {\x0d\n\x09\x09\x09// It's a high surrogate\x2C and there is a next character.\x0d\n\x09\x09\x09const extra = string.charCodeAt(counter++);\x0d\n\x09\x09\x09if ((extra & 0xFC00) == 0xDC00) { // Low surrogate.\x0d\n\x09\x09\x09\x09output.push(((value & 0x3FF) << 10) + (extra & 0x3FF) + 0x10000);\x0d\n\x09\x09\x09} else {\x0d\n\x09\x09\x09\x09// It's an unmatched surrogate; only append this code unit\x2C in case the\x0d\n\x09\x09\x09\x09// next code unit is the high surrogate of a surrogate pair.\x0d\n\x09\x09\x09\x09output.push(value);\x0d\n\x09\x09\x09\x09counter--;\x0d\n\x09\x09\x09}\x0d\n\x09\x09} else {\x0d\n\x09\x09\x09output.push(value);\x0d\n\x09\x09}\x0d\n\x09}\x0d\n\x09return output;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Creates a string based on an array of numeric code points.\x0d\n * @see `punycode.ucs2.decode`\x0d\n * @memberOf punycode.ucs2\x0d\n * @name encode\x0d\n * @param {Array} codePoints The array of numeric code points.\x0d\n * @returns {String} The new Unicode string (UCS-2).\x0d\n */\x0d\nconst ucs2encode = codePoints => String.fromCodePoint(...codePoints);\x0d\n\x0d\n/**\x0d\n * Converts a basic code point into a digit/integer.\x0d\n * @see `digitToBasic()`\x0d\n * @private\x0d\n * @param {Number} codePoint The basic numeric code point value.\x0d\n * @returns {Number} The numeric value of a basic code point (for use in\x0d\n * representing integers) in the range `0` to `base - 1`\x2C or `base` if\x0d\n * the code point does not represent a value.\x0d\n */\x0d\nconst basicToDigit = function(codePoint) {\x0d\n\x09if (codePoint >= 0x30 && codePoint < 0x3A) {\x0d\n\x09\x09return 26 + (codePoint - 0x30);\x0d\n\x09}\x0d\n\x09if (codePoint >= 0x41 && codePoint < 0x5B) {\x0d\n\x09\x09return codePoint - 0x41;\x0d\n\x09}\x0d\n\x09if (codePoint >= 0x61 && codePoint < 0x7B) {\x0d\n\x09\x09return codePoint - 0x61;\x0d\n\x09}\x0d\n\x09return base;\x0d\n};\x0d\n\x0d\n/**\x0d\n * Converts a digit/integer into a basic code point.\x0d\n * @see `basicToDigit()`\x0d\n * @private\x0d\n * @param {Number} digit The numeric value of a basic code point.\x0d\n * @returns {Number} The basic code point whose value (when used for\x0d\n * representing integers) is `digit`\x2C which needs to be in the range\x0d\n * `0` to `base - 1`. If `flag` is non-zero\x2C the uppercase form is\x0d\n * used; else\x2C the lowercase form is used. The behavior is undefined\x0d\n * if `flag` is non-zero and `digit` has no uppercase form.\x0d\n */\x0d\nconst digitToBasic = function(digit\x2C flag) {\x0d\n\x09//  0..25 map to ASCII a..z or A..Z\x0d\n\x09// 26..35 map to ASCII 0..9\x0d\n\x09return digit + 22 + 75 * (digit < 26) - ((flag != 0) << 5);\x0d\n};\x0d\n\x0d\n/**\x0d\n * Bias adaptation function as per section 3.4 of RFC 3492.\x0d\n * https://tools.ietf.org/html/rfc3492#section-3.4\x0d\n * @private\x0d\n */\x0d\nconst adapt = function(delta\x2C numPoints\x2C firstTime) {\x0d\n\x09let k = 0;\x0d\n\x09delta = firstTime ? floor(delta / damp) : delta >> 1;\x0d\n\x09delta += floor(delta / numPoints);\x0d\n\x09for (/* no initialization */; delta > baseMinusTMin * tMax >> 1; k += base) {\x0d\n\x09\x09delta = floor(delta / baseMinusTMin);\x0d\n\x09}\x0d\n\x09return floor(k + (baseMinusTMin + 1) * delta / (delta + skew));\x0d\n};\x0d\n\x0d\n/**\x0d\n * Converts a Punycode string of ASCII-only symbols to a string of Unicode\x0d\n * symbols.\x0d\n * @memberOf punycode\x0d\n * @param {String} input The Punycode string of ASCII-only symbols.\x0d\n * @returns {String} The resulting string of Unicode symbols.\x0d\n */\x0d\nconst decode = function(input) {\x0d\n\x09// Don't use UCS-2.\x0d\n\x09const output = [];\x0d\n\x09const inputLength = input.length;\x0d\n\x09let i = 0;\x0d\n\x09let n = initialN;\x0d\n\x09let bias = initialBias;\x0d\n\x0d\n\x09// Handle the basic code points: let `basic` be the number of input code\x0d\n\x09// points before the last delimiter\x2C or `0` if there is none\x2C then copy\x0d\n\x09// the first basic code points to the output.\x0d\n\x0d\n\x09let basic = input.lastIndexOf(delimiter);\x0d\n\x09if (basic < 0) {\x0d\n\x09\x09basic = 0;\x0d\n\x09}\x0d\n\x0d\n\x09for (let j = 0; j < basic; ++j) {\x0d\n\x09\x09// if it's not a basic code point\x0d\n\x09\x09if (input.charCodeAt(j) >= 0x80) {\x0d\n\x09\x09\x09error('not-basic');\x0d\n\x09\x09}\x0d\n\x09\x09output.push(input.charCodeAt(j));\x0d\n\x09}\x0d\n\x0d\n\x09// Main decoding loop: start just after the last delimiter if any basic code\x0d\n\x09// points were copied; start at the beginning otherwise.\x0d\n\x0d\n\x09for (let index = basic > 0 ? basic + 1 : 0; index < inputLength; /* no final expression */) {\x0d\n\x0d\n\x09\x09// `index` is the index of the next character to be consumed.\x0d\n\x09\x09// Decode a generalized variable-length integer into `delta`\x2C\x0d\n\x09\x09// which gets added to `i`. The overflow checking is easier\x0d\n\x09\x09// if we increase `i` as we go\x2C then subtract off its starting\x0d\n\x09\x09// value at the end to obtain `delta`.\x0d\n\x09\x09const oldi = i;\x0d\n\x09\x09for (let w = 1\x2C k = base; /* no condition */; k += base) {\x0d\n\x0d\n\x09\x09\x09if (index >= inputLength) {\x0d\n\x09\x09\x09\x09error('invalid-input');\x0d\n\x09\x09\x09}\x0d\n\x0d\n\x09\x09\x09const digit = basicToDigit(input.charCodeAt(index++));\x0d\n\x0d\n\x09\x09\x09if (digit >= base) {\x0d\n\x09\x09\x09\x09error('invalid-input');\x0d\n\x09\x09\x09}\x0d\n\x09\x09\x09if (digit > floor((maxInt - i) / w)) {\x0d\n\x09\x09\x09\x09error('overflow');\x0d\n\x09\x09\x09}\x0d\n\x0d\n\x09\x09\x09i += digit * w;\x0d\n\x09\x09\x09const t = k <= bias ? tMin : (k >= bias + tMax ? tMax : k - bias);\x0d\n\x0d\n\x09\x09\x09if (digit < t) {\x0d\n\x09\x09\x09\x09break;\x0d\n\x09\x09\x09}\x0d\n\x0d\n\x09\x09\x09const baseMinusT = base - t;\x0d\n\x09\x09\x09if (w > floor(maxInt / baseMinusT)) {\x0d\n\x09\x09\x09\x09error('overflow');\x0d\n\x09\x09\x09}\x0d\n\x0d\n\x09\x09\x09w *= baseMinusT;\x0d\n\x0d\n\x09\x09}\x0d\n\x0d\n\x09\x09const out = output.length + 1;\x0d\n\x09\x09bias = adapt(i - oldi\x2C out\x2C oldi == 0);\x0d\n\x0d\n\x09\x09// `i` was supposed to wrap around from `out` to `0`\x2C\x0d\n\x09\x09// incrementing `n` each time\x2C so we'll fix that now:\x0d\n\x09\x09if (floor(i / out) > maxInt - n) {\x0d\n\x09\x09\x09error('overflow');\x0d\n\x09\x09}\x0d\n\x0d\n\x09\x09n += floor(i / out);\x0d\n\x09\x09i %= out;\x0d\n\x0d\n\x09\x09// Insert `n` at position `i` of the output.\x0d\n\x09\x09output.splice(i++\x2C 0\x2C n);\x0d\n\x0d\n\x09}\x0d\n\x0d\n\x09return String.fromCodePoint(...output);\x0d\n};\x0d\n\x0d\n/**\x0d\n * Converts a string of Unicode symbols (e.g. a domain name label) to a\x0d\n * Punycode string of ASCII-only symbols.\x0d\n * @memberOf punycode\x0d\n * @param {String} input The string of Unicode symbols.\x0d\n * @returns {String} The resulting Punycode string of ASCII-only symbols.\x0d\n */\x0d\nconst encode = function(input) {\x0d\n\x09const output = [];\x0d\n\x0d\n\x09// Convert the input in UCS-2 to an array of Unicode code points.\x0d\n\x09input = ucs2decode(input);\x0d\n\x0d\n\x09// Cache the length.\x0d\n\x09const inputLength = input.length;\x0d\n\x0d\n\x09// Initialize the state.\x0d\n\x09let n = initialN;\x0d\n\x09let delta = 0;\x0d\n\x09let bias = initialBias;\x0d\n\x0d\n\x09// Handle the basic code points.\x0d\n\x09for (const currentValue of input) {\x0d\n\x09\x09if (currentValue < 0x80) {\x0d\n\x09\x09\x09output.push(stringFromCharCode(currentValue));\x0d\n\x09\x09}\x0d\n\x09}\x0d\n\x0d\n\x09const basicLength = output.length;\x0d\n\x09let handledCPCount = basicLength;\x0d\n\x0d\n\x09// `handledCPCount` is the number of code points that have been handled;\x0d\n\x09// `basicLength` is the number of basic code points.\x0d\n\x0d\n\x09// Finish the basic string with a delimiter unless it's empty.\x0d\n\x09if (basicLength) {\x0d\n\x09\x09output.push(delimiter);\x0d\n\x09}\x0d\n\x0d\n\x09// Main encoding loop:\x0d\n\x09while (handledCPCount < inputLength) {\x0d\n\x0d\n\x09\x09// All non-basic code points < n have been handled already. Find the next\x0d\n\x09\x09// larger one:\x0d\n\x09\x09let m = maxInt;\x0d\n\x09\x09for (const currentValue of input) {\x0d\n\x09\x09\x09if (currentValue >= n && currentValue < m) {\x0d\n\x09\x09\x09\x09m = currentValue;\x0d\n\x09\x09\x09}\x0d\n\x09\x09}\x0d\n\x0d\n\x09\x09// Increase `delta` enough to advance the decoder's <n\x2Ci> state to <m\x2C0>\x2C\x0d\n\x09\x09// but guard against overflow.\x0d\n\x09\x09const handledCPCountPlusOne = handledCPCount + 1;\x0d\n\x09\x09if (m - n > floor((maxInt - delta) / handledCPCountPlusOne)) {\x0d\n\x09\x09\x09error('overflow');\x0d\n\x09\x09}\x0d\n\x0d\n\x09\x09delta += (m - n) * handledCPCountPlusOne;\x0d\n\x09\x09n = m;\x0d\n\x0d\n\x09\x09for (const currentValue of input) {\x0d\n\x09\x09\x09if (currentValue < n && ++delta > maxInt) {\x0d\n\x09\x09\x09\x09error('overflow');\x0d\n\x09\x09\x09}\x0d\n\x09\x09\x09if (currentValue === n) {\x0d\n\x09\x09\x09\x09// Represent delta as a generalized variable-length integer.\x0d\n\x09\x09\x09\x09let q = delta;\x0d\n\x09\x09\x09\x09for (let k = base; /* no condition */; k += base) {\x0d\n\x09\x09\x09\x09\x09const t = k <= bias ? tMin : (k >= bias + tMax ? tMax : k - bias);\x0d\n\x09\x09\x09\x09\x09if (q < t) {\x0d\n\x09\x09\x09\x09\x09\x09break;\x0d\n\x09\x09\x09\x09\x09}\x0d\n\x09\x09\x09\x09\x09const qMinusT = q - t;\x0d\n\x09\x09\x09\x09\x09const baseMinusT = base - t;\x0d\n\x09\x09\x09\x09\x09output.push(\x0d\n\x09\x09\x09\x09\x09\x09stringFromCharCode(digitToBasic(t + qMinusT % baseMinusT\x2C 0))\x0d\n\x09\x09\x09\x09\x09);\x0d\n\x09\x09\x09\x09\x09q = floor(qMinusT / baseMinusT);\x0d\n\x09\x09\x09\x09}\x0d\n\x0d\n\x09\x09\x09\x09output.push(stringFromCharCode(digitToBasic(q\x2C 0)));\x0d\n\x09\x09\x09\x09bias = adapt(delta\x2C handledCPCountPlusOne\x2C handledCPCount === basicLength);\x0d\n\x09\x09\x09\x09delta = 0;\x0d\n\x09\x09\x09\x09++handledCPCount;\x0d\n\x09\x09\x09}\x0d\n\x09\x09}\x0d\n\x0d\n\x09\x09++delta;\x0d\n\x09\x09++n;\x0d\n\x0d\n\x09}\x0d\n\x09return output.join('');\x0d\n};\x0d\n\x0d\n/**\x0d\n * Converts a Punycode string representing a domain name or an email address\x0d\n * to Unicode. Only the Punycoded parts of the input will be converted\x2C i.e.\x0d\n * it doesn't matter if you call it on a string that has already been\x0d\n * converted to Unicode.\x0d\n * @memberOf punycode\x0d\n * @param {String} input The Punycoded domain name or email address to\x0d\n * convert to Unicode.\x0d\n * @returns {String} The Unicode representation of the given Punycode\x0d\n * string.\x0d\n */\x0d\nconst toUnicode = function(input) {\x0d\n\x09return mapDomain(input\x2C function(string) {\x0d\n\x09\x09return regexPunycode.test(string)\x0d\n\x09\x09\x09? decode(string.slice(4).toLowerCase())\x0d\n\x09\x09\x09: string;\x0d\n\x09});\x0d\n};\x0d\n\x0d\n/**\x0d\n * Converts a Unicode string representing a domain name or an email address to\x0d\n * Punycode. Only the non-ASCII parts of the domain name will be converted\x2C\x0d\n * i.e. it doesn't matter if you call it with a domain that's already in\x0d\n * ASCII.\x0d\n * @memberOf punycode\x0d\n * @param {String} input The domain name or email address to convert\x2C as a\x0d\n * Unicode string.\x0d\n * @returns {String} The Punycode representation of the given domain name or\x0d\n * email address.\x0d\n */\x0d\nconst toASCII = function(input) {\x0d\n\x09return mapDomain(input\x2C function(string) {\x0d\n\x09\x09return regexNonASCII.test(string)\x0d\n\x09\x09\x09? 'xn--' + encode(string)\x0d\n\x09\x09\x09: string;\x0d\n\x09});\x0d\n};\x0d\n\x0d\n/*--------------------------------------------------------------------------*/\x0d\n\x0d\n/** Define the public API */\x0d\nconst punycode = {\x0d\n\x09/**\x0d\n\x09 * A string representing the current Punycode.js version number.\x0d\n\x09 * @memberOf punycode\x0d\n\x09 * @type String\x0d\n\x09 */\x0d\n\x09'version': '2.1.0'\x2C\x0d\n\x09/**\x0d\n\x09 * An object of methods to convert from JavaScript's internal character\x0d\n\x09 * representation (UCS-2) to Unicode code points\x2C and back.\x0d\n\x09 * @see <https://mathiasbynens.be/notes/javascript-encoding>\x0d\n\x09 * @memberOf punycode\x0d\n\x09 * @type Object\x0d\n\x09 */\x0d\n\x09'ucs2': {\x0d\n\x09\x09'decode': ucs2decode\x2C\x0d\n\x09\x09'encode': ucs2encode\x0d\n\x09}\x2C\x0d\n\x09'decode': decode\x2C\x0d\n\x09'encode': encode\x2C\x0d\n\x09'toASCII': toASCII\x2C\x0d\n\x09'toUnicode': toUnicode\x0d\n};\x0d\n\x0d\nmodule.exports = punycode;\x0d\n
