script-source,1007,C:\\development\\NestJS Federation\\gateway\\node_modules\\cacache\\lib\\content\\write.js,'use strict'\n\nconst events = require('events')\n\nconst contentPath = require('./path')\nconst fs = require('fs/promises')\nconst { moveFile } = require('@npmcli/fs')\nconst { Minipass } = require('minipass')\nconst Pipeline = require('minipass-pipeline')\nconst Flush = require('minipass-flush')\nconst path = require('path')\nconst ssri = require('ssri')\nconst { tmpName } = require('../util/tmp')\nconst fsm = require('fs-minipass')\n\nmodule.exports = write\n\n// Cache of move operations in process so we don't duplicate\nconst moveOperations = new Map()\n\nasync function write (cache\x2C data\x2C opts = {}) {\n  const { algorithms\x2C size\x2C integrity } = opts\n\n  if (typeof size === 'number' && data.length !== size) {\n    throw sizeError(size\x2C data.length)\n  }\n\n  const sri = ssri.fromData(data\x2C algorithms ? { algorithms } : {})\n  if (integrity && !ssri.checkData(data\x2C integrity\x2C opts)) {\n    throw checksumError(integrity\x2C sri)\n  }\n\n  for (const algo in sri) {\n    const tmp = await makeTmp(cache\x2C opts)\n    const hash = sri[algo].toString()\n    try {\n      await fs.writeFile(tmp.target\x2C data\x2C { flag: 'wx' })\n      await moveToDestination(tmp\x2C cache\x2C hash\x2C opts)\n    } finally {\n      if (!tmp.moved) {\n        await fs.rm(tmp.target\x2C { recursive: true\x2C force: true })\n      }\n    }\n  }\n  return { integrity: sri\x2C size: data.length }\n}\n\nmodule.exports.stream = writeStream\n\n// writes proxied to the 'inputStream' that is passed to the Promise\n// 'end' is deferred until content is handled.\nclass CacacheWriteStream extends Flush {\n  constructor (cache\x2C opts) {\n    super()\n    this.opts = opts\n    this.cache = cache\n    this.inputStream = new Minipass()\n    this.inputStream.on('error'\x2C er => this.emit('error'\x2C er))\n    this.inputStream.on('drain'\x2C () => this.emit('drain'))\n    this.handleContentP = null\n  }\n\n  write (chunk\x2C encoding\x2C cb) {\n    if (!this.handleContentP) {\n      this.handleContentP = handleContent(\n        this.inputStream\x2C\n        this.cache\x2C\n        this.opts\n      )\n      this.handleContentP.catch(error => this.emit('error'\x2C error))\n    }\n    return this.inputStream.write(chunk\x2C encoding\x2C cb)\n  }\n\n  flush (cb) {\n    this.inputStream.end(() => {\n      if (!this.handleContentP) {\n        const e = new Error('Cache input stream was empty')\n        e.code = 'ENODATA'\n        // empty streams are probably emitting end right away.\n        // defer this one tick by rejecting a promise on it.\n        return Promise.reject(e).catch(cb)\n      }\n      // eslint-disable-next-line promise/catch-or-return\n      this.handleContentP.then(\n        (res) => {\n          res.integrity && this.emit('integrity'\x2C res.integrity)\n          // eslint-disable-next-line promise/always-return\n          res.size !== null && this.emit('size'\x2C res.size)\n          cb()\n        }\x2C\n        (er) => cb(er)\n      )\n    })\n  }\n}\n\nfunction writeStream (cache\x2C opts = {}) {\n  return new CacacheWriteStream(cache\x2C opts)\n}\n\nasync function handleContent (inputStream\x2C cache\x2C opts) {\n  const tmp = await makeTmp(cache\x2C opts)\n  try {\n    const res = await pipeToTmp(inputStream\x2C cache\x2C tmp.target\x2C opts)\n    await moveToDestination(\n      tmp\x2C\n      cache\x2C\n      res.integrity\x2C\n      opts\n    )\n    return res\n  } finally {\n    if (!tmp.moved) {\n      await fs.rm(tmp.target\x2C { recursive: true\x2C force: true })\n    }\n  }\n}\n\nasync function pipeToTmp (inputStream\x2C cache\x2C tmpTarget\x2C opts) {\n  const outStream = new fsm.WriteStream(tmpTarget\x2C {\n    flags: 'wx'\x2C\n  })\n\n  if (opts.integrityEmitter) {\n    // we need to create these all simultaneously since they can fire in any order\n    const [integrity\x2C size] = await Promise.all([\n      events.once(opts.integrityEmitter\x2C 'integrity').then(res => res[0])\x2C\n      events.once(opts.integrityEmitter\x2C 'size').then(res => res[0])\x2C\n      new Pipeline(inputStream\x2C outStream).promise()\x2C\n    ])\n    return { integrity\x2C size }\n  }\n\n  let integrity\n  let size\n  const hashStream = ssri.integrityStream({\n    integrity: opts.integrity\x2C\n    algorithms: opts.algorithms\x2C\n    size: opts.size\x2C\n  })\n  hashStream.on('integrity'\x2C i => {\n    integrity = i\n  })\n  hashStream.on('size'\x2C s => {\n    size = s\n  })\n\n  const pipeline = new Pipeline(inputStream\x2C hashStream\x2C outStream)\n  await pipeline.promise()\n  return { integrity\x2C size }\n}\n\nasync function makeTmp (cache\x2C opts) {\n  const tmpTarget = tmpName(cache\x2C opts.tmpPrefix)\n  await fs.mkdir(path.dirname(tmpTarget)\x2C { recursive: true })\n  return {\n    target: tmpTarget\x2C\n    moved: false\x2C\n  }\n}\n\nasync function moveToDestination (tmp\x2C cache\x2C sri) {\n  const destination = contentPath(cache\x2C sri)\n  const destDir = path.dirname(destination)\n  if (moveOperations.has(destination)) {\n    return moveOperations.get(destination)\n  }\n  moveOperations.set(\n    destination\x2C\n    fs.mkdir(destDir\x2C { recursive: true })\n      .then(async () => {\n        await moveFile(tmp.target\x2C destination\x2C { overwrite: false })\n        tmp.moved = true\n        return tmp.moved\n      })\n      .catch(err => {\n        if (!err.message.startsWith('The destination file exists')) {\n          throw Object.assign(err\x2C { code: 'EEXIST' })\n        }\n      }).finally(() => {\n        moveOperations.delete(destination)\n      })\n\n  )\n  return moveOperations.get(destination)\n}\n\nfunction sizeError (expected\x2C found) {\n  /* eslint-disable-next-line max-len */\n  const err = new Error(`Bad data size: expected inserted data to be ${expected} bytes\x2C but got ${found} instead`)\n  err.expected = expected\n  err.found = found\n  err.code = 'EBADSIZE'\n  return err\n}\n\nfunction checksumError (expected\x2C found) {\n  const err = new Error(`Integrity check failed:\n  Wanted: ${expected}\n   Found: ${found}`)\n  err.code = 'EINTEGRITY'\n  err.expected = expected\n  err.found = found\n  return err\n}\n
