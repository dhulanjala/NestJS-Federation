script-source,1013,C:\\development\\NestJS Federation\\gateway\\node_modules\\make-fetch-happen\\lib\\pipeline.js,'use strict'\n\nconst MinipassPipeline = require('minipass-pipeline')\n\nclass CachingMinipassPipeline extends MinipassPipeline {\n  #events = []\n  #data = new Map()\n\n  constructor (opts\x2C ...streams) {\n    // CRITICAL: do NOT pass the streams to the call to super()\x2C this will start\n    // the flow of data and potentially cause the events we need to catch to emit\n    // before we've finished our own setup. instead we call super() with no args\x2C\n    // finish our setup\x2C and then push the streams into ourselves to start the\n    // data flow\n    super()\n    this.#events = opts.events\n\n    /* istanbul ignore next - coverage disabled because this is pointless to test here */\n    if (streams.length) {\n      this.push(...streams)\n    }\n  }\n\n  on (event\x2C handler) {\n    if (this.#events.includes(event) && this.#data.has(event)) {\n      return handler(...this.#data.get(event))\n    }\n\n    return super.on(event\x2C handler)\n  }\n\n  emit (event\x2C ...data) {\n    if (this.#events.includes(event)) {\n      this.#data.set(event\x2C data)\n    }\n\n    return super.emit(event\x2C ...data)\n  }\n}\n\nmodule.exports = CachingMinipassPipeline\n
