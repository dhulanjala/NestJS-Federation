ARGUMENT\x2C\x0d\n    ERR_CONSTRUCT_CALL_REQUIRED\x2C\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n    ERR_INVALID_RETURN_VALUE\x2C\x0d\n    ERR_MISSING_ARGS\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\nconst AssertionError = require('internal/assert/assertion_error');\x0d\nconst { inspect } = require('internal/util/inspect');\x0d\nconst {\x0d\n  isPromise\x2C\x0d\n  isRegExp\x2C\x0d\n} = require('internal/util/types');\x0d\nconst { isError\x2C deprecate\x2C setOwnProperty } = require('internal/util');\x0d\nconst { innerOk } = require('internal/assert/utils');\x0d\n\x0d\nconst CallTracker = require('internal/assert/calltracker');\x0d\nconst {\x0d\n  validateFunction\x2C\x0d\n  validateOneOf\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nconst kOptions = Symbol('options');\x0d\n\x0d\nlet isDeepEqual;\x0d\nlet isDeepStrictEqual;\x0d\nlet isPartialStrictEqual;\x0d\n\x0d\nfunction lazyLoadComparison() {\x0d\n  const comparison = require('internal/util/comparisons');\x0d\n  isDeepEqual = comparison.isDeepEqual;\x0d\n  isDeepStrictEqual = comparison.isDeepStrictEqual;\x0d\n  isPartialStrictEqual = comparison.isPartialStrictEqual;\x0d\n}\x0d\n\x0d\nlet warned = false;\x0d\n\x0d\n// The assert module provides functions that throw\x0d\n// AssertionError's when particular conditions are not met. The\x0d\n// assert module must conform to the following interface.\x0d\n\x0d\nconst assert = module.exports = ok;\x0d\n\x0d\nconst NO_EXCEPTION_SENTINEL = {};\x0d\n\x0d\n/**\x0d\n * Assert options.\x0d\n * @typedef {object} AssertOptions\x0d\n * @property {'full'|'simple'} [diff='simple'] - If set to 'full'\x2C shows the full diff in assertion errors.\x0d\n * @property {boolean} [strict=true] - If set to true\x2C non-strict methods behave like their corresponding\x0d\n *   strict methods.\x0d\n * @property {boolean} [skipPrototype=false] - If set to true\x2C skips comparing prototypes\x0d\n *   in deep equality checks.\x0d\n */\x0d\n\x0d\n/**\x0d\n * @class Assert\x0d\n * @param {AssertOptions} [options] - Optional configuration for assertions.\x0d\n * @throws {ERR_CONSTRUCT_CALL_REQUIRED} If not called with `new`.\x0d\n */\x0d\nfunction Assert(options) {\x0d\n  if (!new.target) {\x0d\n    throw new ERR_CONSTRUCT_CALL_REQUIRED('Assert');\x0d\n  }\x0d\n\x0d\n  options = ObjectAssign({ __proto__: null\x2C strict: true\x2C skipPrototype: false }\x2C options);\x0d\n\x0d\n  const allowedDiffs = ['simple'\x2C 'full'];\x0d\n  if (options.diff !== undefined) {\x0d\n    validateOneOf(options.diff\x2C 'options.diff'\x2C allowedDiffs);\x0d\n  }\x0d\n\x0d\n  this.AssertionError = AssertionError;\x0d\n  ObjectDefineProperty(this\x2C kOptions\x2C {\x0d\n    __proto__: null\x2C\x0d\n    value: options\x2C\x0d\n    enumerable: false\x2C\x0d\n    configurable: false\x2C\x0d\n    writable: false\x2C\x0d\n  });\x0d\n\x0d\n  if (options.strict) {\x0d\n    this.equal = this.strictEqual;\x0d\n    this.deepEqual = this.deepStrictEqual;\x0d\n    this.notEqual = this.notStrictEqual;\x0d\n    this.notDeepEqual = this.notDeepStrictEqual;\x0d\n  }\x0d\n}\x0d\n\x0d\n// All of the following functions must throw an AssertionError\x0d\n// when a corresponding condition is not met\x2C with a message that\x0d\n// may be undefined if not provided. All assertion methods provide\x0d\n// both the actual and expected values to the assertion error for\x0d\n// display purposes.\x0d\n\x0d\n// DESTRUCTURING WARNING: All Assert.prototype methods use optional chaining\x0d\n// (this?.[kOptions]) to safely access instance configuration. When methods are\x0d\n// destructured from an Assert instance (e.g.\x2C const {strictEqual} = myAssert)\x2C\x0d\n// they lose their `this` context and will use default behavior instead of the\x0d\n// instance's custom options.\x0d\n\x0d\nfunction innerFail(obj) {\x0d\n  if (obj.message instanceof Error) throw obj.message;\x0d\n\x0d\n  throw new AssertionError(obj);\x0d\n}\x0d\n\x0d\n/**\x0d\n * @param {any} actual\x0d\n * @param {any} expected\x0d\n * @param {string | Error} [message]\x0d\n * @param {string} [operator]\x0d\n * @param {Function} [stackStartFn]\x0d\n */\x0d\nAssert.prototype.fail = function fail(actual\x2C expected\x2C message\x2C operator\x2C stackStartFn) {\x0d\n  const argsLen = arguments.length;\x0d\n\x0d\n  let internalMessage = false;\x0d\n  if (actual == null && argsLen <= 1) {\x0d\n    internalMessage = true;\x0d\n    message = 'Failed';\x0d\n  } else if (argsLen === 1) {\x0d\n    message = actual;\x0d\n    actual = undefined;\x0d\n  } else {\x0d\n    if (warned === false) {\x0d\n      warned = true;\x0d\n      process.emitWarning(\x0d\n        'assert.fail() with more than one argument is deprecated. ' +\x0d\n          'Please use assert.strictEqual() instead or only pass a message.'\x2C\x0d\n        'DeprecationWarning'\x2C\x0d\n        'DEP0094'\x2C\x0d\n      );\x0d\n    }\x0d\n    if (argsLen === 2)\x0d\n      operator = '!=';\x0d\n  }\x0d\n\x0d\n  if (message instanceof Error) throw message;\x0d\n\x0d\n  // IMPORTANT: When adding new references to `this`\x2C ensure they use optional chaining\x0d\n  // (this?.[kOptions]?.diff) to handle cases where the method is destructured from an\x0d\n  // Assert instance and loses its context. Destructured methods will fall back\x0d\n  // to default behavior when `this` is undefined.\x0d\n  const errArgs = {\x0d\n    actual\x2C\x0d\n    expected\x2C\x0d\n    operator: operator === undefined ? 'fail' : operator\x2C\x0d\n    stackStartFn: stackStartFn || fail\x2C\x0d\n    message\x2C\x0d\n    diff: this?.[kOptions]?.diff\x2C\x0d\n  };\x0d\n  const err = new AssertionError(errArgs);\x0d\n  if (internalMessage) {\x0d\n    err.generatedMessage = true;\x0d\n  }\x0d\n  throw err;\x0d\n};\x0d\n\x0d\n// The AssertionError is defined in internal/error.\x0d\nassert.AssertionError = AssertionError;\x0d\n\x0d\n/**\x0d\n * Pure assertion tests whether a value is truthy\x2C as determined\x0d\n * by !!value.\x0d\n * @param {...any} args\x0d\n * @returns {void}\x0d\n */\x0d\nfunction ok(...args) {\x0d\n  innerOk(ok\x2C args.length\x2C ...args);\x0d\n}\x0d\n\x0d\n/**\x0d\n * Pure assertion tests whether a value is truthy\x2C as determined\x0d\n * by !!value.\x0d\n * Duplicated as the other `ok` function is supercharged and exposed as default export.\x0d\n * @param {...any} args\x0d\n * @returns {void}\x0d\n */\x0d\nAssert.prototype.ok = function ok(...args) {\x0d\n  innerOk(ok\x2C args.length\x2C ...args);\x0d\n};\x0d\n\x0d\n/**\x0d\n * The equality assertion tests shallow\x2C coercive equality with ==.\x0d\n * @param {any} actual\x0d\n * @param {any} expected\x0d\n * @param {string | Error} [message]\x0d\n * @returns {void}\x0d\n */\x0d\nAssert.prototype.equal = function equal(actual\x2C expected\x2C message) {\x0d\n  if (arguments.length < 2) {\x0d\n    throw new ERR_MISSING_ARGS('actual'\x2C 'expected');\x0d\n  }\x0d\n  // eslint-disable-next-line eqeqeq\x0d\n  if (actual != expected && (!NumberIsNaN(actual) || !NumberIsNaN(expected))) {\x0d\n    innerFail({\x0d\n      actual\x2C\x0d\n      expected\x2C\x0d\n      message\x2C\x0d\n      operator: '=='\x2C\x0d\n      stackStartFn: equal\x2C\x0d\n      diff: this?.[kOptions]?.diff\x2C\x0d\n    });\x0d\n  }\x0d\n};\x0d\n\x0d\n/**\x0d\n * The non-equality assertion tests for whether two objects are not\x0d\n * equal with !=.\x0d\n * @param {any} actual\x0d\n * @param {any} expected\x0d\n * @param {string | Error} [message]\x0d\n * @returns {void}\x0d\n */\x0d\nAssert.prototype.notEqual = function notEqual(actual\x2C expected\x2C message) {\x0d\n  if (arguments.length < 2) {\x0d\n    throw new ERR_MISSING_ARGS('actual'\x2C 'expected');\x0d\n  }\x0d\n  // eslint-disable-next-line eqeqeq\x0d\n  if (actual == expected || (NumberIsNaN(actual) && NumberIsNaN(expected))) {\x0d\n    innerFail({\x0d\n      actual\x2C\x0d\n      expected\x2C\x0d\n      message\x2C\x0d\n      operator: '!='\x2C\x0d\n      stackStartFn: notEqual\x2C\x0d\n      diff: this?.[kOptions]?.diff\x2C\x0d\n    });\x0d\n  }\x0d\n};\x0d\n\x0d\n/**\x0d\n * The deep equivalence assertion tests a deep equality relation.\x0d\n * @param {any} actual\x0d\n * @param {any} expected\x0d\n * @param {string | Error} [message]\x0d\n * @returns {void}\x0d\n */\x0d\nAssert.prototype.deepEqual = function deepEqual(actual\x2C expected\x2C message) {\x0d\n  if (arguments.length < 2) {\x0d\n    throw new ERR_MISSING_ARGS('actual'\x2C 'expected');\x0d\n  }\x0d\n  if (isDeepEqual === undefined) lazyLoadComparison();\x0d\n  if (!isDeepEqual(actual\x2C expected)) {\x0d\n    innerFail({\x0d\n      actual\x2C\x0d\n      expected\x2C\x0d\n      message\x2C\x0d\n      operator: 'deepEqual'\x2C\x0d\n      stackStartFn: deepEqual\x2C\x0d\n      diff: this?.[kOptions]?.diff\x2C\x0d\n    });\x0d\n  }\x0d\n};\x0d\n\x0d\n/**\x0d\n * The deep non-equivalence assertion tests for any deep inequality.\x0d\n * @param {any} actual\x0d\n * @param {any} expected\x0d\n * @param {string | Error} [message]\x0d\n * @returns {void}\x0d\n */\x0d\nAssert.prototype.notDeepEqual = function notDeepEqual(actual\x2C expected\x2C message) {\x0d\n  if (arguments.length < 2) {\x0d\n    throw new ERR_MISSING_ARGS('actual'\x2C 'expected');\x0d\n  }\x0d\n  if (isDeepEqual === undefined) lazyLoadComparison();\x0d\n  if (isDeepEqual(actual\x2C expected)) {\x0d\n    innerFail({\x0d\n      actual\x2C\x0d\n      expected\x2C\x0d\n      message\x2C\x0d\n      operator: 'notDeepEqual'\x2C\x0d\n      stackStartFn: notDeepEqual\x2C\x0d\n      diff: this?.[kOptions]?.diff\x2C\x0d\n    });\x0d\n  }\x0d\n};\x0d\n\x0d\n/**\x0d\n * The deep strict equivalence assertion tests a deep strict equality\x0d\n * relation.\x0d\n * @param {any} actual\x0d\n * @param {any} expected\x0d\n * @param {string | Error} [message]\x0d\n * @returns {void}\x0d\n */\x0d\nAssert.prototype.deepStrictEqual = function deepStrictEqual(actual\x2C expected\x2C message) {\x0d\n  if (arguments.length < 2) {\x0d\n    throw new ERR_MISSING_ARGS('actual'\x2C 'expected');\x0d\n  }\x0d\n  if (isDeepEqual === undefined) lazyLoadComparison();\x0d\n  if (!isDeepStrictEqual(actual\x2C expected\x2C this?.[kOptions]?.skipPrototype)) {\x0d\n    innerFail({\x0d\n      actual\x2C\x0d\n      expected\x2C\x0d\n      message\x2C\x0d\n      operator: 'deepStrictEqual'\x2C\x0d\n      stackStartFn: deepStrictEqual\x2C\x0d\n      diff: this?.[kOptions]?.diff\x2C\x0d\n    });\x0d\n  }\x0d\n};\x0d\n\x0d\n/**\x0d\n * The deep strict non-equivalence assertion tests for any deep strict\x0d\n * inequality.\x0d\n * @param {any} actual\x0d\n * @param {any} expected\x0d\n * @param {string | Error} [message]\x0d\n * @returns {void}\x0d\n */\x0d\nAssert.prototype.notDeepStrictEqual = notDeepStrictEqual;\x0d\nfunction notDeepStrictEqual(actual\x2C expected\x2C message) {\x0d\n  if (arguments.length < 2) {\x0d\n    throw new ERR_MISSING_ARGS('actual'\x2C 'expected');\x0d\n  }\x0d\n  if (isDeepEqual === undefined) lazyLoadComparison();\x0d\n  if (isDeepStrictEqual(actual\x2C expected\x2C this?.[kOptions]?.skipPrototype)) {\x0d\n    innerFail({\x0d\n      actual\x2C\x0d\n      expected\x2C\x0d\n      message\x2C\x0d\n      operator: 'notDeepStrictEqual'\x2C\x0d\n      stackStartFn: notDeepStrictEqual\x2C\x0d\n      diff: this?.[kOptions]?.diff\x2C\x0d\n    });\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * The strict equivalence assertion tests a strict equality relation.\x0d\n * @param {any} actual\x0d\n * @param {any} expected\x0d\n * @param {string | Error} [message]\x0d\n * @returns {void}\x0d\n */\x0d\nAssert.prototype.strictEqual = function strictEqual(actual\x2C expected\x2C message) {\x0d\n  if (arguments.length < 2) {\x0d\n    throw new ERR_MISSING_ARGS('actual'\x2C 'expected');\x0d\n  }\x0d\n  if (!ObjectIs(actual\x2C expected)) {\x0d\n    innerFail({\x0d\n      actual\x2C\x0d\n      expected\x2C\x0d\n      message\x2C\x0d\n      operator: 'strictEqual'\x2C\x0d\n      stackStartFn: strictEqual\x2C\x0d\n      diff: this?.[kOptions]?.diff\x2C\x0d\n    });\x0d\n  }\x0d\n};\x0d\n\x0d\n/**\x0d\n * The strict non-equivalence assertion tests for any strict inequality.\x0d\n * @param {any} actual\x0d\n * @param {any} expected\x0d\n * @param {string | Error} [message]\x0d\n * @returns {void}\x0d\n */\x0d\nAssert.prototype.notStrictEqual = function notStrictEqual(actual\x2C expected\x2C message) {\x0d\n  if (arguments.length < 2) {\x0d\n    throw new ERR_MISSING_ARGS('actual'\x2C 'expected');\x0d\n  }\x0d\n  if (ObjectIs(actual\x2C expected)) {\x0d\n    innerFail({\x0d\n      actual\x2C\x0d\n      expected\x2C\x0d\n      message\x2C\x0d\n      operator: 'notStrictEqual'\x2C\x0d\n      stackStartFn: notStrictEqual\x2C\x0d\n      diff: this?.[kOptions]?.diff\x2C\x0d\n    });\x0d\n  }\x0d\n};\x0d\n\x0d\n/**\x0d\n * The strict equivalence assertion test between two objects\x0d\n * @param {any} actual\x0d\n * @param {any} expected\x0d\n * @param {string | Error} [message]\x0d\n * @returns {void}\x0d\n */\x0d\nAssert.prototype.partialDeepStrictEqual = function partialDeepStrictEqual(\x0d\n  actual\x2C\x0d\n  expected\x2C\x0d\n  message\x2C\x0d\n) {\x0d\n  if (arguments.length < 2) {\x0d\n    throw new ERR_MISSING_ARGS('actual'\x2C 'expected');\x0d\n  }\x0d\n  if (isDeepEqual === undefined) lazyLoadComparison();\x0d\n  if (!isPartialStrictEqual(actual\x2C expected)) {\x0d\n    innerFail({\x0d\n      actual\x2C\x0d\n      expected\x2C\x0d\n      message\x2C\x0d\n      operator: 'partialDeepStrictEqual'\x2C\x0d\n      stackStartFn: partialDeepStrictEqual\x2C\x0d\n      diff: this?.[kOptions]?.diff\x2C\x0d\n    });\x0d\n  }\x0d\n};\x0d\n\x0d\nclass Comparison {\x0d\n  constructor(obj\x2C keys\x2C actual) {\x0d\n    for (const key of keys) {\x0d\n      if (key in obj) {\x0d\n        if (actual !== undefined &&\x0d\n            typeof actual[key] === 'string' &&\x0d\n            isRegExp(obj[key]) &&\x0d\n            RegExpPrototypeExec(obj[key]\x2C actual[key]) !== null) {\x0d\n          this[key] = actual[key];\x0d\n        } else {\x0d\n          this[key] = obj[key];\x0d\n        }\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction compareExceptionKey(actual\x2C expected\x2C key\x2C message\x2C keys\x2C fn) {\x0d\n  if (!(key in actual) || !isDeepStrictEqual(actual[key]\x2C expected[key])) {\x0d\n    if (!message) {\x0d\n      // Create placeholder objects to create a nice output.\x0d\n      const a = new Comparison(actual\x2C keys);\x0d\n      const b = new Comparison(expected\x2C keys\x2C actual);\x0d\n\x0d\n      const err = new AssertionError({\x0d\n        actual: a\x2C\x0d\n        expected: b\x2C\x0d\n        operator: 'deepStrictEqual'\x2C\x0d\n        stackStartFn: fn\x2C\x0d\n        diff: this?.[kOptions]?.diff\x2C\x0d\n      });\x0d\n      err.actual = actual;\x0d\n      err.expected = expected;\x0d\n      err.operator = fn.name;\x0d\n      throw err;\x0d\n    }\x0d\n    innerFail({\x0d\n      actual\x2C\x0d\n      expected\x2C\x0d\n      message\x2C\x0d\n      operator: fn.name\x2C\x0d\n      stackStartFn: fn\x2C\x0d\n      diff: this?.[kOptions]?.diff\x2C\x0d\n    });\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction expectedException(actual\x2C expected\x2C message\x2C fn) {\x0d\n  let generatedMessage = false;\x0d\n  let throwError = false;\x0d\n\x0d\n  if (typeof expected !== 'function') {\x0d\n    // Handle regular expressions.\x0d\n    if (isRegExp(expected)) {\x0d\n      const str = String(actual);\x0d\n      if (RegExpPrototypeExec(expected\x2C str) !== null)\x0d\n        return;\x0d\n\x0d\n      if (!message) {\x0d\n        generatedMessage = true;\x0d\n        message = 'The input did not match the regular expression ' +\x0d\n                  `${inspect(expected)}. Input:\\n\\n${inspect(str)}\\n`;\x0d\n      }\x0d\n      throwError = true;\x0d\n      // Handle primitives properly.\x0d\n    } else if (typeof actual !== 'object' || actual === null) {\x0d\n      const err = new AssertionError({\x0d\n        actual\x2C\x0d\n        expected\x2C\x0d\n        message\x2C\x0d\n        operator: 'deepStrictEqual'\x2C\x0d\n        stackStartFn: fn\x2C\x0d\n        diff: this?.[kOptions]?.diff\x2C\x0d\n      });\x0d\n      err.operator = fn.name;\x0d\n      throw err;\x0d\n    } else {\x0d\n      // Handle validation objects.\x0d\n      const keys = ObjectKeys(expected);\x0d\n      // Special handle errors to make sure the name and the message are\x0d\n      // compared as well.\x0d\n      if (expected instanceof Error) {\x0d\n        ArrayPrototypePush(keys\x2C 'name'\x2C 'message');\x0d\n      } else if (keys.length === 0) {\x0d\n        throw new ERR_INVALID_ARG_VALUE('error'\x2C\x0d\n                                        expected\x2C 'may not be an empty object');\x0d\n      }\x0d\n      if (isDeepEqual === undefined) lazyLoadComparison();\x0d\n      for (const key of keys) {\x0d\n        if (typeof actual[key] === 'string' &&\x0d\n            isRegExp(expected[key]) &&\x0d\n            RegExpPrototypeExec(expected[key]\x2C actual[key]) !== null) {\x0d\n          continue;\x0d\n        }\x0d\n        compareExceptionKey(actual\x2C expected\x2C key\x2C message\x2C keys\x2C fn);\x0d\n      }\x0d\n      return;\x0d\n    }\x0d\n  // Guard instanceof against arrow functions as they don't have a prototype.\x0d\n  // Check for matching Error classes.\x0d\n  } else if (expected.prototype !== undefined && actual instanceof expected) {\x0d\n    return;\x0d\n  } else if (ObjectPrototypeIsPrototypeOf(Error\x2C expected)) {\x0d\n    if (!message) {\x0d\n      generatedMessage = true;\x0d\n      message = 'The error is expected to be an instance of ' +\x0d\n        `"${expected.name}". Received `;\x0d\n      if (isError(actual)) {\x0d\n        const name = (actual.constructor?.name) ||\x0d\n                     actual.name;\x0d\n        if (expected.name === name) {\x0d\n          message += 'an error with identical name but a different prototype.';\x0d\n        } else {\x0d\n          message += `"${name}"`;\x0d\n        }\x0