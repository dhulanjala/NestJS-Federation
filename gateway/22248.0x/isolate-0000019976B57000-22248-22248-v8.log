script-source,944,C:\\development\\NestJS Federation\\gateway\\node_modules\\cacache\\lib\\util\\tmp.js,'use strict'\n\nconst crypto = require('crypto')\nconst { withTempDir } = require('@npmcli/fs')\nconst fs = require('fs/promises')\nconst path = require('path')\n\nmodule.exports.mkdir = mktmpdir\n\nmodule.exports.tmpName = function tmpName (cache\x2C tmpPrefix) {\n  const id = crypto.randomUUID()\n  return path.join(cache\x2C 'tmp'\x2C tmpPrefix ? `${tmpPrefix}-${id}` : id)\n}\n\nasync function mktmpdir (cache\x2C opts = {}) {\n  const { tmpPrefix } = opts\n  const tmpDir = path.join(cache\x2C 'tmp')\n  await fs.mkdir(tmpDir\x2C { recursive: true\x2C owner: 'inherit' })\n  // do not use path.join()\x2C it drops the trailing / if tmpPrefix is unset\n  const target = `${tmpDir}${path.sep}${tmpPrefix || ''}`\n  return fs.mkdtemp(target\x2C { owner: 'inherit' })\n}\n\nmodule.exports.withTmp = withTmp\n\nfunction withTmp (cache\x2C opts\x2C cb) {\n  if (!cb) {\n    cb = opts\n    opts = {}\n  }\n  return withTempDir(path.join(cache\x2C 'tmp')\x2C cb\x2C opts)\n}\n
