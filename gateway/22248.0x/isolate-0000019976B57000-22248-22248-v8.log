n${StringPrototypeRepeat(' '\x2C col - 1)}^\\n`;\x0d\n    setArrowMessage(err\x2C frame);\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * Generate the legacy ERR_REQUIRE_ESM for the cases where require(esm) is disabled.\x0d\n * @param {Module} mod The module being required.\x0d\n * @param {undefined|object} pkg Data of the nearest package.json of the module.\x0d\n * @param {string} content Source code of the module.\x0d\n * @param {string} filename Filename of the module\x0d\n * @returns {Error}\x0d\n */\x0d\nfunction getRequireESMError(mod\x2C pkg\x2C content\x2C filename) {\x0d\n  // This is an error path because `require` of a `.js` file in a `"type": "module"` scope is not allowed.\x0d\n  const parent = mod[kFirstModuleParent];\x0d\n  const parentPath = parent?.filename;\x0d\n  const packageJsonPath = pkg?.path;\x0d\n  const usesEsm = containsModuleSyntax(content\x2C filename);\x0d\n  const err = new ERR_REQUIRE_ESM(filename\x2C usesEsm\x2C parentPath\x2C\x0d\n                                  packageJsonPath);\x0d\n  // Attempt to reconstruct the parent require frame.\x0d\n  const parentModule = Module._cache[parentPath];\x0d\n  if (parentModule) {\x0d\n    let parentSource;\x0d\n    try {\x0d\n      ({ source: parentSource } = loadSource(parentModule\x2C parentPath));\x0d\n    } catch {\x0d\n      // Continue regardless of error.\x0d\n    }\x0d\n    if (parentSource) {\x0d\n      // TODO(joyeecheung): trim off internal frames from the stack.\x0d\n      reconstructErrorStack(err\x2C parentPath\x2C parentSource);\x0d\n    }\x0d\n  }\x0d\n  return err;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Built-in handler for `.js` files.\x0d\n * @param {Module} module The module to compile\x0d\n * @param {string} filename The file path of the module\x0d\n */\x0d\nModule._extensions['.js'] = function(module\x2C filename) {\x0d\n  let format\x2C pkg;\x0d\n  const tsEnabled = getOptionValue('--strip-types');\x0d\n  if (StringPrototypeEndsWith(filename\x2C '.cjs')) {\x0d\n    format = 'commonjs';\x