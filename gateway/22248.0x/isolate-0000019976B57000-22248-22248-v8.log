script-source,46,node:internal/process/warning,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayIsArray\x2C\x0d\n  Error\x2C\x0d\n  ErrorCaptureStackTrace\x2C\x0d\n  ErrorPrototypeToString\x2C\x0d\n  SafeSet\x2C\x0d\n  String\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  getOptionValue\x2C\x0d\n} = require('internal/options');\x0d\n\x0d\nconst assert = require('internal/assert');\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n  }\x2C\x0d\n  isErrorStackTraceLimitWritable\x2C\x0d\n} = require('internal/errors');\x0d\nconst { validateString } = require('internal/validators');\x0d\n\x0d\n// Lazily loaded\x0d\nlet fs;\x0d\nlet fd;\x0d\nlet warningFile;\x0d\nlet traceWarningHelperShown = false;\x0d\n\x0d\nfunction resetForSerialization() {\x0d\n  if (fd !== undefined) {\x0d\n    process.removeListener('exit'\x2C closeFdOnExit);\x0d\n  }\x0d\n  fd = undefined;\x0d\n  warningFile = undefined;\x0d\n  traceWarningHelperShown = false;\x0d\n}\x0d\n\x0d\nfunction lazyOption() {\x0d\n  // This will load `warningFile` only once. If the flag is not set\x2C\x0d\n  // `warningFile` will be set to an empty string.\x0d\n  if (warningFile === undefined) {\x0d\n    const diagnosticDir = getOptionValue('--diagnostic-dir');\x0d\n    const redirectWarnings = getOptionValue('--redirect-warnings');\x0d\n    warningFile = diagnosticDir || redirectWarnings || '';\x0d\n  }\x0d\n  return warningFile;\x0d\n}\x0d\n\x0d\n// If we can't write to stderr\x2C we'd like to make this a noop\x2C\x0d\n// so use console.error.\x0d\nlet error;\x0d\nfunction writeOut(message) {\x0d\n  error ??= require('internal/console/global').error;\x0d\n  error(message);\x0d\n}\x0d\n\x0d\nfunction closeFdOnExit() {\x0d\n  try {\x0d\n    fs.closeSync(fd);\x0d\n  } catch {\x0d\n    // Continue regardless of error.\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction writeToFile(message) {\x0d\n  if (fd === undefined) {\x0d\n    fs = require('fs');\x0d\n    try {\x0d\n      fd = fs.openSync(warningFile\x2C 'a');\x0d\n 