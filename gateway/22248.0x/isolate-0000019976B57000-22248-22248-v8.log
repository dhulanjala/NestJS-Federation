script-source,415,node:internal/http,'use strict';\x0d\n\x0d\nconst {\x0d\n  Date\x2C\x0d\n  Number\x2C\x0d\n  NumberParseInt\x2C\x0d\n  Symbol\x2C\x0d\n  decodeURIComponent\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst { setUnrefTimeout } = require('internal/timers');\x0d\nconst { getCategoryEnabledBuffer\x2C trace } = internalBinding('trace_events');\x0d\nconst {\x0d\n  CHAR_LOWERCASE_B\x2C\x0d\n  CHAR_LOWERCASE_E\x2C\x0d\n} = require('internal/constants');\x0d\n\x0d\nconst { URL } = require('internal/url');\x0d\nconst { Buffer } = require('buffer');\x0d\nconst { isIPv4 } = require('internal/net');\x0d\nconst { ERR_PROXY_INVALID_CONFIG } = require('internal/errors').codes;\x0d\nlet utcCache;\x0d\n\x0d\nfunction utcDate() {\x0d\n  if (!utcCache) cache();\x0d\n  return utcCache;\x0d\n}\x0d\n\x0d\nfunction cache() {\x0d\n  const d = new Date();\x0d\n  utcCache = d.toUTCString();\x0d\n  setUnrefTimeout(resetCache\x2C 1000 - d.getMilliseconds());\x0d\n}\x0d\n\x0d\nfunction resetCache() {\x0d\n  utcCache = undefined;\x0d\n}\x0d\n\x0d\nlet traceEventId = 0;\x0d\n\x0d\nfunction getNextTraceEventId() {\x0d\n  return ++traceEventId;\x0d\n}\x0d\n\x0d\nconst httpEnabled = getCategoryEnabledBuffer('node.http');\x0d\n\x0d\nfunction isTraceHTTPEnabled() {\x0d\n  return httpEnabled[0] > 0;\x0d\n}\x0d\n\x0d\nconst traceEventCategory = 'node\x2Cnode.http';\x0d\n\x0d\nfunction traceBegin(...args) {\x0d\n  trace(CHAR_LOWERCASE_B\x2C traceEventCategory\x2C ...args);\x0d\n}\x0d\n\x0d\nfunction traceEnd(...args) {\x0d\n  trace(CHAR_LOWERCASE_E\x2C traceEventCategory\x2C ...args);\x0d\n}\x0d\n\x0d\nfunction ipToInt(ip) {\x0d\n  const octets = ip.split('.');\x0d\n  let result = 0;\x0d\n  for (let i = 0; i < octets.length; i++) {\x0d\n    result = (result << 8) + NumberParseInt(octets[i]);\x0d\n  }\x0d\n  // Force unsigned 32-bit result\x0d\n  return result >>> 0;\x0d\n}\x0d\n\x0d\n// There are two factors in play when proxying the request:\x0d\n// 1. What the request protocol is\x2C that is\x2C whether users are sending it via\x0d\n//    http.request or https.request\x2C or whether they are sending\x0d\n//    the request to a https:// URL or a http:// URL. HTTPS requests should be\x0d\n//    proxied by the proxy specified using the HTTPS_PROXY environment variable.\x0d\n//    HTTP requests should be proxied by the proxy specified using the HTTP_PROXY\x0d\n//    environment variable.\x0d\n// 2. What the proxy protocol is. This depends on the value of the environment variables\x2C\x0d\n//    for example.\x0d\n//\x0d\n// When proxying a HTTP request\x2C the following needs to be done:\x0d\n// https://datatracker.ietf.org/doc/html/rfc7230#section-5.3.2\x0d\n// 1. Rewrite the request path to absolute-form.\x0d\n// 2. Add proxy-connection and proxy-authorization headers appropriately.\x0d\n//\x0d\n// When proxying a HTTPS request\x2C the following needs to be done:\x0d\n// https://datatracker.ietf.org/doc/html/rfc9110#CONNECT\x0d\n// 1. Send a CONNECT request to the proxy server.\x0d\n// 2. Wait for 200 connection established response to establish the tunnel.\x0d\n// 3. Perform TLS handshake with the endpoint through the tunnel.\x0d\n// 4. Tunnel the request using the established connection.\x0d\n//\x0d\n// When the proxy protocol is HTTP\x2C the modified HTTP request can just be sent over\x0d\n// the TCP socket to the proxy server\x2C and the HTTPS request tunnel can be established\x0d\n// over the TCP socket to the proxy server.\x0d\n// When the proxy protocol is HTTPS\x2C the modified request needs to be sent after\x0d\n// TLS handshake with the proxy server. Same goes to the HTTPS request tunnel establishment.\x0d\n\x0d\n/**\x0d\n * Represents the proxy configuration for an agent. The built-in http and https agent\x0d\n * implementation have one of this when they are configured to use a proxy.\x0d\n * @property {string} href - Full URL of the proxy server.\x0d\n * @property {string} protocol - Proxy protocol used to talk to the proxy server.\x0d\n * @property {string|undefined} auth - proxy-authorization header value\x2C if username or password is provided.\x0d\n * @property {Array<string>} bypassList - List of hosts to bypass the proxy.\x0d\n * @property {object} proxyConnectionOptions - Options for connecting to the proxy server.\x0d\n */\x0d\nclass ProxyConfig {\x0d\n  constructor(proxyUrl\x2C keepAlive\x2C noProxyList) {\x0d\n    let parsedURL;\x0d\n    try {\x0d\n      parsedURL = new URL(proxyUrl);\x0d\n    } catch {\x0d\n      throw new ERR_PROXY_INVALID_CONFIG(`Invalid proxy URL: ${proxyUrl}`);\x0d\n    }\x0d\n    const { hostname\x2C port\x2C protocol\x2C username\x2C password } = parsedURL;\x0d\n\x0d\n    this.href = proxyUrl;\x0d\n    this.protocol = protocol;\x0d\n\x0d\n    if (username || password) {\x0d\n      // If username or password is provided\x2C prepare the proxy-authorization header.\x0d\n      const auth = `${decodeURIComponent(username)}:${decodeURIComponent(password)}`;\x0d\n      this.auth = `Basic ${Buffer.from(auth).toString('base64')}`;\x0d\n    }\x0d\n    if (noProxyList) {\x0d\n      this.bypassList = noProxyList.split('\x2C').map((entry) => entry.trim().toLowerCase());\x0d\n    } else {\x0d\n      this.bypassList = []; // No bypass list provided.\x0d\n    }\x0d\n\x0d\n    this.proxyConnectionOptions = {\x0d\n      // The host name comes from parsed URL so if it starts with '[' it must be an IPv6 address\x0d\n      // ending with ']'. Remove the brackets for net.connect().\x0d\n      host: hostname[0] === '[' ? hostname.slice(1\x2C -1) : hostname\x2C\x0d\n      // The port comes from parsed URL so it is either '' or a valid number string.\x0d\n      port: port ? Number(port) : (protocol === 'https:' ? 443 : 80)\x2C\x0d\n    };\x0d\n  }\x0d\n\x0d\n  // See: https://about.gitlab.com/blog/we-need-to-talk-no-proxy\x0d\n  // TODO(joyeecheung): share code with undici.\x0d\n  shouldUseProxy(hostname\x2C port) {\x0d\n    const bypassList = this.bypassList;\x0d\n    if (this.bypassList.length === 0) {\x0d\n      return true; // No bypass list\x2C always use the proxy.\x0d\n    }\x0d\n\x0d\n    const host = hostname.toLowerCase();\x0d\n    const hostWithPort = port ? `${host}:${port}` : host;\x0d\n\x0d\n    for (let i = 0; i < bypassList.length; i++) {\x0d\n      const entry = bypassList[i];\x0d\n\x0d\n      if (entry === '*') return false;  // * bypasses all hosts.\x0d\n      if (entry === host || entry === hostWithPort) return false;  // Matching host and host:port\x0d\n\x0d\n      // Follow curl's behavior: strip leading dot before matching suffixes.\x0d\n      if (entry[0] === '.') {\x0d\n        const suffix = entry.substring(1);\x0d\n        if (host.endsWith(suffix)) return false;\x0d\n      }\x0d\n\x0d\n      // Handle wildcards like *.example.com\x0d\n      if (entry.startsWith('*.') && host.endsWith(entry.substring(1))) return false;\x0d\n\x0d\n      // Handle IP ranges (simple format like 192.168.1.0-192.168.1.255)\x0d\n      // TODO(joyeecheung): support IPv6.\x0d\n      if (entry.includes('-') && isIPv4(host)) {\x0d\n        let { 0: startIP\x2C 1: endIP } = entry.split('-');\x0d\n        startIP = startIP.trim();\x0d\n        endIP = endIP.trim();\x0d\n        if (startIP && endIP && isIPv4(startIP) && isIPv4(endIP)) {\x0d\n          const hostInt = ipToInt(host);\x0d\n          const startInt = ipToInt(startIP);\x0d\n          const endInt = ipToInt(endIP);\x0d\n          if (hostInt >= startInt && hostInt <= endInt) return false;\x0d\n        }\x0d\n      }\x0d\n\x0d\n      // It might be useful to support CIDR notation\x2C but it's not so widely supported\x0d\n      // in other tools as a de-facto standard to follow\x2C so we don't implement it for now.\x0d\n    }\x0d\n\x0d\n    return true; // If no matches found\x2C use the proxy.\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction parseProxyUrl(env\x2C protocol) {\x0d\n  // Get the proxy url - following the most popular convention\x2C lower case takes precedence.\x0d\n  // See https://about.gitlab.com/blog/we-need-to-talk-no-proxy/#http_proxy-and-https_proxy\x0d\n  const proxyUrl = (protocol === 'https:') ?\x0d\n    (env.https_proxy || env.HTTPS_PROXY) : (env.http_proxy || env.HTTP_PROXY);\x0d\n  // No proxy settings from the environment\x2C ignore.\x0d\n  if (!proxyUrl) {\x0d\n    return null;\x0d\n  }\x0d\n\x0d\n  if (proxyUrl.includes('\\r') || proxyUrl.includes('\\n')) {\x0d\n    throw new ERR_PROXY_INVALID_CONFIG(`Invalid proxy URL: ${proxyUrl}`);\x0d\n  }\x0d\n\x0d\n  return proxyUrl;\x0d\n}\x0d\n\x0d\nfunction parseProxyConfigFromEnv(env\x2C protocol\x2C keepAlive) {\x0d\n  // We only support proxying for HTTP and HTTPS requests.\x0d\n  if (protocol !== 'http:' && protocol !== 'https:') {\x0d\n    return null;\x0d\n  }\x0d\n\x0d\n  const proxyUrl = parseProxyUrl(env\x2C protocol);\x0d\n  if (proxyUrl === null) {\x0d\n    return null;\x0d\n  }\x0d\n\x0d\n  // Only http:// and https:// proxies are supported.\x0d\n  // Ignore instead of throw\x2C in case other protocols are supposed to be\x0d\n  // handled by the user land.\x0d\n  if (!proxyUrl.startsWith('http://') && !proxyUrl.startsWith('https://')) {\x0d\n    return null;\x0d\n  }\x0d\n\x0d\n  const noProxyList = env.no_proxy || env.NO_PROXY;\x0d\n  return new ProxyConfig(proxyUrl\x2C keepAlive\x2C noProxyList);\x0d\n}\x0d\n\x0d\n/**\x0d\n * @param {ProxyConfig} proxyConfig\x0d\n * @param {object} reqOptions\x0d\n * @returns {boolean}\x0d\n */\x0d\nfunction checkShouldUseProxy(proxyConfig\x2C reqOptions) {\x0d\n  if (!proxyConfig) {\x0d\n    return false;\x0d\n  }\x0d\n  if (reqOptions.socketPath) {\x0d\n    // If socketPath is set\x2C the endpoint is a Unix domain socket\x2C which can't\x0d\n    // be proxied.\x0d\n    return false;\x0d\n  }\x0d\n  return proxyConfig.shouldUseProxy(reqOptions.host || 'localhost'\x2C reqOptions.port);\x0d\n}\x0d\n\x0d\nfunction filterEnvForProxies(env) {\x0d\n  return {\x0d\n    __proto__: null\x2C\x0d\n    http_proxy: env.http_proxy\x2C\x0d\n    HTTP_PROXY: env.HTTP_PROXY\x2C\x0d\n    https_proxy: env.https_proxy\x2C\x0d\n    HTTPS_PROXY: env.HTTPS_PROXY\x2C\x0d\n    no_proxy: env.no_proxy\x2C\x0d\n    NO_PROXY: env.NO_PROXY\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\nfunction getGlobalAgent(proxyEnv\x2C Agent) {\x0d\n  return new Agent({\x0d\n    keepAlive: true\x2C scheduling: 'lifo'\x2C timeout: 5000\x2C\x0d\n    proxyEnv\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  kOutHeaders: Symbol('kOutHeaders')\x2C\x0d\n  kNeedDrain: Symbol('kNeedDrain')\x2C\x0d\n  kProxyConfig: Symbol('kProxyConfig')\x2C\x0d\n  kWaitForProxyTunnel: Symbol('kWaitForProxyTunnel')\x2C\x0d\n  checkShouldUseProxy\x2C\x0d\n  parseProxyConfigFromEnv\x2C\x0d\n  utcDate\x2C\x0d\n  traceBegin\x2C\x0d\n  traceEnd\x2C\x0d\n  getNextTraceEventId\x2C\x0d\n  isTraceHTTPEnabled\x2C\x0d\n  filterEnvForProxies\x2C\x0d\n  getGlobalAgent\x2C\x0d\n  parseProxyUrl\x2C\x0d\n};\x0d\n
