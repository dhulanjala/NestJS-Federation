\x0d\n  else\x0d\n    this.ca = undefined;\x0d\n\x0d\n  if (options.minVersion)\x0d\n    this.minVersion = options.minVersion;\x0d\n  else\x0d\n    this.minVersion = undefined;\x0d\n\x0d\n  if (options.maxVersion)\x0d\n    this.maxVersion = options.maxVersion;\x0d\n  else\x0d\n    this.maxVersion = undefined;\x0d\n\x0d\n  if (options.secureProtocol)\x0d\n    this.secureProtocol = options.secureProtocol;\x0d\n  else\x0d\n    this.secureProtocol = undefined;\x0d\n\x0d\n  if (options.crl)\x0d\n    this.crl = options.crl;\x0d\n  else\x0d\n    this.crl = undefined;\x0d\n\x0d\n  this.sigalgs = options.sigalgs;\x0d\n\x0d\n  if (options.ciphers)\x0d\n    this.ciphers = options.ciphers;\x0d\n  else\x0d\n    this.ciphers = undefined;\x0d\n\x0d\n  this.ecdhCurve = options.ecdhCurve;\x0d\n\x0d\n  if (options.dhparam)\x0d\n    this.dhparam = options.dhparam;\x0d\n  else\x0d\n    this.dhparam = undefined;\x0d\n\x0d\n  if (options.honorCipherOrder !== undefined)\x0d\n    this.honorCipherOrder = !!options.honorCipherOrder;\x0d\n  else\x0d\n    this.honorCipherOrder = true;\x0d\n\x0d\n  const secureOptions = options.secureOptions || 0;\x0d\n\x0d\n  if (secureOptions)\x0d\n    this.secureOptions = secureOptions;\x0d\n  else\x0d\n    this.secureOptions = undefined;\x0d\n\x0d\n  if (options.sessionIdContext) {\x0d\n    this.sessionIdContext = options.sessionIdContext;\x0d\n  } else {\x0d\n    this.sessionIdContext = crypto.createHash('sha1')\x0d\n      .update(process.argv.join(' '))\x0d\n      .digest('hex')\x0d\n      .slice(0\x2C 32);\x0d\n  }\x0d\n\x0d\n  if (options.sessionTimeout)\x0d\n    this.sessionTimeout = options.sessionTimeout;\x0d\n\x0d\n  if (options.ticketKeys)\x0d\n    this.ticketKeys = options.ticketKeys;\x0d\n\x0d\n  this.privateKeyIdentifier = options.privateKeyIdentifier;\x0d\n  this.privateKeyEngine = options.privateKeyEngine;\x0d\n\x0d\n  this._sharedCreds = tls.createSecureContext({\x0d\n    pfx: this.pfx\x2C\x0d\n    key: this.key\x2C\x0d\n    passphrase: this.passphrase\x2C\x0d\n    cert: this.cert\x2C\x0d\n    clientCertEngine: this.clientCertEngine\x2C\x0d\n    ca: this.ca\x2C\x0d\n    ciphers: this.ciphers\x2C\x0d\n    sigalgs: this.sigalgs\x2C\x0d\n    ecdhCurve: this.ecdhCurve\x2C\x0d\n    dhparam: this.dhparam\x2C\x0d\n    minVersion: this.minVersion\x2C\x0d\n    maxVersion: this.maxVersion\x2C\x0d\n    secureProtocol: this.secureProtocol\x2C\x0d\n    secureOptions: this.secureOptions\x2C\x0d\n    honorCipherOrder: this.honorCipherOrder\x2C\x0d\n    crl: this.crl\x2C\x0d\n    sessionIdContext: this.sessionIdContext\x2C\x0d\n    ticketKeys: this.ticketKeys\x2C\x0d\n    sessionTimeout: this.sessionTimeout\x2C\x0d\n    privateKeyIdentifier: this.privateKeyIdentifier\x2C\x0d\n    privateKeyEngine: this.privateKeyEngine\x2C\x0d\n  });\x0d\n};\x0d\n\x0d\n\x0d\nServer.prototype._getServerData = function() {\x0d\n  return {\x0d\n    ticketKeys: this.getTicketKeys().toString('hex')\x2C\x0d\n  };\x0d\n};\x0d\n\x0d\n\x0d\nServer.prototype._setServerData = function(data) {\x0d\n  this.setTicketKeys(Buffer.from(data.ticketKeys\x2C 'hex'));\x0d\n};\x0d\n\x0d\n\x0d\nServer.prototype.getTicketKeys = function getTicketKeys() {\x0d\n  return this._sharedCreds.context.getTicketKeys();\x0d\n};\x0d\n\x0d\n\x0d\nServer.prototype.setTicketKeys = function setTicketKeys(keys) {\x0d\n  validateBuffer(keys);\x0d\n  assert(keys.byteLength === 48\x2C\x0d\n         'Session ticket keys must be a 48-byte buffer');\x0d\n  this._sharedCreds.context.setTicketKeys(keys);\x0d\n};\x0d\n\x0d\n// SNI Contexts High-Level API\x0d\nServer.prototype.addContext = function(servername\x2C context) {\x0d\n  if (!servername) {\x0d\n    throw new ERR_TLS_REQUIRED_SERVER_NAME();\x0d\n  }\x0d\n\x0d\n  const re = new RegExp(`^${\x0d\n    servername\x0d\n      .replace(/([.^$+?\\-\\\\[\\]{}])/g\x2C '\\\\$1')\x0d\n      .replaceAll('*'\x2C '[^.]*')\x0d\n  }$`);\x0d\n\x0d\n  const secureContext =\x0d\n    context instanceof common.SecureContext ? context : tls.createSecureContext(context);\x0d\n  this._contexts.push([re\x2C secureContext.context]);\x0d\n};\x0d\n\x0d\nServer.prototype[EE.captureRejectionSymbol] = function(\x0d\n  err\x2C event\x2C sock) {\x0d\n\x0d\n  switch (event) {\x0d\n    case 'secureConnection':\x0d\n      sock.destroy(err);\x0d\n      break;\x0d\n    default:\x0d\n      FunctionPrototypeCall(net.Server.prototype[SymbolFor('nodejs.rejection')]\x2C this\x2C err\x2C event\x2C sock);\x0d\n  }\x0d\n};\x0d\n\x0d\nfunction SNICallback(servername\x2C callback) {\x0d\n  const contexts = this.server._contexts;\x0d\n\x0d\n  for (let i = contexts.length - 1; i >= 0; --i) {\x0d\n    const elem = contexts[i];\x0d\n    if (elem[0].test(servername)) {\x0d\n      callback(null\x2C elem[1]);\x0d\n      return;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  callback(null\x2C undefined);\x0d\n}\x0d\n\x0d\n\x0d\n// Target API:\x0d\n//\x0d\n//  let s = tls.connect({port: 8000\x2C host: "google.com"}\x2C function() {\x0d\n//    if (!s.authorized) {\x0d\n//      s.destroy();\x0d\n//      return;\x0d\n//    }\x0d\n//\x0d\n//    // s.socket;\x0d\n//\x0d\n//    s.end("hello world\\n");\x0d\n//  });\x0d\n//\x0d\n//\x0d\nfunction normalizeConnectArgs(listArgs) {\x0d\n  const args = net._normalizeArgs(listArgs);\x0d\n  const options = args[0];\x0d\n  const cb = args[1];\x0d\n\x0d\n  // If args[0] was options\x2C then normalize dealt with it.\x0d\n  // If args[0] is port\x2C or args[0]\x2C args[1] is host\x2C port\x2C we need to\x0d\n  // find the options and merge them in\x2C normalize's options has only\x0d\n  // the host/port/path args that it knows about\x2C not the tls options.\x0d\n  // This means that options.host overrides a host arg.\x0d\n  if (listArgs[1] !== null && typeof listArgs[1] === 'object') {\x0d\n    ObjectAssign(options\x2C listArgs[1]);\x0d\n  } else {\x0d\n    ObjectAssign(options\x2C listArgs[2]);\x0d\n  }\x0d\n\x0d\n  return cb ? [options\x2C cb] : [options];\x0d\n}\x0d\n\x0d\nfunction onConnectSecure() {\x0d\n  const options = this[kConnectOptions];\x0d\n\x0d\n  // Check the size of DHE parameter above minimum requirement\x0d\n  // specified in options.\x0d\n  const ekeyinfo = this.getEphemeralKeyInfo();\x0d\n  if (ekeyinfo.type === 'DH' && ekeyinfo.size < options.minDHSize) {\x0d\n    const err = new ERR_TLS_DH_PARAM_SIZE(ekeyinfo.size);\x0d\n    debug('client emit:'\x2C err);\x0d\n    this.emit('error'\x2C err);\x0d\n    this.destroy();\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  let verifyError = this._handle.verifyError();\x0d\n\x0d\n  // Verify that server's identity matches it's certificate's names\x0d\n  // Unless server has resumed our existing session\x0d\n  if (!verifyError && !this.isSessionReused()) {\x0d\n    const hostname = options.servername ||\x0d\n                   options.host ||\x0d\n                   (options.socket?._host) ||\x0d\n                   'localhost';\x0d\n    const cert = this.getPeerCertificate(true);\x0d\n    verifyError = options.checkServerIdentity(hostname\x2C cert);\x0d\n  }\x0d\n\x0d\n  if (verifyError) {\x0d\n    this.authorized = false;\x0d\n    this.authorizationError = verifyError.code || verifyError.message;\x0d\n\x0d\n    // rejectUnauthorized property can be explicitly defined as `undefined`\x0d\n    // causing the assignment to default value (`true`) fail. Before assigning\x0d\n    // it to the tlssock connection options\x2C explicitly check if it is false\x0d\n    // and update rejectUnauthorized property. The property gets used by\x0d\n    // TLSSocket connection handler to allow or reject connection if\x0d\n    // unauthorized.\x0d\n    // This check is potentially redundant\x2C however it is better to keep it\x0d\n    // in case the option object gets modified somewhere.\x0d\n    if (options.rejectUnauthorized !== false) {\x0d\n      this.destroy(verifyError);\x0d\n      return;\x0d\n    }\x0d\n    debug('client emit secureConnect. rejectUnauthorized: %s\x2C ' +\x0d\n          'authorizationError: %s'\x2C options.rejectUnauthorized\x2C\x0d\n          this.authorizationError);\x0d\n  } else {\x0d\n    this.authorized = true;\x0d\n    debug('client emit secureConnect. authorized:'\x2C this.authorized);\x0d\n  }\x0d\n  this.secureConnecting = false;\x0d\n  this.emit('secureConnect');\x0d\n\x0d\n  this[kIsVerified] = true;\x0d\n  const session = this[kPendingSession];\x0d\n  this[kPendingSession] = null;\x0d\n  if (session)\x0d\n    this.emit('session'\x2C session);\x0d\n\x0d\n  this.removeListener('end'\x2C onConnectEnd);\x0d\n}\x0d\n\x0d\nfunction onConnectEnd() {\x0d\n  // NOTE: This logic is shared with _http_client.js\x0d\n  if (!this._hadError) {\x0d\n    const options = this[kConnectOptions];\x0d\n    this._hadError = true;\x0d\n    const error = new ConnResetException('Client network socket disconnected ' +\x0d\n                                         'before secure TLS connection was ' +\x0d\n                                         'established');\x0d\n    error.path = options.path;\x0d\n    error.host = options.host;\x0d\n    error.port = options.port;\x0d\n    error.localAddress = options.localAddress;\x0d\n    this.destroy(error);\x0d\n  }\x0d\n}\x0d\n\x0d\n// Arguments: [port\x2C] [host\x2C] [options\x2C] [cb]\x0d\nexports.connect = function connect(...args) {\x0d\n  args = normalizeConnectArgs(args);\x0d\n  let options = args[0];\x0d\n  const cb = args[1];\x0d\n  const allowUnauthorized = getAllowUnauthorized();\x0d\n\x0d\n  options = {\x0d\n    rejectUnauthorized: !allowUnauthorized\x2C\x0d\n    ciphers: tls.DEFAULT_CIPHERS\x2C\x0d\n    checkServerIdentity: tls.checkServerIdentity\x2C\x0d\n    minDHSize: 1024\x2C\x0d\n    ...options\x2C\x0d\n  };\x0d\n\x0d\n  if (!options.keepAlive)\x0d\n    options.singleUse = true;\x0d\n\x0d\n  validateFunction(options.checkServerIdentity\x2C 'options.checkServerIdentity');\x0d\n  validateNumber(options.minDHSize\x2C 'options.minDHSize'\x2C 1);\x0d\n\x0d\n  const context = options.secureContext || tls.createSecureContext(options);\x0d\n\x0d\n  const tlssock = new TLSSocket(options.socket\x2C {\x0d\n    allowHalfOpen: options.allowHalfOpen\x2C\x0d\n    pipe: !!options.path\x2C\x0d\n    secureContext: context\x2C\x0d\n    isServer: false\x2C\x0d\n    requestCert: true\x2C\x0d\n    rejectUnauthorized: options.rejectUnauthorized !== false\x2C\x0d\n    session: options.session\x2C\x0d\n    ALPNProtocols: options.ALPNProtocols\x2C\x0d\n    requestOCSP: options.requestOCSP\x2C\x0d\n    enableTrace: options.enableTrace\x2C\x0d\n    pskCallback: options.pskCallback\x2C\x0d\n    highWaterMark: options.highWaterMark\x2C\x0d\n    onread: options.onread\x2C\x0d\n    signal: options.signal\x2C\x0d\n    noDelay: options.noDelay\x2C\x0d\n    keepAlive: options.keepAlive\x2C\x0d\n    keepAliveInitialDelay: options.keepAliveInitialDelay\x2C\x0d\n  });\x0d\n\x0d\n  // rejectUnauthorized property can be explicitly defined as `undefined`\x0d\n  // causing the assignment to default value (`true`) fail. Before assigning\x0d\n  // it to the tlssock connection options\x2C explicitly check if it is false\x0d\n  // and update rejectUnauthorized property. The property gets used by TLSSocket\x0d\n  // connection handler to allow or reject connection if unauthorized\x0d\n  options.rejectUnauthorized = options.rejectUnauthorized !== false;\x0d\n\x0d\n  tlssock[kConnectOptions] = options;\x0d\n\x0d\n  if (cb)\x0d\n    tlssock.once('secureConnect'\x2C cb);\x0d\n\x0d\n  if (!options.socket) {\x0d\n    // If user provided the socket\x2C it's their responsibility to manage its\x0d\n    // connectivity. If we created one internally\x2C we connect it.\x0d\n    if (options.timeout) {\x0d\n      tlssock.setTimeout(options.timeout);\x0d\n    }\x0d\n\x0d\n    tlssock.connect(options\x2C tlssock._start);\x0d\n  }\x0d\n\x0d\n  tlssock._releaseControl();\x0d\n\x0d\n  if (options.session)\x0d\n    tlssock.setSession(options.session);\x0d\n\x0d\n  if (options.servername) {\x0d\n    if (!ipServernameWarned && net.isIP(options.servername)) {\x0d\n      proces