x0d\n */\x0d\nfunction populateCJSExportsFromESM(mod\x2C wrap\x2C namespace) {\x0d\n  // Tooling in the ecosystem have been using the __esModule property to recognize\x0d\n  // transpiled ESM in consuming code. For example\x2C a 'log' package written in ESM:\x0d\n  //\x0d\n  // export default function log(val) { console.log(val); }\x0d\n  //\x0d\n  // Can be transpiled as:\x0d\n  //\x0d\n  // exports.__esModule = true;\x0d\n  // exports.default = function log(val) { console.log(val); }\x0d\n  //\x0d\n  // The consuming code may be written like this in ESM:\x0d\n  //\x0d\n  // import log from 'log'\x0d\n  //\x0d\n  // Which gets transpiled to:\x0d\n  //\x0d\n  // const _mod = require('log');\x0d\n  // const log = _mod.__esModule ? _mod.default : _mod;\x0d\n  //\x0d\n  // So to allow transpiled consuming code to recognize require()'d real ESM\x0d\n  // as ESM and pick up the default exports\x2C we add a __esModule property by\x0d\n  // building a source text module facade for any module that has a default\x0d\n  // export and add .__esModule = true to the exports. This maintains the\x0d\n  // enumerability of the re-exported names and the live binding of the exports\x2C\x0d\n  // without incurring a non-trivial per-access overhead on the exports.\x0d\n  //\x0d\n  // The source of the facade is defined as a constant per-isolate property\x0d\n  // required_module_default_facade_source_string\x2C which looks like this\x0d\n  //\x0d\n  // export * from 'original';\x0d\n  // export { default } from 'original';\x0d\n  // export const __esModule = true;\x0d\n  //\x0d\n  // And the 'original' module request is always resolved by\x0d\n  // createRequiredModuleFacade() to `wrap` which is a ModuleWrap wrapping\x0d\n  // over the original module.\x0d\n\x0d\n  // We don't do this to modules that are marked as CJS ESM or that\x0d\n  // don't have default exports to avoid the unnecessary overhead.\x0d\n  // If __esModule is already defined\x2C we will also skip the extension\x0d\n  