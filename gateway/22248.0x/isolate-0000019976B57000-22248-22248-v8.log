script-source,1022,C:\\development\\NestJS Federation\\gateway\\node_modules\\@npmcli\\agent\\lib\\index.js,'use strict'\n\nconst { LRUCache } = require('lru-cache')\nconst { normalizeOptions\x2C cacheOptions } = require('./options')\nconst { getProxy\x2C proxyCache } = require('./proxy.js')\nconst dns = require('./dns.js')\nconst Agent = require('./agents.js')\n\nconst agentCache = new LRUCache({ max: 20 })\n\nconst getAgent = (url\x2C { agent\x2C proxy\x2C noProxy\x2C ...options } = {}) => {\n  // false has meaning so this can't be a simple truthiness check\n  if (agent != null) {\n    return agent\n  }\n\n  url = new URL(url)\n\n  const proxyForUrl = getProxy(url\x2C { proxy\x2C noProxy })\n  const normalizedOptions = {\n    ...normalizeOptions(options)\x2C\n    proxy: proxyForUrl\x2C\n  }\n\n  const cacheKey = cacheOptions({\n    ...normalizedOptions\x2C\n    secureEndpoint: url.protocol === 'https:'\x2C\n  })\n\n  if (agentCache.has(cacheKey)) {\n    return agentCache.get(cacheKey)\n  }\n\n  const newAgent = new Agent(normalizedOptions)\n  agentCache.set(cacheKey\x2C newAgent)\n\n  return newAgent\n}\n\nmodule.exports = {\n  getAgent\x2C\n  Agent\x2C\n  // these are exported for backwards compatability\n  HttpAgent: Agent\x2C\n  HttpsAgent: Agent\x2C\n  cache: {\n    proxy: proxyCache\x2C\n    agent: agentCache\x2C\n    dns: dns.cache\x2C\n    clear: () => {\n      proxyCache.clear()\n      agentCache.clear()\n      dns.cache.clear()\n    }\x2C\n  }\x2C\n}\n
