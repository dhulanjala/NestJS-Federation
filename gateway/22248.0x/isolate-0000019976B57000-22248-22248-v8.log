nds Error` and call\x0d\n// `super()` to construct an object. The `super` in `super()` call in the constructor will\x0d\n// be resolved to `Function`\x2C instead of `Error`. Use the trick of return overriding to\x0d\n// create an object with the `[[ErrorData]]` internal slot.\x0d\n// Ref: https://tc39.es/ecma262/multipage/ecmascript-language-expressions.html#sec-getsuperconstructor\x0d\nclass DOMException {\x0d\n  constructor(message = ''\x2C options = 'Error') {\x0d\n    // Invokes the Error constructor to create an object with the [[ErrorData]]\x0d\n    // internal slot.\x0d\n    // eslint-disable-next-line no-restricted-syntax\x0d\n    const self = new Error();\x0d\n    // Use `new.target.prototype` to support DOMException subclasses.\x0d\n    ObjectSetPrototypeOf(self\x2C new.target.prototype);\x0d\n    self[transfer_mode_private_symbol] = kCloneable;\x0d\n\x0d\n    if (options && typeof options === 'object') {\x0d\n      const { name } = options;\x0d\n      internalsMap.set(self\x2C {\x0d\n        message: `${message}`\x2C\x0d\n        name: `${name}`\x2C\x0d\n      });\x0d\n\x0d\n      if ('cause' in options) {\x0d\n        ObjectDefineProperty(self\x2C 'cause'\x2C {\x0d\n          __proto__: null\x2C\x0d\n          value: options.cause\x2C\x0d\n          configurable: true\x2C\x0d\n          writable: true\x2C\x0d\n          enumerable: false\x2C\x0d\n        });\x0d\n      }\x0d\n    } else {\x0d\n      internalsMap.set(self\x2C {\x0d\n        message: `${message}`\x2C\x0d\n        name: `${options}`\x2C\x0d\n      });\x0d\n    }\x0d\n    // Return the error object as the return overriding of the constructor.\x0d\n    // eslint-disable-next-line no-constructor-return\x0d\n    return self;\x0d\n  }\x0d\n\x0d\n  [messaging_clone_symbol]() {\x0d\n    // See serialization steps in https://webidl.spec.whatwg.org/#dom-domexception-domexception\x0d\n    const internals = internalsMap.get(this);\x0d\n    return {\x0d\n      data: {\x0d\n        message: internals.message\x2C\x0d\n        name: internals.name\x2C\x0d\n        stack: this.stack\x2C\x0d\n      }\x2C\x0d\n      deserializeInfo: 'internal/worker/clone_dom_exception:DOMException'\x2C\x0d\n    };\x0d\n  }\x0d\n\x0d\n  [messaging_deserialize_symbol](data) {\x0d\n    // See deserialization steps in https://webidl.spec.whatwg.org/#dom-domexception-domexception\x0d\n    internalsMap.set(this\x2C {\x0d\n      message: data.message\x2C\x0d\n      name: data.name\x2C\x0d\n    });\x0d\n    this.stack = data.stack;\x0d\n  }\x0d\n\x0d\n  get name() {\x0d\n    const internals = internalsMap.get(this);\x0d\n    if (internals === undefined) {\x0d\n      throwInvalidThisError(TypeError\x2C 'DOMException');\x0d\n    }\x0d\n    return internals.name;\x0d\n  }\x0d\n\x0d\n  get message() {\x0d\n    const internals = internalsMap.get(this);\x0d\n    if (internals === undefined) {\x0d\n      throwInvalidThisError(TypeError\x2C 'DOMException');\x0d\n    }\x0d\n    return internals.message;\x0d\n  }\x0d\n\x0d\n  get code() {\x0d\n    const internals = internalsMap.get(this);\x0d\n    if (internals === undefined) {\x0d\n      throwInvalidThisError(TypeError\x2C 'DOMException');\x0d\n    }\x0d\n\x0d\n    if (disusedNamesSet.has(internals.name)) {\x0d\n      return 0;\x0d\n    }\x0d\n\x0d\n    const code = nameToCodeMap.get(internals.name);\x0d\n    return code === undefined ? 0 : code;\x0d\n  }\x0d\n}\x0d\n\x0d\nconst DOMExceptionPrototype = DOMException.prototype;\x0d\nObjectSetPrototypeOf(DOMExceptionPrototype\x2C ErrorPrototype);\x0d\nObjectDefineProperties(DOMExceptionPrototype\x2C {\x0d\n  [SymbolToStringTag]: { __proto__: null\x2C configurable: true\x2C value: 'DOMException' }\x2C\x0d\n  name: { __proto__: null\x2C enumerable: true\x2C configurable: true }\x2C\x0d\n  message: { __proto__: null\x2C enumerable: true\x2C configurable: true }\x2C\x0d\n  code: { __proto__: null\x2C enumerable: true\x2C configurable: true }\x2C\x0d\n});\x0d\n\x0d\nfor (const { 0: name\x2C 1: codeName\x2C 2: value } of [\x0d\n  ['IndexSizeError'\x2C 'INDEX_SIZE_ERR'\x2C 1]\x2C\x0d\n  ['DOMStringSizeError'\x2C 'DOMSTRING_SIZE_ERR'\x2C 2]\x2C\x0d\n  ['HierarchyRequestError'\x2C 'HIERARCHY_REQUEST_ERR'\x2C 3]\x2C\x0d\n  ['WrongDocumentError'\x2C 'WRONG_DOCUMENT_ERR'\x2C 4]\x2C\x0d\n  ['InvalidCharacterError'\x2C 'INVALID_CHARACTER_ERR'\x2C 5]\x2C\x0d\n  ['NoDataAllowedError'\x2C 'NO_DATA_ALLOWED_ERR'\x2C 6]\x2C\x0d\n  ['NoModificationAllowedError'\x2C 'NO_MODIFICATION_ALLOWED_ERR'\x2C 7]\x2C\x0d\n  ['NotFoundError'\x2C 'NOT_FOUND_ERR'\x2C 8]\x2C\x0d\n  ['NotSupportedError'\x2C 'NOT_SUPPORTED_ERR'\x2C 9]\x2C\x0d\n  ['InUseAttributeError'\x2C 'INUSE_ATTRIBUTE_ERR'\x2C 10]\x2C\x0d\n  ['InvalidStateError'\x2C 'INVALID_STATE_ERR'\x2C 11]\x2C\x0d\n  ['SyntaxError'\x2C 'SYNTAX_ERR'\x2C 12]\x2C\x0d\n  ['InvalidModificationError'\x2C 'INVALID_MODIFICATION_ERR'\x2C 13]\x2C\x0d\n  ['NamespaceError'\x2C 'NAMESPACE_ERR'\x2C 14]\x2C\x0d\n  ['InvalidAccessError'\x2C 'INVALID_ACCESS_ERR'\x2C 15]\x2C\x0d\n  ['ValidationError'\x2C 'VALIDATION_ERR'\x2C 16]\x2C\x0d\n  ['TypeMismatchError'\x2C 'TYPE_MISMATCH_ERR'\x2C 17]\x2C\x0d\n  ['SecurityError'\x2C 'SECURITY_ERR'\x2C 18]\x2C\x0d\n  ['NetworkError'\x2C 'NETWORK_ERR'\x2C 19]\x2C\x0d\n  ['AbortError'\x2C 'ABORT_ERR'\x2C 20]\x2C\x0d\n  ['URLMismatchError'\x2C 'URL_MISMATCH_ERR'\x2C 21]\x2C\x0d\n  ['QuotaExceededError'\x2C 'QUOTA_EXCEEDED_ERR'\x2C 22]\x2C\x0d\n  ['TimeoutError'\x2C 'TIMEOUT_ERR'\x2C 23]\x2C\x0d\n  ['InvalidNodeTypeError'\x2C 'INVALID_NODE_TYPE_ERR'\x2C 24]\x2C\x0d\n  ['DataCloneError'\x2C 'DATA_CLONE_ERR'\x2C 25]\x2C\x0d\n  // There are some more error names\x2C but since they don't have codes assigned\x2C\x0d\n  // we don't need to care about them.\x0d\n]) {\x0d\n  const desc = { enumerable: true\x2C value };\x0d\n  ObjectDefineProperty(DOMException\x2C codeName\x2C desc);\x0d\n  ObjectDefineProperty(DOMExceptionPrototype\x2C codeName\x2C desc);\x0d\n  nameToCodeMap.set(name\x2C value);\x0d\n}\x0d\n\x0d\nexports.DOMException 