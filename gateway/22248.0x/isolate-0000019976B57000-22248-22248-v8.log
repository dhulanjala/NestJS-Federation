script-source,294,C:\\development\\NestJS Federation\\gateway\\node_modules\\graphql\\validation\\rules\\OverlappingFieldsCanBeMergedRule.js,'use strict';\n\nObject.defineProperty(exports\x2C '__esModule'\x2C {\n  value: true\x2C\n});\nexports.OverlappingFieldsCanBeMergedRule = OverlappingFieldsCanBeMergedRule;\n\nvar _inspect = require('../../jsutils/inspect.js');\n\nvar _GraphQLError = require('../../error/GraphQLError.js');\n\nvar _kinds = require('../../language/kinds.js');\n\nvar _printer = require('../../language/printer.js');\n\nvar _definition = require('../../type/definition.js');\n\nvar _sortValueNode = require('../../utilities/sortValueNode.js');\n\nvar _typeFromAST = require('../../utilities/typeFromAST.js');\n\n/** @category Validation Rules */\nfunction reasonMessage(reason) {\n  if (Array.isArray(reason)) {\n    return reason\n      .map(\n        ([responseName\x2C subReason]) =>\n          `subfields "${responseName}" conflict because ` +\n          reasonMessage(subReason)\x2C\n      )\n      .join(' and ');\n  }\n\n  return reason;\n}\n/**\n * Overlapping fields can be merged\n *\n * A selection set is only valid if all fields (including spreading any\n * fragments) either correspond to distinct response names or can be merged\n * without ambiguity.\n *\n * See https://spec.graphql.org/draft/#sec-Field-Selection-Merging\n * @param context - The validation context used while checking the document.\n * @returns A visitor that reports validation errors for this rule.\n * @example\n * ```ts\n * import { buildSchema\x2C parse\x2C validate } from 'graphql';\n * import { OverlappingFieldsCanBeMergedRule } from 'graphql/validation';\n *\n * const schema = buildSchema(`\n *   type Query {\n *     dog: Dog\n *   }\n *\n *   type Dog {\n *     name: String\n *     barkVolume: Int\n *   }\n * `);\n *\n * const invalidDocument = parse(`\n *   { dog { value: barkVolume value: name } }\n * `);\n * const invalidErrors = validate(schema\x2C invalidDocument\x2C [OverlappingFieldsCanBeMergedRule]);\n *\n * invalidErrors.length; // => 1\n *\n * const validDocument = parse(`\n *   { dog { barkVolume name } }\n * `);\n * const validErrors = validate(schema\x2C validDocument\x2C [OverlappingFieldsCanBeMergedRule]);\n *\n * validErrors; // => []\n * ```\n */\n\nfunction OverlappingFieldsCanBeMergedRule(context) {\n  // A memoization for when fields and a fragment or two fragments are compared\n  // "between" each other for conflicts. Comparisons made be made many times\x2C\n  // so memoizing this can dramatically improve the performance of this validator.\n  const comparedFieldsAndFragmentPairs = new OrderedPairSet();\n  const comparedFragmentPairs = new PairSet(); // A cache for the "field map" and list of fragment names found in any given\n  // selection set. Selection sets may be asked for this information multiple\n  // times\x2C so this improves the performance of this validator.\n\n  const cachedFieldsAndFragmentNames = new Map();\n  return {\n    SelectionSet(selectionSet) {\n      const conflicts = findConflictsWithinSelectionSet(\n        context\x2C\n        cachedFieldsAndFragmentNames\x2C\n        comparedFieldsAndFragmentPairs\x2C\n        comparedFragmentPairs\x2C\n        context.getParentType()\x2C\n        selectionSet\x2C\n      );\n\n      for (const [[responseName\x2C reason]\x2C fields1\x2C fields2] of conflicts) {\n        const reasonMsg = reasonMessage(reason);\n        context.reportError(\n          new _GraphQLError.GraphQLError(\n            `Fields "${responseName}" conflict because ${reasonMsg}. Use different aliases on the fields to fetch both if this was intentional.`\x2C\n            {\n              nodes: fields1.concat(fields2)\x2C\n            }\x2C\n          )\x2C\n        );\n      }\n    }\x2C\n  };\n}\n\n/**\n * Find all conflicts found "within" a selection set\x2C including those found\n * via spreading in fragments. Called when visiting each SelectionSet in the\n * GraphQL Document.\n *\n * Algorithm:\n *\n * Conflicts occur when two fields exist in a query which will produce the same\n * response name\x2C but represent differing values\x2C thus creating a conflict.\n * The algorithm below finds all conflicts via making a series of comparisons\n * between fields. In order to compare as few fields as possible\x2C this makes\n * a series of comparisons "within" sets of fields and "between" sets of fields.\n *\n * Given any selection set\x2C a collection produces both a set of fields by\n * also including all inline fragments\x2C as well as a list of fragments\n * referenced by fragment spreads.\n *\n * A) Each selection set represented in the document first compares "within" its\n * collected set of fields\x2C finding any conflicts between every pair of\n * overlapping fields.\n * Note: This is the *only time* that the fields "within" a set are compared\n * to each other. After this only fields "between" sets are compared.\n *\n * B) Also\x2C if any fragment is referenced in a selection set\x2C then a\n * comparison is made "between" the original set of fields and the\n * referenced fragment.\n *\n * C) Also\x2C if multiple fragments are referenced\x2C then comparisons\n * are made "between" each referenced fragment.\n *\n * D) When comparing "between" a set of fields and a referenced fragment\x2C first\n * a comparison is made between each field in the original set of fields and\n * each field in the referenced set of fields.\n *\n * E) Also\x2C if any fragment is referenced in the referenced selection set\x2C\n * then a comparison is made "between" the original set of fields and the\n * referenced fragment (recursively referring to step D).\n *\n * F) When comparing "between" two fragments\x2C first a comparison is made between\n * each field in the first referenced set of fields and each field in the\n * second referenced set of fields.\n *\n * G) Also\x2C any fragments referenced by the first must be compared to the\n * second\x2C and any fragments referenced by the second must be compared to the\n * first (recursively referring to step F).\n *\n * H) When comparing two fields\x2C if both have selection sets\x2C then a comparison\n * is made "between" both selection sets\x2C first comparing the set of fields in\n * the first selection set with the set of fields in the second.\n *\n * I) Also\x2C if any fragment is referenced in either selection set\x2C then a\n * comparison is made "between" the other set of fields and the\n * referenced fragment.\n *\n * J) Also\x2C if two fragments are referenced in both selection sets\x2C then a\n * comparison is made "between" the two fragments.\n *\n * @internal\n */\nfunction findConflictsWithinSelectionSet(\n  context\x2C\n  cachedFieldsAndFragmentNames\x2C\n  comparedFieldsAndFragmentPairs\x2C\n  comparedFragmentPairs\x2C\n  parentType\x2C\n  selectionSet\x2C\n) {\n  const conflicts = [];\n  const [fieldMap\x2C fragmentNames] = getFieldsAndFragmentNames(\n    context\x2C\n    cachedFieldsAndFragmentNames\x2C\n    parentType\x2C\n    selectionSet\x2C\n  ); // (A) Find find all conflicts "within" the fields of this selection set.\n  // Note: this is the *only place* `collectConflictsWithin` is called.\n\n  collectConflictsWithin(\n    context\x2C\n    conflicts\x2C\n    cachedFieldsAndFragmentNames\x2C\n    comparedFieldsAndFragmentPairs\x2C\n    comparedFragmentPairs\x2C\n    fieldMap\x2C\n  );\n\n  if (fragmentNames.length !== 0) {\n    // (B) Then collect conflicts between these fields and those represented by\n    // each spread fragment name found.\n    for (let i = 0; i < fragmentNames.length; i++) {\n      collectConflictsBetweenFieldsAndFragment(\n        context\x2C\n        conflicts\x2C\n        cachedFieldsAndFragmentNames\x2C\n        comparedFieldsAndFragmentPairs\x2C\n        comparedFragmentPairs\x2C\n        false\x2C\n        fieldMap\x2C\n        fragmentNames[i]\x2C\n      ); // (C) Then compare this fragment with all other fragments found in this\n      // selection set to collect conflicts between fragments spread together.\n      // This compares each item in the list of fragment names to every other\n      // item in that same list (except for itself).\n\n      for (let j = i + 1; j < fragmentNames.length; j++) {\n        collectConflictsBetweenFragments(\n          context\x2C\n          conflicts\x2C\n          cachedFieldsAndFragmentNames\x2C\n          comparedFieldsAndFragmentPairs\x2C\n          comparedFragmentPairs\x2C\n          false\x2C\n          fragmentNames[i]\x2C\n          fragmentNames[j]\x2C\n        );\n      }\n    }\n  }\n\n  return conflicts;\n} // Collect all conflicts found between a set of fields and a fragment reference\n// including via spreading in any nested fragments.\n\nfunction collectConflictsBetweenFieldsAndFragment(\n  context\x2C\n  conflicts\x2C\n  cachedFieldsAndFragmentNames\x2C\n  comparedFieldsAndFragmentPairs\x2C\n  comparedFragmentPairs\x2C\n  areMutuallyExclusive\x2C\n  fieldMap\x2C\n  fragmentName\x2C\n) {\n  // Memoize so the fields and fragments are not compared for conflicts more\n  // than once.\n  if (\n    comparedFieldsAndFragmentPairs.has(\n      fieldMap\x2C\n      fragmentName\x2C\n      areMutuallyExclusive\x2C\n    )\n  ) {\n    return;\n  }\n\n  comparedFieldsAndFragmentPairs.add(\n    fieldMap\x2C\n    fragmentName\x2C\n    areMutuallyExclusive\x2C\n  );\n  const fragment = context.getFragment(fragmentName);\n\n  if (!fragment) {\n    return;\n  }\n\n  const [fieldMap2\x2C referencedFragmentNames] =\n    getReferencedFieldsAndFragmentNames(\n      context\x2C\n      cachedFieldsAndFragmentNames\x2C\n      fragment\x2C\n    ); // Do not compare a fragment's fieldMap to itself.\n\n  if (fieldMap === fieldMap2) {\n    return;\n  } // (D) First collect any conflicts between the provided collection of fields\n  // and the collection of fields represented by the given fragment.\n\n  collectConflictsBetween(\n    context\x2C\n    conflicts\x2C\n    cachedFieldsAndFragmentNames\x2C\n    comparedFieldsAndFragmentPairs\x2C\n    comparedFragmentPairs\x2C\n    areMutuallyExclusive\x2C\n    fieldMap\x2C\n    fieldMap2\x2C\n  ); // (E) Then collect any conflicts between the provided collection of fields\n  // and any fragment names found in the given fragment.\n\n  for (const referencedFragmentName of referencedFragmentNames) {\n    collectConflictsBetweenFieldsAndFragment(\n      context\x2C\n      conflicts\x2C\n      cachedFieldsAndFragmentNames\x2C\n      comparedFieldsAndFragmentPairs\x2C\n      comparedFragmentPairs\x2C\n      areMutuallyExclusive\x2C\n      fieldMap\x2C\n      referencedFragmentName\x2C\n    );\n  }\n} // Collect all conflicts found between two fragments\x2C including via spreading in\n// any nested fragments.\n\nfunction collectConflictsBetweenFragments(\n  context\x2C\n  conflicts\x2C\n  cachedFieldsAndFragmentNames\x2C\n  comparedFieldsAndFragmentPairs\x2C\n  comparedFragmentPairs\x2C\n  areMutuallyExclusive\x2C\n  fragmentName1\x2C\n  fragmentName2\x2C\n) {\n  // No need to compare a fragment to itself.\n  if (fragmentName1 === fragmentName2) {\n    return;\n  } // Memoize so two fragments are not compared for conflicts more than once.\n\n  if (\n    comparedFragmentPairs.has(\n      fragmentName1\x2C\n      fragmentName2\x2C\n      areMutuallyExclusive\x2C\n    )\n  ) {\n    return;\n  }\n\n  comparedFragmentPairs.add(fragmentName1\x2C fragmentName2\x2C areMutuallyExclusive);\n  const fragment1 = context.getFragment(fragmentName1);\n  const fragment2 = context.getFragment(fragmentName2);\n\n  if (!fragment1 || !fragment2) {\n    return;\n  }\n\n  const [fieldMap1\x2C referencedFragmentNames1] =\n    getReferencedFieldsAndFragmentNames(\n      context\x2C\n      cachedFieldsAndFragmentNames\x2C\n      fragment1\x2C\n    );\n  const [fieldMap2\x2C referencedFragmentNames2] =\n    getReferencedFieldsAndFragmentNames(\n      context\x2C\n      cachedFieldsAndFragmentNames\x2C\n      fragment2\x2C\n    ); // (F) First\x2C collect all conflicts between these two collections of fields\n  // (not including any nested fragments).\n\n  collectConflictsBetween(\n    context\x2C\n    conflicts\x2C\n    cachedFieldsAndFragmentNames\x2C\n    comparedFieldsAndFragmentPairs\x2C\n    comparedFragmentPairs\x2C\n    areMutuallyExclusive\x2C\n    fieldMap1\x2C\n    fieldMap2\x2C\n  ); // (G) Then collect conflicts between the first fragment and any nested\n  // fragments spread in the second fragment.\n\n  for (const referencedFragmentName2 of referencedFragmentNames2) {\n    collectConflictsBetweenFragments(\n      context\x2C\n      conflicts\x2C\n      cachedFieldsAndFragmentNames\x2C\n      comparedFieldsAndFragmentPairs\x2C\n      comparedFragmentPairs\x2C\n      areMutuallyExclusive\x2C\n      fragmentName1\x2C\n      referencedFragmentName2\x2C\n    );\n  } // (G) Then collect conflicts between the second fragment and any nested\n  // fragments spread in the first fragment.\n\n  for (const referencedFragmentName1 of referencedFragmentNames1) {\n    collectConflictsBetweenFragments(\n      context\x2C\n      conflicts\x2C\n      cachedFieldsAndFragmentNames\x2C\n      comparedFieldsAndFragmentPairs\x2C\n      comparedFragmentPairs\x2C\n      areMutuallyExclusive\x2C\n      referencedFragmentName1\x2C\n      fragmentName2\x2C\n    );\n  }\n} // Find all conflicts found between two selection sets\x2C including those found\n// via spreading in fragments. Called when determining if conflicts exist\n// between the sub-fields of two overlapping fields.\n\nfunction findConflictsBetweenSubSelectionSets(\n  context\x2C\n  cachedFieldsAndFragmentNames\x2C\n  comparedFieldsAndFragmentPairs\x2C\n  comparedFragmentPairs\x2C\n  areMutuallyExclusive\x2C\n  parentType1\x2C\n  selectionSet1\x2C\n  parentType2\x2C\n  selectionSet2\x2C\n) {\n  const conflicts = [];\n  const [fieldMap1\x2C fragmentNames1] = getFieldsAndFragmentNames(\n    context\x2C\n    cachedFieldsAndFragmentNames\x2C