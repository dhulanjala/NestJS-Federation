script-source,430,node:https,// Copyright Joyent\x2C Inc. and other Node contributors.\x0d\n//\x0d\n// Permission is hereby granted\x2C free of charge\x2C to any person obtaining a\x0d\n// copy of this software and associated documentation files (the\x0d\n// "Software")\x2C to deal in the Software without restriction\x2C including\x0d\n// without limitation the rights to use\x2C copy\x2C modify\x2C merge\x2C publish\x2C\x0d\n// distribute\x2C sublicense\x2C and/or sell copies of the Software\x2C and to permit\x0d\n// persons to whom the Software is furnished to do so\x2C subject to the\x0d\n// following conditions:\x0d\n//\x0d\n// The above copyright notice and this permission notice shall be included\x0d\n// in all copies or substantial portions of the Software.\x0d\n//\x0d\n// THE SOFTWARE IS PROVIDED "AS IS"\x2C WITHOUT WARRANTY OF ANY KIND\x2C EXPRESS\x0d\n// OR IMPLIED\x2C INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF\x0d\n// MERCHANTABILITY\x2C FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN\x0d\n// NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM\x2C\x0d\n// DAMAGES OR OTHER LIABILITY\x2C WHETHER IN AN ACTION OF CONTRACT\x2C TORT OR\x0d\n// OTHERWISE\x2C ARISING FROM\x2C OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE\x0d\n// USE OR OTHER DEALINGS IN THE SOFTWARE.\x0d\n\x0d\n'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypeIndexOf\x2C\x0d\n  ArrayPrototypePush\x2C\x0d\n  ArrayPrototypeShift\x2C\x0d\n  ArrayPrototypeSplice\x2C\x0d\n  ArrayPrototypeUnshift\x2C\x0d\n  FunctionPrototypeCall\x2C\x0d\n  JSONStringify\x2C\x0d\n  NumberParseInt\x2C\x0d\n  ObjectAssign\x2C\x0d\n  ObjectSetPrototypeOf\x2C\x0d\n  ReflectApply\x2C\x0d\n  ReflectConstruct\x2C\x0d\n  SymbolAsyncDispose\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  assertCrypto\x2C\x0d\n  kEmptyObject\x2C\x0d\n  promisify\x2C\x0d\n  once\x2C\x0d\n} = require('internal/util');\x0d\nconst { ERR_PROXY_TUNNEL } = require('internal/errors').codes;\x0d\nassertCrypto();\x0d\n\x0d\nconst tls = require('tls');\x0d\nconst {\x0d\n  kProxyConfig\x2C\x0d\n  checkShouldUseProxy\x2C\x0d\n  kWaitForProxyTunnel\x2C\x0d\n  getGlobalAgent\x2C\x0d\n} = require('internal/http');\x0d\nconst { Agent: HttpAgent } = require('_http_agent');\x0d\nconst {\x0d\n  httpServerPreClose\x2C\x0d\n  Server: HttpServer\x2C\x0d\n  setupConnectionsTracking\x2C\x0d\n  storeHTTPOptions\x2C\x0d\n  _connectionListener\x2C\x0d\n} = require('_http_server');\x0d\nconst { ClientRequest } = require('_http_client');\x0d\nlet debug = require('internal/util/debuglog').debuglog('https'\x2C (fn) => {\x0d\n  debug = fn;\x0d\n});\x0d\nconst net = require('net');\x0d\nconst { URL\x2C urlToHttpOptions\x2C isURL } = require('internal/url');\x0d\nconst { validateObject } = require('internal/validators');\x0d\nconst { isIP } = require('internal/net');\x0d\nconst assert = require('internal/assert');\x0d\nconst { getOptionValue } = require('internal/options');\x0d\n\x0d\nfunction Server(opts\x2C requestListener) {\x0d\n  if (!(this instanceof Server)) return new Server(opts\x2C requestListener);\x0d\n\x0d\n  let ALPNProtocols = ['http/1.1'];\x0d\n  if (typeof opts === 'function') {\x0d\n    requestListener = opts;\x0d\n    opts = kEmptyObject;\x0d\n  } else if (opts == null) {\x0d\n    opts = kEmptyObject;\x0d\n  } else {\x0d\n    validateObject(opts\x2C 'options');\x0d\n    // Only one of ALPNProtocols and ALPNCallback can be set\x2C so make sure we\x0d\n    // only set a default ALPNProtocols if the caller has not set either of them\x0d\n    if (opts.ALPNProtocols || opts.ALPNCallback)\x0d\n      ALPNProtocols = undefined;\x0d\n  }\x0d\n\x0d\n  FunctionPrototypeCall(storeHTTPOptions\x2C this\x2C opts);\x0d\n  FunctionPrototypeCall(tls.Server\x2C this\x2C\x0d\n                        {\x0d\n                          noDelay: true\x2C\x0d\n                          ALPNProtocols\x2C\x0d\n                          ...opts\x2C\x0d\n                        }\x2C\x0d\n                        _connectionListener);\x0d\n\x0d\n  this.httpAllowHalfOpen = false;\x0d\n\x0d\n  if (requestListener) {\x0d\n    this.addListener('request'\x2C requestListener);\x0d\n  }\x0d\n\x0d\n  this.addListener('tlsClientError'\x2C function addListener(err\x2C conn) {\x0d\n    if (!this.emit('clientError'\x2C err\x2C conn))\x0d\n      conn.destroy(err);\x0d\n  });\x0d\n\x0d\n  this.timeout = 0;\x0d\n  this.maxHeadersCount = null;\x0d\n  this.on('listening'\x2C setupConnectionsTracking);\x0d\n}\x0d\n\x0d\nObjectSetPrototypeOf(Server.prototype\x2C tls.Server.prototype);\x0d\nObjectSetPrototypeOf(Server\x2C tls.Server);\x0d\n\x0d\nServer.prototype.closeAllConnections = HttpServer.prototype.closeAllConnections;\x0d\n\x0d\nServer.prototype.closeIdleConnections = HttpServer.prototype.closeIdleConnections;\x0d\n\x0d\nServer.prototype.setTimeout = HttpServer.prototype.setTimeout;\x0d\n\x0d\nServer.prototype.close = function close() {\x0d\n  httpServerPreClose(this);\x0d\n  ReflectApply(tls.Server.prototype.close\x2C this\x2C arguments);\x0d\n  return this;\x0d\n};\x0d\n\x0d\nServer.prototype[SymbolAsyncDispose] = async function() {\x0d\n  await FunctionPrototypeCall(promisify(this.close)\x2C this);\x0d\n};\x0d\n\x0d\n/**\x0d\n * Creates a new `https.Server` instance.\x0d\n * @param {{\x0d\n *   IncomingMessage?: IncomingMessage;\x0d\n *   ServerResponse?: ServerResponse;\x0d\n *   insecureHTTPParser?: boolean;\x0d\n *   maxHeaderSize?: number;\x0d\n *   }} [opts]\x0d\n * @param {Function} [requestListener]\x0d\n * @returns {Server}\x0d\n */\x0d\nfunction createServer(opts\x2C requestListener) {\x0d\n  return new Server(opts\x2C requestListener);\x0d\n}\x0d\n\x0d\n// When proxying a HTTPS request\x2C the following needs to be done:\x0d\n// https://datatracker.ietf.org/doc/html/rfc9110#CONNECT\x0d\n// 1. Send a CONNECT request to the proxy server.\x0d\n// 2. Wait for 200 connection established response to establish the tunnel.\x0d\n// 3. Perform TLS handshake with the endpoint over the socket.\x0d\n// 4. Tunnel the request using the established connection.\x0d\n//\x0d\n// This function computes the tunnel configuration for HTTPS requests.\x0d\n// The handling of the tunnel connection is done in createConnection.\x0d\nfunction getTunnelConfigForProxiedHttps(agent\x2C reqOptions) {\x0d\n  if (!agent[kProxyConfig]) {\x0d\n    return null;\x0d\n  }\x0d\n  if ((reqOptions.protocol || agent.protocol) !== 'https:') {\x0d\n    return null;\x0d\n  }\x0d\n  const shouldUseProxy = checkShouldUseProxy(agent[kProxyConfig]\x2C reqOptions);\x0d\n  debug(`getTunnelConfigForProxiedHttps should use proxy for ${reqOptions.host}:${reqOptions.port}:`\x2C shouldUseProxy);\x0d\n  if (!shouldUseProxy) {\x0d\n    return null;\x0d\n  }\x0d\n  const { auth\x2C href } = agent[kProxyConfig];\x0d\n  // The request is a HTTPS request\x2C assemble the payload for establishing the tunnel.\x0d\n  const ipType = isIP(reqOptions.host);\x0d\n  // The request target must put IPv6 address in square brackets.\x0d\n  // Here reqOptions is already processed by urlToHttpOptions so we'll add them back if necessary.\x0d\n  // See https://www.rfc-editor.org/rfc/rfc3986#section-3.2.2\x0d\n  const requestHost = ipType === 6 ? `[${reqOptions.host}]` : reqOptions.host;\x0d\n  const requestPort = reqOptions.port || agent.defaultPort;\x0d\n  const endpoint = `${requestHost}:${requestPort}`;\x0d\n  // The ClientRequest constructor should already have validated the host and the port.\x0d\n  // When the request options come from a string invalid characters would be stripped away\x2C\x0d\n  // when it's an object ERR_INVALID_CHAR would be thrown. Here we just assert in case\x0d\n  // agent.createConnection() is called with invalid options.\x0d\n  assert(!endpoint.includes('\\r'));\x0d\n  assert(!endpoint.includes('\\n'));\x0d\n\x0d\n  let payload = `CONNECT ${endpoint} HTTP/1.1\\r\\n`;\x0d\n  // The parseProxyConfigFromEnv() method should have already validated the authorization header\x0d\n  // value.\x0d\n  if (auth) {\x0d\n    payload += `proxy-authorization: ${auth}\\r\\n`;\x0d\n  }\x0d\n  if (agent.keepAlive || agent.maxSockets !== Infinity) {\x0d\n    payload += 'proxy-connection: keep-alive\\r\\n';\x0d\n  }\x0d\n  payload += `host: ${endpoint}`;\x0d\n  payload += '\\r\\n\\r\\n';\x0d\n\x0d\n  const result = {\x0d\n    __proto__: null\x2C\x0d\n    proxyTunnelPayload: payload\x2C\x0d\n    requestOptions: {  // Options used for the request sent after the tunnel is established.\x0d\n      __proto__: null\x2C\x0d\n      servername: reqOptions.servername || ipType ? undefined : reqOptions.host\x2C\x0d\n      ...reqOptions\x2C\x0d\n    }\x2C\x0d\n  };\x0d\n  debug(`updated request for HTTPS proxy ${href} with`\x2C result);\x0d\n  return result;\x0d\n};\x0d\n\x0d\nfunction establishTunnel(agent\x2C socket\x2C options\x2C tunnelConfig\x2C afterSocket) {\x0d\n  const { proxyTunnelPayload } = tunnelConfig;\x0d\n  // By default\x2C the socket is in paused mode. Read to look for the 200\x0d\n  // connection established response.\x0d\n  function read() {\x0d\n    let chunk;\x0d\n    while ((chunk = socket.read()) !== null) {\x0d\n      if (onProxyData(chunk) !== -1) {\x0d\n        break;\x0d\n      }\x0d\n    }\x0d\n    socket.on('readable'\x2C read);\x0d\n  }\x0d\n\x0d\n  function cleanup() {\x0d\n    socket.removeListener('end'\x2C onProxyEnd);\x0d\n    socket.removeListener('error'\x2C onProxyError);\x0d\n    socket.removeListener('readable'\x2C read);\x0d\n    socket.setTimeout(0);  // Clear the timeout for the tunnel establishment.\x0d\n  }\x0d\n\x0d\n  function onProxyError(err) {\x0d\n    debug('onProxyError'\x2C err);\x0d\n    cleanup();\x0d\n    afterSocket(err\x2C socket);\x0d\n  }\x0d\n\x0d\n  // Read the headers from the chunks and check for the status code. If it fails we\x0d\n  // clean up the socket and return an error. Otherwise we establish the tunnel.\x0d\n  let buffer = '';\x0d\n  function onProxyData(chunk) {\x0d\n    const str = chunk.toString();\x0d\n    debug('onProxyData'\x2C str);\x0d\n    buffer += str;\x0d\n    const headerEndIndex = buffer.indexOf('\\r\\n\\r\\n');\x0d\n    if (headerEndIndex === -1) return headerEndIndex;\x0d\n    const statusLine = buffer.substring(0\x2C buffer.indexOf('\\r\\n'));\x0d\n    const statusCode = statusLine.split(' ')[1];\x0d\n    if (statusCode !== '200') {\x0d\n      debug(`onProxyData receives ${statusCode}\x2C cleaning up`);\x0d\n      cleanup();\x0d\n      const targetHost = proxyTunnelPayload.split('\\r')[0].split(' ')[1];\x0d\n      const message = `Failed to establish tunnel to ${targetHost} via ${agent[kProxyConfig].href}: ${statusLine}`;\x0d\n      const err = new ERR_PROXY_TUNNEL(message);\x0d\n      err.statusCode = NumberParseInt(statusCode);\x0d\n      afterSocket(err\x2C socket);\x0d\n    } else {\x0d\n      // https://datatracker.ietf.org/doc/html/rfc9110#CONNECT\x0d\n      // RFC 9110 says that it can be 2xx but in the real world\x2C proxy clients generally only\x0d\n      // accepts 200.\x0d\n      // Proxy servers are not supposed to send anything after the headers - the payload must be\x0d\n      // be empty. So after this point we will proceed with the tunnel e.g. starting TLS handshake.\x0d\n      debug('onProxyData receives 200\x2C establishing tunnel');\x0d\n      cleanup();\x0d\n\x0d\n      // Reuse the tunneled socket to perform the TLS handshake with the endpoint\x2C\x0d\n      // then send the request.\x0d\n      const { requestOptions } = tunnelConfig;\x0d\n      tunnelConfig.requestOptions = null;\x0d\n      requestOptions.socket = socket;\x0d\n      let tunneldSocket;\x0d\n      const onTLSHandshakeError = (err) => {\x0d\n        debug('Propagate error event from tunneled socket to tunnel socket');\x0d\n        afterSocket(err\x2C tunneldSocket);\x0d\n      };\x0d\n      tunneldSocket = tls.connect(requestOptions\x2C () => {\x0d\n        debug('TLS handshake over tunnel succeeded');\x0d\n        tunneldSocket.removeListener('error'\x2C onTLSHandshakeError);\x0d\n        afterSocket(null\x2C tunneldSocket);\x0d\n      });\x0d\n      tunneldSocket.on('free'\x2C () => {\x0d\n        debug('Propagate free event from tunneled socket to tunnel socket');\x0d\n        socket.emit('free');\x0d\n      });\x0d\n      tunneldSocket.on('error'\x2C onTLSHandshakeError);\x0d\n    }\x0d\n    return headerEndIndex;\x0d\n  }\x0d\n\x0d\n  function onProxyEnd() {\x0d\n    cleanup();\x0d\n    const err = new ERR_PROXY_TUNNEL('Connection to establish proxy tunnel ended unexpectedly');\x0d\n    afterSocket(err\x2C socket);\x0d\n  }\x0d\n\x0d\n  const proxyTunnelTimeout = tunnelConfig.requestOptions.timeout;\x0d\n  debug('proxyTunnelTimeout'\x2C proxyTunnelTimeout\x2C options.timeout);\x0d\n  // It may be worth a separate timeout error/event.\x0d\n  // But it also makes sense to treat the tunnel establishment timeout as\x0d\n  // a normal timeout for the request.\x0d\n  function onProxyTimeout() {\x0d\n    debug('onProxyTimeout'\x2C proxyTunnelTimeout);\x0d\n    cleanup();\x0d\n    const err = new ERR_PROXY_TUNNEL(`Connection to establish proxy tunnel timed out after ${proxyTunnelTimeout}ms`);\x0d\n    err.proxyTunnelTimeout = proxyTunnelTimeout;\x0d\n    afterSocket(err\x2C socket);\x0d\n  }\x0d\n\x0d\n  if (proxyTunnelTimeout && proxyTunnelTimeout > 0) {\x0d\n    debug('proxy tunnel setTimeout'\x2C proxyTunnelTimeout);\x0d\n    socket.setTimeout(proxyTunnelTimeout\x2C onProxyTimeout);\x0d\n  }\x0d\n\x0d\n  socket.on('error'\x2C onProxyError);\x0d\n  socket.on('end'\x2C onProxyEnd);\x0d\n  socket.write(proxyTunnelPayload);\x0d\n\x0d\n  read();\x0d\n}\x0d\n\x0d\n// HTTPS agents.\x0d\n// See ProxyConfig in internal/http.js for how the connection should be handled\x0d\n// when the agent is configured to use a proxy server.\x0d\nfunction createConnection(...args) {\x0d\n  // XXX: This signature (port\x2C host\x2C options) is different from all the other\x0d\n  // createConnection() methods.\x0d\n  let options\x2C cb;\x0d\n  if (args[0] !== null && typeof args[0] === 'object') {\x0d\n    options = args[0];\x0d\n  } else if (args[1] !== null && typeof args[1] === 'object') {\x0d\n    options = { ...args[1] };\x0d\n  } else if (args[2] === null || typeof args[2] !== 'object') {\x0d\n    options = {};\x0d\n  } else {\x0d\n    options = { ...args[2] };\x0d\n  }\x0d\n  if (typeof args[0] === 'number') {\x0d\n    options.port = args[0];\x0d\n  }\x0d\n  if (typeof args[1] === 'string') {\x0d\n    options.host = args[1];\x0d\n  }\x0d\n  if (typeof args[args.length - 1] === 'function') {\x0d\n    cb = args[args.length - 1];\x0d\n  }\x0d\n\x0d\n  debug('createConnection'\x2C options);\x0d\n\x0d\n  if (options._agentKey) {\x0d\n    const session = this._getSession(options._agentKey);\x0d\n    if (session) {\x0d\n      debug('reuse session for %j'\x2C options._agentKey);\x0d\n      options = {\x0d\n        session\x2C\x0d\n        ...options\x2C\x0d\n      };\x0d\n    }\x0d\n  }\x0d\n\x0d\n  let socket;\x0d\n  const tunnelConfig = getTunnelConfigForProxiedHttps(this\x2C options);\x0d\n  debug(`https createConnection should use proxy for ${options.host}:${options.port}:`\x2C tunnelConfig);\x0d\n\x0d\n  if (!tunnelConfig) {\x0d\n    socket = tls.connect(options);\x0d\n  } else {\x0d\n    const connectOptions = {\x0d\n      ...this[kProxyConfig].proxyConnectionOptions\x2C\x0d\n    };\x0d\n    debug('Create proxy socket'\x2C connectOptions);\x0d\n    const onError = (err) => {\x0d\n      cleanupAndPropagate(err\x2C socket);\x0d\n    };\x0d\n    const proxyTunnelTimeout = tunnelConfig.requestOptions.timeout;\x0d\n    const onTimeout = () => {\x0d\n      const err = new ERR_PROXY_TUNNEL(`Connection to establish proxy tunnel timed out after ${proxyTunnelTimeout}ms`);\x0d\n      err.proxyTunnelTimeout = proxyTunnelTimeout;\x0d\n      cleanupAndPropagate(err\x2C socket);\x0d\n    };\x0d\n    const cleanupAndPropagate = once((err\x2C currentSocket) => {\x0d\n      debug('cleanupAndPropagate'\x2C err);\x0d\n      socket.removeListener('error'\x2C onError);\x0d\n      socket.removeListener('timeout'\x2C onTimeout);\x0d\n      // An error occurred during tunnel establishment\x2C in that case just destroy the socket.\x0d\n      // and propagate the error to the callback.\x0d\n\x0d\n      // When the error comes from unexpected status code\x2C the stream is still in good shape\x2C\x0d\n      // in that case let req.onSocket handle the destruction instead.\x0d\n      if (err && err.code === 'ERR_PROXY_TUNNEL' && !err.statusCode) {\x0d\n        socket.destroy();\x0d\n      }\x0d\n      // This error should go to:\x0d\n      // -> oncreate in Agent.prototype.createSocket\x0d\n      // -> closure in Agent.prototype.addRequest or Agent.prototype.removeSocket\x0d\n      if (cb) {\x0d\n        cb(err\x2C currentSocket);\x0d\n      }\x0d\n    });\x0d\n    const onProxyConnection = () => {\x0d\n      socket.removeListener('error'\x2C onError);\x0d\n      establishTunnel(this\x2C socket\x2C options\x2C tunnelConfig\x2C cleanupAndPropagate);\x0d\n    };\x0d\n    if (this[kProxyConfig].protocol === 'http:') {\x0d\n      socket = net.connect(connectOptions\x2C onProxyConnection);\x0d\n    } else {\x0d\n      socket = tls.connect(connectOptions\x2C onProxyConnection);\x0d\n    }\x0d\n\x0d\n    socket.on('error'\x2C onError);\x0d\n    if (proxyTunnelTimeout) {\x0d\n      socket.setTimeout(proxyTunnelTimeout\x2C onTimeout);\x0d\n    }\x0d\n    socket[kWaitForProxyTunnel] = true;\x0d\n  }\x0d\n\x0d\n  if (options._agentKey) {\x0d\n    // Cache new session for reuse\x0d\n    socket.on('session'\x2C (session) => {\x0d\n      this._cacheSession(options._agentKey\x2C session);\x0d\n    });\x0d\n\x0d\n    // Evict session on error\x0d\n    socket.once('close'\x2C (err) => {\x0d\n      if (err)\x0d\n        this._evictSession(options._agentKey);\x0d\n    });\x0d\n  }\x0d\n\x0d\n  return socket;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Creates a new `HttpAgent` instance.\x0d\n * @param {{\x0d\n *   keepAlive?: boolean;\x0d\n *   keepAliveMsecs?: number;\x0d\n *   maxSockets?: number;\x0d\n *   maxTotalSockets?: number;\x0d\n *   maxFreeSockets?: number;\x0d\n *   scheduling?: string;\x0d\n *   timeout?: number;\x0d\n *   maxCachedSessions?: number;\x0d\n *   servername?: string;\x0d\n *   defaultPort?: number;\x0d\n *   protocol?: string;\x0d\n *   proxyEnv?: object;\x0d\n *   }} [options]\x0d\n * @class\x0d\n */\x0d\nfunction Agent(options) {\x0d\n  if (!(this instanceof Agent))\x0d\n    return new Agent(options);\x0d\n\x0d\n  options = { __proto__: null\x2C ...options };\x0d\n  options.defaultPort ??= 443;\x0d\n  options.protocol ??= 'https:';\x0d\n  FunctionPrototypeCall(HttpAgent\x2C this\x2C options);\x0d\n\x0d\n  this.maxCachedSessions = this.options.maxCachedSessions;\x0d\n  if (this.maxCachedSessions === undefined)\x0d\n    this.maxCachedSessions = 100;\x0d\n\x0d\n  this._sessionCache = {\x0d\n    map: {}\x2C\x0d\n    list: []\x2C\x0d\n  };\x0d\n}\x0d\nObjectSetPrototypeOf(Agent.prototype\x2C HttpAgent.prototype);\x0d\nObjectSetPrototypeOf(Agent\x2C HttpAgent);\x0d\nAgent.prototype.createConnection = createConnection;\x0d\n\x0d\n/**\x0d\n * Gets a unique name for a set of options.\x0d\n * @param {{\x0d\n *   host: string;\x0d\n *   port: number;\x0d\n *   localAddress: string;\x0d\n *   family: number;\x0d\n *   }} [options]\x0d\n * @returns {string}\x0d\n */\x0d\nAgent.prototype.getName = function getName(options = kEmptyObject) {\x0d\n  let name = FunctionPrototypeCall(HttpAgent.prototype.getName\x2C this\x2C options);\x0d\n\x0d\n  name += ':';\x0d\n  if (options.ca)\x0d\n    name += options.ca;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.cert)\x0d\n    name += options.cert;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.clientCertEngine)\x0d\n    name += options.clientCertEngine;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.ciphers)\x0d\n    name += options.ciphers;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.key)\x0d\n    name += options.key;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.pfx)\x0d\n    name += options.pfx;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.rejectUnauthorized !== undefined)\x0d\n    name += options.rejectUnauthorized;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.servername && options.servername !== options.host)\x0d\n    name += options.servername;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.minVersion)\x0d\n    name += options.minVersion;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.maxVersion)\x0d\n    name += options.maxVersion;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.secureProtocol)\x0d\n    name += options.secureProtocol;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.crl)\x0d\n    name += options.crl;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.honorCipherOrder !== undefined)\x0d\n    name += options.honorCipherOrder;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.ecdhCurve)\x0d\n    name += options.ecdhCurve;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.dhparam)\x0d\n    name += options.dhparam;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.secureOptions !== undefined)\x0d\n    name += options.secureOptions;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.sessionIdContext)\x0d\n    name += options.sessionIdContext;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.sigalgs)\x0d\n    name += JSONStringify(options.sigalgs);\x0d\n\x0d\n  name += ':';\x0d\n  if (options.privateKeyIdentifier)\x0d\n    name += options.privateKeyIdentifier;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.privateKeyEngine)\x0d\n    name += options.privateKeyEngine;\x0d\n\x0d\n  return name;\x0d\n};\x0d\n\x0d\nAgent.prototype._getSession = function _getSession(key) {\x0d\n  return this._sessionCache.map[key];\x0d\n};\x0d\n\x0d\nAgent.prototype._cacheSession = function _cacheSession(key\x2C session) {\x0d\n  // Cache is disabled\x0d\n  if (this.maxCachedSessions === 0)\x0d\n    return;\x0d\n\x0d\n  // Fast case - update existing entry\x0d\n  if (this._sessionCache.map[key]) {\x0d\n    this._sessionCache.map[key] = session;\x0