0/29'\x2C 'IPv4 Service Continuity Prefix'\x2C false]\x2C\n    ['192.0.0.8/32'\x2C 'IPv4 dummy address'\x2C false]\x2C\n    ['192.0.0.9/32'\x2C 'Port Control Protocol Anycast'\x2C true]\x2C\n    ['192.0.0.10/32'\x2C 'Traversal Using Relays around NAT Anycast'\x2C true]\x2C\n    ['192.0.0.170/32'\x2C 'NAT64/DNS64 Discovery'\x2C false]\x2C\n    ['192.0.0.171/32'\x2C 'NAT64/DNS64 Discovery'\x2C false]\x2C\n    ['192.0.2.0/24'\x2C 'Documentation (TEST-NET-1)'\x2C false]\x2C\n    ['192.31.196.0/24'\x2C 'AS112-v4'\x2C true]\x2C\n    ['192.52.193.0/24'\x2C 'AMT'\x2C true]\x2C\n    ['192.88.99.0/24'\x2C 'Deprecated (6to4 Relay Anycast)'\x2C null]\x2C\n    ['192.88.99.2/32'\x2C '6a44-relay anycast address'\x2C false]\x2C\n    ['192.168.0.0/16'\x2C 'Private-Use'\x2C false]\x2C\n    ['192.175.48.0/24'\x2C 'Direct Delegation AS112 Service'\x2C true]\x2C\n    ['198.18.0.0/15'\x2C 'Benchmarking'\x2C false]\x2C\n    ['198.51.100.0/24'\x2C 'Documentation (TEST-NET-2)'\x2C false]\x2C\n    ['203.0.113.0/24'\x2C 'Documentation (TEST-NET-3)'\x2C false]\x2C\n    ['240.0.0.0/4'\x2C 'Reserved'\x2C false]\x2C\n    ['255.255.255.255/32'\x2C 'Limited Broadcast'\x2C false]\x2C\n];\n//# sourceMappingURL=constants.js.map
