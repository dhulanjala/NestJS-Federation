script-source,1023,C:\\development\\NestJS Federation\\gateway\\node_modules\\@npmcli\\agent\\lib\\options.js,'use strict'\n\nconst dns = require('./dns')\n\nconst normalizeOptions = (opts) => {\n  const family = parseInt(opts.family ?? '0'\x2C 10)\n  const keepAlive = opts.keepAlive ?? true\n\n  const normalized = {\n    // nodejs http agent options. these are all the defaults\n    // but kept here to increase the likelihood of cache hits\n    // https://nodejs.org/api/http.html#new-agentoptions\n    keepAliveMsecs: keepAlive ? 1000 : undefined\x2C\n    maxSockets: opts.maxSockets ?? 15\x2C\n    maxTotalSockets: Infinity\x2C\n    maxFreeSockets: keepAlive ? 256 : undefined\x2C\n    scheduling: 'fifo'\x2C\n    // then spread the rest of the options\n    ...opts\x2C\n    // we already set these to their defaults that we want\n    family\x2C\n    keepAlive\x2C\n    // our custom timeout options\n    timeouts: {\n      // the standard timeout option is mapped to our idle timeout\n      // and then deleted below\n      idle: opts.timeout ?? 0\x2C\n      connection: 0\x2C\n      response: 0\x2C\n      transfer: 0\x2C\n      ...opts.timeouts\x2C\n    }\x2C\n    // get the dns options that go at the top level of socket connection\n    ...dns.getOptions({ family\x2C ...opts.dns })\x2C\n  }\n\n  // remove timeout since we already used it to set our own idle timeout\n  delete normalized.timeout\n\n  // since opts is often passed when initiating requests\x2C it may contain\n  // headers\x2C which should not be saved in an agent\n  delete normalized.headers\n\n  return normalized\n}\n\nconst createKey = (obj) => {\n  let key = ''\n  const sorted = Object.entries(obj).sort((a\x2C b) => a[0] - b[0])\n  for (let [k\x2C v] of sorted) {\n    if (v == null) {\n      v = 'null'\n    } else if (v instanceof URL) {\n      v = v.toString()\n    } else if (typeof v === 'object') {\n      v = createKey(v)\n    }\n    key += `${k}:${v}:`\n  }\n  return key\n}\n\nconst cacheOptions = ({ secureEndpoint\x2C ...options }) => createKey({\n  secureEndpoint: !!secureEndpoint\x2C\n  // socket connect options\n  family: options.family\x2C\n  hints: options.hints\x2C\n  localAddress: options.localAddress\x2C\n  // tls specific connect options\n  strictSsl: secureEndpoint ? !!options.rejectUnauthorized : false\x2C\n  ca: secureEndpoint ? options.ca : null\x2C\n  cert: secureEndpoint ? options.cert : null\x2C\n  key: secureEndpoint ? options.key : null\x2C\n  // http agent options\n  keepAlive: options.keepAlive\x2C\n  keepAliveMsecs: options.keepAliveMsecs\x2C\n  maxSockets: options.maxSockets\x2C\n  maxTotalSockets: options.maxTotalSockets\x2C\n  maxFreeSockets: options.maxFreeSockets\x2C\n  scheduling: options.scheduling\x2C\n  // timeout options\n  timeouts: options.timeouts\x2C\n  // proxy\n  proxy: options.proxy\x2C\n})\n\nmodule.exports = {\n  normalizeOptions\x2C\n  cacheOptions\x2C\n}\n
