.DEFAULT_MIN_VERSION = 'TLSv1.3';\x0d\nelse\x0d\n  exports.DEFAULT_MIN_VERSION = 'TLSv1.2';\x0d\n\x0d\nif (getOptionValue('--tls-max-v1.3'))\x0d\n  exports.DEFAULT_MAX_VERSION = 'TLSv1.3';\x0d\nelse if (getOptionValue('--tls-max-v1.2'))\x0d\n  exports.DEFAULT_MAX_VERSION = 'TLSv1.2';\x0d\nelse\x0d\n  exports.DEFAULT_MAX_VERSION = 'TLSv1.3'; // Will depend on node version.\x0d\n\x0d\n\x0d\nexports.getCiphers = internalUtil.cachedResult(\x0d\n  () => internalUtil.filterDuplicateStrings(getSSLCiphers()\x2C true)\x2C\x0d\n);\x0d\n\x0d\nlet bundledRootCertificates;\x0d\nfunction cacheBundledRootCertificates() {\x0d\n  bundledRootCertificates ||= ObjectFreeze(getBundledRootCertificates());\x0d\n\x0d\n  return bundledRootCertificates;\x0d\n}\x0d\n\x0d\nObjectDefineProperty(exports\x2C 'rootCertificates'\x2C {\x0d\n  __proto__: null\x2C\x0d\n  configurable: false\x2C\x0d\n  enumerable: true\x2C\x0d\n  get: cacheBundledRootCertificates\x2C\x0d\n});\x0d\n\x0d\nlet extraCACertificates;\x0d\nfunction cacheExtraCACertificates() {\x0d\n  extraCACertificates ||= ObjectFreeze(getExtraCACertificates());\x0d\n\x0d\n  return extraCACertificates;\x0d\n}\x0d\n\x0d\nlet systemCACertificates;\x0d\nfunction cacheSystemCACertificates() {\x0d\n  systemCACertificates ||= ObjectFreeze(getSystemCACertificates());\x0d\n\x0d\n  return systemCACertificates;\x0d\n}\x0d\n\x0d\nlet defaultCACertificates;\x0d\nlet hasResetDefaultCACertificates = false;\x0d\n\x0d\nfunction cacheDefaultCACertificates() {\x0d\n  if (defaultCACertificates) { return defaultCACertificates; }\x0d\n\x0d\n  if (hasResetDefaultCACertificates) {\x0d\n    defaultCACertificates = getUserRootCertificates();\x0d\n    ObjectFreeze(defaultCACertificates);\x0d\n    return defaultCACertificates;\x0d\n  }\x0d\n\x0d\n  defaultCACertificates = [];\x0d\n\x0d\n  if (!getOptionValue('--use-openssl-ca')) {\x0d\n    const bundled = cacheBundledRootCertificates();\x0d\n    for (let i = 0; i < bundled.length; ++i) {\x0d\n      ArrayPrototypePush(defaultCACertificates\x2C bundled[i]);\x0d\n    }\x0d\n    if (getOptionValue('--use-system-ca')) {\x0d\n      const system = cacheSystemCACertificates();\x0d\n      for (let i = 0; i < system.length; ++i) {\x0d\n\x0d\n        ArrayPrototypePush(defaultCACertificates\x2C system[i]);\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n\x0d\n  if (process.env.NODE_EXTRA_CA_CERTS) {\x0d\n    const extra = cacheExtraCACertificates();\x0d\n    for (let i = 0; i < extra.length; ++i) {\x0d\n\x0d\n      ArrayPrototypePush(defaultCACertificates\x2C extra[i]);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  ObjectFreeze(defaultCACertificates);\x0d\n  return defaultCACertificates;\x0d\n}\x0d\n\x0d\n// TODO(joyeecheung): support X509Certificate output?\x0d\nfunction getCACertificates(type = 'default') {\x0d\n  validateString(type\x2C 'type');\x0d\n\x0d\n  switch (type) {\x0d\n    case 'default':\x0d\n      return cacheDefaultCACertificates();\x0d\n    case 'bundled':\x0d\n      return cacheBundledRootCertificates();\x0d\n    case 'system':\x0d\n      return cacheSystemCACertificates();\x0d\n    case 'extra':\x0d\n      return cacheExtraCACertificates();\x0d\n    default:\x0d\n      throw new ERR_INVALID_ARG_VALUE('type'\x2C type);\x0d\n  }\x0d\n}\x0d\nexports.getCACertificates = getCACertificates;\x0d\n\x0d\nfunction setDefaultCACertificates(certs) {\x0d\n  if (!ArrayIsArray(certs)) {\x0d\n    throw new ERR_INVALID_ARG_TYPE('certs'\x2C 'Array'\x2C certs);\x0d\n  }\x0d\n\x0d\n  // Verify that all elements in the array are strings\x0d\n  for (let i = 0; i < certs.length; i++) {\x0d\n    if (typeof certs[i] !== 'string' && !isArrayBufferView(certs[i])) {\x0d\n      throw new ERR_INVALID_ARG_TYPE(\x0d\n        `certs[${i}]`\x2C ['string'\x2C 'ArrayBufferView']\x2C certs[i]);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  resetRootCertStore(certs);\x0d\n  defaultCACertificates = undefined; // Reset the cached default certificates\x0d\n  hasResetDefaultCACertificates = true;\x0d\n}\x0d\n\x0d\nexports.setDefaultCACertificates = setDefaultCACertificates;\x0d\n\x0d\nif (isBuildingSnapshot()) {\x0d\n  addSerializeCallback(() => {\x0d\n    // Clear the cached certs so that they are reloaded at runtime.\x0d\n    // Bundled certificates are immutable so they are spared.\x0d\n    extraCACertificates = undefined;\x0d\n    systemCACertificates = undefined;\x0d\n    if (hasResetDefaultCACertificates) {\x0d\n      defaultCACertificates = undefined;\x0d\n    }\x0d\n  });\x0d\n  addDeserializeCallback(() => {\x0d\n    // If the tls module is loaded during snapshotting\x2C load the certificates from\x0d\n    // various sources again at runtime so that by the time an actual TLS connection is\x0d\n    // made\x2C the loading is done. If the default CA certificates have been overridden\x2C then\x0d\n    // the serialized overriding certificates are likely to be used and pre-loading\x0d\n    // from the sources would probably not yield any benefit\x2C so skip it.\x0d\n    if (!hasResetDefaultCACertificates) {\x0d\n      startLoadingCertificatesOffThread();\x0d\n    }\x0d\n  });\x0d\n}\x0d\n\x0d\n// Convert protocols array into valid OpenSSL protocols list\x0d\n// ("\\x06spdy/2\\x08http/1.1\\x08http/1.0")\x0d\nfunction convertProtocols(protocols) {\x0d\n  const lens = new Array(protocols.length);\x0d\n  const buff = Buffer.allocUnsafe(protocols.reduce((p\x2C c\x2C i) => {\x0d\n    const len = Buffer.byteLength(c);\x0d\n    if (len > 255) {\x0d\n      throw new ERR_OUT_OF_RANGE('The byte length of the protocol at index ' +\x0d\n        `${i} exceeds the maximum length.`\x2C '<= 255'\x2C len\x2C true);\x0d\n    }\x0d\n    lens[i] = len;\x0d\n    return p + 1 + len;\x0d\n  }\x2C 0));\x0d\n\x0d\n  let offset = 0;\x0d\n  for (let i = 0\x2C c = protocols.length; i < c; i++) {\x0d\n    buff[offset++] = lens[i];\x0d\n    buff.write(protocols[i]\x2C offset);\x0d\n    offset += lens[i];\x0d\n  }\x0d\n\x0d\n  return buff;\x0d\n}\x0d\n\x0d\nexports.convertALPNProtocols = function convertALPNProtocols(protocols\x2C out) {\x0d\n  // If protocols is Array - translate it into buffer\x0d\n  if (ArrayIsArray(protocols)) {\x0d\n    out.ALPNProtocols = convertProtocols(protocols);\x0d\n  } else if (isUint8Array(protocols)) {\x0d\n    // Copy new buffer not to be modified by user.\x0d\n    out.ALPNProtocols = Buffer.from(protocols);\x0d\n  } else if (isArrayBufferView(protocols)) {\x0d\n    out.ALPNProtocols = Buffer.from(protocols.buffer.slice(\x0d\n      protocols.byteOffset\x2C\x0d\n      protocols.byteOffset + protocols.byteLength\x2C\x0d\n    ));\x0d\n  }\x0d\n};\x0d\n\x0d\nfunction unfqdn(host) {\x0d\n  return host.replace(/[.]$/\x2C '');\x0d\n}\x0d\n\x0d\n// String#toLowerCase() is locale-sensitive so we use\x0d\n// a conservative version that only lowercases A-Z.\x0d\nfunction toLowerCase(c) {\x0d\n  return StringFromCharCode(32 + c.charCodeAt(0));\x0d\n}\x0d\n\x0d\nfunction splitHost(host) {\x0d\n  return unfqdn(host).replace(/[A-Z]/g\x2C toLowerCase).split('.');\x0d\n}\x0d\n\x0d\nfunction check(hostParts\x2C pattern\x2C wildcards) {\x0d\n  // Empty strings\x2C null\x2C undefined\x2C etc. never match.\x0d\n  if (!pattern)\x0d\n    return false;\x0d\n\x0d\n  const patternParts = splitHost(pattern);\x0d\n\x0d\n  if (hostParts.length !== patternParts.length)\x0d\n    return false;\x0d\n\x0d\n  // Pattern has empty components\x2C e.g. "bad..example.com".\x0d\n  if (patternParts.includes(''))\x0d\n    return false;\x0d\n\x0d\n  // RFC 6125 allows IDNA U-labels (Unicode) in names but we have no\x0d\n  // good way to detect their encoding or normalize them so we simply\x0d\n  // reject them.  Control characters and blanks are rejected as well\x0d\n  // because nothing good can come from accepting them.\x0d\n  const isBad = (s) => /[^\\u0021-\\u007F]/u.test(s);\x0d\n  if (patternParts.some(isBad))\x0d\n    return false;\x0d\n\x0d\n  // Check host parts from right to left first.\x0d\n  for (let i = hostParts.length - 1; i > 0; i -= 1) {\x0d\n    if (hostParts[i] !== patternParts[i])\x0d\n      return false;\x0d\n  }\x0d\n\x0d\n  const hostSubdomain = hostParts[0];\x0d\n  const patternSubdomain = patternParts[0];\x0d\n  const patternSubdomainParts = patternSubdomain.split('*'\x2C 3);\x0d\n\x0d\n  // Short-circuit when the subdomain does not contain a wildcard.\x0d\n  // RFC 6125 does not allow wildcard substitution for components\x0d\n  // containing IDNA A-labels (Punycode) so match those verbatim.\x0d\n  if (patternSubdomainParts.length === 1 ||\x0d\n      patternSubdomain.includes('xn--'))\x0d\n    return hostSubdomain === patternSubdomain;\x0d\n\x0d\n  if (!wildcards)\x0d\n    return false;\x0d\n\x0d\n  // More than one wildcard is always wrong.\x0d\n  if (patternSubdomainParts.length > 2)\x0d\n    return false;\x0d\n\x0d\n  // *.tld wildcards are not allowed.\x0d\n  if (patternParts.length <= 2)\x0d\n    return false;\x0d\n\x0d\n  const { 0: prefix\x2C 1: suffix } = patternSubdomainParts;\x0d\n\x0d\n  if (prefix.length + suffix.length > hostSubdomain.length)\x0d\n    return false;\x0d\n\x0d\n  if (!hostSubdomain.startsWith(prefix))\x0d\n    return false;\x0d\n\x0d\n  if (!hostSubdomain.endsWith(suffix))\x0d\n    return false;\x0d\n\x0d\n  return true;\x0d\n}\x0d\n\x0d\n// This pattern is used to determine the length of escaped sequences within\x0d\n// the subject alt names string. It allows any valid JSON string literal.\x0d\n// This MUST match the JSON specification (ECMA-404 / RFC8259) exactly.\x0d\nconst jsonStringPattern =\x0d\n  // eslint-disable-next-line no-control-regex\x0d\n  /^"(?:[^"\\\\\\u0000-\\u001f]|\\\\(?:["\\\\/bfnrt]|u[0-9a-fA-F]{4}))*"/;\x0d\n\x0d\nfunction splitEscapedAltNames(altNames) {\x0d\n  const result = [];\x0d\n  let currentToken = '';\x0d\n  let offset = 0;\x0d\n  while (offset !== altNames.length) {\x0d\n    const nextSep = altNames.indexOf('\x2C'\x2C offset);\x0d\n    const nextQuote = altNames.indexOf('"'\x2C offset);\x0d\n    if (nextQuote !== -1 && (nextSep === -1 || nextQuote < nextSep)) {\x0d\n      // There is a quote character and there is no separator before the quote.\x0d\n      currentToken += altNames.substring(offset\x2C nextQuote);\x0d\n      const match = jsonStringPattern.exec(altNames.substring(nextQuote));\x0d\n      if (!match) {\x0d\n        throw new ERR_TLS_CERT_ALTNAME_FORMAT();\x0d\n      }\x0d\n      currentToken += JSONParse(match[0]);\x0d\n      offset = nextQuote + match[0].length;\x0d\n    } else if (nextSep !== -1) {\x0d\n      // There is a separator and no quote before it.\x0d\n      currentToken += altNames.substring(offset\x2C nextSep);\x0d\n      result.push(currentToken);\x0d\n      currentToken = '';\x0d\n      offset = nextSep + 2;\x0d\n    } else {\x0d\n      currentToken += altNames.substring(offset);\x0d\n      offset = altNames.length;\x0d\n    }\x0d\n  }\x0d\n  result.push(currentToken);\x0d\n  return result;\x0d\n}\x0d\n\x0d\nexports.checkServerIdentity = function checkServerIdentity(hostname\x2C cert) {\x0d\n  const subject = cert.subject;\x0d\n  const altNames = cert.subjectaltname;\x0d\n  const dnsNames = [];\x0d\n  const ips = [];\x0d\n\x0d\n  hostname = '' + hostname;\x0d\n\x0d\n  if (altNames) {\x0d\n    const splitAltNames = altNames.includes('"') ?\x0d\n      splitEscapedAltNames(altNames) :\x0d\n      altNames.split('\x2C ');\x0d\n    splitAltNames.forEach((name) => {\x0d\n      if (name.startsWith('DNS:')) {\x0d\n        dnsNames.push(name.slice(4));\x0d\n      } else if (name.startsWith('IP Address:')) {\x0d\n        ips.push(canonicalizeIP(name.slice(11)));\x0d\n      }\x0d\n    });\x0d\n  }\x0d\n\x0d\n  let valid = false;\x0d\n  let reason = 'Unknown reason';\x0d\n\x0d\n  hostname = unfqdn(hostname);  // Remove trailing dot for error messages.\x0d\n\x0d\n  if (net.isIP(hostname)) {\x0d\n    valid = ips.includes(canonicalizeIP(hostname));\x0d\n    if (!valid)\x0d\n      reason = `IP: ${hostname} is not in the cert's list: ` + ips.join('\x2C ');\x0d\n  } else if (dnsNames.length > 0 || subject?.CN) {\x0d\n    const hostParts = splitHost(hostname);\x0d\n    const wildcard = (pattern) => check(hostParts\x2C pattern\x2C true);\x0d\n\x0d\n    if (dnsNames.length > 0) {\x0d\n      valid = dnsNames.some(wildcard);\x0d\n      if (!valid)\x0d\n        reason =\x0d\n          `Host: ${hostname}. is not in the cert's altnames: ${altNames}`;\x0d\n    } else {\x0d\n      // Match against Common Name only if no supported identifiers exist.\x0d\n      const cn = subject.CN;\x0d\n\x0d\n      if (ArrayIsArray(cn))\x0d\n        valid = cn.some(wildcard);\x0d\n      else if (cn)\x0d\n        valid = wildcard(cn);\x0d\n\x0d\n      if (!valid)\x0d\n        reason = `Host: ${hostname}. is not cert's CN: ${cn}`;\x0d\n    }\x0d\n  } else {\x0d\n    reason = 'Cert does not contain a DNS name';\x0d\n  }\x0d\n\x0d\n  if (!valid) {\x0d\n    return new ERR_TLS_CERT_ALTNAME_INVALID(reason\x2C hostname\x2C cert);\x0d\n  }\x0d\n};\x0d\n\x0d\nexports.createSecureContext = tlsCommon.createSecureContext;\x0d\nexports.SecureContext = tlsCommon.SecureContext;\x0d\nexports.TLSSocket = tlsWrap.TLSSocket;\x0d\nexports.Server = tlsWrap.Server;\x0d\nexports.createServer = tlsWrap.createServer;\x0d\nexports.connect = tlsWrap.connect;\x0d\n
