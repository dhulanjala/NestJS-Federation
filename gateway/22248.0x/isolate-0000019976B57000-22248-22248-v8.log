code-creation,Eval,9,14572388,0xa1fc0ea0a8,5, C:\\development\\NestJS Federation\\gateway\\node_modules\\@npmcli\\fs\\lib\\move-file.js:1:1,0x25988e74e08,~
script-source,999,C:\\development\\NestJS Federation\\gateway\\node_modules\\@npmcli\\fs\\lib\\move-file.js,const { dirname\x2C join\x2C resolve\x2C relative\x2C isAbsolute } = require('path')\nconst fs = require('fs/promises')\n\nconst pathExists = async path => {\n  try {\n    await fs.access(path)\n    return true\n  } catch (er) {\n    return er.code !== 'ENOENT'\n  }\n}\n\nconst moveFile = async (source\x2C destination\x2C options = {}\x2C root = true\x2C symlinks = []) => {\n  if (!source || !destination) {\n    throw new TypeError('`source` and `destination` file required')\n  }\n\n  options = {\n    overwrite: true\x2C\n    ...options\x2C\n  }\n\n  if (!options.overwrite && await pathExists(destination)) {\n    throw new Error(`The destination file exists: ${destination}`)\n  }\n\n  await fs.mkdir(dirname(destination)\x2C { recursive: true })\n\n  try {\n    await fs.rename(source\x2C destination)\n  } catch (error) {\n    if (error.code === 'EXDEV' || error.code === 'EPERM') {\n      const sourceStat = await fs.lstat(source)\n      if (sourceStat.isDirectory()) {\n        const files = await fs.readdir(source)\n        await Promise.all(files.map((file) =>\n          moveFile(join(source\x2C file)\x2C join(destination\x2C file)\x2C options\x2C false\x2C symlinks)\n        ))\n      } else if (sourceStat.isSymbolicLink()) {\n        symlinks.push({ source\x2C destination })\n      } else {\n        await fs.copyFile(source\x2C destination)\n      }\n    } else {\n      throw error\n    }\n  }\n\n  if (root) {\n    await Promise.all(symlinks.map(async ({ source: symSource\x2C destination: symDestination }) => {\n      let target = await fs.readlink(symSource)\n      // junction symlinks in windows will be absolute paths\x2C so we need to\n      // make sure they point to the symlink destination\n      if (isAbsolute(target)) {\n        target = resolve(symDestination\x2C relative(symSource\x2C target))\n      }\n      // try to determine what the actual file is so we can create the correct\n      // type of symlink in windows\n      let targetStat = 'file'\n      try {\n        targetStat = await fs.stat(resolve(dirname(symSource)\x2C target))\n        if (targetStat.isDirectory()) {\n          targetStat = 'junction'\n        }\n      } catch {\n        // targetStat remains 'file'\n      }\n      await fs.symlink(\n        target\x2C\n        symDestination\x2C\n        targetStat\n      )\n    }))\n    await fs.rm(source\x2C { recursive: true\x2C force: true })\n  }\n}\n\nmodule.exports = moveFile\n
