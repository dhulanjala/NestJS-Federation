script-source,942,C:\\development\\NestJS Federation\\gateway\\node_modules\\cacache\\lib\\entry-index.js,'use strict'\n\nconst crypto = require('crypto')\nconst {\n  appendFile\x2C\n  mkdir\x2C\n  readFile\x2C\n  readdir\x2C\n  rm\x2C\n  writeFile\x2C\n} = require('fs/promises')\nconst { Minipass } = require('minipass')\nconst path = require('path')\nconst ssri = require('ssri')\nconst { tmpName } = require('./util/tmp')\n\nconst contentPath = require('./content/path')\nconst hashToSegments = require('./util/hash-to-segments')\nconst indexV = require('../package.json')['cache-version'].index\nconst { moveFile } = require('@npmcli/fs')\n\nconst lsStreamConcurrency = 5\n\nmodule.exports.NotFoundError = class NotFoundError extends Error {\n  constructor (cache\x2C key) {\n    super(`No cache entry for ${key} found in ${cache}`)\n    this.code = 'ENOENT'\n    this.cache = cache\n    this.key = key\n  }\n}\n\nmodule.exports.compact = compact\n\nasync function compact (cache\x2C key\x2C matchFn\x2C opts = {}) {\n  const bucket = bucketPath(cache\x2C key)\n  const entries = await bucketEntries(bucket)\n  const newEntries = []\n  // we loop backwards because the bottom-most result is the newest\n  // since we add new entries with appendFile\n  for (let i = entries.length - 1; i >= 0; --i) {\n    const entry = entries[i]\n    // a null integrity could mean either a delete was appended\n    // or the user has simply stored an index that does not map\n    // to any content. we determine if the user wants to keep the\n    // null integrity based on the validateEntry function passed in options.\n    // if the integrity is null and no validateEntry is provided\x2C we break\n    // as we consider the null integrity to be a deletion of everything\n    // that came before it.\n    if (entry.integrity === null && !opts.validateEntry) {\n      break\n    }\n\n    // if this entry is valid\x2C and it is either the first entry or\n    // the newEntries array doesn't already include an entry that\n    // matches this one based on the provided matchFn\x2C then we add\n    // it to the beginning of our list\n    if ((!opts.validateEntry || opts.validateEntry(entry) === true) &&\n      (newEntries.length === 0 ||\n        !newEntries.find((oldEntry) => matchFn(oldEntry\x2C entry)))) {\n      newEntries.unshift(entry)\n    }\n  }\n\n  const newIndex = '\\n' + newEntries.map((entry) => {\n    const stringified = JSON.stringify(entry)\n    const hash = hashEntry(stringified)\n    return `${hash}\\t${stringified}`\n  }).join('\\n')\n\n  const setup = async () => {\n    const target = tmpName(cache\x2C opts.tmpPrefix)\n    await mkdir(path.dirname(target)\x2C { recursive: true })\n    return {\n      target\x2C\n      moved: false\x2C\n    }\n  }\n\n  const teardown = async (tmp) => {\n    if (!tmp.moved) {\n      return rm(tmp.target\x2C { recursive: true\x2C force: true })\n    }\n  }\n\n  const write = async (tmp) => {\n    await writeFile(tmp.target\x2C newIndex\x2C { flag: 'wx' })\n    await mkdir(path.dirname(bucket)\x2C { recursive: true })\n    // we use @npmcli/move-file directly here because we\n    // want to overwrite the existing file\n    await moveFile(tmp.target\x2C bucket)\n    tmp.moved = true\n  }\n\n  // write the file atomically\n  const tmp = await setup()\n  try {\n    await write(tmp)\n  } finally {\n    await teardown(tmp)\n  }\n\n  // we reverse the list we generated such that the newest\n  // entries come first in order to make looping through them easier\n  // the true passed to formatEntry tells it to keep null\n  // integrity values\x2C if they made it this far it's because\n  // validateEntry returned true\x2C and as such we should return it\n  return newEntries.reverse().map((entry) => formatEntry(cache\x2C entry\x2C true))\n}\n\nmodule.exports.insert = insert\n\nasync function insert (cache\x2C key\x2C integrity\x2C opts = {}) {\n  const { metadata\x2C size\x2C time } = opts\n  const bucket = bucketPath(cache\x2C key)\n  const entry = {\n    key\x2C\n    integrity: integrity && ssri.stringify(integrity)\x2C\n    time: time || Date.now()\x2C\n    size\x2C\n    metadata\x2C\n  }\n  try {\n    await mkdir(path.dirname(bucket)\x2C { recursive: true })\n    const stringified = JSON.stringify(entry)\n    // NOTE - Cleverness ahoy!\n    //\n    // This works because it's tremendously unlikely for an entry to corrupt\n    // another while still preserving the string length of the JSON in\n    // question. So\x2C we just slap the length in there and verify it on read.\n    //\n    // Thanks to @isaacs for the whiteboarding session that ended up with\n    // this.\n    await appendFile(bucket\x2C `\\n${hashEntry(stringified)}\\t${stringified}`)\n  } catch (err) {\n    if (err.code === 'ENOENT') {\n      return undefined\n    }\n\n    throw err\n  }\n  return formatEntry(cache\x2C entry)\n}\n\nmodule.exports.find = find\n\nasync function find (cache\x2C key) {\n  const bucket = bucketPath(cache\x2C key)\n  try {\n    const entries = await bucketEntries(bucket)\n    return entries.reduce((latest\x2C next) => {\n      if (next && next.key === key) {\n        return formatEntry(cache\x2C next)\n      } else {\n        return latest\n      }\n    }\x2C null)\n  } catch (err) {\n    if (err.code === 'ENOENT') {\n      return null\n    } else {\n      throw err\n    }\n  }\n}\n\nmodule.exports.delete = del\n\nfunction del (cache\x2C key\x2C opts = {}) {\n  if (!opts.removeFully) {\n    return insert(cache\x2C key\x2C null\x2C opts)\n  }\n\n  const bucket = bucketPath(cache\x2C key)\n  return rm(bucket\x2C { recursive: true\x2C force: true })\n}\n\nmodule.exports.lsStream = lsStream\n\nfunction lsStream (cache) {\n  const indexDir = bucketDir(cache)\n  const stream = new Minipass({ objectMode: true })\n\n  // Set all this up to run on the stream and then just return the stream\n  Promise.resolve().then(async () => {\n    const { default: pMap } = await import('p-map')\n    const buckets = await readdirOrEmpty(indexDir)\n    await pMap(buckets\x2C async (bucket) => {\n      const bucketPath = path.join(indexDir\x2C bucket)\n      const subbuckets = await readdirOrEmpty(bucketPath)\n      await pMap(subbuckets\x2C async (subbucket) => {\n        const subbucketPath = path.join(bucketPath\x2C subbucket)\n\n        // "/cachename/<bucket 0xFF>/<bucket 0xFF>./*"\n        const subbucketEntries = await readdirOrEmpty(subbucketPath)\n        await pMap(subbucketEntries\x2C async (entry) => {\n          const entryPath = path.join(subbucketPath\x2C entry)\n          try {\n            const entries = await bucketEntries(entryPath)\n            // using a Map here prevents duplicate keys from showing up\n            // twice\x2C I guess?\n            const reduced = entries.reduce((acc\x2C entry) => {\n              acc.set(entry.key\x2C entry)\n              return acc\n            }\x2C new Map())\n            // reduced is a map of key => entry\n            for (const entry of reduced.values()) {\n              const formatted = formatEntry(cache\x2C entry)\n              if (formatted) {\n                stream.write(formatted)\n              }\n            }\n          } catch (err) {\n            if (err.code === 'ENOENT') {\n              return undefined\n            }\n            throw err\n          }\n        }\x2C\n        { concurrency: lsStreamConcurrency })\n      }\x2C\n      { concurrency: lsStreamConcurrency })\n    }\x2C\n    { concurrency: lsStreamConcurrency })\n    stream.end()\n    return stream\n  }).catch(err => stream.emit('error'\x2C err))\n\n  return stream\n}\n\nmodule.exports.ls = ls\n\nasync function ls (cache) {\n  const entries = await lsStream(cache).collect()\n  return entries.reduce((acc\x2C xs) => {\n    acc[xs.key] = xs\n    return acc\n  }\x2C {})\n}\n\nmodule.exports.bucketEntries = bucketEntries\n\nasync function bucketEntries (bucket\x2C filter) {\n  const data = await readFile(bucket\x2C 'utf8')\n  return _bucketEntries(data\x2C filter)\n}\n\nfunction _bucketEntries (data) {\n  const entries = []\n  data.split('\\n').forEach((entry) => {\n    if (!entry) {\n      return\n    }\n\n    const pieces = entry.split('\\t')\n    if (!pieces[1] || hashEntry(pieces[1]) !== pieces[0]) {\n      // Hash is no good! Corruption or malice? Doesn't matter!\n      // EJECT EJECT\n      return\n    }\n    let obj\n    try {\n      obj = JSON.parse(pieces[1])\n    } catch (_) {\n      // eslint-ignore-next-line no-empty-block\n    }\n    // coverage disabled here\x2C no need to test with an entry that parses to something falsey\n    // istanbul ignore else\n    if (obj) {\n      entries.push(obj)\n    }\n  })\n  return entries\n}\n\nmodule.exports.bucketDir = bucketDir\n\nfunction bucketDir (cache) {\n  return path.join(cache\x2C `index-v${indexV}`)\n}\n\nmodule.exports.bucketPath = bucketPath\n\nfunction bucketPath (cache\x2C key) {\n  const hashed = hashKey(key)\n  return path.join.apply(\n    path\x2C\n    [bucketDir(cache)].concat(hashToSegments(hashed))\n  )\n}\n\nmodule.exports.hashKey = hashKey\n\nfunction hashKey (key) {\n  return hash(key\x2C 'sha256')\n}\n\nmodule.exports.hashEntry = hashEntry\n\nfunction hashEntry (str) {\n  return hash(str\x2C 'sha1')\n}\n\nfunction hash (str\x2C digest) {\n  return crypto\n    .createHash(digest)\n    .update(str)\n    .digest('hex')\n}\n\nfunction formatEntry (cache\x2C entry\x2C keepAll) {\n  // Treat null digests as deletions. They'll shadow any previous entries.\n  if (!entry.integrity && !keepAll) {\n    return null\n  }\n\n  return {\n    key: entry.key\x2C\n    integrity: entry.integrity\x2C\n    path: entry.integrity ? contentPath(cache\x2C entry.integrity) : undefined\x2C\n    size: entry.size\x2C\n    time: entry.time\x2C\n    metadata: entry.metadata\x2C\n  }\n}\n\nfunction readdirOrEmpty (dir) {\n  return readdir(dir).catch((err) => {\n    if (err.code === 'ENOENT' || err.code === 'ENOTDIR') {\n      return []\n    }\n\n    throw err\n  })\n}\n
