script-source,33,node:internal/process/promises,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypePush\x2C\x0d\n  ArrayPrototypeShift\x2C\x0d\n  Error\x2C\x0d\n  ObjectPrototypeHasOwnProperty\x2C\x0d\n  SafeMap\x2C\x0d\n  SafeWeakMap\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  tickInfo\x2C\x0d\n  promiseRejectEvents: {\x0d\n    kPromiseRejectWithNoHandler\x2C\x0d\n    kPromiseHandlerAddedAfterReject\x2C\x0d\n    kPromiseRejectAfterResolved\x2C\x0d\n    kPromiseResolveAfterResolved\x2C\x0d\n  }\x2C\x0d\n  setPromiseRejectCallback\x2C\x0d\n} = internalBinding('task_queue');\x0d\n\x0d\nconst { deprecate } = require('internal/util');\x0d\n\x0d\nconst {\x0d\n  noSideEffectsToString\x2C\x0d\n  triggerUncaughtException\x2C\x0d\n  exitCodes: { kGenericUserError }\x2C\x0d\n} = internalBinding('errors');\x0d\n\x0d\nconst {\x0d\n  pushAsyncContext\x2C\x0d\n  popAsyncContext\x2C\x0d\n  symbols: {\x0d\n    async_id_symbol: kAsyncIdSymbol\x2C\x0d\n    trigger_async_id_symbol: kTriggerAsyncIdSymbol\x2C\x0d\n  }\x2C\x0d\n} = require('internal/async_hooks');\x0d\nconst { isErrorStackTraceLimitWritable } = require('internal/errors');\x0d\n\x0d\nconst AsyncContextFrame = require('internal/async_context_frame');\x0d\n\x0d\n// *Must* match Environment::TickInfo::Fields in src/env.h.\x0d\nconst kHasRejectionToWarn = 1;\x0d\n\x0d\n// By default true because in cases where process is not a global\x0d\n// it is not possible to determine if the user has added a listener\x0d\n// to the process object.\x0d\nlet hasMultipleResolvesListener = true;\x0d\n\x0d\nif (process.on) {\x0d\n  hasMultipleResolvesListener = process.listenerCount('multipleResolves') !== 0;\x0d\n\x0d\n  process.on('newListener'\x2C (eventName) => {\x0d\n    if (eventName === 'multipleResolves') {\x0d\n      hasMultipleResolvesListener = true;\x0d\n    }\x0d\n  });\x0d\n\x0d\n  process.on('removeListener'\x2C (eventName) => {\x0d\n    if (eventName === 'multipleResolves') {\x0d\n      hasMultipleResolvesListener = process.listenerCount('multipleResolves') !== 0;\x0d\n    }\x0d\n  });\x0d\n}\x0d\n\x0d\n/**\x0d\n * Errors & Warnings\x0d\n */\x0d\n\x0d\nclass UnhandledPromiseRejection extends Error {\x0d\n  code = 'ERR_UNHANDLED_REJECTION';\x0d\n  name = 'UnhandledPromiseRejection';\x0d\n  /**\x0d\n   * @param {Error} reason\x0d\n   */\x0d\n  constructor(reason) {\x0d\n    super('This error originated either by throwing inside of an ' +\x0d\n    'async function without a catch block\x2C or by rejecting a promise which ' +\x0d\n    'was not handled with .catch(). The promise rejected with the reason "' +\x0d\n    noSideEffectsToString(reason) + '".');\x0d\n  }\x0d\n}\x0d\n\x0d\nclass UnhandledPromiseRejectionWarning extends Error {\x0d\n  name = 'UnhandledPromiseRejectionWarning';\x0d\n  /**\x0d\n   * @param {number} uid\x0d\n   */\x0d\n  constructor(uid) {\x0d\n    const message = 'Unhandled promise rejection. This error originated either by ' +\x0d\n    'throwing inside of an async function without a catch block\x2C ' +\x0d\n    'or by rejecting a promise which was not handled with .catch(). ' +\x0d\n    'To terminate the node process on unhandled promise ' +\x0d\n    'rejection\x2C use the CLI flag `--unhandled-rejections=strict` (see ' +\x0d\n    'https://nodejs.org/api/cli.html#cli_unhandled_rejections_mode). ' +\x0d\n    `(rejection id: ${uid})`;\x0d\n\x0d\n    // UnhandledPromiseRejectionWarning will get the stack trace from the\x0d\n    // reason\x2C so we can disable the stack trace limit temporarily for better\x0d\n    // performance.\x0d\n    if (isErrorStackTraceLimitWritable()) {\x0d\n      const stackTraceLimit = Error.stackTraceLimit;\x0d\n      Error.stackTraceLimit = 0;\x0d\n      super(message);\x0d\n      Error.stackTraceLimit = stackTraceLimit;\x0d\n    } else {\x0d\n      super(message);\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\nclass PromiseRejectionHandledWarning extends Error {\x0d\n  name = 'PromiseRejectionHandledWarning';\x0d\n\x0d\n  /**\x0d\n   * @param {number} uid\x0d\n   */\x0d\n  constructor(uid) {\x0d\n    super(`Promise rejection was handled asynchronously (rejection id: ${uid})`);\x0d\n    this.id = uid;\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * @typedef PromiseInfo\x0d\n * @property {*} reason the reason for the rejection\x0d\n * @property {number} uid the unique id of the promise\x0d\n * @property {boolean} warned whether the rejection has been warned\x0d\n * @property {object} [domain] the domain the promise was created in\x0d\n */\x0d\n\x0d\n/**\x0d\n * @type {WeakMap<Promise\x2C PromiseInfo>}\x0d\n */\x0d\nconst maybeUnhandledPromises = new SafeWeakMap();\x0d\n\x0d\n/**\x0d\n * Using a Mp causes the promise to be referenced at least for one tick.\x0d\n * @type {Map<Promise\x2C PromiseInfo>}\x0d\n */\x0d\nlet pendingUnhandledRejections = new SafeMap();\x0d\n\x0d\n/**\x0d\n * @type {Array<{promise: Promise\x2C warning: Error}>}\x0d\n */\x0d\nconst asyncHandledRejections = [];\x0d\n\x0d\n/**\x0d\n * @type {number}\x0d\n */\x0d\nlet lastPromiseId = 0;\x0d\n\x0d\n/**\x0d\n * @param {boolean} value\x0d\n */\x0d\nfunction setHasRejectionToWarn(value) {\x0d\n  tickInfo[kHasRejectionToWarn] = value ? 1 : 0;\x0d\n}\x0d\n\x0d\n/**\x0d\n * @returns {boolean}\x0d\n */\x0d\nfunction hasRejectionToWarn() {\x0d\n  return tickInfo[kHasRejectionToWarn] === 1;\x0d\n}\x0d\n\x0d\n/**\x0d\n * @param {string|Error} obj\x0d\n * @returns {obj is Error}\x0d\n */\x0d\nfunction isErrorLike(obj) {\x0d\n  return typeof obj === 'object' &&\x0d\n         obj !== null &&\x0d\n         ObjectPrototypeHasOwnProperty(obj\x2C 'stack');\x0d\n}\x0d\n\x0d\n/**\x0d\n * @param {0|1|2|3} type\x0d\n * @param {Promise} promise\x0d\n * @param {Error} reason\x0d\n */\x0d\nfunction promiseRejectHandler(type\x2C promise\x2C reason) {\x0d\n  if (unhandledRejectionsMode === undefined) {\x0d\n    unhandledRejectionsMode = getUnhandledRejectionsMode();\x0d\n  }\x0d\n  switch (type) {\x0d\n    case kPromiseRejectWithNoHandler: // 0\x0d\n      unhandledRejection(promise\x2C reason);\x0d\n      break;\x0d\n    case kPromiseHandlerAddedAfterReject: // 1\x0d\n      handledRejection(promise);\x0d\n      break;\x0d\n    case kPromiseRejectAfterResolved: // 2\x0d\n      if (hasMultipleResolvesListener) {\x0d\n        resolveErrorReject(promise\x2C reason);\x0d\n      }\x0d\n      break;\x0d\n    case kPromiseResolveAfterResolved: // 3\x0d\n      if (hasMultipleResolvesListener) {\x0d\n        resolveErrorResolve(promise\x2C reason);\x0d\n      }\x0d\n      break;\x0d\n  }\x0d\n}\x0d\n\x0d\nconst multipleResolvesDeprecate = deprecate(\x0d\n  () => {}\x2C\x0d\n  'The multipleResolves event has been deprecated.'\x2C\x0d\n  'DEP0160'\x2C\x0d\n);\x0d\n\x0d\n/**\x0d\n * @param {Promise} promise\x0d\n * @param {Error} reason\x0d\n */\x0d\nfunction resolveErrorResolve(promise\x2C reason) {\x0d\n  // We have to wrap this in a next tick. Otherwise the error could be caught by\x0d\n  // the executed promise.\x0d\n  process.nextTick(() => {\x0d\n    // Emit the multipleResolves event.\x0d\n    // This is a deprecated event\x2C so we have to check if it's being listened to.\x0d\n    if (process.emit('multipleResolves'\x2C 'resolve'\x2C promise\x2C reason)) {\x0d\n      // If the event is being listened to\x2C emit a deprecation warning.\x0d\n      multipleResolvesDeprecate();\x0d\n    }\x0d\n  });\x0d\n}\x0d\n\x0d\n/**\x0d\n * @param {Promise} promise\x0d\n * @param {Error} reason\x0d\n */\x0d\nfunction resolveErrorReject(promise\x2C reason) {\x0d\n  // We have to wrap this in a next tick. Otherwise the error could be caught by\x0d\n  // the executed promise.\x0d\n  process.nextTick(() => {\x0d\n    if (process.emit('multipleResolves'\x2C 'reject'\x2C promise\x2C reason)) {\x0d\n      multipleResolvesDeprecate();\x0d\n    }\x0d\n  });\x0d\n}\x0d\n\x0d\n/**\x0d\n * @param {Promise} promise\x0d\n * @param {PromiseInfo} promiseInfo\x0d\n * @returns {boolean}\x0d\n */\x0d\nconst emitUnhandledRejection = (promise\x2C promiseInfo) => {\x0d\n  return promiseInfo.domain ?\x0d\n    promiseInfo.domain.emit('error'\x2C promiseInfo.reason) :\x0d\n    process.emit('unhandledRejection'\x2C promiseInfo.reason\x2C promise);\x0d\n};\x0d\n\x0d\n/**\x0d\n * @param {Promise} promise\x0d\n * @param {Error} reason\x0d\n */\x0d\nfunction unhandledRejection(promise\x2C reason) {\x0d\n  pendingUnhandledRejections.set(promise\x2C {\x0d\n    reason\x2C\x0d\n    uid: ++lastPromiseId\x2C\x0d\n    warned: false\x2C\x0d\n    domain: process.domain\x2C\x0d\n    contextFrame: AsyncContextFrame.current()\x2C\x0d\n  });\x0d\n  setHasRejectionToWarn(true);\x0d\n}\x0d\n\x0d\n/**\x0d\n * @param {Promise} promise\x0d\n */\x0d\nfunction handledRejection(promise) {\x0d\n  if (pendingUnhandledRejections.has(promise)) {\x0d\n    pendingUnhandledRejections.delete(promise);\x0d\n    return;\x0d\n  }\x0d\n  const promiseInfo = maybeUnhandledPromises.get(promise);\x0d\n  if (promiseInfo !== undefined) {\x0d\n    maybeUnhandledPromises.delete(promise);\x0d\n    if (promiseInfo.warned) {\x0d\n      // Generate the warning object early to get a good stack trace.\x0d\n      const warning = new PromiseRejectionHandledWarning(promiseInfo.uid);\x0d\n      ArrayPrototypePush(asyncHandledRejections\x2C { promise\x2C warning });\x0d\n      setHasRejectionToWarn(true);\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\nconst unhandledRejectionErrName = UnhandledPromiseRejectionWarning.name;\x0d\n\x0d\n/**\x0d\n * @param {PromiseInfo} promiseInfo\x0d\n */\x0d\nfunction emitUnhandledRejectionWarning(promiseInfo) {\x0d\n  const warning = new UnhandledPromiseRejectionWarning(promiseInfo.uid);\x0d\n  const reason = promiseInfo.reason;\x0d\n  try {\x0d\n    if (isErrorLike(reason)) {\x0d\n      warning.stack = reason.stack;\x0d\n      process.emitWarning(reason.stack\x2C unhandledRejectionErrName);\x0d\n    } else {\x0d\n      process.emitWarning(\x0d\n        noSideEffectsToString(reason)\x2C unhandledRejectionErrName);\x0d\n    }\x0d\n  } catch {\x0d\n    try {\x0d\n      process.emitWarning(\x0d\n        noSideEffectsToString(reason)\x2C unhandledRejectionErrName);\x0d\n    } catch {\x0d\n      // Ignore.\x0d\n    }\x0d\n  }\x0d\n\x0d\n  process.emitWarning(warning);\x0d\n}\x0d\n\x0d\n/**\x0d\n * @callback UnhandledRejectionsModeHandler\x0d\n * @param {Promise} promise\x0d\n * @param {PromiseInfo} promiseInfo\x0d\n * @param {number} [promiseAsyncId]\x0d\n * @returns {boolean}\x0d\n */\x0d\n\x0d\n/**\x0d\n * The mode of unhandled rejections.\x0d\n * @type {UnhandledRejectionsModeHandler}\x0d\n */\x0d\nlet unhandledRejectionsMode;\x0d\n\x0d\n/**\x0d\n * --unhandled-rejections=strict:\x0d\n * Emit 'uncaughtException'. If it's not handled\x2C print the error to stderr\x0d\n * and exit the process.\x0d\n * Otherwise\x2C emit 'unhandledRejection'. If 'unhandledRejection' is not\x0d\n * handled\x2C emit 'UnhandledPromiseRejectionWarning'.\x0d\n * @type {UnhandledRejectionsModeHandler}\x0d\n */\x0d\nfunction strictUnhandledRejectionsMode(promise\x2C promiseInfo\x2C promiseAsyncId) {\x0d\n  const reason = promiseInfo.reason;\x0d\n  const err = isErrorLike(reason) ?\x0d\n    reason : new UnhandledPromiseRejection(reason);\x0d\n  // This destroys the async stack\x2C don't clear it after\x0d\n  triggerUncaughtException(err\x2C true /* fromPromise */);\x0d\n  if (promiseAsyncId !== undefined) {\x0d\n    pushAsyncContext(\x0d\n      promise[kAsyncIdSymbol]\x2C\x0d\n      promise[kTriggerAsyncIdSymbol]\x2C\x0d\n      promise\x2C\x0d\n    );\x0d\n  }\x0d\n  const handled = emitUnhandledRejection(promise\x2C promiseInfo);\x0d\n  if (!handled) emitUnhandledRejectionWarning(promiseInfo);\x0d\n  return true;\x0d\n}\x0d\n\x0d\n/**\x0d\n * --unhandled-rejections=none:\x0d\n * Emit 'unhandledRejection'\x2C but do not emit any warning.\x0d\n * @type {UnhandledRejectionsModeHandler}\x0d\n */\x0d\nfunction ignoreUnhandledRejectionsMode(promise\x2C promiseInfo) {\x0d\n  emitUnhandledRejection(promise\x2C promiseInfo);\x0d\n  return true;\x0d\n}\x0d\n\x0d\n/**\x0d\n * --unhandled-rejections=warn:\x0d\n * Emit 'unhandledRejection'\x2C then emit 'UnhandledPromiseRejectionWarning'.\x0d\n * @type {UnhandledRejectionsModeHandler}\x0d\n */\x0d\nfunction alwaysWarnUnhandledRejectionsMode(promise\x2C promiseInfo) {\x0d\n  emitUnhandledRejection(promise\x2C promiseInfo);\x0d\n  emitUnhandledRejectionWarning(promiseInfo);\x0d\n  return true;\x0d\n}\x0d\n\x0d\n/**\x0d\n * --unhandled-rejections=throw:\x0d\n * Emit 'unhandledRejection'\x2C if it's unhandled\x2C emit\x0d\n * 'uncaughtException'. If it's not handled\x2C print the error to stderr\x0d\n * and exit the process.\x0d\n * @type {UnhandledRejectionsModeHandler}\x0d\n */\x0d\nfunction throwUnhandledRejectionsMode(promise\x2C promiseInfo) {\x0d\n  const reason = promiseInfo.reason;\x0d\n  const handled = emitUnhandledRejection(promise\x2C promiseInfo);\x0d\n  if (!handled) {\x0d\n    const err = isErrorLike(reason) ?\x0d\n      reason :\x0d\n      new UnhandledPromiseRejection(reason);\x0d\n    // This destroys the async stack\x2C don't clear it after\x0d\n    triggerUncaughtException(err\x2C true /* fromPromise */);\x0d\n    return false;\x0d\n  }\x0d\n  return true;\x0d\n}\x0d\n\x0d\n/**\x0d\n * --unhandled-rejections=warn-with-error-code:\x0d\n * Emit 'unhandledRejection'\x2C if it's unhandled\x2C emit\x0d\n * 'UnhandledPromiseRejectionWarning'\x2C then set process exit code to 1.\x0d\n * @type {UnhandledRejectionsModeHandler}\x0d\n */\x0d\nfunction warnWithErrorCodeUnhandledRejectionsMode(promise\x2C promiseInfo) {\x0d\n  const handled = emitUnhandledRejection(promise\x2C promiseInfo);\x0d\n  if (!handled) {\x0d\n    emitUnhandledRejectionWarning(promiseInfo);\x0d\n    process.exitCode = kGenericUserError;\x0d\n  }\x0d\n  return true;\x0d\n}\x0d\n\x0d\n/**\x0d\n * @returns {UnhandledRejectionsModeHandler}\x0d\n */\x0d\nfunction getUnhandledRejectionsMode() {\x0d\n  const { getOptionValue } = require('internal/options');\x0d\n  switch (getOptionValue('--unhandled-rejections')) {\x0d\n    case 'none':\x0d\n      return ignoreUnhandledRejectionsMode;\x0d\n    case 'warn':\x0d\n      return alwaysWarnUnhandledRejectionsMode;\x0d\n    case 'strict':\x0d\n      return strictUnhandledRejectionsMode;\x0d\n    case 'throw':\x0d\n      return throwUnhandledRejectionsMode;\x0d\n    case 'warn-with-error-code':\x0d\n      return warnWithErrorCodeUnhandledRejectionsMode;\x0d\n    default:\x0d\n      return throwUnhandledRejectionsMode;\x0d\n  }\x0d\n}\x0d\n\x0d\n// If this method returns true\x2C we've executed user code or triggered\x0d\n// a warning to be emitted which requires the microtask and next tick\x0d\n// queues to be drained again.\x0d\nfunction processPromiseRejections() {\x0d\n  let maybeScheduledTicksOrMicrotasks = asyncHandledRejections.length > 0;\x0d\n\x0d\n  while (asyncHandledRejections.length !== 0) {\x0d\n    const { promise\x2C warning } = ArrayPrototypeShift(asyncHandledRejections);\x0d\n    if (!process.emit('rejectionHandled'\x2C promise)) {\x0d\n      process.emitWarning(warning);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  let needPop = true;\x0d\n  let promiseAsyncId;\x0d\n\x0d\n  const pending = pendingUnhandledRejections;\x0d\n  pendingUnhandledRejections = new SafeMap();\x0d\n\x0d\n  for (const { 0: promise\x2C 1: promiseInfo } of pending.entries()) {\x0d\n    maybeUnhandledPromises.set(promise\x2C promiseInfo);\x0d\n\x0d\n    promiseInfo.warned = true;\x0d\n\x0d\n    // We need to check if async_hooks are enabled\x0d\n    // don't use enabledHooksExist as a Promise could\x0d\n    // come from a vm.* context and not have an async id\x0d\n    promiseAsyncId = promise[kAsyncIdSymbol];\x0d\n    if (promiseAsyncId !== undefined) {\x0d\n      pushAsyncContext(\x0d\n        promiseAsyncId\x2C\x0d\n        promise[kTriggerAsyncIdSymbol]\x2C\x0d\n        promise\x2C\x0d\n      );\x0d\n    }\x0d\n\x0d\n    const { contextFrame } = promiseInfo;\x0d\n    const priorContextFrame = AsyncContextFrame.exchange(contextFrame);\x0d\n    try {\x0d\n      needPop = unhandledRejectionsMode(promise\x2C promiseInfo\x2C promiseAsyncId);\x0d\n    } finally {\x0d\n      AsyncContextFrame.set(priorContextFrame);\x0d\n      needPop &&\x0d\n      promiseAsyncId !== undefined &&\x0d\n      popAsyncContext(promiseAsyncId);\x0d\n    }\x0d\n    maybeScheduledTicksOrMicrotasks = true;\x0d\n  }\x0d\n  return maybeScheduledTicksOrMicrotasks ||\x0d\n         pendingUnhandledRejections.size !== 0;\x0d\n}\x0d\n\x0d\nfunction listenForRejections() {\x0d\n  setPromiseRejectCallback(promiseRejectHandler);\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  hasRejectionToWarn\x2C\x0d\n  setHasRejectionToWarn\x2C\x0d\n  listenForRejections\x2C\x0d\n  processPromiseRejections\x2C\x0d\n};\x0d\n
