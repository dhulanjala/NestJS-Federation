script-source,1016,C:\\development\\NestJS Federation\\gateway\\node_modules\\@gar\\promise-retry\\lib\\index.js,const { RetryOperation } = require('./retry')\n\nconst createTimeout = (attempt\x2C opts) => Math.min(Math.round((1 + (opts.randomize ? Math.random() : 0)) * Math.max(opts.minTimeout\x2C 1) * Math.pow(opts.factor\x2C attempt))\x2C opts.maxTimeout)\nconst isRetryError = err => err?.code === 'EPROMISERETRY' && Object.hasOwn(err\x2C 'retried')\n\nconst promiseRetry = async (fn\x2C options = {}) => {\n  let timeouts = []\n  if (options instanceof Array) {\n    timeouts = [...options]\n  } else {\n    if (options.retries === Infinity) {\n      options.forever = true\n      delete options.retries\n    }\n    const opts = {\n      retries: 10\x2C\n      factor: 2\x2C\n      minTimeout: 1 * 1000\x2C\n      maxTimeout: Infinity\x2C\n      randomize: false\x2C\n      ...options\n    }\n    if (opts.minTimeout > opts.maxTimeout) {\n      throw new Error('minTimeout is greater than maxTimeout')\n    }\n    if (opts.retries) {\n      for (let i = 0; i < opts.retries; i++) {\n        timeouts.push(createTimeout(i\x2C opts))\n      }\n      // sort the array numerically ascending (since the timeouts may be out of order at factor < 1)\n      timeouts.sort((a\x2C b) => a - b)\n    } else if (options.forever) {\n      timeouts.push(createTimeout(0\x2C opts))\n    }\n  }\n\n  const operation = new RetryOperation(timeouts\x2C {\n    forever: options.forever\x2C\n    unref: options.unref\x2C\n    maxRetryTime: options.maxRetryTime\n  })\n\n  return new Promise(function (resolve\x2C reject) {\n    operation.attempt(async number => {\n      try {\n        const result = await fn(err => {\n          throw Object.assign(new Error('Retrying')\x2C { code: 'EPROMISERETRY'\x2C retried: err })\n        }\x2C number\x2C operation)\n        return resolve(result)\n      } catch (err) {\n        if (!isRetryError(err)) {\n          return reject(err)\n        }\n        if (!operation.retry(err.retried || new Error())) {\n          return reject(err.retried)\n        }\n      }\n    })\n  })\n}\n\nmodule.exports = { promiseRetry }\n
