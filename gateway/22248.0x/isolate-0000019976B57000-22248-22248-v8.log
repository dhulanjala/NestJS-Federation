t(schema\x2C document\x2C typeInfo\x2C () => {});\n   * let inputTypeName;\n   *\n   * visit(\n   *   document\x2C\n   *   visitWithTypeInfo(typeInfo\x2C {\n   *     Argument: () => {\n   *       inputTypeName = String(context.getInputType());\n   *     }\x2C\n   *   })\x2C\n   * );\n   *\n   * inputTypeName; // => 'Int'\n   * ```\n   */\n\n  getInputType() {\n    return this._typeInfo.getInputType();\n  }\n  /**\n   * Returns the parent input type for the current input position.\n   * @returns The parent input type\x2C if known.\n   * @example\n   * ```ts\n   * import { parse\x2C visit } from 'graphql/language';\n   * import { buildSchema\x2C TypeInfo\x2C visitWithTypeInfo } from 'graphql/utilities';\n   * import { ValidationContext } from 'graphql/validation';\n   *\n   * const schema = buildSchema(`\n   *   input ReviewFilter {\n   *     stars: Int\n   *   }\n   *\n   *   type Query {\n   *     reviews(filter: ReviewFilter): [String]\n   *   }\n   * `);\n   * const document = parse('{ reviews(filter: { stars: 5 }) }');\n   * const typeInfo = new TypeInfo(schema);\n   * const context = new ValidationContext(schema\x2C document\x2C typeInfo\x2C () => {});\n   * let parentInputTypeName;\n   *\n   * visit(\n   *   document\x2C\n   *   visitWithTypeInfo(typeInfo\x2C {\n   *     ObjectField: () => {\n   *       parentInputTypeName = String(context.getParentInputType());\n   *     }\x2C\n   *   })\x2C\n   * );\n   *\n   * parentInputTypeName; // => 'ReviewFilter'\n   * ```\n   */\n\n  getParentInputType() {\n    return this._typeInfo.getParentInputType();\n  }\n  /**\n   * Returns the current field definition.\n   * @returns The current field definition\x2C if known.\n   * @example\n   * ```ts\n   * import { parse\x2C visit } from 'graphql/language';\n   * import { buildSchema\x2C TypeInfo\x2C visitWithTypeInfo } from 'graphql/utilities';\n   * import { ValidationContext } from 'graphql/validation';\n   *\n   * const schema = buildSchema(`\n   *   type Query {\n   *    