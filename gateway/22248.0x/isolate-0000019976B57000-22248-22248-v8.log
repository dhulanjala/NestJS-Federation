script-source,1029,C:\\development\\NestJS Federation\\gateway\\node_modules\\debug\\src\\common.js,\n/**\n * This is the common logic for both the Node.js and web browser\n * implementations of `debug()`.\n */\n\nfunction setup(env) {\n\x09createDebug.debug = createDebug;\n\x09createDebug.default = createDebug;\n\x09createDebug.coerce = coerce;\n\x09createDebug.disable = disable;\n\x09createDebug.enable = enable;\n\x09createDebug.enabled = enabled;\n\x09createDebug.humanize = require('ms');\n\x09createDebug.destroy = destroy;\n\n\x09Object.keys(env).forEach(key => {\n\x09\x09createDebug[key] = env[key];\n\x09});\n\n\x09/**\n\x09* The currently active debug mode names\x2C and names to skip.\n\x09*/\n\n\x09createDebug.names = [];\n\x09createDebug.skips = [];\n\n\x09/**\n\x09* Map of special "%n" handling functions\x2C for the debug "format" argument.\n\x09*\n\x09* Valid key names are a single\x2C lower or upper-case letter\x2C i.e. "n" and "N".\n\x09*/\n\x09createDebug.formatters = {};\n\n\x09/**\n\x09* Selects a color for a debug namespace\n\x09* @param {String} namespace The namespace string for the debug instance to be colored\n\x09* @return {Number|String} An ANSI color code for the given namespace\n\x09* @api private\n\x09*/\n\x09function selectColor(namespace) {\n\x09\x09let hash = 0;\n\n\x09\x09for (let i = 0; i < namespace.length; i++) {\n\x09\x09\x09hash = ((hash << 5) - hash) + namespace.charCodeAt(i);\n\x09\x09\x09hash |= 0; // Convert to 32bit integer\n\x09\x09}\n\n\x09\x09return createDebug.colors[Math.abs(hash) % createDebug.colors.length];\n\x09}\n\x09createDebug.selectColor = selectColor;\n\n\x09/**\n\x09* Create a debugger with the given `namespace`.\n\x09*\n\x09* @param {String} namespace\n\x09* @return {Function}\n\x09* @api public\n\x09*/\n\x09function createDebug(namespace) {\n\x09\x09let prevTime;\n\x09\x09let enableOverride = null;\n\x09\x09let namespacesCache;\n\x09\x09let enabledCache;\n\n\x09\x09function debug(...args) {\n\x09\x09\x09// Disa