script-source,1012,C:\\development\\NestJS Federation\\gateway\\node_modules\\cacache\\lib\\verify.js,'use strict'\n\nconst {\n  mkdir\x2C\n  readFile\x2C\n  rm\x2C\n  stat\x2C\n  truncate\x2C\n  writeFile\x2C\n} = require('fs/promises')\nconst contentPath = require('./content/path')\nconst fsm = require('fs-minipass')\nconst glob = require('./util/glob.js')\nconst index = require('./entry-index')\nconst path = require('path')\nconst ssri = require('ssri')\n\nconst hasOwnProperty = (obj\x2C key) =>\n  Object.prototype.hasOwnProperty.call(obj\x2C key)\n\nconst verifyOpts = (opts) => ({\n  concurrency: 20\x2C\n  log: { silly () {} }\x2C\n  ...opts\x2C\n})\n\nmodule.exports = verify\n\nasync function verify (cache\x2C opts) {\n  opts = verifyOpts(opts)\n  opts.log.silly('verify'\x2C 'verifying cache at'\x2C cache)\n\n  const steps = [\n    markStartTime\x2C\n    fixPerms\x2C\n    garbageCollect\x2C\n    rebuildIndex\x2C\n    cleanTmp\x2C\n    writeVerifile\x2C\n    markEndTime\x2C\n  ]\n\n  const stats = {}\n  for (const step of steps) {\n    const label = step.name\n    const start = new Date()\n    const s = await step(cache\x2C opts)\n    if (s) {\n      Object.keys(s).forEach((k) => {\n        stats[k] = s[k]\n      })\n    }\n    const end = new Date()\n    if (!stats.runTime) {\n      stats.runTime = {}\n    }\n    stats.runTime[label] = end - start\n  }\n  stats.runTime.total = stats.endTime - stats.startTime\n  opts.log.silly(\n    'verify'\x2C\n    'verification finished for'\x2C\n    cache\x2C\n    'in'\x2C\n    `${stats.runTime.total}ms`\n  )\n  return stats\n}\n\nasync function markStartTime () {\n  return { startTime: new Date() }\n}\n\nasync function markEndTime () {\n  return { endTime: new Date() }\n}\n\nasync function fixPerms (cache\x2C opts) {\n  opts.log.silly('verify'\x2C 'fixing cache permissions')\n  await mkdir(cache\x2C { recursive: true })\n  return null\n}\n\n// Implements a naive mark-and-sweep tracing garbage collector.\n//\n// The algorithm is basically as follows:\n// 1. Read (and filter) all index entries ("pointers")\n// 2. Mark each integrity value as "live"\n// 3. Read entire filesystem tree in `content-vX/` dir\n// 4. If content is live\x2C verify its checksum and delete it if it fails\n// 5. If content is not marked as live\x2C rm it.\n//\nasync function garbageCollect (cache\x2C opts) {\n  opts.log.silly('verify'\x2C 'garbage collecting content')\n  const { default: pMap } = await import('p-map')\n  const indexStream = index.lsStream(cache)\n  const liveContent = new Set()\n  indexStream.on('data'\x2C (entry) => {\n    if (opts.filter && !opts.filter(entry)) {\n      return\n    }\n\n    // integrity is stringified\x2C re-parse it so we can get each hash\n    const integrity = ssri.parse(entry.integrity)\n    for (const algo in integrity) {\n      liveContent.add(integrity[algo].toString())\n    }\n  })\n  await new Promise((resolve\x2C reject) => {\n    indexStream.on('end'\x2C resolve).on('error'\x2C reject)\n  })\n  const contentDir = contentPath.contentDir(cache)\n  const files = await glob(path.join(contentDir\x2C '**')\x2C {\n    follow: false\x2C\n    nodir: true\x2C\n    nosort: true\x2C\n  })\n  const stats = {\n    verifiedContent: 0\x2C\n    reclaimedCount: 0\x2C\n    reclaimedSize: 0\x2C\n    badContentCount: 0\x2C\n    keptSize: 0\x2C\n  }\n  await pMap(\n    files\x2C\n    async (f) => {\n      const split = f.split(/[/\\\\]/)\n      const digest = split.slice(split.length - 3).join('')\n      const algo = split[split.length - 4]\n      const integrity = ssri.fromHex(digest\x2C algo)\n      if (liveContent.has(integrity.toString())) {\n        const info = await verifyContent(f\x2C integrity)\n        if (!info.valid) {\n          stats.reclaimedCount++\n          stats.badContentCount++\n          stats.reclaimedSize += info.size\n        } else {\n          stats.verifiedContent++\n          stats.keptSize += info.size\n        }\n      } else {\n        // No entries refer to this content. We can delete.\n        stats.reclaimedCount++\n        const s = await stat(f)\n        await rm(f\x2C { recursive: true\x2C force: true })\n        stats.reclaimedSize += s.size\n      }\n      return stats\n    }\x2C\n    { concurrency: opts.concurrency }\n  )\n  return stats\n}\n\nasync function verifyContent (filepath\x2C sri) {\n  const contentInfo = {}\n  try {\n    const { size } = await stat(filepath)\n    contentInfo.size = size\n    contentInfo.valid = true\n    await ssri.checkStream(new fsm.ReadStream(filepath)\x2C sri)\n  } catch (err) {\n    if (err.code === 'ENOENT') {\n      return { size: 0\x2C valid: false }\n    }\n    if (err.code !== 'EINTEGRITY') {\n      throw err\n    }\n\n    await rm(filepath\x2C { recursive: true\x2C force: true })\n    contentInfo.valid = false\n  }\n  return contentInfo\n}\n\nasync function rebuildIndex (cache\x2C opts) {\n  opts.log.silly('verify'\x2C 'rebuilding index')\n  const { default: pMap } = await import('p-map')\n  const entries = await index.ls(cache)\n  const stats = {\n    missingContent: 0\x2C\n    rejectedEntries: 0\x2C\n    totalEntries: 0\x2C\n  }\n  const buckets = {}\n  for (const k in entries) {\n    /* istanbul ignore else */\n    if (hasOwnProperty(entries\x2C k)) {\n      const hashed = index.hashKey(k)\n      const entry = entries[k]\n      const excluded = opts.filter && !opts.filter(entry)\n      excluded && stats.rejectedEntries++\n      if (buckets[hashed] && !excluded) {\n        buckets[hashed].push(entry)\n      } else if (buckets[hashed] && excluded) {\n        // skip\n      } else if (excluded) {\n        buckets[hashed] = []\n        buckets[hashed]._path = index.bucketPath(cache\x2C k)\n      } else {\n        buckets[hashed] = [entry]\n        buckets[hashed]._path = index.bucketPath(cache\x2C k)\n      }\n    }\n  }\n  await pMap(\n    Object.keys(buckets)\x2C\n    (key) => {\n      return rebuildBucket(cache\x2C buckets[key]\x2C stats\x2C opts)\n    }\x2C\n    { concurrency: opts.concurrency }\n  )\n  return stats\n}\n\nasync function rebuildBucket (cache\x2C bucket\x2C stats) {\n  await truncate(bucket._path)\n  // This needs to be serialized because cacache explicitly\n  // lets very racy bucket conflicts clobber each other.\n  for (const entry of bucket) {\n    const content = contentPath(cache\x2C entry.integrity)\n    try {\n      await stat(content)\n      await index.insert(cache\x2C entry.key\x2C entry.integrity\x2C {\n        metadata: entry.metadata\x2C\n        size: entry.size\x2C\n        time: entry.time\x2C\n      })\n      stats.totalEntries++\n    } catch (err) {\n      if (err.code === 'ENOENT') {\n        stats.rejectedEntries++\n        stats.missingContent++\n      } else {\n        throw err\n      }\n    }\n  }\n}\n\nfunction cleanTmp (cache\x2C opts) {\n  opts.log.silly('verify'\x2C 'cleaning tmp directory')\n  return rm(path.join(cache\x2C 'tmp')\x2C { recursive: true\x2C force: true })\n}\n\nasync function writeVerifile (cache\x2C opts) {\n  const verifile = path.join(cache\x2C '_lastverified')\n  opts.log.silly('verify'\x2C 'writing verifile to ' + verifile)\n  return writeFile(verifile\x2C `${Date.now()}`)\n}\n\nmodule.exports.lastRun = lastRun\n\nasync function lastRun (cache) {\n  const data = await readFile(path.join(cache\x2C '_lastverified')\x2C { encoding: 'utf8' })\n  return new Date(+data)\n}\n
