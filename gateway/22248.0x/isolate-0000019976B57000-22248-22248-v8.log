script-source,920,node:internal/dns/callback_resolver,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypeMap\x2C\x0d\n  FunctionPrototypeCall\x2C\x0d\n  ObjectDefineProperty\x2C\x0d\n  Symbol\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  DNSException\x2C\x0d\n  codes: {\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\n\x0d\nconst {\x0d\n  createResolverClass\x2C\x0d\n} = require('internal/dns/utils');\x0d\n\x0d\nconst {\x0d\n  validateFunction\x2C\x0d\n  validateString\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nconst {\x0d\n  QueryReqWrap\x2C\x0d\n} = internalBinding('cares_wrap');\x0d\n\x0d\nconst {\x0d\n  hasObserver\x2C\x0d\n  startPerf\x2C\x0d\n  stopPerf\x2C\x0d\n} = require('internal/perf/observe');\x0d\n\x0d\nconst kPerfHooksDnsLookupResolveContext = Symbol('kPerfHooksDnsLookupResolveContext');\x0d\n\x0d\nfunction onresolve(err\x2C result\x2C ttls) {\x0d\n  if (ttls && this.ttl)\x0d\n    result = ArrayPrototypeMap(\x0d\n      result\x2C (address\x2C index) => ({ address\x2C ttl: ttls[index] }));\x0d\n\x0d\n  if (err)\x0d\n    this.callback(new DNSException(err\x2C this.bindingName\x2C this.hostname));\x0d\n  else {\x0d\n    this.callback(null\x2C result);\x0d\n    if (this[kPerfHooksDnsLookupResolveContext] && hasObserver('dns')) {\x0d\n      stopPerf(this\x2C kPerfHooksDnsLookupResolveContext\x2C { detail: { result } });\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction resolver(bindingName) {\x0d\n  function query(name\x2C /* options\x2C */ callback) {\x0d\n    let options;\x0d\n    if (arguments.length > 2) {\x0d\n      options = callback;\x0d\n      callback = arguments[2];\x0d\n    }\x0d\n\x0d\n    validateString(name\x2C 'name');\x0d\n    validateFunction(callback\x2C 'callback');\x0d\n\x0d\n    const req = new QueryReqWrap();\x0d\n    req.bindingName = bindingName;\x0d\n    req.callback = callback;\x0d\n    req.hostname = name;\x0d\n    req.oncomplete = onresolve;\x0d\n    req.ttl = !!(options?.ttl);\x0d\n    const err = this._handle[bindingName](req\x2C name);\x0d\n    if (err) throw new DNSException(err\x2C bindingName\x2C name);\x0d\n    if (hasObserver('dns')) {\x0d\n      startPerf(req\x2C kPerfHooksDnsLookupResolveContext\x2C {\x0d\n        type: 'dns'\x2C\x0d\n        name: bindingName\x2C\x0d\n        detail: {\x0d\n          host: name\x2C\x0d\n          ttl: req.ttl\x2C\x0d\n        }\x2C\x0d\n      });\x0d\n    }\x0d\n    return req;\x0d\n  }\x0d\n  ObjectDefineProperty(query\x2C 'name'\x2C { __proto__: null\x2C value: bindingName });\x0d\n  return query;\x0d\n}\x0d\n\x0d\n// This is the callback-based resolver. There is another similar\x0d\n// resolver in dns/promises.js with resolve methods that are based\x0d\n// on promises instead.\x0d\nconst { Resolver\x2C resolveMap } = createResolverClass(resolver);\x0d\nResolver.prototype.resolve = resolve;\x0d\n\x0d\nfunction resolve(hostname\x2C rrtype\x2C callback) {\x0d\n  let resolver;\x0d\n  if (typeof rrtype === 'string') {\x0d\n    resolver = resolveMap[rrtype];\x0d\n  } else if (typeof rrtype === 'function') {\x0d\n    resolver = resolveMap.A;\x0d\n    callback = rrtype;\x0d\n  } else {\x0d\n    throw new ERR_INVALID_ARG_TYPE('rrtype'\x2C 'string'\x2C rrtype);\x0d\n  }\x0d\n\x0d\n  if (typeof resolver === 'function') {\x0d\n    return FunctionPrototypeCall(resolver\x2C this\x2C hostname\x2C callback);\x0d\n  }\x0d\n  throw new ERR_INVALID_ARG_VALUE('rrtype'\x2C rrtype);\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  Resolver\x2C\x0d\n};\x0d\n
