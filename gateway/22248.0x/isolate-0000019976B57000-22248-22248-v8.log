perShown = true;\x0d\n  }\x0d\n  const warningFile = lazyOption();\x0d\n  if (warningFile) {\x0d\n    return writeToFile(msg);\x0d\n  }\x0d\n  writeOut(msg);\x0d\n}\x0d\n\x0d\n// process.emitWarning(error)\x0d\n// process.emitWarning(str[\x2C type[\x2C code]][\x2C ctor])\x0d\n// process.emitWarning(str[\x2C options])\x0d\nfunction emitWarning(warning\x2C type\x2C code\x2C ctor) {\x0d\n  // Fast path to avoid memory allocation\x2C\x0d\n  // this doesn't eliminate the other if a few lines below\x0d\n  if (process.noDeprecation && type === 'DeprecationWarning') {\x0d\n    return;\x0d\n  }\x0d\n  let detail;\x0d\n  if (type !== null && typeof type === 'object' && !ArrayIsArray(type)) {\x0d\n    ctor = type.ctor;\x0d\n    code = type.code;\x0d\n    if (typeof type.detail === 'string')\x0d\n      detail = type.detail;\x0d\n    type = type.type || 'Warning';\x0d\n  } else if (typeof type === 'function') {\x0d\n    ctor = type;\x0d\n    code = undefined;\x0d\n    type = 'Warning';\x0d\n  }\x0d\n  if (type !== undefined)\x0d\n    validateString(type\x2C 'type');\x0d\n  if (typeof code === 'function') {\x0d\n    ctor = code;\x0d\n    code = undefined;\x0d\n  } else if (code !== undefined) {\x0d\n    validateString(code\x2C 'code');\x0d\n  }\x0d\n  if (typeof warning === 'string') {\x0d\n    warning = createWarningObject(warning\x2C type\x2C code\x2C ctor\x2C detail);\x0d\n  } else if (!(warning instanceof Error)) {\x0d\n    throw new ERR_INVALID_ARG_TYPE('warning'\x2C ['Error'\x2C 'string']\x2C warning);\x0d\n  }\x0d\n  if (warning.name === 'DeprecationWarning') {\x0d\n    if (process.noDeprecation)\x0d\n      return;\x0d\n    if (process.throwDeprecation) {\x0d\n      // Delay throwing the error to guarantee that all former warnings were\x0d\n      // properly logged.\x0d\n      return process.nextTick(() => {\x0d\n        throw warning;\x0d\n      });\x0d\n    }\x0d\n  }\x0d\n  process.nextTick(doEmitWarning\x2C warning);\x0d\n}\x0d\n\x0d\nfunction emitWarningSync(warning\x