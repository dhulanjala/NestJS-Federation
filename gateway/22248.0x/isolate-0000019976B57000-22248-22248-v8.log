script-source,946,C:\\development\\NestJS Federation\\gateway\\node_modules\\@npmcli\\fs\\lib\\cp\\index.js,const fs = require('fs/promises')\nconst getOptions = require('../common/get-options.js')\nconst node = require('../common/node.js')\nconst polyfill = require('./polyfill.js')\n\n// node 16.7.0 added fs.cp\nconst useNative = node.satisfies('>=16.7.0')\n\nconst cp = async (src\x2C dest\x2C opts) => {\n  const options = getOptions(opts\x2C {\n    copy: ['dereference'\x2C 'errorOnExist'\x2C 'filter'\x2C 'force'\x2C 'preserveTimestamps'\x2C 'recursive']\x2C\n  })\n\n  // the polyfill is tested separately from this module\x2C no need to hack\n  // process.version to try to trigger it just for coverage\n  // istanbul ignore next\n  return useNative\n    ? fs.cp(src\x2C dest\x2C options)\n    : polyfill(src\x2C dest\x2C options)\n}\n\nmodule.exports = cp\n
