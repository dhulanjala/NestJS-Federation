     const result = findExpressionCompleteTarget(code.slice(0\x2C -2));\x0d\n      return !result ? result : `${result}?.`;\x0d\n    }\x0d\n\x0d\n    // The code ends with a dot\x2C such code can't generate a valid AST\x0d\n    // so we need to strip the suffix\x2C run this function's logic and\x0d\n    // add back the dot to the result if present\x0d\n    const result = findExpressionCompleteTarget(code.slice(0\x2C -1));\x0d\n    return !result ? result : `${result}.`;\x0d\n  }\x0d\n\x0d\n  let ast;\x0d\n  try {\x0d\n    ast = acornParse(code\x2C { __proto__: null\x2C sourceType: 'module'\x2C ecmaVersion: 'latest' });\x0d\n  } catch {\x0d\n    const keywords = code.split(' ');\x0d\n\x0d\n    if (keywords.length > 1) {\x0d\n      // Something went wrong with the parsing\x2C however this can be due to incomplete code\x0d\n      // (that is for example missing a closing bracket\x2C as for example `{ a: obj.te`)\x2C in\x0d\n      // this case we take the last code keyword and try again\x0d\n      // TODO(dario-piotrowicz): make this more robust\x2C right now we only split by spaces\x0d\n      //                         but that's not always enough\x2C for example it doesn't handle\x0d\n      //                         this code: `{ a: obj['hello world'].te`\x0d\n      return findExpressionCompleteTarget(keywords.at(-1));\x0d\n    }\x0d\n\x0d\n    // The ast parsing has legitimately failed so we return null\x0d\n    return null;\x0d\n  }\x0d\n\x0d\n  const lastBodyStatement = ast.body[ast.body.length - 1];\x0d\n\x0d\n  if (!lastBodyStatement) {\x0d\n    return null;\x0d\n  }\x0d\n\x0d\n  // If the last statement is a block we know there is not going to be a potential\x0d\n  // completion target (e.g. in `{ a: true }` there is no completion to be done)\x0d\n  if (lastBodyStatement.type === 'BlockStatement') {\x0d\n    return null;\x0d\n  }\x0d\n\x0d\n  // If the last statement is an expression and it has a right side\x2C that's what we\x0d\n  // want to potentially complete on\x2C so let's re-run the function's logic on that\x0d\n  if (lastBodyStatement.type === 'ExpressionStatement' && lastBodyStatement.expression.right) {\x0d\n    const exprRight = lastBodyStatement.expression.right;\x0d\n    const exprRightCode = code.slice(exprRight.start\x2C exprRight.end);\x0d\n    return findExpressionCompleteTarget(exprRightCode);\x0d\n  }\x0d\n\x0d\n  // If the last statement is a variable declaration statement the last declaration is\x0d\n  // what we can potentially complete on\x2C so let's re-run the function's logic on that\x0d\n  if (lastBodyStatement.type === 'VariableDeclaration') {\x0d\n    const lastDeclarationInit = lastBodyStatement.declarations.at(-1).init;\x0d\n    if (!lastDeclarationInit) {\x0d\n      // If there is no initialization we can simply return\x0d\n      return null;\x0d\n    }\x0d\n    const lastDeclarationInitCode = code.slice(lastDeclarationInit.start\x2C lastDeclarationInit.end);\x0d\n    return findExpressionCompleteTarget(lastDeclarationInitCode);\x0d\n  }\x0d\n\x0d\n  // If the last statement is an expression statement with a unary operator (delete\x2C typeof\x2C etc.)\x0d\n  // we want to extract the argument for completion (e.g. for `delete obj.prop` we want `obj.prop`)\x0d\n  if (lastBodyStatement.type === 'ExpressionStatement' &&\x0d\n      lastBodyStatement.expression.type === 'UnaryExpression' &&\x0d\n      lastBodyStatement.expression.argument) {\x0d\n    const argument = lastBodyStatement.expression.argument;\x0d\n    const argumentCode = code.slice(argument.start\x2C argument.end);\x0d\n    return findExpressionCompleteTarget(argumentCode);\x0d\n  }\x0d\n\x0d\n  // If the last statement is an expression statement with "new" syntax\x0d\n  // we want to extract the callee for completion (e.g. for `new Sample` we want `Sample`)\x0d\n  if (lastBodyStatement.type === 'ExpressionStatement' &&\x0d\n      lastBodyStatement.expression.type === 'NewExpression' &&\x0d\n      lastBodyStatement.expression.callee) {\x0d\n    const callee = lastBodyStatement.expression.callee;\x0d\n    const calleeCode = code.slice(callee.start\x2C callee.end);\x0d\n    return findExpressionCompleteTarget(calleeCode);\x0d\n  }\x0d\n\x0d\n  // Walk the AST for the current block of code\x2C and check whether it contains any\x0d\n  // statement or expression type that would potentially have side effects if evaluated.\x0d\n  let isAllowed = true;\x0d\n  const disallow = () => isAllowed = false;\x0d\n  acornWalk.simple(lastBodyStatement\x2C {\x0d\n    ForInStatement: disallow\x2C\x0d\n    ForOfStatement: disallow\x2C\x0d\n    CallExpression: disallow\x2C\x0d\n    AssignmentExpression: disallow\x2C\x0d\n    UpdateExpression: disallow\x2C\x0d\n  });\x0d\n  if (!isAllowed) {\x0d\n    return null;\x0d\n  }\x0d\n\x0d\n  // If any of the above early returns haven't activated then it means that\x0d\n  // the potential complete target is the full code (e.g. the code represents\x0d\n  // a simple partial identifier\x2C a member expression\x2C etc...)\x0d\n  return code.slice(lastBodyStatement.start\x2C lastBodyStatement.end);\x0d\n}\x0d\n\x0d\n/**\x0d\n * Utility used to determine if an expression includes object getters or proxies.\x0d\n *\x0d\n * Example: given `obj.foo`\x2C the function lets you know if `foo` has a getter function\x0d\n * associated to it\x2C or if `obj` is a proxy\x0d\n * @param {any} expr The expression\x2C in AST format to analyze\x0d\n * @param {string} exprStr The string representation of the expression\x0d\n * @param {(str: string\x2C ctx: any\x2C resourceName: string\x2C cb: (error\x2C evaled) => void) => void} evalFn\x0d\n *   Eval function to use\x0d\n * @param {any} ctx The context to use for any code evaluation\x0d\n * @param {(includes: boolean) => void} callback Callback that will be called with the result of the operation\x0d\n * @returns {void}\x0d\n */\x0d\nfunction includesProxiesOrGetters(expr\x2C exprStr\x2C evalFn\x2C ctx\x2C callback) {\x0d\n  if (expr?.type !== 'MemberExpression') {\x0d\n    // If the expression is not a member one for obvious reasons no getters are involved\x0d\n    return callback(false);\x0d\n  }\x0d\n\x0d\n  if (expr.object.type === 'MemberExpression') {\x0d\n    // The object itself is a member expression\x2C so we need to recurse (e.g. the expression is `obj.foo.bar`)\x0d\n    return includesProxiesOrGetters(\x0d\n      expr.object\x2C\x0d\n      exprStr.slice(0\x2C expr.object.end)\x2C\x0d\n      evalFn\x2C\x0d\n      ctx\x2C\x0d\n      (includes\x2C lastEvaledObj) => {\x0d\n        if (includes) {\x0d\n          // If the recurred call found a getter we can also terminate\x0d\n          return callback(includes);\x0d\n        }\x0d\n\x0d\n        if (isProxy(lastEvaledObj)) {\x0d\n          return callback(true);\x0d\n        }\x0d\n\x0d\n        // If a getter/proxy hasn't been found by the recursion call we need to check if maybe a getter/proxy\x0d\n        // is present here (e.g. in `obj.foo.bar` we found that `obj.foo` doesn't involve any getters so we now\x0d\n        // need to check if `bar` on `obj.foo` (i.e. `lastEvaledObj`) has a getter or if `obj.foo.bar` is a proxy)\x0d\n        return hasGetterOrIsProxy(lastEvaledObj\x2C expr.property\x2C (doesHaveGetterOrIsProxy) => {\x0d\n          return callback(doesHaveGetterOrIsProxy);\x0d\n        });\x0d\n      }\x2C\x0d\n    );\x0d\n  }\x0d\n\x0d\n  // This is the base of the recursion we have an identifier for the object and an identifier or literal\x0d\n  // for the property (e.g. we have `obj.foo` or `obj['foo']`\x2C `obj` is the object identifier and `foo`\x0d\n  // is the property identifier/literal)\x0d\n  if (expr.object.type === 'Identifier') {\x0d\n    return evalFn(`try { ${expr.object.name} } catch {}`\x2C ctx\x2C getREPLResourceName()\x2C (err\x2C obj) => {\x0d\n      if (err) {\x0d\n        return callback(false);\x0d\n      }\x0d\n\x0d\n      if (isProxy(obj)) {\x0d\n        return callback(true);\x0d\n      }\x0d\n\x0d\n      return hasGetterOrIsProxy(obj\x2C expr.property\x2C (doesHaveGetterOrIsProxy) => {\x0d\n        if (doesHaveGetterOrIsProxy) {\x0d\n          return callback(true);\x0d\n        }\x0d\n\x0d\n        return evalFn(\x0d\n          `try { ${exprStr} } catch {} `\x2C ctx\x2C getREPLResourceName()\x2C (err\x2C obj) => {\x0d\n            if (err) {\x0d\n              return callback(false);\x0d\n            }\x0d\n            return callback(false\x2C obj);\x0d\n          });\x0d\n      });\x0d\n    });\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Utility to see if a property has a getter associated to it or if\x0d\n   * the property itself is a proxy object.\x0d\n   * @returns {void}\x0d\n   */\x0d\n  function hasGetterOrIsProxy(obj\x2C astProp\x2C cb) {\x0d\n    if (!obj || !astProp) {\x0d\n      return cb(false);\x0d\n    }\x0d\n\x0d\n    if (astProp.type === 'Literal') {\x0d\n      // We have something like `obj['foo'].x` where `x` is the literal\x0d\n      return propHasGetterOrIsProxy(obj\x2C astProp.value\x2C cb);\x0d\n    }\x0d\n\x0d\n    if (\x0d\n      astProp.type === 'Identifier' &&\x0d\n      exprStr.at(astProp.start - 1) === '.'\x0d\n    ) {\x0d\n      // We have something like `obj.foo.x` where `foo` is the identifier\x0d\n      return propHasGetterOrIsProxy(obj\x2C astProp.name\x2C cb);\x0d\n    }\x0d\n\x0d\n    return evalFn(\x0d\n      // Note: this eval runs the property expression\x2C which might be side-effectful\x2C for example\x0d\n      //       the user could be running `obj[getKey()].` where `getKey()` has some side effects.\x0d\n      //       Arguably this behavior should not be too surprising\x2C but if it turns out that it is\x2C\x0d\n      //       then we can revisit this behavior and add logic to analyze the property expression\x0d\n      //       and eval it only if we can confidently say that it can't have any side effects\x0d\n      `try { ${exprStr.slice(astProp.start\x2C astProp.end)} } catch {} `\x2C\x0d\n      ctx\x2C\x0d\n      getREPLResourceName()\x2C\x0d\n      (err\x2C evaledProp) => {\x0d\n        if (err) {\x0d\n          return cb(false);\x0d\n        }\x0d\n\x0d\n        if (typeof evaledProp === 'string') {\x0d\n          return propHasGetterOrIsProxy(obj\x2C evaledProp\x2C cb);\x0d\n        }\x0d\n\x0d\n        return cb(false);\x0d\n      }\x2C\x0d\n    );\x0d\n  }\x0d\n\x0d\n  return callback(false);\x0d\n}\x0d\n\x0d\n/**\x0d\n * Given an object and a property name\x2C checks whether the property has a getter\x2C if not checks whether its\x0d\n * value is a proxy.\x0d\n *\x0d\n * Note: the order is relevant here\x2C we want to check whether the property has a getter _before_ we check\x0d\n *       whether its value is a proxy\x2C to ensure that is the property does have a getter we don't end up\x0d\n *       triggering it when checking its value\x0d\n * @param {any} obj The target object\x0d\n * @param {string | number | bigint | boolean | RegExp} prop The target property\x0d\n * @param {(includes: boolean) => void} cb Callback that will be called with the result of the operation\x0d\n * @returns {void}\x0d\n */\x0d\nfunction propHasGetterOrIsProxy(obj\x2C prop\x2C cb) {\x0d\n  const propDescriptor = ObjectGetOwnPropertyDescriptor(\x0d\n    obj\x2C\x0d\n    prop\x2C\x0d\n  );\x0d\n  const propHasGetter = typeof propDescriptor?.get === 'function';\x0d\n  if (propHasGetter) {\x0d\n    return cb(true);\x0d\n  }\x0d\n\x0d\n  if (isProxy(obj[prop])) {\x0d\n    return cb(true);\x0d\n  }\x0d\n\x0d\n  return cb(false);\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  complete\x2C\x0d\n};\x0d\n
