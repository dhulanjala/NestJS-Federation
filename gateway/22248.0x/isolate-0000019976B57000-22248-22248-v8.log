script-source,1020,C:\\development\\NestJS Federation\\gateway\\node_modules\\@npmcli\\redact\\lib\\matchers.js,const TYPE_REGEX = 'regex'\nconst TYPE_URL = 'url'\nconst TYPE_PATH = 'path'\n\nconst NPM_SECRET = {\n  type: TYPE_REGEX\x2C\n  pattern: /\\b(npms?_)[a-zA-Z0-9]{36\x2C48}\\b/gi\x2C\n  replacement: `[REDACTED_NPM_SECRET]`\x2C\n}\n\nconst AUTH_HEADER = {\n  type: TYPE_REGEX\x2C\n  pattern: /\\b(Basic\\s+|Bearer\\s+)[\\w+=\\-.]+\\b/gi\x2C\n  replacement: `[REDACTED_AUTH_HEADER]`\x2C\n}\n\nconst JSON_WEB_TOKEN = {\n  type: TYPE_REGEX\x2C\n  pattern: /\\b[A-Za-z0-9-_]{10\x2C}(?!\\.\\d+\\.)\\.[A-Za-z0-9-_]{3\x2C}\\.[A-Za-z0-9-_]{20\x2C}\\b/gi\x2C\n  replacement: `[REDACTED_JSON_WEB_TOKEN]`\x2C\n}\n\nconst UUID = {\n  type: TYPE_REGEX\x2C\n  pattern: /\\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\b/gi\x2C\n  replacement: `[REDACTED_UUID]`\x2C\n}\n\nconst URL_MATCHER = {\n  type: TYPE_REGEX\x2C\n  pattern: /(?:https?|ftp):\\/\\/[^\\s/"$.?#].[^\\s"]*/gi\x2C\n  replacement: '[REDACTED_URL]'\x2C\n}\n\nconst DEEP_HEADER_AUTHORIZATION = {\n  type: TYPE_PATH\x2C\n  predicate: ({ path }) => path.endsWith('.headers.authorization')\x2C\n  replacement: '[REDACTED_HEADER_AUTHORIZATION]'\x2C\n}\n\nconst DEEP_HEADER_SET_COOKIE = {\n  type: TYPE_PATH\x2C\n  predicate: ({ path }) => path.endsWith('.headers.set-cookie')\x2C\n  replacement: '[REDACTED_HEADER_SET_COOKIE]'\x2C\n}\n\nconst DEEP_HEADER_COOKIE = {\n  type: TYPE_PATH\x2C\n  predicate: ({ path }) => path.endsWith('.headers.cookie')\x2C\n  replacement: '[REDACTED_HEADER_COOKIE]'\x2C\n}\n\nconst REWRITE_REQUEST = {\n  type: TYPE_PATH\x2C\n  predicate: ({ path }) => path.endsWith('.request')\x2C\n  replacement: (input) => ({\n    method: input?.method\x2C\n    path: input?.path\x2C\n    headers: input?.headers\x2C\n    url: input?.url\x2C\n  })\x2C\n}\n\nconst REWRITE_RESPONSE = {\n  type: TYPE_PATH\x2C\n  predicate: ({ path }) => path.endsWith('.response')\x2C\n  replacement: (input) => ({\n    data: input?.data\x2C\n    status: input?.status\x2C\n    headers: input?.headers\x2C\n  })\x2C\n}\n\nmodule.exports = {\n  TYPE_REGEX\x2C\n  TYPE_URL\x2C\n  TYPE_PATH\x2C\n  NPM_SECRET\x2C\n  AUTH_HEADER\x2C\n  JSON_WEB_TOKEN\x2C\n  UUID\x2C\n  URL_MATCHER\x2C\n  DEEP_HEADER_AUTHORIZATION\x2C\n  DEEP_HEADER_SET_COOKIE\x2C\n  DEEP_HEADER_COOKIE\x2C\n  REWRITE_REQUEST\x2C\n  REWRITE_RESPONSE\x2C\n}\n
