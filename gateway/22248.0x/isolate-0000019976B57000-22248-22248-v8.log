rmalizeServerName(options\x2C req);\x0d\n\x0d\n  const name = this.getName(options);\x0d\n  this.sockets[name] ||= [];\x0d\n\x0d\n  const freeSockets = this.freeSockets[name];\x0d\n  let socket;\x0d\n  if (freeSockets) {\x0d\n    while (freeSockets.length && freeSockets[0].destroyed) {\x0d\n      freeSockets.shift();\x0d\n    }\x0d\n    socket = this.scheduling === 'fifo' ?\x0d\n      freeSockets.shift() :\x0d\n      freeSockets.pop();\x0d\n    if (!freeSockets.length)\x0d\n      delete this.freeSockets[name];\x0d\n  }\x0d\n\x0d\n  const freeLen = freeSockets ? freeSockets.length : 0;\x0d\n  const sockLen = freeLen + this.sockets[name].length;\x0d\n\x0d\n  // Reusing a socket from the pool.\x0d\n  if (socket) {\x0d\n    asyncResetHandle(socket);\x0d\n    this.reuseSocket(socket\x2C req);\x0d\n    setRequestSocket(this\x2C req\x2C socket);\x0d\n    this.sockets[name].push(socket);\x0d\n  } else if (sockLen < this.maxSockets &&\x0d\n             this.totalSocketCount < this.maxTotalSockets) {\x0d\n    // If we are under maxSockets create a new one.\x0d\n    this.createSocket(req\x2C options\x2C (err\x2C socket) => {\x0d\n      if (err) {\x0d\n        handleSocketAfterProxy(err\x2C req);\x0d\n        debug('call onSocket'\x2C sockLen\x2C freeLen);\x0d\n        req.onSocket(socket\x2C err);\x0d\n        return;\x0d\n      }\x0d\n\x0d\n      setRequestSocket(this\x2C req\x2C socket);\x0d\n    });\x0d\n  } else {\x0d\n    debug('wait for socket');\x0d\n    // We are over limit so we'll add it to the queue.\x0d\n    this.requests[name] ||= [];\x0d\n\x0d\n    // Used to create sockets for pending requests from different origin\x0d\n    req[kRequestOptions] = options;\x0d\n    // Used to capture the original async context.\x0d\n    req[kRequestAsyncResource] = new AsyncResource('QueuedRequest');\x0d\n\x0d\n    this.requests[name].push(req);\x0d\n  }\x0d\n};\x0d\n\x0d\nAgent.prototype.createSocket = function createSocket(req\x2C options\x2C cb) {\x0d\n  // Here the agent options will override per-request options.\x0d\n  options = { __proto__: null\x2C ...options\x2C ...this.options };\x0d\n  if (options.socketPath)\x0d\n    options.path = options.socketPath;\x0d\n\x0d\n  normalizeServerName(options\x2C req);\x0d\n\x0d\n  // Make sure per-request timeout is respected.\x0d\n  const timeout = req.timeout || this.options.timeout || undefined;\x0d\n  if (timeout) {\x0d\n    options.timeout = timeout;\x0d\n  }\x0d\n\x0d\n  const name = this.getName(options);\x0d\n  options._agentKey = name;\x0d\n\x0d\n  debug('createConnection'\x2C name);\x0d\n  options.encoding = null;\x0d\n\x0d\n  const oncreate = once((err\x2C s) => {\x0d\n    if (err)\x0d\n      return cb(err);\x0d\n    this.sockets[name] ||= [];\x0d\n    this.sockets[name].push(s);\x0d\n    this.totalSocketCount++;\x0d\n    debug('sockets'\x2C name\x2C this.sockets[name].length\x2C this.totalSocketCount);\x0d\n    installListeners(this\x2C s\x2C options);\x0d\n    cb(null\x2C s);\x0d\n  });\x0d\n  // When keepAlive is true\x2C pass the related options to createConnection\x0d\n  if (this.keepAlive) {\x0d\n    options.keepAlive = this.keepAlive;\x0d\n    options.keepAliveInitialDelay = this.keepAliveMsecs;\x0d\n  }\x0d\n\x0d\n  const newSocket = this.createConnection(options\x2C oncreate);\x0d\n  // In the case where we are proxying through a tunnel for HTTPS\x2C only add\x0d\n  // the socket to the pool and install/invoke the listeners after\x0d\n  // the tunnel is successfully established\x2C so that actual operations\x0d\n  // on the socket all go through the tunnel. Errors emitted during\x0d\n  // tunnel establishment will be handled in the createConnection method\x0d\n  // in lib/https.js.\x0d\n  if (newSocket && !newSocket[kWaitForProxyTunnel])\x0d\n    oncreate(null\x2C newSocket);\x0d\n};\x0d\n\x0d\nfunction normalizeServerName(options\x2C req) {\x0d\n  if (!options.servername && options.servername !== '')\x0d\n    options.servername = calculateServerName(options\x2C req);\x0d\n}\x