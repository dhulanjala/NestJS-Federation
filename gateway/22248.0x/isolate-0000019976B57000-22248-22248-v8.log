script-source,947,C:\\development\\NestJS Federation\\gateway\\node_modules\\@npmcli\\fs\\lib\\common\\get-options.js,// given an input that may or may not be an object\x2C return an object that has\n// a copy of every defined property listed in 'copy'. if the input is not an\n// object\x2C assign it to the property named by 'wrap'\nconst getOptions = (input\x2C { copy\x2C wrap }) => {\n  const result = {}\n\n  if (input && typeof input === 'object') {\n    for (const prop of copy) {\n      if (input[prop] !== undefined) {\n        result[prop] = input[prop]\n      }\n    }\n  } else {\n    result[wrap] = input\n  }\n\n  return result\n}\n\nmodule.exports = getOptions\n
