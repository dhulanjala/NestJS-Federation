n\x0d\nfunction setGlobalProxyFromEnv(env = process.env) {\x0d\n  validateObject(env\x2C 'proxyEnv');\x0d\n  const httpProxy = parseProxyUrl(env\x2C 'http:');\x0d\n  const httpsProxy = parseProxyUrl(env\x2C 'https:');\x0d\n  const noProxy = env.no_proxy || env.NO_PROXY;\x0d\n\x0d\n  if (!httpProxy && !httpsProxy) {\x0d\n    return () => {};\x0d\n  }\x0d\n\x0d\n  if (httpProxy && !URL.canParse(httpProxy)) {\x0d\n    throw new ERR_PROXY_INVALID_CONFIG(httpProxy);\x0d\n  }\x0d\n  if (httpsProxy && !URL.canParse(httpsProxy)) {\x0d\n    throw new ERR_PROXY_INVALID_CONFIG(httpsProxy);\x0d\n  }\x0d\n\x0d\n  let originalDispatcher\x2C originalHttpsAgent\x2C originalHttpAgent;\x0d\n  if (httpProxy || httpsProxy) {\x0d\n    // Set it for fetch.\x0d\n    const { setGlobalDispatcher\x2C getGlobalDispatcher\x2C EnvHttpProxyAgent } = lazyUndici();\x0d\n    const envHttpProxyAgent = new EnvHttpProxyAgent({\x0d\n      __proto__: null\x2C httpProxy\x2C httpsProxy\x2C noProxy\x2C\x0d\n    });\x0d\n    originalDispatcher = getGlobalDispatcher();\x0d\n    setGlobalDispatcher(envHttpProxyAgent);\x0d\n  }\x0d\n\x0d\n  if (httpProxy) {\x0d\n    originalHttpAgent = module.exports.globalAgent;\x0d\n    module.exports.globalAgent = getGlobalAgent(env\x2C httpAgent.Agent);\x0d\n  }\x0d\n  if (httpsProxy && !!process.versions.openssl) {\x0d\n    const https = require('https');\x0d\n    originalHttpsAgent = https.globalAgent;\x0d\n    https.globalAgent = getGlobalAgent(env\x2C https.Agent);\x0d\n  }\x0d\n\x0d\n  return function restore() {\x0d\n    if (originalDispatcher) {\x0d\n      const { setGlobalDispatcher } = lazyUndici();\x0d\n      setGlobalDispatcher(originalDispatcher);\x0d\n    }\x0d\n    if (originalHttpAgent) {\x0d\n      module.exports.globalAgent = originalHttpAgent;\x0d\n    }\x0d\n    if (originalHttpsAgent) {\x0d\n      require('https').globalAgent = originalHttpsAgent;\x0d\n    }\x0d\n  };\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  _connectionListener\x2C\x0d\n  METHODS: methods.toSorted()\x2C\x0d\n  STATUS_CODES\x2C\x0d\n  Agent: httpAgent.Agent\x2C\x0d\n  ClientRequest\x2C\x0d\n  IncomingMessage\x2C\x0d\n  OutgoingMessage\x2C\x0d\n  Server\x2C\x0d\n  ServerResponse\x2C\x0d\n  createServer\x2C\x0d\n  validateHeaderName\x2C\x0d\n  validateHeaderValue\x2C\x0d\n  get\x2C\x0d\n  request\x2C\x0d\n  setMaxIdleHTTPParsers(max) {\x0d\n    validateInteger(max\x2C 'max'\x2C 1);\x0d\n    parsers.max = max;\x0d\n  }\x2C\x0d\n  setGlobalProxyFromEnv\x2C\x0d\n};\x0d\n\x0d\nObjectDefineProperty(module.exports\x2C 'maxHeaderSize'\x2C {\x0d\n  __proto__: null\x2C\x0d\n  configurable: true\x2C\x0d\n  enumerable: true\x2C\x0d\n  get() {\x0d\n    if (maxHeaderSize === undefined) {\x0d\n      const { getOptionValue } = require('internal/options');\x0d\n      maxHeaderSize = getOptionValue('--max-http-header-size');\x0d\n    }\x0d\n\x0d\n    return maxHeaderSize;\x0d\n  }\x2C\x0d\n});\x0d\n\x0d\nObjectDefineProperty(module.exports\x2C 'globalAgent'\x2C {\x0d\n  __proto__: null\x2C\x0d\n  configurable: true\x2C\x0d\n  enumerable: true\x2C\x0d\n  get() {\x0d\n    return httpAgent.globalAgent;\x0d\n  }\x2C\x0d\n  set(value) {\x0d\n    httpAgent.globalAgent = value;\x0d\n  }\x2C\x0d\n});\x0d\n\x0d\nObjectDefineProperty(module.exports\x2C 'WebSocket'\x2C {\x0d\n  __proto__: null\x2C\x0d\n  configurable: true\x2C\x0d\n  enumerable: true\x2C\x0d\n  get() {\x0d\n    return lazyUndici().WebSocket;\x0d\n  }\x2C\x0d\n});\x0d\n\x0d\nObjectDefineProperty(module.exports\x2C 'CloseEvent'\x2C {\x0d\n  __proto__: null\x2C\x0d\n  configurable: true\x2C\x0d\n  enumerable: true\x2C\x0d\n  get() {\x0d\n    return lazyUndici().CloseEvent;\x0d\n  }\x2C\x0d\n});\x0d\n\x0d\nObjectDefineProperty(module.exports\x2C 'MessageEvent'\x2C {\x0d\n  __proto__: null\x2C\x0d\n  configurable: true\x2C\x0d\n  enumerable: true\x2C\x0d\n  get() {\x0d\n    return lazyUndici().MessageEvent;\x0d\n  }\x2C\x0d\n});\x0d\n
