AX_EXP > 1e7\x2C e.g. new BigNumber('1e100000000').plus(1) may be slow.\x0d\n      MAX_EXP = 1e7\x2C                           // 1 to MAX\x0d\n\x0d\n      // Whether to use cryptographically-secure random number generation\x2C if available.\x0d\n      CRYPTO = false\x2C                          // true or false\x0d\n\x0d\n      // The modulo mode used when calculating the modulus: a mod n.\x0d\n      // The quotient (q = a / n) is calculated according to the corresponding rounding mode.\x0d\n      // The remainder (r) is calculated as: r = a - n * q.\x0d\n      //\x0d\n      // UP        0 The remainder is positive if the dividend is negative\x2C else is negative.\x0d\n      // DOWN      1 The remainder has the same sign as the dividend.\x0d\n      //             This modulo mode is commonly known as 'truncated division' and is\x0d\n      //             equivalent to (a % n) in JavaScript.\x0d\n      // FLOOR     3 The remainder has the same sign as the divisor (Python %).\x0d\n      // HALF_EVEN 6 This modulo mode implements the IEEE 754 remainder function.\x0d\n      // EUCLID    9 Euclidian division. q = sign(n) * floor(a / abs(n)).\x0d\n      //             The remainder is always positive.\x0d\n      //\x0d\n      // The truncated division\x2C floored division\x2C Euclidian division and IEEE 754 remainder\x0d\n      // modes are commonly used for the modulus operation.\x0d\n      // Although the other rounding modes can also be used\x2C they may not give useful results.\x0d\n      MODULO_MODE = 1\x2C                         // 0 to 9\x0d\n\x0d\n      // The maximum number of significant digits of the result of the exponentiatedBy operation.\x0d\n      // If POW_PRECISION is 0\x2C there will be unlimited significant digits.\x0d\n      POW_PRECISION = 0\x2C                       // 0 to MAX\x0d\n\x0d\n      // The format specification used by the BigNumber.prototype.toFormat method.\x0d\n      FORMAT = {\x0d\n        prefix: ''\x2C\x0d\n        groupSize: 3\x2C\x0d\n        secondaryGroupSize: 0\x2C\x0d\n        groupSeparator: '\x2C'\x2C\x0d\n        decimalSeparator: '.'\x2C\x0d\n        fractionGroupSize: 0\x2C\x0d\n        fractionGroupSeparator: '\\xA0'\x2C        // non-breaking space\x0d\n        suffix: ''\x0d\n      }\x2C\x0d\n\x0d\n      // The alphabet used for base conversion. It must be at least 2 characters long\x2C with no '+'\x2C\x0d\n      // '-'\x2C '.'\x2C whitespace\x2C or repeated character.\x0d\n      // '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ$_'\x0d\n      ALPHABET = '0123456789abcdefghijklmnopqrstuvwxyz'\x2C\x0d\n      alphabetHasNormalDecimalDigits = true;\x0d\n\x0d\n\x0d\n    //------------------------------------------------------------------------------------------\x0d\n\x0d\n\x0d\n    // CONSTRUCTOR\x0d\n\x0d\n\x0d\n    /*\x0d\n     * The BigNumber constructor and exported function.\x0d\n     * Create and return a new instance of a BigNumber object.\x0d\n     *\x0d\n     * v {number|string|BigNumber} A numeric value.\x0d\n     * [b] {number} The base of v. Integer\x2C 2 to ALPHABET.length inclusive.\x0d\n     */\x0d\n    function BigNumber(v\x2C b) {\x0d\n      var alphabet\x2C c\x2C caseChanged\x2C e\x2C i\x2C isNum\x2C len\x2C str\x2C\x0d\n        x = this;\x0d\n\x0d\n      // Enable constructor call without `new`.\x0d\n      if (!(x instanceof BigNumber)) return new BigNumber(v\x2C b);\x0d\n\x0d\n      if (b == null) {\x0d\n\x0d\n        if (v && v._isBigNumber === true) {\x0d\n          x.s = v.s;\x0d\n\x0d\n          if (!v.c || v.e > MAX_EXP) {\x0d\n            x.c = x.e = null;\x0d\n          } else if (v.e < MIN_EXP) {\x0d\n            x.c = [x.e = 0];\x0d\n          } else {\x0d\n            x.e = v.e;\x0d\n            x.c = v.c.slice();\x0d\n          }\x0d\n\x0d\n          return;\x0d\n        }\x0d\n\x0d\n        if ((isNum = typeof v == 'number') && v * 0 == 0) {\x0d\n\x0d\n          // Use `1 / n` to handle minus zero also.\x0d\n          x.s = 1 / v < 0 ? (v = -v\x2C -1) : 1;\x0d\n\x0d\n          // Fast path for integers\x2C where n < 2147483648 (2**31).\x0d\n          if (v === ~~v) {\x0d\n            for (e = 0\x2C i = v; i >= 10; i /= 10\x2C e++);\x0d\n\x0d\n            if (e > MAX_EXP) {\x0d\n              x.c = x.e = null;\x0d\n            } else {\x0d\n              x.e = e;\x0d\n              x.c = [v];\x0d\n            }\x0d\n\x0d\n            return;\x0d\n          }\x0d\n\x0d\n          str = String(v);\x0d\n        } else {\x0d\n\x0d\n          if (!isNumeric.test(str = String(v))) return parseNumeric(x\x2C str\x2C isNum);\x0d\n\x0d\n          x.s = str.charCodeAt(0) == 45 ? (str = str.slice(1)\x2C -1) : 1;\x0d\n        }\x0d\n\x0d\n        // Decimal point?\x0d\n        if ((e = str.indexOf('.')) > -1) str = str.replace('.'\x2C '');\x0d\n\x0d\n        // Exponential form?\x0d\n        if ((i = str.search(/e/i)) > 0) {\x0d\n\x0d\n          // Determine exponent.\x0d\n          if (e < 0) e = i;\x0d\n          e += +str.slice(i + 1);\x0d\n          str = str.substring(0\x2C i);\x0d\n        } else if (e < 0) {\x0d\n\x0d\n          // Integer.\x0d\n          e = str.length;\x0d\n        }\x0d\n\x0d\n      } else {\x0d\n\x0d\n        // '[BigNumber Error] Base {not a primitive number|not an integer|out of range}: {b}'\x0d\n        intCheck(b\x2C 2\x2C ALPHABET.length\x2C 'Base');\x0d\n\x0d\n        // Allow exponential notation to be used with base 10 argument\x2C while\x0d\n        // also rounding to DECIMAL_PLACES as with other bases.\x0d\n        if (b == 10 && alphabetHasNormalDecimalDigits) {\x0d\n          x = new BigNumber(v);\x0d\n          return round(x\x2C DECIMAL_PLACES + x.e + 1\x2C ROUNDING_MODE);\x0d\n        }\x0d\n\x0d\n        str = String(v);\x0d\n\x0d\n        if (isNum = typeof v == 'number') {\x0d\n\x0d\n          // Avoid potential interpretation of Infinity and NaN as base 44+ values.\x0d\n          if (v * 0 != 0) return parseNumeric(x\x2C str\x2C isNum\x2C b);\x0d\n\x0d\n          x.s = 1 / v < 0 ? (str = str.slice(1)\x2C -1) : 1;\x0d\n\x0d\n          // '[BigNumber Error] Number primitive has more than 15 significant digits: {n}'\x0d\n          if (BigNumber.DEBUG && str.replace(/^0\\.0*|\\./\x2C '').length > 15) {\x0d\n            throw Error\x0d\n             (tooManyDigits + v);\x0d\n          }\x0d\n        } else {\x0d\n          x.s = str.charCodeAt(0) === 45 ? (str = str.slice(1)\x2C -1) : 1;\x0d\n        }\x0d\n\x0d\n        alphabet = ALPHABET.slice(0\x2C b);\x0d\n        e = i = 0;\x0d\n\x0d\n        // Check that str is a valid base b number.\x0d\n        // Don't use RegExp\x2C so alphabet can contain special characters.\x0d\n        for (len = str.length; i < len; i++) {\x0d\n          if (alphabet.indexOf(c = str.charAt(i)) < 0) {\x0d\n            if (c == '.') {\x0d\n\x0d\n              // If '.' is not the first character and it has not be found before.\x0d\n              if (i > e) {\x0d\n                e = len;\x0d\n                continue;\x0d\n              }\x0d\n            } else if (!caseChanged) {\x0d\n\x0d\n              // Allow e.g. hexadecimal 'FF' as well as 'ff'.\x0d\n              if (str == str.toUpperCase() && (str = str.toLowerCase()) ||\x0d\n                  str == str.toLowerCase() && (str = str.toUpperCase())) {\x0d\n                caseChanged = true;\x0d\n                i = -1;\x0d\n                e = 0;\x0d\n                continue;\x0d\n              }\x0d\n            }\x0d\n\x0d\n            return parseNumeric(x\x2C String(v)\x2C isNum\x2C b);\x0d\n          }\x0d\n        }\x0d\n\x0d\n        // Prevent later check for length on converted number.\x0d\n        isNum = false;\x0d\n        str = convertBase(str\x2C b\x2C 10\x2C x.s);\x0d\n\x0d\n        // Decimal point?\x0d\n        if ((e = str.indexOf('.')) > -1) str = str.replace('.'\x2C '');\x0d\n        else e = str.length;\x0d\n      }\x0d\n\x0d\n      // Determine leading zeros.\x0d\n      for (i = 0; str.charCodeAt(i) === 48; i++);\x0d