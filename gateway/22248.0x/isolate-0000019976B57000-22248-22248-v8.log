script-source,1021,C:\\development\\NestJS Federation\\gateway\\node_modules\\@npmcli\\redact\\lib\\utils.js,const {\n  URL_MATCHER\x2C\n  TYPE_URL\x2C\n  TYPE_REGEX\x2C\n  TYPE_PATH\x2C\n} = require('./matchers')\n\n/**\n * creates a string of asterisks\x2C\n * this forces a minimum asterisk for security purposes\n */\nconst asterisk = (length = 0) => {\n  length = typeof length === 'string' ? length.length : length\n  if (length < 8) {\n    return '*'.repeat(8)\n  }\n  return '*'.repeat(length)\n}\n\n/**\n * escapes all special regex chars\n * @see https://stackoverflow.com/a/9310752\n * @see https://github.com/tc39/proposal-regex-escaping\n */\nconst escapeRegExp = (text) => {\n  return text.replace(/[-[\\]{}()*+?.\x2C\\\\^$|#\\s]/g\x2C `\\\\$&`)\n}\n\n/**\n * provieds a regex "or" of the url versions of a string\n */\nconst urlEncodeRegexGroup = (value) => {\n  const decoded = decodeURIComponent(value)\n  const encoded = encodeURIComponent(value)\n  const union = [...new Set([encoded\x2C decoded\x2C value])].map(escapeRegExp).join('|')\n  return union\n}\n\n/**\n * a tagged template literal that returns a regex ensures all variables are excaped\n */\nconst urlEncodeRegexTag = (strings\x2C ...values) => {\n  let pattern = ''\n  for (let i = 0; i < values.length; i++) {\n    pattern += strings[i] + `(${urlEncodeRegexGroup(values[i])})`\n  }\n  pattern += strings[strings.length - 1]\n  return new RegExp(pattern)\n}\n\n/**\n * creates a matcher for redacting url hostname\n */\nconst redactUrlHostnameMatcher = ({ hostname\x2C replacement } = {}) => ({\n  type: TYPE_URL\x2C\n  predicate: ({ url }) => url.hostname === hostname\x2C\n  pattern: ({ url }) => {\n    return urlEncodeRegexTag`(^${url.protocol}//${url.username}:.+@)?${url.hostname}`\n  }\x2C\n  replacement: `$1${replacement || asterisk()}`\x2C\n})\n\n/**\n * creates a matcher for redacting url search / query parameter values\n */\nconst redactUrlSearchParamsMatcher = ({ param\x2C replacement } = {}) => ({\n  type: TYPE_URL\x2C\n  predicate: ({ url }) => url.searchParams.has(param)\x2C\n  pattern: ({ url }) => urlEncodeRegexTag`(${param}=)${url.searchParams.get(param)}`\x2C\n  replacement: `$1${replacement || asterisk()}`\x2C\n})\n\n/** creates a matcher for redacting the url password */\nconst redactUrlPasswordMatcher = ({ replacement } = {}) => ({\n  type: TYPE_URL\x2C\n  predicate: ({ url }) => url.password\x2C\n  pattern: ({ url }) => urlEncodeRegexTag`(^${url.protocol}//${url.username}:)${url.password}`\x2C\n  replacement: `$1${replacement || asterisk()}`\x2C\n})\n\nconst redactUrlReplacement = (...matchers) => (subValue) => {\n  try {\n    const url = new URL(subValue)\n    return redactMatchers(...matchers)(subValue\x2C { url })\n  } catch (err) {\n    return subValue\n  }\n}\n\n/**\n * creates a matcher / submatcher for urls\x2C this function allows you to first\n * collect all urls within a larger string and then pass those urls to a\n * submatcher\n *\n * @example\n * console.log("this will first match all urls\x2C then pass those urls to the password patcher")\n * redactMatchers(redactUrlMatcher(redactUrlPasswordMatcher()))\n *\n * @example\n * console.log(\n *   "this will assume you are passing in a string that is a url\x2C and will redact the password"\n * )\n * redactMatchers(redactUrlPasswordMatcher())\n *\n */\nconst redactUrlMatcher = (...matchers) => {\n  return {\n    ...URL_MATCHER\x2C\n    replacement: redactUrlReplacement(...matchers)\x2C\n  }\n}\n\nconst matcherFunctions = {\n  [TYPE_REGEX]: (matcher) => (value) => {\n    if (typeof value === 'string') {\n      value = value.replace(matcher.pattern\x2C matcher.replacement)\n    }\n    return value\n  }\x2C\n  [TYPE_URL]: (matcher) => (value\x2C ctx) => {\n    if (typeof value === 'string') {\n      try {\n        const url = ctx?.url || new URL(value)\n        const { predicate\x2C pattern } = matcher\n        const predicateValue = predicate({ url })\n        if (predicateValue) {\n          value = value.replace(pattern({ url })\x2C matcher.replacement)\n        }\n      } catch (_e) {\n        return value\n      }\n    }\n    return value\n  }\x2C\n  [TYPE_PATH]: (matcher) => (value\x2C ctx) => {\n    const rawPath = ctx?.path\n    const path = rawPath.join('.').toLowerCase()\n    const { predicate\x2C replacement } = matcher\n    const replace = typeof replacement === 'function' ? replacement : () => replacement\n    const shouldRun = predicate({ rawPath\x2C path })\n    if (shouldRun) {\n      value = replace(value\x2C { rawPath\x2C path })\n    }\n    return value\n  }\x2C\n}\n\n/** converts a matcher to a function */\nconst redactMatcher = (matcher) => {\n  return matcherFunctions[matcher.type](matcher)\n}\n\n/** converts a series of matchers to a function */\nconst redactMatchers = (...matchers) => (value\x2C ctx) => {\n  const flatMatchers = matchers.flat()\n  return flatMatchers.reduce((result\x2C matcher) => {\n    const fn = (typeof matcher === 'function') ? matcher : redactMatcher(matcher)\n    return fn(result\x2C ctx)\n  }\x2C value)\n}\n\n/**\n * replacement handler\x2C keeping $1 (if it exists) and replacing the\n * rest of the string with asterisks\x2C maintaining string length\n */\nconst redactDynamicReplacement = () => (value\x2C start) => {\n  if (typeof start === 'number') {\n    return asterisk(value)\n  }\n  return start + asterisk(value.substring(start.length).length)\n}\n\n/**\n * replacement handler\x2C keeping $1 (if it exists) and replacing the\n * rest of the string with a fixed number of asterisks\n */\nconst redactFixedReplacement = (length) => (_value\x2C start) => {\n  if (typeof start === 'number') {\n    return asterisk(length)\n  }\n  return start + asterisk(length)\n}\n\nconst redactUrlPassword = (value\x2C replacement) => {\n  return redactMatchers(redactUrlPasswordMatcher({ replacement }))(value)\n}\n\nmodule.exports = {\n  asterisk\x2C\n  escapeRegExp\x2C\n  urlEncodeRegexGroup\x2C\n  urlEncodeRegexTag\x2C\n  redactUrlHostnameMatcher\x2C\n  redactUrlSearchParamsMatcher\x2C\n  redactUrlPasswordMatcher\x2C\n  redactUrlMatcher\x2C\n  redactUrlReplacement\x2C\n  redactDynamicReplacement\x2C\n  redactFixedReplacement\x2C\n  redactMatchers\x2C\n  redactUrlPassword\x2C\n}\n
