script-source,1008,C:\\development\\NestJS Federation\\gateway\\node_modules\\cacache\\lib\\rm.js,'use strict'\n\nconst { rm } = require('fs/promises')\nconst glob = require('./util/glob.js')\nconst index = require('./entry-index')\nconst memo = require('./memoization')\nconst path = require('path')\nconst rmContent = require('./content/rm')\n\nmodule.exports = entry\nmodule.exports.entry = entry\n\nfunction entry (cache\x2C key\x2C opts) {\n  memo.clearMemoized()\n  return index.delete(cache\x2C key\x2C opts)\n}\n\nmodule.exports.content = content\n\nfunction content (cache\x2C integrity) {\n  memo.clearMemoized()\n  return rmContent(cache\x2C integrity)\n}\n\nmodule.exports.all = all\n\nasync function all (cache) {\n  memo.clearMemoized()\n  const paths = await glob(path.join(cache\x2C '*(content-*|index-*)')\x2C { silent: true\x2C nosort: true })\n  return Promise.all(paths.map((p) => rm(p\x2C { recursive: true\x2C force: true })))\n}\n
