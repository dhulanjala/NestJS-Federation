x0d\n    }\x0d\n  }\x0d\n\x0d\n  let packageJSONUrl = new URL(`./node_modules/${packageName}/package.json`\x2C base);\x0d\n  let packageJSONPath = fileURLToPath(packageJSONUrl);\x0d\n  let lastPath;\x0d\n  do {\x0d\n    const stat = internalFsBinding.internalModuleStat(\x0d\n      StringPrototypeSlice(packageJSONPath\x2C 0\x2C packageJSONPath.length - 13)\x2C\x0d\n    );\x0d\n    // Check for !stat.isDirectory()\x0d\n    if (stat !== 1) {\x0d\n      lastPath = packageJSONPath;\x0d\n      packageJSONUrl = new URL(\x0d\n        `${isScoped ? '../' : ''}../../../node_modules/${packageName}/package.json`\x2C\x0d\n        packageJSONUrl\x2C\x0d\n      );\x0d\n      packageJSONPath = fileURLToPath(packageJSONUrl);\x0d\n      continue;\x0d\n    }\x0d\n\x0d\n    // Package match.\x0d\n    return { packageJSONUrl\x2C packageJSONPath\x2C packageSubpath };\x0d\n  } while (packageJSONPath.length !== lastPath.length);\x0d\n\x0d\n  throw new ERR_MODULE_NOT_FOUND(packageName\x2C fileURLToPath(base)\x2C null);\x0d\n}\x0d\n\x0d\n/** @type {import('./esm/resolve.js').defaultResolve} */\x0d\nlet defaultResolve;\x0d\n/**\x0d\n * @param {string | URL} specifier The location for which to get the "root" package.json\x0d\n * @param {string | URL} [base] The location of the current module (ex file://tmp/foo.js).\x0d\n * @returns {string}\x0d\n */\x0d\nfunction findPackageJSON(specifier\x2C base = 'data:') {\x0d\n  if (arguments.length === 0) {\x0d\n    throw new ERR_MISSING_ARGS('specifier');\x0d\n  }\x0d\n  try {\x0d\n    specifier = `${specifier}`;\x0d\n  } catch {\x0d\n    validateString(specifier\x2C 'specifier');\x0d\n  }\x0d\n\x0d\n  let parentURL = base;\x0d\n  if (!isURL(base)) {\x0d\n    validateString(base\x2C 'base');\x0d\n    parentURL = path.isAbsolute(base) ? pathToFileURL(base) : new URL(base);\x0d\n  }\x0d\n\x0d\n  if (specifier && specifier[0] !== '.' && specifier[0] !== '/' && !URLCanParse(specifier)) {\x0d\n    // If `specifier` is a bare specifier.\x0d\n    const { packageJSONPath } = getPackageJSONURL(specifier\x2C parentURL);\x0d\n    return packageJSONPath;\x0d\n  }\x0d\n\x0d\n  let resolvedTarget;\x0d\n  defaultResolve ??= require('internal/modules/esm/resolve').defaultResolve;\x0d\n\x0d\n  try {\x0d\n    // TODO(@JakobJingleheimer): Detect whether findPackageJSON is being used within a loader\x0d\n    // (possibly piggyback on `allowImportMetaResolve`)\x0d\n    // - When inside\x2C use the default resolve\x0d\n    //   - (I think it's impossible to use the chain because of re-entry & a deadlock from atomics).\x0d\n    // - When outside\x2C use cascadedLoader.resolveSync (not implemented yet\x2C but the pieces exist).\x0d\n    resolvedTarget = defaultResolve(specifier\x2C { parentURL: `${parentURL}` }).url;\x0d\n  } catch (err) {\x0d\n    if (err.code === 'ERR_UNSUPPORTED_DIR_IMPORT') {\x0d\n      resolvedTarget = err.url;\x0d\n    } else {\x0d\n      throw err;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  const pkg = getNearestParentPackageJSON(fileURLToPath(resolvedTarget));\x0d\n\x0d\n  return pkg?.path;\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  read\x2C\x0d\n  getNearestParentPackageJSON\x2C\x0d\n  getPackageScopeConfig\x2C\x0d\n  getPackageType\x2C\x0d\n  getPackageJSONURL\x2C\x0d\n  findPackageJSON\x2C\x0d\n};\x0d\n
