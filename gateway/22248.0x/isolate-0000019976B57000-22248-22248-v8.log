script-source,995,C:\\development\\NestJS Federation\\gateway\\node_modules\\@npmcli\\fs\\lib\\cp\\polyfill.js,// this file is a modified version of the code in node 17.2.0\n// which is\x2C in turn\x2C a modified version of the fs-extra module on npm\n// node core changes:\n// - Use of the assert module has been replaced with core's error system.\n// - All code related to the glob dependency has been removed.\n// - Bring your own custom fs module is not currently supported.\n// - Some basic code cleanup.\n// changes here:\n// - remove all callback related code\n// - drop sync support\n// - change assertions back to non-internal methods (see options.js)\n// - throws ENOTDIR when rmdir gets an ENOENT for a path that exists in Windows\n'use strict'\n\nconst {\n  ERR_FS_CP_DIR_TO_NON_DIR\x2C\n  ERR_FS_CP_EEXIST\x2C\n  ERR_FS_CP_EINVAL\x2C\n  ERR_FS_CP_FIFO_PIPE\x2C\n  ERR_FS_CP_NON_DIR_TO_DIR\x2C\n  ERR_FS_CP_SOCKET\x2C\n  ERR_FS_CP_SYMLINK_TO_SUBDIRECTORY\x2C\n  ERR_FS_CP_UNKNOWN\x2C\n  ERR_FS_EISDIR\x2C\n  ERR_INVALID_ARG_TYPE\x2C\n} = require('./errors.js')\nconst {\n  constants: {\n    errno: {\n      EEXIST\x2C\n      EISDIR\x2C\n      EINVAL\x2C\n      ENOTDIR\x2C\n    }\x2C\n  }\x2C\n} = require('os')\nconst {\n  chmod\x2C\n  copyFile\x2C\n  lstat\x2C\n  mkdir\x2C\n  readdir\x2C\n  readlink\x2C\n  stat\x2C\n  symlink\x2C\n  unlink\x2C\n  utimes\x2C\n} = require('fs/promises')\nconst {\n  dirname\x2C\n  isAbsolute\x2C\n  join\x2C\n  parse\x2C\n  resolve\x2C\n  sep\x2C\n  toNamespacedPath\x2C\n} = require('path')\nconst { fileURLToPath } = require('url')\n\nconst defaultOptions = {\n  dereference: false\x2C\n  errorOnExist: false\x2C\n  filter: undefined\x2C\n  force: true\x2C\n  preserveTimestamps: false\x2C\n  recursive: false\x2C\n}\n\nasync function cp (src\x2C dest\x2C opts) {\n  if (opts != null && typeof opts !== 'object') {\n    throw new ERR_INVALID_ARG_TYPE('options'\x2C ['Object']\x2C opts)\n  }\n  return cpFn(\n    toNamespacedPath(getValidatedPath(src))\x2C\n    toNamespacedPath(getValidatedPath(dest))\x2C\n    { ...defaultOptions\x2C ...opts })\n}\n\nfunction getValidatedPath (fileURLOrPath) {\n  const path = fileURLOrPath != null && fileURLOrPath.href\n      && fileURLOrPath.origin\n    ? fileURLToPath(fileURLOrPath)\n    : fileURLOrPath\n  return path\n}\n\nasync function cpFn (src\x2C dest\x2C opts) {\n  // Warn about using preserveTimestamps on 32-bit node\n  // istanbul ignore next\n  if (opts.preserveTimestamps && process.arch === 'ia32') {\n    const warning = 'Using the preserveTimestamps option in 32-bit ' +\n      'node is not recommended'\n    process.emitWarning(warning\x2C 'TimestampPrecisionWarning')\n  }\n  const stats = await checkPaths(src\x2C dest\x2C opts)\n  const { srcStat\x2C destStat } = stats\n  await checkParentPaths(src\x2C srcStat\x2C dest)\n  if (opts.filter) {\n    return handleFilter(checkParentDir\x2C destStat\x2C src\x2C dest\x2C opts)\n  }\n  return checkParentDir(destStat\x2C src\x2C dest\x2C opts)\n}\n\nasync function checkPaths (src\x2C dest\x2C opts) {\n  const { 0: srcStat\x2C 1: destStat } = await getStats(src\x2C dest\x2C opts)\n  if (destStat) {\n    if (areIdentical(srcStat\x2C destStat)) {\n      throw new ERR_FS_CP_EINVAL({\n        message: 'src and dest cannot be the same'\x2C\n        path: dest\x2C\n        syscall: 'cp'\x2C\n        errno: EINVAL\x2C\n      })\n    }\n    if (srcStat.isDirectory() && !destStat.isDirectory()) {\n      throw new ERR_FS_CP_DIR_TO_NON_DIR({\n        message: `cannot overwrite directory ${src} ` +\n            `with non-directory ${dest}`\x2C\n        path: dest\x2C\n        syscall: 'cp'\x2C\n        errno: EISDIR\x2C\n      })\n    }\n    if (!srcStat.isDirectory() && destStat.isDirectory()) {\n      throw new ERR_FS_CP_NON_DIR_TO_DIR({\n        message: `cannot overwrite non-directory ${src} ` +\n            `with directory ${dest}`\x2C\n        path: dest\x2C\n        syscall: 'cp'\x2C\n        errno: ENOTDIR\x2C\n      })\n    }\n  }\n\n  if (srcStat.isDirectory() && isSrcSubdir(src\x2C dest)) {\n    throw new ERR_FS_CP_EINVAL({\n      message: `cannot copy ${src} to a subdirectory of self ${dest}`\x2C\n      path: dest\x2C\n      syscall: 'cp'\x2C\n      errno: EINVAL\x2C\n    })\n  }\n  return { srcStat\x2C destStat }\n}\n\nfunction areIdentical (srcStat\x2C destStat) {\n  return destStat.ino && destStat.dev && destStat.ino === srcStat.ino &&\n    destStat.dev === srcStat.dev\n}\n\nfunction getStats (src\x2C dest\x2C opts) {\n  const statFunc = opts.dereference ?\n    (file) => stat(file\x2C { bigint: true }) :\n    (file) => lstat(file\x2C { bigint: true })\n  return Promise.all([\n    statFunc(src)\x2C\n    statFunc(dest).catch((err) => {\n      // istanbul ignore next: unsure how to cover.\n      if (err.code === 'ENOENT') {\n        return null\n      }\n      // istanbul ignore next: unsure how to cover.\n      throw err\n    })\x2C\n  ])\n}\n\nasync function checkParentDir (destStat\x2C src\x2C dest\x2C opts) {\n  const destParent = dirname(dest)\n  const dirExists = await pathExists(destParent)\n  if (dirExists) {\n    return getStatsForCopy(destStat\x2C src\x2C dest\x2C opts)\n  }\n  await mkdir(destParent\x2C { recursive: true })\n  return getStatsForCopy(destStat\x2C src\x2C dest\x2C opts)\n}\n\nfunction pathExists (dest) {\n  return stat(dest).then(\n    () => true\x2C\n    // istanbul ignore next: not sure when this would occur\n    (err) => (err.code === 'ENOENT' ? false : Promise.reject(err)))\n}\n\n// Recursively check if dest parent is a subdirectory of src.\n// It works for all file types including symlinks since it\n// checks the src and dest inodes. It starts from the deepest\n// parent and stops once it reaches the src parent or the root path.\nasync function checkParentPaths (src\x2C srcStat\x2C dest) {\n  const srcParent = resolve(dirname(src))\n  const destParent = resolve(dirname(dest))\n  if (destParent === srcParent || destParent === parse(destParent).root) {\n    return\n  }\n  let destStat\n  try {\n    destStat = await stat(destParent\x2C { bigint: true })\n  } catch (err) {\n    // istanbul ignore else: not sure when this would occur\n    if (err.code === 'ENOENT') {\n      return\n    }\n    // istanbul ignore next: not sure when this would occur\n    throw err\n  }\n  if (areIdentical(srcStat\x2C destStat)) {\n    throw new ERR_FS_CP_EINVAL({\n      message: `cannot copy ${src} to a subdirectory of self ${dest}`\x2C\n      path: dest\x2C\n      syscall: 'cp'\x2C\n      errno: EINVAL\x2C\n    })\n  }\n  return checkParentPaths(src\x2C srcStat\x2C destParent)\n}\n\nconst normalizePathToArray = (path) =>\n  resolve(path).split(sep).filter(Boolean)\n\n// Return true if dest is a subdir of src\x2C otherwise false.\n// It only checks the path strings.\nfunction isSrcSubdir (src\x2C dest) {\n  const srcArr = normalizePathToArray(src)\n  const destArr = normalizePathToArray(dest)\n  return srcArr.every((cur\x2C i) => destArr[i] === cur)\n}\n\nasync function handleFilter (onInclude\x2C destStat\x2C src\x2C dest\x2C opts\x2C cb) {\n  const include = await opts.filter(src\x2C dest)\n  if (include) {\n    return onInclude(destStat\x2C src\x2C dest\x2C opts\x2C cb)\n  }\n}\n\nfunction startCopy (destStat\x2C src\x2C dest\x2C opts) {\n  if (opts.filter) {\n    return handleFilter(getStatsForCopy\x2C destStat\x2C src\x2C dest\x2C opts)\n  }\n  return getStatsForCopy(destStat\x2C src\x2C dest\x2C opts)\n}\n\nasync function getStatsForCopy (destStat\x2C src\x2C dest\x2C opts) {\n  const statFn = opts.dereference ? stat : lstat\n  const srcStat = await statFn(src)\n  // istanbul ignore else: can't portably test FIFO\n  if (srcStat.isDirectory() && opts.recursive) {\n    return onDir(srcStat\x2C destStat\x2C src\x2C dest\x2C opts)\n  } else if (srcStat.isDirectory()) {\n    throw new ERR_FS_EISDIR({\n      message: `${src} is a directory (not copied)`\x2C\n      path: src\x2C\n      syscall: 'cp'\x2C\n      errno: EINVAL\x2C\n    })\n  } else if (srcStat.isFile() ||\n            srcStat.isCharacterDevice() ||\n            srcStat.isBlockDevice()) {\n    return onFile(srcStat\x2C destStat\x2C src\x2C dest\x2C opts)\n  } else if (srcStat.isSymbolicLink()) {\n    return onLink(destStat\x2C src\x2C dest)\n  } else if (srcStat.isSocket()) {\n    throw new ERR_FS_CP_SOCKET({\n      message: `cannot copy a socket file: ${dest}`\x2C\n      path: dest\x2C\n      syscall: 'cp'\x2C\n      errno: EINVAL\x2C\n    })\n  } else if (srcStat.isFIFO()) {\n    throw new ERR_FS_CP_FIFO_PIPE({\n      message: `cannot copy a FIFO pipe: ${dest}`\x2C\n      path: dest\x2C\n      syscall: 'cp'\x2C\n      errno: EINVAL\x2C\n    })\n  }\n  // istanbul ignore next: should be unreachable\n  throw new ERR_FS_CP_UNKNOWN({\n    message: `cannot copy an unknown file type: ${dest}`\x2C\n    path: dest\x2C\n    syscall: 'cp'\x2C\n    errno: EINVAL\x2C\n  })\n}\n\nfunction onFile (srcStat\x2C destStat\x2C src\x2C dest\x2C opts) {\n  if (!destStat) {\n    return _copyFile(srcStat\x2C src\x2C dest\x2C opts)\n  }\n  return mayCopyFile(srcStat\x2C src\x2C dest\x2C opts)\n}\n\nasync function mayCopyFile (srcStat\x2C src\x2C dest\x2C opts) {\n  if (opts.force) {\n    await unlink(dest)\n    return _copyFile(srcStat\x2C src\x2C dest\x2C opts)\n  } else if (opts.errorOnExist) {\n    throw new ERR_FS_CP_EEXIST({\n      message: `${dest} already exists`\x2C\n      path: dest\x2C\n      syscall: 'cp'\x2C\n      errno: EEXIST\x2C\n    })\n  }\n}\n\nasync function _copyFile (srcStat\x2C src\x2C dest\x2C opts) {\n  await copyFile(src\x2C dest)\n  if (opts.preserveTimestamps) {\n    return handleTimestampsAndMode(srcStat.mode\x2C src\x2C dest)\n  }\n  return setDestMode(dest\x2C srcStat.mode)\n}\n\nasync function handleTimestampsAndMode (srcMode\x2C src\x2C dest) {\n  // Make sure the file is writable before setting the timestamp\n  // otherwise open fails with EPERM when invoked with 'r+'\n  // (through utimes call)\n  if (fileIsNotWritable(srcMod