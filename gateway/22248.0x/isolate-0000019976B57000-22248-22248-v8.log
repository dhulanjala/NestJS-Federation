script-source,1006,C:\\development\\NestJS Federation\\gateway\\node_modules\\cacache\\lib\\put.js,'use strict'\n\nconst index = require('./entry-index')\nconst memo = require('./memoization')\nconst write = require('./content/write')\nconst Flush = require('minipass-flush')\nconst { PassThrough } = require('minipass-collect')\nconst Pipeline = require('minipass-pipeline')\n\nconst putOpts = (opts) => ({\n  algorithms: ['sha512']\x2C\n  ...opts\x2C\n})\n\nmodule.exports = putData\n\nasync function putData (cache\x2C key\x2C data\x2C opts = {}) {\n  const { memoize } = opts\n  opts = putOpts(opts)\n  const res = await write(cache\x2C data\x2C opts)\n  const entry = await index.insert(cache\x2C key\x2C res.integrity\x2C { ...opts\x2C size: res.size })\n  if (memoize) {\n    memo.put(cache\x2C entry\x2C data\x2C opts)\n  }\n\n  return res.integrity\n}\n\nmodule.exports.stream = putStream\n\nfunction putStream (cache\x2C key\x2C opts = {}) {\n  const { memoize } = opts\n  opts = putOpts(opts)\n  let integrity\n  let size\n  let error\n\n  let memoData\n  const pipeline = new Pipeline()\n  // first item in the pipeline is the memoizer\x2C because we need\n  // that to end first and get the collected data.\n  if (memoize) {\n    const memoizer = new PassThrough().on('collect'\x2C data => {\n      memoData = data\n    })\n    pipeline.push(memoizer)\n  }\n\n  // contentStream is a write-only\x2C not a passthrough\n  // no data comes out of it.\n  const contentStream = write.stream(cache\x2C opts)\n    .on('integrity'\x2C (int) => {\n      integrity = int\n    })\n    .on('size'\x2C (s) => {\n      size = s\n    })\n    .on('error'\x2C (err) => {\n      error = err\n    })\n\n  pipeline.push(contentStream)\n\n  // last but not least\x2C we write the index and emit hash and size\x2C\n  // and memoize if we're doing that\n  pipeline.push(new Flush({\n    async flush () {\n      if (!error) {\n        const entry = await index.insert(cache\x2C key\x2C integrity\x2C { ...opts\x2C size })\n        if (memoize && memoData) {\n          memo.put(cache\x2C entry\x2C memoData\x2C opts)\n        }\n        pipeline.emit('integrity'\x2C integrity)\n        pipeline.emit('size'\x2C size)\n      }\n    }\x2C\n  }))\n\n  return pipeline\n}\n
