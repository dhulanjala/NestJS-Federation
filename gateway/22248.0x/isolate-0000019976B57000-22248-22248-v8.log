script-source,81,node:internal/net,'use strict';\x0d\n\x0d\nconst {\x0d\n  RegExp\x2C\x0d\n  RegExpPrototypeTest\x2C\x0d\n  Symbol\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst Buffer = require('buffer').Buffer;\x0d\nconst { writeBuffer } = internalBinding('fs');\x0d\nconst {\x0d\n  UVException\x2C\x0d\n} = require('internal/errors');\x0d\n\x0d\n// IPv4 Segment\x0d\nconst v4Seg = '(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])';\x0d\nconst v4Str = `(?:${v4Seg}\\\\.){3}${v4Seg}`;\x0d\nconst IPv4Reg = new RegExp(`^${v4Str}$`);\x0d\n\x0d\n// IPv6 Segment\x0d\nconst v6Seg = '(?:[0-9a-fA-F]{1\x2C4})';\x0d\nconst IPv6Reg = new RegExp('^(?:' +\x0d\n  `(?:${v6Seg}:){7}(?:${v6Seg}|:)|` +\x0d\n  `(?:${v6Seg}:){6}(?:${v4Str}|:${v6Seg}|:)|` +\x0d\n  `(?:${v6Seg}:){5}(?::${v4Str}|(?::${v6Seg}){1\x2C2}|:)|` +\x0d\n  `(?:${v6Seg}:){4}(?:(?::${v6Seg}){0\x2C1}:${v4Str}|(?::${v6Seg}){1\x2C3}|:)|` +\x0d\n  `(?:${v6Seg}:){3}(?:(?::${v6Seg}){0\x2C2}:${v4Str}|(?::${v6Seg}){1\x2C4}|:)|` +\x0d\n  `(?:${v6Seg}:){2}(?:(?::${v6Seg}){0\x2C3}:${v4Str}|(?::${v6Seg}){1\x2C5}|:)|` +\x0d\n  `(?:${v6Seg}:){1}(?:(?::${v6Seg}){0\x2C4}:${v4Str}|(?::${v6Seg}){1\x2C6}|:)|` +\x0d\n  `(?::(?:(?::${v6Seg}){0\x2C5}:${v4Str}|(?::${v6Seg}){1\x2C7}|:))` +\x0d\n')(?:%[0-9a-zA-Z-.:]{1\x2C})?$');\x0d\n\x0d\n/**\x0d\n * @param {string} s\x0d\n * @returns {boolean}\x0d\n */\x0d\nfunction isIPv4(s) {\x0d\n  // TODO(aduh95): Replace RegExpPrototypeTest with RegExpPrototypeExec when it\x0d\n  // no longer creates a perf regression in the dns benchmark.\x0d\n  // eslint-disable-next-line node-core/avoid-prototype-pollution\x0d\n  return RegExpPrototypeTest(IPv4Reg\x2C s);\x0d\n}\x0d\n\x0d\n/**\x0d\n * @param {string} s\x0d\n * @returns {boolean}\x0d\n */\x0d\nfunction isIPv6(s) {\x0d\n  // TODO(aduh95): Replace RegExpPrototypeTest with RegExpPrototypeExec when it\x0d\n  // no longer creates a perf regression in the dns benchmark.\x0d\n  // eslint-disable-next-line node-core/avoid-prototype-pollution\x0d\n  return RegExpPrototypeTest(IPv6Reg\x2C s);\x0d\n}\x0d\n\x0d\n/**\x0d\n * @param {string} s\x0d\n * @returns {4|6|0}\x0d\n */\x0d\nfunction isIP(s) {\x0d\n  if (isIPv4(s)) return 4;\x0d\n  if (isIPv6(s)) return 6;\x0d\n  return 0;\x0d\n}\x0d\n\x0d\nfunction makeSyncWrite(fd) {\x0d\n  return function(chunk\x2C enc\x2C cb) {\x0d\n    if (enc !== 'buffer')\x0d\n      chunk = Buffer.from(chunk\x2C enc);\x0d\n\x0d\n    this._handle.bytesWritten += chunk.length;\x0d\n\x0d\n    const ctx = {};\x0d\n    writeBuffer(fd\x2C chunk\x2C 0\x2C chunk.length\x2C null\x2C undefined\x2C ctx);\x0d\n    if (ctx.errno !== undefined) {\x0d\n      const ex = new UVException(ctx);\x0d\n      ex.errno = ctx.errno;\x0d\n      return cb(ex);\x0d\n    }\x0d\n    cb();\x0d\n  };\x0d\n}\x0d\n\x0d\n/**\x0d\n * https://www.iana.org/assignments/iana-ipv4-special-registry/iana-ipv4-special-registry.xhtml\x0d\n * https://www.iana.org/assignments/iana-ipv6-special-registry/iana-ipv6-special-registry.xhtml\x0d\n * https://www.iana.org/assignments/special-use-domain-names/special-use-domain-names.xhtml\x0d\n * @param {string} host\x0d\n * @returns {boolean}\x0d\n */\x0d\nfunction isLoopback(host) {\x0d\n  const hostLower = host.toLowerCase();\x0d\n\x0d\n  return (\x0d\n    hostLower === 'localhost' ||\x0d\n    hostLower.startsWith('127.') ||\x0d\n    hostLower === '[::1]' ||\x0d\n    hostLower === '[0:0:0:0:0:0:0:1]'\x0d\n  );\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  kReinitializeHandle: Symbol('kReinitializeHandle')\x2C\x0d\n  kSetNoDelay: Symbol('kSetNoDelay')\x2C\x0d\n  kSetKeepAlive: Symbol('kSetKeepAlive')\x2C\x0d\n  kSetKeepAliveInitialDelay: Symbol('kSetKeepAliveInitialDelay')\x2C\x0d\n  isIP\x2C\x0d\n  isIPv4\x2C\x0d\n  isIPv6\x2C\x0d\n  makeSyncWrite\x2C\x0d\n  normalizedArgsSymbol: Symbol('normalizedArgs')\x2C\x0d\n  isLoopback\x2C\x0d\n};\x0d\n
