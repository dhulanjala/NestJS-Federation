script-source,934,C:\\development\\NestJS Federation\\gateway\\node_modules\\make-fetch-happen\\lib\\cache\\entry.js,const { Request\x2C Response } = require('minipass-fetch')\nconst { Minipass } = require('minipass')\nconst MinipassFlush = require('minipass-flush')\nconst cacache = require('cacache')\nconst url = require('url')\n\nconst CachingMinipassPipeline = require('../pipeline.js')\nconst CachePolicy = require('./policy.js')\nconst cacheKey = require('./key.js')\nconst remote = require('../remote.js')\n\nconst hasOwnProperty = (obj\x2C prop) => Object.prototype.hasOwnProperty.call(obj\x2C prop)\n\n// allow list for request headers that will be written to the cache index\n// note: we will also store any request headers\n// that are named in a response's vary header\nconst KEEP_REQUEST_HEADERS = [\n  'accept-charset'\x2C\n  'accept-encoding'\x2C\n  'accept-language'\x2C\n  'accept'\x2C\n  'cache-control'\x2C\n]\n\n// allow list for response headers that will be written to the cache index\n// note: we must not store the real response's age header\x2C or when we load\n// a cache policy based on the metadata it will think the cached response\n// is always stale\nconst KEEP_RESPONSE_HEADERS = [\n  'cache-control'\x2C\n  'content-encoding'\x2C\n  'content-language'\x2C\n  'content-type'\x2C\n  'date'\x2C\n  'etag'\x2C\n  'expires'\x2C\n  'last-modified'\x2C\n  'link'\x2C\n  'location'\x2C\n  'pragma'\x2C\n  'vary'\x2C\n]\n\n// return an object containing all metadata to be written to the index\nconst getMetadata = (request\x2C response\x2C options) => {\n  const metadata = {\n    time: Date.now()\x2C\n    url: request.url\x2C\n    reqHeaders: {}\x2C\n    resHeaders: {}\x2C\n\n    // options on which we must match the request and vary the response\n    options: {\n      compress: options.compress != null ? options.compress : request.compress\x2C\n    }\x2C\n  }\n\n  // only save the status if it's not a 200 or 304\n  if (response.status !== 200 && response.status !== 304) {\n    metadata.status = response.status\n  }\n\n  for (const name of KEEP_REQUEST_HEADERS) {\n    if (request.headers.has(name)) {\n      metadata.reqHeaders[name] = request.headers.get(name)\n    }\n  }\n\n  // if the request's host header differs from the host in the url\n  // we need to keep it\x2C otherwise it's just noise and we ignore it\n  const host = request.headers.get('host')\n  const parsedUrl = new url.URL(request.url)\n  if (host && parsedUrl.host !== host) {\n    metadata.reqHeaders.host = host\n  }\n\n  // if the response has a vary header\x2C make sure\n  // we store the relevant request headers too\n  if (response.headers.has('vary')) {\n    const vary = response.headers.get('vary')\n    // a vary of "*" means every header causes a different response.\n    // in that scenario\x2C we do not include any additional headers\n    // as the freshness check will always fail anyway and we don't\n    // want to bloat the cache indexes\n    if (vary !== '*') {\n      // copy any other request headers that will vary the response\n      const varyHeaders = vary.trim().toLowerCase().split(/\\s*\x2C\\s*/)\n      for (const name of varyHeaders) {\n        if (request.headers.has(name)) {\n          metadata.reqHeaders[name] = request.headers.get(name)\n        }\n      }\n    }\n  }\n\n  for (const name of KEEP_RESPONSE_HEADERS) {\n    if (response.headers.has(name)) {\n      metadata.resHeaders[name] = response.headers.get(name)\n    }\n  }\n\n  for (const name of options.cacheAdditionalHeaders) {\n    if (response.headers.has(name)) {\n      metadata.resHeaders[name] = response.headers.get(name)\n    }\n  }\n\n  return metadata\n}\n\n// symbols used to hide objects that may be lazily evaluated in a getter\nconst _request = Symbol('request')\nconst _response = Symbol('response')\nconst _policy = Symbol('policy')\n\nclass CacheEntry {\n  constructor ({ entry\x2C request\x2C response\x2C options }) {\n    if (entry) {\n      this.key = entry.key\n      this.entry = entry\n      // previous versions of this module didn't write an explicit timestamp in\n      // the metadata\x2C so fall back to the entry's timestamp. we can't use the\n      // entry timestamp to determine staleness because cacache will update it\n      // when it verifies its data\n      this.entry.metadata.time = this.entry.metadata.time || this.entry.time\n    } else {\n      this.key = cacheKey(request)\n    }\n\n    this.options = options\n\n    // these properties are behind getters that lazily evaluate\n    this[_request] = request\n    this[_response] = response\n    this[_policy] = null\n  }\n\n  // returns a CacheEntry instance that satisfies the given request\n  // or undefined if no existing entry satisfies\n  static async find (request\x2C options) {\n    try {\n      // compacts the index and returns an array of unique entries\n      var matches = await cacache.index.compact(options.cachePath\x2C cacheKey(request)\x2C (A\x2C B) => {\n        const entryA = new CacheEntry({ entry: A\x2C options })\n        const entryB = new CacheEntry({ entry: B\x2C options })\n        return entryA.policy.satisfies(entryB.request)\n      }\x2C {\n        validateEntry: (entry) => {\n          // clean out entries with a buggy content-encoding value\n          if (entry.metadata &&\n              entry.metadata.resHeaders &&\n              entry.metadata.resHeaders['content-encoding'] === null) {\n            return false\n          }\n\n          // if an integrity is null\x2C it needs to have a status specified\n          if (entry.integrity === null) {\n            return !!(entry.metadata && entry.metadata.status)\n          }\n\n          return true\n        }\x2C\n      })\n    } catch (err) {\n      // if the compact request fails\x2C ignore the error and return\n      return\n    }\n\n    // a cache mode of 'reload' means to behave as though we have no cache\n    // on the way to the network. return undefined to allow cacheFetch to\n    // create a brand new request no matter what.\n    if (options.cache === 'reload') {\n      return\n    }\n\n    // find the specific entry that satisfies the request\n    let match\n    for (const entry of matches) {\n      const _entry = new CacheEntry({\n        entry\x2C\n        options\x2C\n      })\n\n      if (_entry.policy.satisfies(request)) {\n        match = _entry\n        break\n      }\n    }\n\n    return match\n  }\n\n  // if the user made a PUT/POST/PATCH then we invalidate our\n  // cache for the same url by deleting the index entirely\n  static async invalidate (request\x2C options) {\n    const key = cacheKey(request)\n    try {\n      await cacache.rm.entry(options.cachePath\x2C key\x2C { removeFully: true })\n    } catch (err) {\n      // ignore errors\n    }\n  }\n\n  get request () {\n    if (!this[_request]) {\n      this[_request] = new Request(this.entry.metadata.url\x2C {\n        method: 'GET'\x2C\n        headers: this.entry.metadata.reqHeaders\x2C\n        ...this.entry.metadata.options\x2C\n      })\n    }\n\n    return this[_request]\n  }\n\n  get response () {\n    if (!this[_response]) {\n      this[_response] = new Response(null\x2C {\n        url: this.entry.metadata.url\x2C\n        counter: this.options.counter\x2C\n        status: this.entry.metadata.status || 200\x2C\n        headers: {\n          ...this.entry.metadata.resHeaders\x2C\n          'content-length': this.entry.size\x2C\n        }\x2C\n      })\n    }\n\n    return this[_response]\n  }\n\n  get policy () {\n    if (!this[_policy]) {\n      this[_policy] = new CachePolicy({\n        entry: this.entry\x2C\n        request: this.request\x2C\n        response: this.response\x2C\n        options: this.options\x2C\n      })\n    }\n\n    return this[_policy]\n  }\n\n  // wraps the response in a pipeline that stores the data\n  // in the cache while the user consumes it\n  async store (status) {\n    // if we got a status other than 200\x2C 301\x2C or 308\x2C\n    // or the CachePolicy forbid storage\x2C append the\n    // cache status header and return it untouched\n    if (\n      this.request.method !== 'GET' ||\n      ![200\x2C 301\x2C 308].includes(this.response.status) ||\n      !this.policy.storable()\n    ) {\n      this.response.headers.set('x-local-cache-status'\x2C 'skip')\n      return this.response\n    }\n\n    const size = this.response.headers.get('content-length')\n    const cacheOpts = {\n      algorithms: this.options.algorithms\x2C\n      metadata: getMetadata(this.request\x2C this.response\x2C this.options)\x2C\n      size\x2C\n      integrity: this.options.integrity\x2C\n      integrityEmitter: this.response.body.hasIntegrityEmitter && this.response.body\x2C\n    }\n\n    let body = null\n    // we only set a body if the status is a 200\x2C redirects are\n    // stored as metadata only\n    if (this.response.status === 200) {\n      let cacheWriteResolve\x2C cacheWriteReject\n      const cacheWritePromise = new Promise((resolve\x2C reject) => {\n        cacheWriteResolve = resolve\n        cacheWriteReject = reject\n      }).catch((err) => {\n        body.emit('error'\x2C err)\n      })\n\n      body = new CachingMinipassPipeline({ events: ['integrity'\x2C 'size'] }\x2C new MinipassFlush({\n        flush () {\n          return cacheWritePromise\n        }\x2C\n      }))\n      // this is always true since if we aren't reusing the one from the remote fetch\x2C we\n      // are using the one from cacache\n      body.hasIntegrityEmitter = true\n\n      const onResume = () => {\n        const tee = new Minipass()\n        const cacheStream = cacache.put.stream(this.options.cachePath\x2C this.key\x2C cacheOpts)\n        // re-emit the integrity and size events on our new response body so they can be reused\n        cacheStream.on('integrity'\x2C i => body.emit('integrity'\x2C i))\n        cacheStream.on('size'\x2C s => body.emit('size'\x2C s))\n        // stick a flag on here so downstream users will know if they can expect integrity events\n        tee.pipe(cacheStream)\n        // TODO if the cache write fails\x2C log a warning but return the response anyway\n        // eslint-disable-next-line promise/catch-or-return\n        cacheStream.promise().then(cacheWriteResolve\x2C cacheWriteReject)\n        body.unshift(tee)\n        body.unshift(this.response.body)\n      }\n\n      body.once('resume'\x2C onResume)\n      body.once('end'\x2C () => body.removeListener('resume'\x2C onResume))\n    } else {\n      await cacache.index.insert(this.options.cachePath\x2C this.key\x2C null\x2C cacheOpts)\n    }\n\n    // note: we do not set the x-local-cache-hash header because we do not know\n    // the hash value until after the write to the cache completes\x2C which doesn't\n    // happen until after the response has been sent and it's too late to write\n    // the header anyway\n    this.response.headers.set('x-local-cache'\x2C encodeURIComponent(this.options.cachePath))\n    this.response.headers.set('x-local-cache-key'\x2C encodeURIComponent(this.key))\n    this.response.headers.set('x-local-cache-mode'\x2C 'stream')\n    this.response.headers.set('x-local-cache-status'\x2C status)\n    this.response.headers.set('x-local-cache-time'\x2C new Date().toISOString())\n    const newResponse = new Response(body\x2C {\n      url: this.response.url\x2C\n      status: this.response.status\x2C\n      headers: this.response.headers\x2C\n      counter: this.options.counter\x2C\n    })\n    return newResponse\n  }\n\n  // use the cached data to create a response and return it\n  async respond (method\x2C options\x2C status) {\n    let response\n    if (method === 'HEAD' || [301\x2C 308].includes(this.response.status)) {\n      // if the request is a HEAD\x2C or the response is a redirect\x2C\n      // then the metadata in the entry already includes everything\n      // we need to build a response\n      response = this.response\n    } else {\n      // we're responding with a full cached response\x2C so create a body\n      // that reads from cacache and attach it to a new Response\n      const body = new Minipass()\n      const headers = { ...this.policy.responseHeaders() }\n\n      const onResume = () => {\n        const cacheStream = cacache.get.stream.byDigest(\n          this.options.cachePath\x2C this.entry.integrity\x2C { memoize: this.options.memoize }\n        )\n        cacheStream.on('error'\x2C async (err) => {\n          cacheStream.pause()\n          if (err.code === 'EINTEGRITY') {\n            await cacache.rm.content(\n              this.options.cachePath\x2C this.entry.integrity\x2C { memoize: this.options.memoize }\n            )\n          }\n          if (err.code === 'ENOENT' || err.code === 'EINTEGRITY') {\n            await CacheEntry.invalidate(this.request\x2C this.options)\n          }\n          body.emit('error'\x2C err)\n          cacheStream.resume()\n        })\n        // emit the integrity and size events based on our metadata so we're consistent\n        body.emit('integrity'\x2C this.entry.integrity)\n        body.emit('size'\x2C Number(headers['content-length']))\n        cacheStream.pipe(body)\n      }\n\n      body.once('resume'\x2C onResume)\n      body.once('end'\x2C () => body.removeListener('resume'\x2C onResume))\n      response = new Response(body\x2C {\n        url: this.entry.metadata.url\x2C\n        counter: options.counter\x2C\n        status: 200\x2C\n        headers\x2C\n      })\n    }\n\n    response.headers.set('x-local-cache'\x2C encodeURIComponent(this.options.cachePath))\n    response.headers.set('x-local-cache-hash'\x2C encodeURIComponent(this.entry.integrity))\n    response.headers.set('x-local-cache-key'\x2C encodeURIComponent(this.key))\n    response.headers.set('x-local-cache-mode'\x2C 'stream')\n    response.headers.set('x-local-cache-status'\x2C status)\n    response.headers.set('x-local-cache-time'\x2C new Date(this.entry.metadata.time).toUTCString())\n    return response\n  }\n\n  // use the provided request along with this cache entry to\n  // revalidate the stored response. returns a response\x2C either\n  // from the cache or from the update\n  async revalidate (request\x2C options) {\n    const revalidateRequest = new Request(request\x2C {\n      headers: this.policy.revalidationHeaders(request)\x2C\n    })\n\n    try {\n      // NOTE: be sure to remove the headers property from the\n      // user supplied options\x2C since we have already defined\n      // them on the new request object. if they're still in the\n      // options then those will overwrite the ones from the policy\n      var response = await remote(revalidateRequest\x2C {\n        ...options\x2C\n        headers: undefined\x2C\n      })\n    } catch (err) {\n      // if the network fetch fails\x2C return the stale\n      // cached response unless it has a cache-control\n      // of 'must-revalidate'\n      if (!this.policy.mustRevalidate) {\n        return this.respond(request.method\x2C options\x2C 'stale')\n      }\n\n      throw err\n    }\n\n    if (this.policy.revalidated(revalidateRequest\x2C response)) {\n      // we got a 304\x2C write a new index to the cache and respond from cache\n      const metadata = getMetadata(request\x2C response\x2C options)\n      // 304 responses do not include headers that are specific to the response data\n      // since they do not include a body\x2C so we copy values for headers that were\n      // in the old cache entry to the new one\x2C if the new metadata does not already\n      // include that header\n      for (const name of KEEP_RESPONSE_HEADERS) {\n        if (\n          !hasOwnProperty(metadata.resHeaders\x2C name) &&\n          hasOwnProperty(this.entry.metadata.resHeaders\x2C name)\n        ) {\n          metadata.resHeaders[name] = this.entry.metadata.resHeaders[name]\n        }\n      }\n\n      for (const name of options.cacheAdditionalHeaders) {\n        const inMeta = hasOwnProperty(metadata.resHeaders\x2C name)\n        const inEntry = hasOwnProperty(this.entry.metadata.resHeaders\x2C name)\n        const inPolicy = hasOwnProperty(this.policy.response.headers\x2C name)\n\n        // if the header is in the existing entry\x2C but it is not in the metadata\n        // then we need to write it to the metadata as this will refresh the on-disk cache\n        if (!inMeta && inEntry) {\n          metadata.resHeaders[name] = this.entry.metadata.resHeaders[name]\n        }\n        // if the header is in the metadata\x2C but not in the policy\x2C then we need to set\n        // it in the policy so that it's included in the immediate response. future\n        // responses will load a new cache entry\x2C so we don't need to change that\n        if (!inPolicy && inMeta) {\n          this.policy.response.headers[name] = metadata.resHeaders[name]\n        }\n      }\n\n      try {\n        await cacache.index.insert(options.cachePath\x2C this.key\x2C this.entry.integrity\x2C {\n          size: this.entry.size\x2C\n          metadata\x2C\n        })\n      } catch (err) {\n        // if updating the cache index fails\x2C we ignore it and\n        // respond anyway\n      }\n      return this.respond(request.method\x2C options\x2C 'revalidated')\n    }\n\n    // if we got a modified response\x2C create a new entry based on it\n    const newEntry = new CacheEntry({\n      request\x2C\n      response\x2C\n      options\x2C\n    })\n\n    // respond with the new entry while writing it to the cache\n    return newEntry.store('updated')\n  }\n}\n\nmodule.exports = CacheEntry\n
