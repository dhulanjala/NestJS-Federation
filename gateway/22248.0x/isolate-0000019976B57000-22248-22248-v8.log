script-source,1024,C:\\development\\NestJS Federation\\gateway\\node_modules\\@npmcli\\agent\\lib\\dns.js,'use strict'\n\nconst { LRUCache } = require('lru-cache')\nconst dns = require('dns')\n\n// this is a factory so that each request can have its own opts (i.e. ttl)\n// while still sharing the cache across all requests\nconst cache = new LRUCache({ max: 50 })\n\nconst getOptions = ({\n  family = 0\x2C\n  hints = dns.ADDRCONFIG\x2C\n  all = false\x2C\n  verbatim = undefined\x2C\n  ttl = 5 * 60 * 1000\x2C\n  lookup = dns.lookup\x2C\n}) => ({\n  // hints and lookup are returned since both are top level properties to (net|tls).connect\n  hints\x2C\n  lookup: (hostname\x2C ...args) => {\n    const callback = args.pop() // callback is always last arg\n    const lookupOptions = args[0] ?? {}\n\n    const options = {\n      family\x2C\n      hints\x2C\n      all\x2C\n      verbatim\x2C\n      ...(typeof lookupOptions === 'number' ? { family: lookupOptions } : lookupOptions)\x2C\n    }\n\n    const key = JSON.stringify({ hostname\x2C ...options })\n\n    if (cache.has(key)) {\n      const cached = cache.get(key)\n      return process.nextTick(callback\x2C null\x2C ...cached)\n    }\n\n    lookup(hostname\x2C options\x2C (err\x2C ...result) => {\n      if (err) {\n        return callback(err)\n      }\n\n      cache.set(key\x2C result\x2C { ttl })\n      return callback(null\x2C ...result)\n    })\n  }\x2C\n})\n\nmodule.exports = {\n  cache\x2C\n  getOptions\x2C\n}\n
