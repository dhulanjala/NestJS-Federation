script-source,1018,C:\\development\\NestJS Federation\\gateway\\node_modules\\proc-log\\lib\\index.js,const META = Symbol('proc-log.meta')\nmodule.exports = {\n  META: META\x2C\n  output: {\n    LEVELS: [\n      'standard'\x2C\n      'error'\x2C\n      'buffer'\x2C\n      'flush'\x2C\n    ]\x2C\n    KEYS: {\n      standard: 'standard'\x2C\n      error: 'error'\x2C\n      buffer: 'buffer'\x2C\n      flush: 'flush'\x2C\n    }\x2C\n    standard: function (...args) {\n      return process.emit('output'\x2C 'standard'\x2C ...args)\n    }\x2C\n    error: function (...args) {\n      return process.emit('output'\x2C 'error'\x2C ...args)\n    }\x2C\n    buffer: function (...args) {\n      return process.emit('output'\x2C 'buffer'\x2C ...args)\n    }\x2C\n    flush: function (...args) {\n      return process.emit('output'\x2C 'flush'\x2C ...args)\n    }\x2C\n  }\x2C\n  log: {\n    LEVELS: [\n      'notice'\x2C\n      'error'\x2C\n      'warn'\x2C\n      'info'\x2C\n      'verbose'\x2C\n      'http'\x2C\n      'silly'\x2C\n      'timing'\x2C\n      'pause'\x2C\n      'resume'\x2C\n    ]\x2C\n    KEYS: {\n      notice: 'notice'\x2C\n      error: 'error'\x2C\n      warn: 'warn'\x2C\n      info: 'info'\x2C\n      verbose: 'verbose'\x2C\n      http: 'http'\x2C\n      silly: 'silly'\x2C\n      timing: 'timing'\x2C\n      pause: 'pause'\x2C\n      resume: 'resume'\x2C\n    }\x2C\n    error: function (...args) {\n      return process.emit('log'\x2C 'error'\x2C ...args)\n    }\x2C\n    notice: function (...args) {\n      return process.emit('log'\x2C 'notice'\x2C ...args)\n    }\x2C\n    warn: function (...args) {\n      return process.emit('log'\x2C 'warn'\x2C ...args)\n    }\x2C\n    info: function (...args) {\n      return process.emit('log'\x2C 'info'\x2C ...args)\n    }\x2C\n    verbose: function (...args) {\n      return process.emit('log'\x2C 'verbose'\x2C ...args)\n    }\x2C\n    http: function (...args) {\n      return process.emit('log'\x2C 'http'\x2C ...args)\n    }\x2C\n    silly: function (...args) {\n      return process.emit('log'\x2C 'silly'\x2C ...args)\n    }\x2C\n    timing: function (...args) {\n      return process.emit('log'\x2C 'timing'\x2C ...args)\n    }\x2C\n    pause: function () {\n      return process.emit('log'\x2C 'pause')\n    }\x2C\n    resume: function () {\n      return process.emit('log'\x2C 'resume')\n    }\x2C\n  }\x2C\n  time: {\n    LEVELS: [\n      'start'\x2C\n      'end'\x2C\n    ]\x2C\n    KEYS: {\n      start: 'start'\x2C\n      end: 'end'\x2C\n    }\x2C\n    start: function (name\x2C fn) {\n      process.emit('time'\x2C 'start'\x2C name)\n      function end () {\n        return process.emit('time'\x2C 'end'\x2C name)\n      }\n      if (typeof fn === 'function') {\n        const res = fn()\n        if (res && res.finally) {\n          return res.finally(end)\n        }\n        end()\n        return res\n      }\n      return end\n    }\x2C\n    end: function (name) {\n      return process.emit('time'\x2C 'end'\x2C name)\n    }\x2C\n  }\x2C\n  input: {\n    LEVELS: [\n      'start'\x2C\n      'end'\x2C\n      'read'\x2C\n    ]\x2C\n    KEYS: {\n      start: 'start'\x2C\n      end: 'end'\x2C\n      read: 'read'\x2C\n    }\x2C\n    start: function (...args) {\n      // Support callback for backwards compatibility and pass additional args to event\n      let fn\n      if (typeof args[0] === 'function') {\n        fn = args.shift()\n      }\n      process.emit('input'\x2C 'start'\x2C ...args)\n      function end () {\n        return process.emit('input'\x2C 'end'\x2C ...args)\n      }\n      if (typeof fn === 'function') {\n        const res = fn()\n        if (res && res.finally) {\n          return res.finally(end)\n        }\n        end()\n        return res\n      }\n      return end\n    }\x2C\n    end: function (...args) {\n      return process.emit('input'\x2C 'end'\x2C ...args)\n    }\x2C\n    read: function (...args) {\n      let resolve\x2C reject\n      const promise = new Promise((_resolve\x2C _reject) => {\n        resolve = _resolve\n        reject = _reject\n      })\n      process.emit('input'\x2C 'read'\x2C resolve\x2C reject\x2C ...args)\n      return promise\n    }\x2C\n  }\x2C\n}\n
