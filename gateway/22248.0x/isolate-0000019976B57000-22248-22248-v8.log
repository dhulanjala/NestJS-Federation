=== NO_EXCEPTION_SENTINEL) {\x0d\n    let details = '';\x0d\n    if (error?.name) {\x0d\n      details += ` (${error.name})`;\x0d\n    }\x0d\n    details += message ? `: ${message}` : '.';\x0d\n    const fnType = stackStartFn === Assert.prototype.rejects ? 'rejection' : 'exception';\x0d\n    innerFail({\x0d\n      actual: undefined\x2C\x0d\n      expected: error\x2C\x0d\n      operator: stackStartFn.name\x2C\x0d\n      message: `Missing expected ${fnType}${details}`\x2C\x0d\n      stackStartFn\x2C\x0d\n      diff: this?.[kOptions]?.diff\x2C\x0d\n    });\x0d\n  }\x0d\n\x0d\n  if (!error)\x0d\n    return;\x0d\n\x0d\n  expectedException.call(this\x2C actual\x2C error\x2C message\x2C stackStartFn);\x0d\n}\x0d\n\x0d\nfunction hasMatchingError(actual\x2C expected) {\x0d\n  if (typeof expected !== 'function') {\x0d\n    if (isRegExp(expected)) {\x0d\n      const str = String(actual);\x0d\n      return RegExpPrototypeExec(expected\x2C str) !== null;\x0d\n    }\x0d\n    throw new ERR_INVALID_ARG_TYPE(\x0d\n      'expected'\x2C ['Function'\x2C 'RegExp']\x2C expected\x2C\x0d\n    );\x0d\n  }\x0d\n  // Guard instanceof against arrow functions as they don't have a prototype.\x0d\n  if (expected.prototype !== undefined && actual instanceof expected) {\x0d\n    return true;\x0d\n  }\x0d\n  if (ObjectPrototypeIsPrototypeOf(Error\x2C expected)) {\x0d\n    return false;\x0d\n  }\x0d\n  return FunctionPrototypeCall(expected\x2C {}\x2C actual) === true;\x0d\n}\x0d\n\x0d\nfunction expectsNoError(stackStartFn\x2C actual\x2C error\x2C message) {\x0d\n  if (actual === NO_EXCEPTION_SENTINEL)\x0d\n    return;\x0d\n\x0d\n  if (typeof error === 'string') {\x0d\n    message = error;\x0d\n    error = undefined;\x0d\n  }\x0d\n\x0d\n  if (!error || hasMatchingError(actual\x2C error)) {\x0d\n    const details = message ? `: ${message}` : '.';\x0d\n    const fnType = stackStartFn === Assert.prototype.doesNotReject ?\x0d\n      'rejection' : 'exception';\x0d\n    innerFail({\x0d\n      actual\x2C\x0d