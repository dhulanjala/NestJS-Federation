script-source,29,node:internal/webidl,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypePush\x2C\x0d\n  ArrayPrototypeToSorted\x2C\x0d\n  MathAbs\x2C\x0d\n  MathMax\x2C\x0d\n  MathMin\x2C\x0d\n  MathPow\x2C\x0d\n  MathSign\x2C\x0d\n  MathTrunc\x2C\x0d\n  NumberIsNaN\x2C\x0d\n  NumberMAX_SAFE_INTEGER\x2C\x0d\n  NumberMIN_SAFE_INTEGER\x2C\x0d\n  ObjectAssign\x2C\x0d\n  ObjectPrototypeIsPrototypeOf\x2C\x0d\n  SafeSet\x2C\x0d\n  String\x2C\x0d\n  Symbol\x2C\x0d\n  SymbolIterator\x2C\x0d\n  TypeError\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\nconst { kEmptyObject } = require('internal/util');\x0d\n\x0d\nconst converters = { __proto__: null };\x0d\n\x0d\nconst UNDEFINED = Symbol('undefined');\x0d\nconst BOOLEAN = Symbol('boolean');\x0d\nconst STRING = Symbol('string');\x0d\nconst SYMBOL = Symbol('symbol');\x0d\nconst NUMBER = Symbol('number');\x0d\nconst BIGINT = Symbol('bigint');\x0d\nconst NULL = Symbol('null');\x0d\nconst OBJECT = Symbol('object');\x0d\n\x0d\n/**\x0d\n * @see https://webidl.spec.whatwg.org/#es-any\x0d\n * @param {any} V\x0d\n * @returns {any}\x0d\n */\x0d\nconverters.any = (V) => {\x0d\n  return V;\x0d\n};\x0d\n\x0d\nconverters.object = (V\x2C opts = kEmptyObject) => {\x0d\n  if (type(V) !== OBJECT) {\x0d\n    throw makeException(\x0d\n      'is not an object'\x2C\x0d\n      kEmptyObject\x2C\x0d\n    );\x0d\n  }\x0d\n  return V;\x0d\n};\x0d\n\x0d\n// https://webidl.spec.whatwg.org/#abstract-opdef-integerpart\x0d\nconst integerPart = MathTrunc;\x0d\n\x0d\n/* eslint-disable node-core/non-ascii-character */\x0d\n// Round x to the nearest integer\x2C choosing the even integer if it lies halfway\x0d\n// between two\x2C and choosing +0 rather than -0.\x0d\n// This is different from Math.round\x2C which rounds to the next integer in the\x0d\n// direction of +\u221e when the fraction portion is exactly 0.5.\x0d\n/* eslint-enable node-core/non-ascii-character */\x0d\nfunction evenRound(x) {\x0d\n  // Convert -0 to +0.\x0d\n  const i = integerPart(x) + 0;\x0d\n  const reminder = MathAbs(x % 1);\x0d\n  const sign = MathSign(i);\x0d\n  if (reminder === 0.5) {\x0d\n    return i % 2 === 0 ? i : i + sign;\x0d\n  }\x0d\n  const r = reminder < 0.5 ? i : i + sign;\x0d\n  // Convert -0 to +0.\x0d\n  if (r === 0) {\x0d\n    return 0;\x0d\n  }\x0d\n  return r;\x0d\n}\x0d\n\x0d\nfunction pow2(exponent) {\x0d\n  // << operates on 32 bit signed integers.\x0d\n  if (exponent < 31) {\x0d\n    return 1 << exponent;\x0d\n  }\x0d\n  if (exponent === 31) {\x0d\n    return 0x8000_0000;\x0d\n  }\x0d\n  if (exponent === 32) {\x0d\n    return 0x1_0000_0000;\x0d\n  }\x0d\n  return MathPow(2\x2C exponent);\x0d\n}\x0d\n\x0d\n// https://tc39.es/ecma262/#eqn-modulo\x0d\n// The notation \u201cx modulo y\u201d computes a value k of the same sign as y.\x0d\nfunction modulo(x\x2C y) {\x0d\n  const r = x % y;\x0d\n  // Convert -0 to +0.\x0d\n  if (r === 0) {\x0d\n    return 0;\x0d\n  }\x0d\n  return r;\x0d\n}\x0d\n\x0d\n// https://webidl.spec.whatwg.org/#abstract-opdef-converttoint\x0d\nfunction convertToInt(name\x2C value\x2C bitLength\x2C options = kEmptyObject) {\x0d\n  const { signed = false\x2C enforceRange = false\x2C clamp = false } = options;\x0d\n\x0d\n  let upperBound;\x0d\n  let lowerBound;\x0d\n  // 1. If bitLength is 64\x2C then:\x0d\n  if (bitLength === 64) {\x0d\n    // 1.1. Let upperBound be 2^53 \u2212 1.\x0d\n    upperBound = NumberMAX_SAFE_INTEGER;\x0d\n    // 1.2. If signedness is "unsigned"\x2C then let lowerBound be 0.\x0d\n    // 1.3. Otherwise let lowerBound be \u22122^53 + 1.\x0d\n    lowerBound = !signed ? 0 : NumberMIN_SAFE_INTEGER;\x0d\n  } else if (!signed) {\x0d\n    // 2. Otherwise\x2C if signedness is "unsigned"\x2C then:\x0d\n    // 2.1. Let lowerBound be 0.\x0d\n    // 2.2. Let upperBound be 2^bitLength \u2212 1.\x0d\n    lowerBound = 0;\x0d\n    upperBound = pow2(bitLength) - 1;\x0d\n  } else {\x0d\n    // 3. Otherwise:\x0d\n    // 3.1. Let lowerBound be -2^(bitLength \u2212 1).\x0d\n    // 3.2. Let upperBound be 2^(bitLength \u2212 1) \u2212 1.\x0d\n    lowerBound = -pow2(bitLength - 1);\x0d\n    upperBound = pow2(bitLength - 1) - 1;\x0d\n  }\x0d\n\x0d\n  // 4. Let x be ? ToNumber(V).\x0d\n  let x = +value;\x0d\n  // 5. If x is \u22120\x2C then set x to +0.\x0d\n  if (x === 0) {\x0d\n    x = 0;\x0d\n  }\x0d\n\x0d\n  // 6. If the conversion is to an IDL type associated with the [EnforceRange]\x0d\n  // extended attribute\x2C then:\x0d\n  if (enforceRange) {\x0d\n    // 6.1. If x is NaN\x2C +\u221e\x2C or \u2212\u221e\x2C then throw a TypeError.\x0d\n    if (NumberIsNaN(x) || x === Infinity || x === -Infinity) {\x0d\n      throw new ERR_INVALID_ARG_VALUE(name\x2C x);\x0d\n    }\x0d\n    // 6.2. Set x to IntegerPart(x).\x0d\n    x = integerPart(x);\x0d\n\x0d\n    // 6.3. If x < lowerBound or x > upperBound\x2C then throw a TypeError.\x0d\n    if (x < lowerBound || x > upperBound) {\x0d\n      throw new ERR_INVALID_ARG_VALUE(name\x2C x);\x0d\n    }\x0d\n\x0d\n    // 6.4. Return x.\x0d\n    return x;\x0d\n  }\x0d\n\x0d\n  // 7. If x is not NaN and the conversion is to an IDL type associated with\x0d\n  // the [Clamp] extended attribute\x2C then:\x0d\n  if (clamp && !NumberIsNaN(x)) {\x0d\n    // 7.1. Set x to min(max(x\x2C lowerBound)\x2C upperBound).\x0d\n    x = MathMin(MathMax(x\x2C lowerBound)\x2C upperBound);\x0d\n\x0d\n    // 7.2. Round x to the nearest integer\x2C choosing the even integer if it\x0d\n    // lies halfway between two\x2C and choosing +0 rather than \u22120.\x0d\n    x = evenRound(x);\x0d\n\x0d\n    // 7.3. Return x.\x0d\n    return x;\x0d\n  }\x0d\n\x0d\n  // 8. If x is NaN\x2C +0\x2C +\u221e\x2C or \u2212\u221e\x2C then return +0.\x0d\n  if (NumberIsNaN(x) || x === 0 || x === Infinity || x === -Infinity) {\x0d\n    return 0;\x0d\n  }\x0d\n\x0d\n  // 9. Set x to IntegerPart(x).\x0d\n  x = integerPart(x);\x0d\n\x0d\n  // 10. Set x to x modulo 2^bitLength.\x0d\n  x = modulo(x\x2C pow2(bitLength));\x0d\n\x0d\n  // 11. If signedness is "signed" and x \u2265 2^(bitLength \u2212 1)\x2C then return x \u2212\x0d\n  // 2^bitLength.\x0d\n  if (signed && x >= pow2(bitLength - 1)) {\x0d\n    return x - pow2(bitLength);\x0d\n  }\x0d\n\x0d\n  // 12. Otherwise\x2C return x.\x0d\n  return x;\x0d\n}\x0d\n\x0d\n/**\x0d\n * @see https://webidl.spec.whatwg.org/#es-DOMString\x0d\n * @param {any} V\x0d\n * @returns {string}\x0d\n */\x0d\nconverters.DOMString = function DOMString(V) {\x0d\n  if (typeof V === 'symbol') {\x0d\n    throw new ERR_INVALID_ARG_VALUE('value'\x2C V);\x0d\n  }\x0d\n\x0d\n  return String(V);\x0d\n};\x0d\n\x0d\nconverters['sequence<object>'] = createSequenceConverter(converters.object);\x0d\n\x0d\nfunction codedTypeError(message\x2C errorProperties = kEmptyObject) {\x0d\n  // eslint-disable-next-line no-restricted-syntax\x0d\n  const err = new TypeError(message);\x0d\n  ObjectAssign(err\x2C errorProperties);\x0d\n  return err;\x0d\n}\x0d\n\x0d\nfunction makeException(message\x2C opts = kEmptyObject) {\x0d\n  const prefix = opts.prefix ? opts.prefix + ': ' : '';\x0d\n  const context = opts.context?.length === 0 ?\x0d\n    '' : (opts.context ?? 'Value') + ' ';\x0d\n  return codedTypeError(\x0d\n    `${prefix}${context}${message}`\x2C\x0d\n    { code: opts.code || 'ERR_INVALID_ARG_TYPE' }\x2C\x0d\n  );\x0d\n}\x0d\n\x0d\nfunction createEnumConverter(name\x2C values) {\x0d\n  const E = new SafeSet(values);\x0d\n\x0d\n  return function(V\x2C opts = kEmptyObject) {\x0d\n    const S = String(V);\x0d\n\x0d\n    if (!E.has(S)) {\x0d\n      throw makeException(\x0d\n        `value '${S}' is not a valid enum value of type ${name}.`\x2C\x0d\n        { __proto__: null\x2C ...opts\x2C code: 'ERR_INVALID_ARG_VALUE' });\x0d\n    }\x0d\n\x0d\n    return S;\x0d\n  };\x0d\n}\x0d\n\x0d\n// https://tc39.es/ecma262/#sec-ecmascript-data-types-and-values\x0d\nfunction type(V) {\x0d\n  switch (typeof V) {\x0d\n    case 'undefined':\x0d\n      return UNDEFINED;\x0d\n    case 'boolean':\x0d\n      return BOOLEAN;\x0d\n    case 'number':\x0d\n      return NUMBER;\x0d\n    case 'string':\x0d\n      return STRING;\x0d\n    case 'symbol':\x0d\n      return SYMBOL;\x0d\n    case 'bigint':\x0d\n      return BIGINT;\x0d\n    case 'object': // Fall through\x0d\n    case 'function': // Fall through\x0d\n    default:\x0d\n      if (V === null) {\x0d\n        return NULL;\x0d\n      }\x0d\n      // Per ES spec\x2C typeof returns an implementation-defined value that is not\x0d\n      // any of the existing ones for uncallable non-standard exotic objects.\x0d\n      // Yet Type() which the Web IDL spec depends on returns Object for such\x0d\n      // cases. So treat the default case as an object.\x0d\n      return OBJECT;\x0d\n  }\x0d\n}\x0d\n\x0d\n// https://webidl.spec.whatwg.org/#js-dictionary\x0d\nfunction createDictionaryConverter(members) {\x0d\n  // The spec requires us to operate the members of a dictionary in\x0d\n  // lexicographical order. We are doing this in the outer scope to\x0d\n  // reduce the overhead that could happen in the returned function.\x0d\n  const sortedMembers = ArrayPrototypeToSorted(members\x2C (a\x2C b) => {\x0d\n    if (a.key === b.key) {\x0d\n      return 0;\x0d\n    }\x0d\n    return a.key < b.key ? -1 : 1;\x0d\n  });\x0d\n\x0d\n  return function(\x0d\n    V\x2C\x0d\n    opts = kEmptyObject\x2C\x0d\n  ) {\x0d\n    if (V != null && type(V) !== OBJECT) {\x0d\n      throw makeException(\x0d\n        'cannot be converted to a dictionary'\x2C\x0d\n        opts\x2C\x0d\n      );\x0d\n    }\x0d\n\x0d\n    const idlDict = { __proto__: null };\x0d\n    for (let i = 0; i < sortedMembers.length; i++) {\x0d\n      const member = sortedMembers[i];\x0d\n      const key = member.key;\x0d\n      let jsMemberValue;\x0d\n      if (V == null) {\x0d\n        jsMemberValue = undefined;\x0d\n      } else {\x0d\n        jsMemberValue = V[key];\x0d\n      }\x0d\n\x0d\n      if (jsMemberValue !== undefined) {\x0d\n        const memberContext = opts.context ? `${key} in ${opts.context}` : `${key}`;\x0d\n        const converter = member.converter;\x0d\n        const idlMemberValue = converter(\x0d\n          jsMemberValue\x2C\x0d\n          {\x0d\n            __proto__: null\x2C\x0d\n            prefix: opts.prefix\x2C\x0d\n            context: memberContext\x2C\x0d\n          }\x2C\x0d\n        );\x0d\n        idlDict[key] = idlMemberValue;\x0d\n      } else if (typeof member.defaultValue === 'function') {\x0d\n        const idlMemberValue = member.defaultValue();\x0d\n        idlDict[key] = idlMemberValue;\x0d\n      } else if (member.required) {\x0d\n        throw makeException(\x0d\n          `cannot be converted because of the missing '${key}'`\x2C\x0d\n          opts\x2C\x0d\n        );\x0d\n      }\x0d\n    }\x0d\n\x0d\n    return idlDict;\x0d\n  };\x0d\n}\x0d\n\x0d\n// https://webidl.spec.whatwg.org/#es-sequence\x0d\nfunction createSequenceConverter(converter) {\x0d\n  return function(V\x2C opts = kEmptyObject) {\x0d\n    if (type(V) !== OBJECT) {\x0d\n      throw makeException(\x0d\n        'can not be converted to sequence.'\x2C\x0d\n        opts);\x0d\n    }\x0d\n    const iter = V?.[SymbolIterator]?.();\x0d\n    if (iter === undefined) {\x0d\n      throw makeException(\x0d\n        'can not be converted to sequence.'\x2C\x0d\n        opts);\x0d\n    }\x0d\n    const array = [];\x0d\n    while (true) {\x0d\n      const res = iter?.next?.();\x0d\n      if (res === undefined) {\x0d\n        throw makeException(\x0d\n          'can not be converted to sequence.'\x2C\x0d\n          opts);\x0d\n      }\x0d\n      if (res.done === true) break;\x0d\n      const val = converter(res.value\x2C {\x0d\n        __proto__: null\x2C\x0d\n        ...opts\x2C\x0d\n        context: `${opts.context}[${array.length}]`\x2C\x0d\n      });\x0d\n      ArrayPrototypePush(array\x2C val);\x0d\n    };\x0d\n    return array;\x0d\n  };\x0d\n}\x0d\n\x0d\n// https://webidl.spec.whatwg.org/#js-interface\x0d\nfunction createInterfaceConverter(name\x2C I) {\x0d\n  return (V\x2C opts = kEmptyObject) => {\x0d\n    // 1. If V implements I\x2C then return the IDL interface type value that\x0d\n    //    represents a reference to that platform object.\x0d\n    if (ObjectPrototypeIsPrototypeOf(I\x2C V)) return V;\x0d\n    // 2. Throw a TypeError.\x0d\n    throw new ERR_INVALID_ARG_TYPE(\x0d\n      typeof opts.context === 'string' ? opts.context : 'value'\x2C name\x2C V\x2C\x0d\n    );\x0d\n  };\x0d\n}\x0d\n\x0d\n\x0d\nmodule.exports = {\x0d\n  type\x2C\x0d\n  converters\x2C\x0d\n  convertToInt\x2C\x0d\n  createEnumConverter\x2C\x0d\n  createInterfaceConverter\x2C\x0d\n  createSequenceConverter\x2C\x0d\n  createDictionaryConverter\x2C\x0d\n  evenRound\x2C\x0d\n  makeException\x2C\x0d\n};\x0d\n
