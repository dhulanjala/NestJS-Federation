script-source,958,C:\\development\\NestJS Federation\\gateway\\node_modules\\semver\\functions\\clean.js,'use strict'\n\nconst parse = require('./parse')\nconst clean = (version\x2C options) => {\n  const s = parse(version.trim().replace(/^[=v]+/\x2C '')\x2C options)\n  return s ? s.version : null\n}\nmodule.exports = clean\n
