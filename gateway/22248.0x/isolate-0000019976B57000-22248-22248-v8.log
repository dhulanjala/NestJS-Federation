script-source,200,node:internal/crypto/hash,'use strict';\x0d\n\x0d\nconst {\x0d\n  FunctionPrototypeCall\x2C\x0d\n  ObjectSetPrototypeOf\x2C\x0d\n  StringPrototypeReplace\x2C\x0d\n  StringPrototypeToLowerCase\x2C\x0d\n  Symbol\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  Hash: _Hash\x2C\x0d\n  HashJob\x2C\x0d\n  Hmac: _Hmac\x2C\x0d\n  kCryptoJobAsync\x2C\x0d\n  oneShotDigest\x2C\x0d\n} = internalBinding('crypto');\x0d\n\x0d\nconst {\x0d\n  getStringOption\x2C\x0d\n  jobPromise\x2C\x0d\n  normalizeHashName\x2C\x0d\n  validateMaxBufferLength\x2C\x0d\n  kHandle\x2C\x0d\n  getCachedHashId\x2C\x0d\n  getHashCache\x2C\x0d\n} = require('internal/crypto/util');\x0d\n\x0d\nconst {\x0d\n  prepareSecretKey\x2C\x0d\n} = require('internal/crypto/keys');\x0d\n\x0d\nconst {\x0d\n  lazyDOMException\x2C\x0d\n  normalizeEncoding\x2C\x0d\n  encodingsMap\x2C\x0d\n  isPendingDeprecation\x2C\x0d\n  getDeprecationWarningEmitter\x2C\x0d\n} = require('internal/util');\x0d\n\x0d\nconst {\x0d\n  Buffer\x2C\x0d\n} = require('buffer');\x0d\n\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_CRYPTO_HASH_FINALIZED\x2C\x0d\n    ERR_CRYPTO_HASH_UPDATE_FAILED\x2C\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\n\x0d\nconst {\x0d\n  validateEncoding\x2C\x0d\n  validateString\x2C\x0d\n  validateObject\x2C\x0d\n  validateUint32\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nconst {\x0d\n  isArrayBufferView\x2C\x0d\n} = require('internal/util/types');\x0d\n\x0d\nconst LazyTransform = require('internal/streams/lazy_transform');\x0d\n\x0d\nconst kState = Symbol('kState');\x0d\nconst kFinalized = Symbol('kFinalized');\x0d\n\x0d\n/**\x0d\n * @param {string} name\x0d\n * @returns {string}\x0d\n */\x0d\nfunction normalizeAlgorithm(name) {\x0d\n  return StringPrototypeReplace(StringPrototypeToLowerCase(name)\x2C '-'\x2C '');\x0d\n}\x0d\n\x0d\nconst maybeEmitDeprecationWarning = getDeprecationWarningEmitter(\x0d\n  'DEP0198'\x2C\x0d\n  'Creating SHAKE128/256 digests without an explicit options.outputLength is deprecated.'\x2C\x0d\n  undefined\x2C\x0d\n  false\x2C\x0d\n  (algorithm) => {\x0d\n    if (!isPendingDeprecation()) return false;\x0d\n    const normalized = normalizeAlgorithm(algorithm);\x0d\n    return normalized === 'shake128' || normalized === 'shake256';\x0d\n  }\x2C\x0d\n);\x0d\n\x0d\nfunction Hash(algorithm\x2C options) {\x0d\n  if (!new.target)\x0d\n    return new Hash(algorithm\x2C options);\x0d\n  const isCopy = algorithm instanceof _Hash;\x0d\n  if (!isCopy)\x0d\n    validateString(algorithm\x2C 'algorithm');\x0d\n  const xofLen = typeof options === 'object' && options !== null ?\x0d\n    options.outputLength : undefined;\x0d\n  if (xofLen !== undefined)\x0d\n    validateUint32(xofLen\x2C 'options.outputLength');\x0d\n  // Lookup the cached ID from JS land because it's faster than decoding\x0d\n  // the string in C++ land.\x0d\n  const algorithmId = isCopy ? -1 : getCachedHashId(algorithm);\x0d\n  this[kHandle] = new _Hash(algorithm\x2C xofLen\x2C algorithmId\x2C getHashCache());\x0d\n  this[kState] = {\x0d\n    [kFinalized]: false\x2C\x0d\n  };\x0d\n  if (!isCopy && xofLen === undefined) {\x0d\n    maybeEmitDeprecationWarning(algorithm);\x0d\n  }\x0d\n  FunctionPrototypeCall(LazyTransform\x2C this\x2C options);\x0d\n}\x0d\n\x0d\nObjectSetPrototypeOf(Hash.prototype\x2C LazyTransform.prototype);\x0d\nObjectSetPrototypeOf(Hash\x2C LazyTransform);\x0d\n\x0d\nHash.prototype.copy = function copy(options) {\x0d\n  const state = this[kState];\x0d\n  if (state[kFinalized])\x0d\n    throw new ERR_CRYPTO_HASH_FINALIZED();\x0d\n\x0d\n  return new Hash(this[kHandle]\x2C options);\x0d\n};\x0d\n\x0d\nHash.prototype._transform = function _transform(chunk\x2C encoding\x2C callback) {\x0d\n  this[kHandle].update(chunk\x2C encoding);\x0d\n  callback();\x0d\n};\x0d\n\x0d\nHash.prototype._flush = function _flush(callback) {\x0d\n  this.push(this[kHandle].digest());\x0d\n  callback();\x0d\n};\x0d\n\x0d\nHash.prototype.update = function update(data\x2C encoding) {\x0d\n  const state = this[kState];\x0d\n  if (state[kFinalized])\x0d\n    throw new ERR_CRYPTO_HASH_FINALIZED();\x0d\n\x0d\n  if (typeof data === 'string') {\x0d\n    validateEncoding(data\x2C encoding);\x0d\n  } else if (!isArrayBufferView(data)) {\x0d\n    throw new ERR_INVALID_ARG_TYPE(\x0d\n      'data'\x2C ['string'\x2C 'Buffer'\x2C 'TypedArray'\x2C 'DataView']\x2C data);\x0d\n  }\x0d\n\x0d\n  if (!this[kHandle].update(data\x2C encoding))\x0d\n    throw new ERR_CRYPTO_HASH_UPDATE_FAILED();\x0d\n  return this;\x0d\n};\x0d\n\x0d\n\x0d\nHash.prototype.digest = function digest(outputEncoding) {\x0d\n  const state = this[kState];\x0d\n  if (state[kFinalized])\x0d\n    throw new ERR_CRYPTO_HASH_FINALIZED();\x0d\n\x0d\n  // Explicit conversion of truthy values for backward compatibility.\x0d\n  const ret = this[kHandle].digest(outputEncoding && `${outputEncoding}`);\x0d\n  state[kFinalized] = true;\x0d\n  return ret;\x0d\n};\x0d\n\x0d\nfunction Hmac(hmac\x2C key\x2C options) {\x0d\n  if (!(this instanceof Hmac))\x0d\n    return new Hmac(hmac\x2C key\x2C options);\x0d\n  validateString(hmac\x2C 'hmac');\x0d\n  const encoding = getStringOption(options\x2C 'encoding');\x0d\n  key = prepareSecretKey(key\x2C encoding);\x0d\n  this[kHandle] = new _Hmac();\x0d\n  this[kHandle].init(hmac\x2C key);\x0d\n  this[kState] = {\x0d\n    [kFinalized]: false\x2C\x0d\n  };\x0d\n  FunctionPrototypeCall(LazyTransform\x2C this\x2C options);\x0d\n}\x0d\n\x0d\nObjectSetPrototypeOf(Hmac.prototype\x2C LazyTransform.prototype);\x0d\nObjectSetPrototypeOf(Hmac\x2C LazyTransform);\x0d\n\x0d\nHmac.prototype.update = Hash.prototype.update;\x0d\n\x0d\nHmac.prototype.digest = function digest(outputEncoding) {\x0d\n  const state = this[kState];\x0d\n\x0d\n  if (state[kFinalized]) {\x0d\n    const buf = Buffer.from('');\x0d\n    if (outputEncoding && outputEncoding !== 'buffer')\x0d\n      return buf.toString(outputEncoding);\x0d\n    return buf;\x0d\n  }\x0d\n\x0d\n  // Explicit conversion of truthy values for backward compatibility.\x0d\n  const ret = this[kHandle].digest(outputEncoding && `${outputEncoding}`);\x0d\n  state[kFinalized] = true;\x0d\n  return ret;\x0d\n};\x0d\n\x0d\nHmac.prototype._flush = Hash.prototype._flush;\x0d\nHmac.prototype._transform = Hash.prototype._transform;\x0d\n\x0d\n// Implementation for WebCrypto subtle.digest()\x0d\n\x0d\nasync function asyncDigest(algorithm\x2C data) {\x0d\n  validateMaxBufferLength(data\x2C 'data');\x0d\n\x0d\n  switch (algorithm.name) {\x0d\n    case 'SHA-1':\x0d\n      // Fall through\x0d\n    case 'SHA-256':\x0d\n      // Fall through\x0d\n    case 'SHA-384':\x0d\n      // Fall through\x0d\n    case 'SHA-512':\x0d\n      // Fall through\x0d\n    case 'SHA3-256':\x0d\n      // Fall through\x0d\n    case 'SHA3-384':\x0d\n      // Fall through\x0d\n    case 'SHA3-512':\x0d\n      // Fall through\x0d\n    case 'cSHAKE128':\x0d\n      // Fall through\x0d\n    case 'cSHAKE256':\x0d\n      return await jobPromise(() => new HashJob(\x0d\n        kCryptoJobAsync\x2C\x0d\n        normalizeHashName(algorithm.name)\x2C\x0d\n        data\x2C\x0d\n        algorithm.outputLength));\x0d\n  }\x0d\n\x0d\n  throw lazyDOMException('Unrecognized algorithm name'\x2C 'NotSupportedError');\x0d\n}\x0d\n\x0d\nfunction hash(algorithm\x2C input\x2C options) {\x0d\n  validateString(algorithm\x2C 'algorithm');\x0d\n  if (typeof input !== 'string' && !isArrayBufferView(input)) {\x0d\n    throw new ERR_INVALID_ARG_TYPE('input'\x2C ['Buffer'\x2C 'TypedArray'\x2C 'DataView'\x2C 'string']\x2C input);\x0d\n  }\x0d\n  let outputEncoding;\x0d\n  let outputLength;\x0d\n\x0d\n  if (typeof options === 'string') {\x0d\n    outputEncoding = options;\x0d\n  } else if (options !== undefined) {\x0d\n    validateObject(options\x2C 'options');\x0d\n    outputLength = options.outputLength;\x0d\n    outputEncoding = options.outputEncoding;\x0d\n  }\x0d\n\x0d\n  outputEncoding ??= 'hex';\x0d\n\x0d\n  let normalized = outputEncoding;\x0d\n  // Fast case: if it's 'hex'\x2C we don't need to validate it further.\x0d\n  if (normalized !== 'hex') {\x0d\n    validateString(outputEncoding\x2C 'outputEncoding');\x0d\n    normalized = normalizeEncoding(outputEncoding);\x0d\n    // If the encoding is invalid\x2C normalizeEncoding() returns undefined.\x0d\n    if (normalized === undefined) {\x0d\n      // normalizeEncoding() doesn't handle 'buffer'.\x0d\n      if (StringPrototypeToLowerCase(outputEncoding) === 'buffer') {\x0d\n        normalized = 'buffer';\x0d\n      } else {\x0d\n        throw new ERR_INVALID_ARG_VALUE('outputEncoding'\x2C outputEncoding);\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n\x0d\n  if (outputLength !== undefined) {\x0d\n    validateUint32(outputLength\x2C 'outputLength');\x0d\n  }\x0d\n\x0d\n  if (outputLength === undefined) {\x0d\n    maybeEmitDeprecationWarning(algorithm);\x0d\n  }\x0d\n\x0d\n  return oneShotDigest(algorithm\x2C getCachedHashId(algorithm)\x2C getHashCache()\x2C\x0d\n                       input\x2C normalized\x2C encodingsMap[normalized]\x2C outputLength);\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  Hash\x2C\x0d\n  Hmac\x2C\x0d\n  asyncDigest\x2C\x0d\n  hash\x2C\x0d\n};\x0d\n
